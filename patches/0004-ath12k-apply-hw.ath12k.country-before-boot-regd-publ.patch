From 3813add9dde8298c04358a258a4e3204a59be834 Mon Sep 17 00:00:00 2001
From: dcasati <dcasati@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:57:18 -0600
Subject: [PATCH 4/6] ath12k: apply hw.ath12k.country before boot regd
 publication

Strict LinuxKPI regulatory mode only accepts a byte-identical regd once
published, so a later country change revokes TX. Send
WMI_SET_CURRENT_COUNTRY from the hw.ath12k.country tunable before the
boot-time ath12k_regd_update(), which waits for the firmware's channel
list event while it still replaces default_regd.

With CA this enables 2.4 GHz channels 1-11 and 5 GHz 149-165.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 sys/contrib/dev/athk/ath12k/mac.c | 34 +++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/sys/contrib/dev/athk/ath12k/mac.c b/sys/contrib/dev/athk/ath12k/mac.c
index 2fc2a4db..36edb4ce 100644
--- a/sys/contrib/dev/athk/ath12k/mac.c
+++ b/sys/contrib/dev/athk/ath12k/mac.c
@@ -44,6 +44,37 @@ void ath12k_mac_m4_cancel(struct ath12k_link_vif *arvif, const char *reason)
 }
 #endif
 
+#if defined(__FreeBSD__)
+/* ISO 3166-1 alpha2 country applied before the boot-time regd is published. */
+static char ath12k_boot_country[3];
+TUNABLE_STR("hw.ath12k.country", ath12k_boot_country,
+    sizeof(ath12k_boot_country));
+
+static void ath12k_mac_request_boot_country(struct ath12k *ar)
+{
+	struct wmi_set_current_country_arg arg = {};
+	const char *cc = ath12k_boot_country;
+	int ret;
+
+	if (!ar->ab->hw_params->current_cc_support ||
+	    cc[0] < 'A' || cc[0] > 'Z' || cc[1] < 'A' || cc[1] > 'Z' ||
+	    cc[2] != '\0')
+		return;
+	memcpy(&arg.alpha2, cc, 2);
+	memcpy(&ar->alpha2, cc, 2);
+	/* ath12k_regd_update() waits for the resulting channel-list event. */
+	reinit_completion(&ar->regd_update_completed);
+	ret = ath12k_wmi_send_set_current_country_cmd(ar, &arg);
+	if (ret) {
+		ath12k_warn(ar->ab, "failed to request boot country %s: %d\n",
+			    cc, ret);
+		complete_all(&ar->regd_update_completed);
+		return;
+	}
+	ath12k_info(ar->ab, "requested boot country %s\n", cc);
+}
+#endif
+
 #define CHAN2G(_channel, _freq, _flags) { \
 	.band                   = NL80211_BAND_2GHZ, \
 	.hw_value               = (_channel), \
@@ -15052,6 +15083,9 @@ static int ath12k_mac_hw_register(struct ath12k_hw *ah)
 		wiphy->interface_modes &= ~BIT(NL80211_IFTYPE_MONITOR);
 
 	for_each_ar(ah, ar, i) {
+#if defined(__FreeBSD__)
+		ath12k_mac_request_boot_country(ar);
+#endif
 		/* Apply the regd received during initialization */
 		ret = ath12k_regd_update(ar, true);
 		if (ret) {
-- 
