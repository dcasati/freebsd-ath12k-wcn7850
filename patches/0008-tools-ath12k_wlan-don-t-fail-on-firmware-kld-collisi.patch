From 2d77d77cbeb299a6081c131e800202db23ba3e73 Mon Sep 17 00:00:00 2001
From: dcasati <dcasati@users.noreply.github.com>
Date: Thu, 22 Oct 2026 21:09:17 -0600
Subject: [PATCH] tools: ath12k_wlan: don't fail on firmware kld collision

The driver fetches firmware from /boot/firmware; loading ath12k_wcn7850_fw
afterwards fails with EEXIST and aborted wlan0 bring-up at boot.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 tools/tools/ath12k/ath12k_wlan.rc | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/tools/tools/ath12k/ath12k_wlan.rc b/tools/tools/ath12k/ath12k_wlan.rc
index e6fdd96a..d03ee5e5 100755
--- a/tools/tools/ath12k/ath12k_wlan.rc
+++ b/tools/tools/ath12k/ath12k_wlan.rc
@@ -47,7 +47,9 @@ ath12k_wlan_start()
 		return 1
 		;;
 	esac
-	kldload -n ath12k_wcn7850_fw if_ath12k || return 1
+	# Firmware is fetched by the driver from /boot/firmware; the fw kld
+	# can collide with it (EEXIST), so it must not be fatal.
+	kldload -n if_ath12k || return 1
 	i=0
 	while ! sysctl -n net.wlan.devices | grep -qw "${parent}"; do
 		i=$((i + 1))
-- 
2.56.0

