--- /dev/null
+++ b/tests/sys/compat/linuxkpi/wlan_kmod_test.sh
@@ -0,0 +1,197 @@
+#
+# SPDX-License-Identifier: BSD-2-Clause
+#
+# Wrappers for the LinuxKPI 802.11 kernel test modules built from
+# sys/modules/tests/linuxkpi_*.  Each module runs its checks from MOD_LOAD:
+# on failure MOD_LOAD returns an error, the kernel linker unloads the file
+# again and kldload(8) fails; on success the module prints a fixed "passed"
+# line and stays loaded until the test case unloads it.
+#
+# The modules are not part of the kernel build.  Build and install them with
+#	make -C /usr/src/sys/modules/tests/linuxkpi_wlan all install
+# or point Kyua at a build directory:
+#	kyua test -v test_suites.FreeBSD.linuxkpi_kmod_dir=/path/to/ko ...
+#
+# The test cases never load the LinuxKPI or net80211 modules they depend on;
+# they are skipped unless that support is already present.
+#
+
+# Set KMOD_PATH to the test module, or skip if it was not installed.
+find_kmod()
+{
+	local dir kmod
+
+	kmod=$1
+	KMOD_PATH=
+	dir=$(atf_config_get linuxkpi_kmod_dir "")
+	if [ -n "${dir}" ]; then
+		[ -f "${dir}/${kmod}.ko" ] && KMOD_PATH=${dir}/${kmod}.ko
+	else
+		for dir in $(sysctl -n kern.module_path | tr ';' ' '); do
+			if [ -f "${dir}/${kmod}.ko" ]; then
+				KMOD_PATH=${dir}/${kmod}.ko
+				break
+			fi
+		done
+	fi
+	if [ -z "${KMOD_PATH}" ]; then
+		atf_skip "${kmod}.ko is not installed (see sys/modules/tests" \
+		    "or set linuxkpi_kmod_dir)"
+	fi
+}
+
+# LinuxKPI may be compiled into the kernel, so check for its sysctl nodes
+# rather than for a loaded linuxkpi.ko or linuxkpi_wlan.ko.
+require_linuxkpi()
+{
+	sysctl -N compat.linuxkpi >/dev/null 2>&1 ||
+	    atf_skip "LinuxKPI (linuxkpi) is not loaded"
+}
+
+require_linuxkpi_wlan()
+{
+	require_linuxkpi
+	sysctl -N compat.linuxkpi.80211 >/dev/null 2>&1 ||
+	    atf_skip "LinuxKPI 802.11 support (linuxkpi_wlan) is not loaded"
+	kldstat -q -m wlan || atf_skip "net80211 (wlan) is not loaded"
+}
+
+marker_count()
+{
+	dmesg | grep -cF -- "$1"
+}
+
+# Load the test module, require the pass marker and unload the module.
+run_kmod()
+{
+	local after before failed kmod marker
+
+	kmod=$1
+	marker=$2
+	if kldstat -q -n "${kmod}.ko"; then
+		atf_skip "${kmod} is already loaded; unload it first"
+	fi
+	find_kmod "${kmod}"
+
+	before=$(marker_count "${marker}")
+	failed=$(marker_count "MOD_LOAD (${kmod},")
+	echo "${kmod}" > loaded_kmod
+	if ! kldload "${KMOD_PATH}"; then
+		rm -f loaded_kmod
+		dmesg | grep -F -e "${kmod}" -e "${3:-${kmod}}" | tail -n 20 >&2
+		if [ "$(marker_count "MOD_LOAD (${kmod},")" -gt "${failed}" ]
+		then
+			atf_fail "${kmod} reported a failure, see stderr"
+		fi
+		atf_fail "kldload ${KMOD_PATH} failed; it must match the" \
+		    "running kernel"
+	fi
+	after=$(marker_count "${marker}")
+	atf_check kldunload "${kmod}"
+	rm -f loaded_kmod
+	if [ "${after}" -le "${before}" ]; then
+		atf_fail "${kmod} loaded without reporting '${marker}'"
+	fi
+}
+
+# Unload the test module if the body loaded it and did not unload it.
+cleanup_kmod()
+{
+	local kmod
+
+	[ -f loaded_kmod ] || return 0
+	kmod=$(cat loaded_kmod)
+	if kldstat -q -n "${kmod}.ko"; then
+		kldunload "${kmod}"
+	fi
+}
+
+atf_test_case compat cleanup
+compat_head()
+{
+	atf_set descr "LinuxKPI mac80211 queue, RCU, list, guard, tasklet," \
+	    "IE, skb and rhashtable checks (lkpi_wlan_test)"
+	atf_set require.user root
+}
+compat_body()
+{
+	require_linuxkpi_wlan
+	run_kmod lkpi_wlan_test "lkpi_wlan_test: queue, RCU, list, guard," \
+	    lkpi_rhashtable_test
+}
+compat_cleanup()
+{
+	cleanup_kmod
+}
+
+atf_test_case regulatory cleanup
+regulatory_head()
+{
+	atf_set descr "LinuxKPI regulatory channel/rule translation and" \
+	    "strict-mode TX gating (lkpi_regulatory_test)"
+	atf_set require.user root
+}
+regulatory_body()
+{
+	require_linuxkpi_wlan
+	run_kmod lkpi_regulatory_test "lkpi_regulatory_test: passed"
+}
+regulatory_cleanup()
+{
+	cleanup_kmod
+}
+
+atf_test_case mhi cleanup
+mhi_head()
+{
+	atf_set descr "LinuxKPI MHI/QMI/CE/HTC/WMI protocol models and MHI" \
+	    "DMA context layout (lkpi_mhi_test); needs an unbound WCN7850"
+	atf_set require.user root
+	atf_set require.config linuxkpi_mhi_pci
+}
+mhi_body()
+{
+	local line sel
+
+	if [ "$(atf_config_get linuxkpi_mhi_pci)" != "yes" ]; then
+		atf_skip "set linuxkpi_mhi_pci=yes to allow DMA on the device"
+	fi
+	# lkpi_mhi_test allocates its DMA rings for the device at a fixed
+	# address in the ATH12KHOST and ATH12KLAB configurations.
+	case "$(sysctl -n kern.ident)" in
+	ATH12KHOST)
+		sel=pci0:194:0:0
+		;;
+	ATH12KLAB)
+		sel=pci0:0:6:0
+		;;
+	*)
+		atf_skip "needs an ATH12KHOST or ATH12KLAB kernel"
+		;;
+	esac
+	line=$(pciconf -l "${sel}" 2>/dev/null)
+	case "${line}" in
+	none*vendor=0x17cb\ device=0x1107\ subvendor=0x17aa\ subdevice=0xe0e6*)
+		;;
+	"")
+		atf_skip "no PCI function at ${sel}"
+		;;
+	*)
+		atf_skip "${sel} is not an unbound WCN7850: ${line}"
+		;;
+	esac
+	require_linuxkpi_wlan
+	run_kmod lkpi_mhi_test "lkpi_mhi_test: DMA contexts, rings," \
+	    mhi_lab_
+}
+mhi_cleanup()
+{
+	cleanup_kmod
+}
+
+atf_init_test_cases()
+{
+	atf_add_test_case compat
+	atf_add_test_case regulatory
+	atf_add_test_case mhi
+}
