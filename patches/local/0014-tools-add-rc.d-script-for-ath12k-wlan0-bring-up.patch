From d7a8350b3e094f097a3785a936d36274e63a62b7 Mon Sep 17 00:00:00 2001
From: Diego Casati <diego.casati@gmail.com>
Date: Thu, 22 Oct 2026 20:57:22 -0600
Subject: [PATCH 14/14] tools: add rc.d script for ath12k wlan0 bring-up

rc.conf's wlans_<parent> parser rejects ath12k_wifi70, so create
wlan0 and run wpa_supplicant and dhclient from a dedicated rc script.
Firmware kld collisions at load time are not treated as fatal.
ath12k_wlan_args (default "scanvalid 10") is passed to ifconfig so a
missed scan after a disconnect does not stall reconnects for ~60s.

dhclient is not started right after wpa_supplicant: it gives up if
the link is not up within ~10s, and devd's LINK_UP rule only restarts
it for interfaces with ifconfig_<if>="DHCP", so a late association
left wlan0 without an address.  With ath12k_wlan_dhcp="YES" (default)
a wpa_cli(8) action daemon (-a pointing at this script) starts dhclient
on every CONNECTED event if it is not running, and start also runs it
if the interface is already associated.  A running dhclient follows
later disassociations itself.  stop kills wpa_cli before dhclient and
wpa_supplicant.  No new rc.conf variables.

Local workaround only; the real fix belongs in the rc.d network
scripts.

Signed-off-by: Diego Casati <diego.casati@gmail.com>
---
 tools/tools/ath12k/ath12k_wlan.rc | 133 ++++++++++++++++++++++++++++++
 1 file changed, 133 insertions(+)
 create mode 100755 tools/tools/ath12k/ath12k_wlan.rc

diff --git a/tools/tools/ath12k/ath12k_wlan.rc b/tools/tools/ath12k/ath12k_wlan.rc
new file mode 100755
index 00000000000..37f71b96eaf
--- /dev/null
+++ b/tools/tools/ath12k/ath12k_wlan.rc
@@ -0,0 +1,133 @@
+#!/bin/sh
+#
+# PROVIDE: ath12k_wlan
+# REQUIRE: NETWORKING
+# BEFORE: LOGIN
+# KEYWORD: shutdown
+#
+# Bring up the Qualcomm WCN7850 (ath12k) station interface.
+# rc.conf's wlans_<parent> parser rejects "ath12k_wifi70" (underscore),
+# so the interface is created here.
+#
+# ath12k_wlan_enable="YES"
+# ath12k_wlan_if="wlan0"
+# ath12k_wlan_conf="/etc/wpa_supplicant-ath12k.conf"
+# ath12k_wlan_kernel="/boot/kernel.ath12k-*/kernel"  (glob)
+# ath12k_wlan_dhcp="YES"
+# ath12k_wlan_args="scanvalid 10"  (extra ifconfig args; see below)
+#
+# With ath12k_wlan_dhcp, dhclient is not started right after
+# wpa_supplicant: it gives up if the link is not up within ~10s, and
+# devd's LINK_UP rule only restarts it for ifconfig_<if>="DHCP"
+# interfaces.  A wpa_cli(8) action daemon runs this script on every
+# association instead and starts dhclient if it is not running; a
+# running dhclient follows later disassociations by itself.
+
+. /etc/rc.subr
+
+name="ath12k_wlan"
+rcvar="ath12k_wlan_enable"
+start_cmd="${name}_start"
+stop_cmd="${name}_stop"
+status_cmd="${name}_status"
+extra_commands="status"
+
+load_rc_config $name
+: ${ath12k_wlan_enable:="NO"}
+: ${ath12k_wlan_if:="wlan0"}
+: ${ath12k_wlan_conf:="/etc/wpa_supplicant-ath12k.conf"}
+: ${ath12k_wlan_kernel:="/boot/kernel.ath12k-*/kernel"}
+: ${ath12k_wlan_dhcp:="YES"}
+# net80211 answers scan requests from its cache for "scanvalid" seconds
+# (default 60); one missed scan after a disconnect then stalls reconnect
+# ~60s. 10 is the net80211 minimum.
+: ${ath12k_wlan_args:="scanvalid 10"}
+
+parent="ath12k_wifi70"
+wpa_pid="/var/run/wpa_supplicant.${ath12k_wlan_if}.pid"
+dhc_pid="/var/run/dhclient/dhclient.${ath12k_wlan_if}.pid"
+cli_pid="/var/run/wpa_cli.${ath12k_wlan_if}.pid"
+
+ath12k_wlan_dhclient()
+{
+	pgrep -F "${dhc_pid}" >/dev/null 2>&1 && return 0
+	/sbin/dhclient -b "${ath12k_wlan_if}"
+}
+
+ath12k_wlan_start()
+{
+	local i
+
+	# The module depends on this kernel's LinuxKPI; never load it elsewhere.
+	case "$(sysctl -n kern.bootfile)" in
+	${ath12k_wlan_kernel}) ;;
+	*)
+		warn "not booted from ${ath12k_wlan_kernel}; skipping"
+		return 1
+		;;
+	esac
+	# Firmware is fetched by the driver from /boot/firmware; the fw kld
+	# can collide with it (EEXIST), so it must not be fatal.
+	kldload -n if_ath12k || return 1
+	i=0
+	while ! sysctl -n net.wlan.devices | grep -qw "${parent}"; do
+		i=$((i + 1))
+		if [ $i -gt 60 ]; then
+			warn "${parent} did not register"
+			return 1
+		fi
+		sleep 1
+	done
+	if ! ifconfig "${ath12k_wlan_if}" >/dev/null 2>&1; then
+		ifconfig "${ath12k_wlan_if}" create wlandev "${parent}" || return 1
+	fi
+	ifconfig "${ath12k_wlan_if}" ${ath12k_wlan_args} up
+	if ! pgrep -F "${wpa_pid}" >/dev/null 2>&1; then
+		/usr/sbin/wpa_supplicant -B -i "${ath12k_wlan_if}" \
+		    -c "${ath12k_wlan_conf}" -P "${wpa_pid}" || return 1
+	fi
+	if checkyesno ath12k_wlan_dhcp; then
+		if ! pgrep -F "${cli_pid}" >/dev/null 2>&1; then
+			/usr/sbin/wpa_cli -B -i "${ath12k_wlan_if}" \
+			    -P "${cli_pid}" -a "$(realpath "$0")" || return 1
+		fi
+		# wpa_cli only reports associations made after it attached.
+		if ifconfig "${ath12k_wlan_if}" | grep -q 'status: associated'; then
+			ath12k_wlan_dhclient
+		fi
+	fi
+	echo "${ath12k_wlan_if} started on ${parent}."
+}
+
+ath12k_wlan_stop()
+{
+	# Interface teardown only; the driver stays loaded.
+	[ -f "${cli_pid}" ] && pkill -F "${cli_pid}"
+	[ -f "${dhc_pid}" ] && pkill -F "${dhc_pid}"
+	[ -f "${wpa_pid}" ] && pkill -F "${wpa_pid}"
+	sleep 1
+	if ifconfig "${ath12k_wlan_if}" >/dev/null 2>&1; then
+		ifconfig "${ath12k_wlan_if}" down
+		ifconfig "${ath12k_wlan_if}" destroy
+	fi
+	rm -f "${wpa_pid}" "${cli_pid}"
+}
+
+ath12k_wlan_status()
+{
+	if ! ifconfig "${ath12k_wlan_if}" >/dev/null 2>&1; then
+		echo "${ath12k_wlan_if} not present"
+		return 1
+	fi
+	ifconfig "${ath12k_wlan_if}" | grep -E 'status:|inet '
+	wpa_cli -i "${ath12k_wlan_if}" status 2>/dev/null | grep '^wpa_state='
+}
+
+# wpa_cli(8) action mode runs this script as "<ifname> <event> [...]".
+if [ "$1" = "${ath12k_wlan_if}" ]; then
+	[ "$2" = "CONNECTED" ] && checkyesno ath12k_wlan_dhcp &&
+	    ath12k_wlan_dhclient
+	exit 0
+fi
+
+run_rc_command "$1"
-- 
