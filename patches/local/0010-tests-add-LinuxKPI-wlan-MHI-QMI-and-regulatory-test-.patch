+struct mhi_ce_model {
+	uint32_t regs[0xa000 / 4];
+	unsigned int writes, fail_at;
+	uint32_t corrupt;
+};
+
+static int
+mhi_ce_model_register(void *arg, uint32_t address, uint32_t *value, bool write)
+{
+	struct mhi_ce_model *model = arg;
+	uint32_t offset = address - 0x1b80000;
+
+	if (address < 0x1b80000 || offset >= sizeof(model->regs) ||
+	    (offset & 3) != 0)
+		return (ERANGE);
+	if (write) {
+		if (++model->writes == model->fail_at)
+			return (EIO);
+		model->regs[offset / 4] = *value;
+	} else {
+		*value = model->regs[offset / 4];
+		if (address == model->corrupt)
+			*value ^= 1;
+	}
+	return (0);
+}
