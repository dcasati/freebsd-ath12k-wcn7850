+int lkpi_rhashtable_test(void);
+
+static const struct ieee80211_ops queue_test_ops = {
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+};
+
+static int
+queue_test(void)
+{
+	struct ieee80211_hw *hw;
+	int error, i;
+
+	hw = ieee80211_alloc_hw(0, &queue_test_ops);
+	if (hw == NULL)
+		return (ENOMEM);
+	hw->queues = IEEE80211_MAX_QUEUES;
+	error = EINVAL;
+
+	for (i = 0; i < hw->queues; i++)
+		CHECK(!ieee80211_queue_stopped(hw, i));
+
+#ifdef INVARIANTS
+	CHECK(!rcu_read_lock_held());
+	CHECK(!rcu_read_lock_any_held());
+	rcu_read_lock();
+	if (!rcu_read_lock_held()) {
+		rcu_read_unlock();
+		CHECK(false);
+	}
+	if (!rcu_read_lock_any_held()) {
+		rcu_read_unlock();
+		CHECK(false);
+	}
+	rcu_read_unlock();
+	CHECK(!rcu_read_lock_held());
+	CHECK(!rcu_read_lock_any_held());
+#endif
+
+	/* Queue state must exist even when there are no virtual interfaces. */
+	ieee80211_stop_queue(hw, 0);
+	CHECK(ieee80211_queue_stopped(hw, 0));
+	CHECK(!ieee80211_queue_stopped(hw, 1));
+	ieee80211_stop_queue(hw, 0);
+	ieee80211_stop_queue(hw, hw->queues - 1);
+	ieee80211_wake_queue(hw, 0);
+	CHECK(!ieee80211_queue_stopped(hw, 0));
+	CHECK(ieee80211_queue_stopped(hw, hw->queues - 1));
+
+	ieee80211_stop_queues(hw);
+	for (i = 0; i < hw->queues; i++)
+		CHECK(ieee80211_queue_stopped(hw, i));
+	ieee80211_wake_queues(hw);
+	for (i = 0; i < hw->queues; i++)
+		CHECK(!ieee80211_queue_stopped(hw, i));
+
+	error = 0;
+out:
+	ieee80211_free_hw(hw);
+	return (error);
+}
+
+static int
+list_test(void)
+{
+	struct list_head head, cut, nodes[3];
+	int error, i;
+
+	error = EINVAL;
+	INIT_LIST_HEAD(&head);
+	list_cut_before(&cut, &head, &head);
+	CHECK(list_empty(&cut) && list_empty(&head));
+
+	for (i = 0; i < nitems(nodes); i++)
+		list_add_tail(&nodes[i], &head);
+	list_cut_before(&cut, &head, &nodes[0]);
+	CHECK(list_empty(&cut) && list_count_nodes(&head) == 3);
+
+	list_cut_before(&cut, &head, &nodes[2]);
+	CHECK(list_count_nodes(&cut) == 2 && list_count_nodes(&head) == 1);
+	CHECK(cut.next == &nodes[0] && cut.prev == &nodes[1]);
+	CHECK(nodes[0].prev == &cut && nodes[1].next == &cut);
+	CHECK(head.next == &nodes[2] && nodes[2].prev == &head);
+
+	list_splice_init(&cut, &head);
+	list_cut_before(&cut, &head, &head);
+	CHECK(list_empty(&head) && list_count_nodes(&cut) == 3);
+	CHECK(cut.next == &nodes[0] && cut.prev == &nodes[2]);
+	CHECK(nodes[0].prev == &cut && nodes[2].next == &cut);
+	error = 0;
+out:
+	return (error);
+}
+
+static bool
+guard_test_locked(spinlock_t *lock)
+{
+	guard(spinlock_bh)(lock);
+	return (mtx_owned(lock));
+}
+
+static int
+guard_test(void)
+{
+	spinlock_t lock;
+	int error;
+
+	error = EINVAL;
+	spin_lock_init(&lock);
+	CHECK(guard_test_locked(&lock));
+	CHECK(!mtx_owned(&lock));
+	error = 0;
+out:
+	spin_lock_destroy(&lock);
+	return (error);
+}
+
+struct tasklet_test_state {
+	struct tasklet_struct tasklet;
+	atomic_t calls;
+};
+
+static int
+ie_test(void)
+{
+	static const uint8_t ies[] = {
+		WLAN_EID_VENDOR_SPECIFIC, 4, 0x50, 0x6f, 0x9a, 9,
+		WLAN_EID_EXTENSION, 2, 42, 1,
+		WLAN_EID_VENDOR_SPECIFIC, 3, 0x00, 0x11, 0x22
+	};
+	const struct element *elem;
+	int error;
+
+	error = EINVAL;
+	CHECK(cfg80211_find_vendor_ie(0x506f9a, 9, ies, sizeof(ies)) == ies);
+	CHECK(cfg80211_find_vendor_ie(0x001122, -1, ies,
+	    sizeof(ies)) == ies + 10);
+	CHECK(cfg80211_find_vendor_ie(0x001122, 1, ies,
+	    sizeof(ies)) == NULL);
+	CHECK(cfg80211_find_vendor_ie(0x001122, -1, ies,
+	    sizeof(ies) - 1) == NULL);
+	elem = cfg80211_find_ext_elem(42, ies, sizeof(ies));
+	CHECK((const uint8_t *)elem == ies + 6);
+	CHECK(cfg80211_find_ext_elem(41, ies, sizeof(ies)) == NULL);
+	CHECK(cfg80211_find_ext_elem(42, ies + 6, 3) == NULL);
+	error = 0;
+out:
+	return (error);
+}
+
+static void
+tasklet_test_callback(struct tasklet_struct *tasklet)
+{
+	struct tasklet_test_state *state;
+
+	state = from_tasklet(state, tasklet, tasklet);
+	if (atomic_inc_return(&state->calls) == 1)
+		tasklet_schedule(tasklet);
+}
+
+static int
+tasklet_test(void)
+{
+	struct tasklet_test_state state;
+	int error;
+
+	error = EINVAL;
+	memset(&state, 0xa5, sizeof(state));
+	atomic_set(&state.calls, 0);
+	tasklet_setup(&state.tasklet, tasklet_test_callback);
+	tasklet_schedule(&state.tasklet);
+	tasklet_kill(&state.tasklet);
+	CHECK(atomic_read(&state.calls) == 2);
+	tasklet_schedule(&state.tasklet);
+	tasklet_kill(&state.tasklet);
+	CHECK(atomic_read(&state.calls) == 3);
+	error = 0;
+out:
+	tasklet_kill(&state.tasklet);
+	return (error);
+}
+
+static void
+skb_test_free(void *arg)
+{
+	unsigned int *frees = arg;
+
+	(*frees)++;
+}
+
+static int
+skb_linear_test(void)
+{
+	struct sk_buff *skb, *copy, *trailer, *empty;
+	unsigned int frees;
+	int error, ret;
+
+	error = EINVAL;
+	frees = 0;
+	copy = empty = NULL;
+	skb = alloc_skb(20, GFP_KERNEL);
+	CHECK(skb != NULL);
+	skb_reserve(skb, 12);
+	memset(skb->head, 0xa5, 12);
+	skb_put_data(skb, "linear", 6);
+	memset(skb->cb, 0x5a, sizeof(skb->cb));
+	skb->protocol = 0x1234;
+	skb->priority = 17;
+	skb->qmap = 3;
+	skb->ip_summed = CHECKSUM_UNNECESSARY;
+	skb->mac_header = 12;
+	skb->l3hdroff = 14;
+	skb->l4hdroff = 16;
+
+	copy = skb_copy(skb, GFP_KERNEL);
+	CHECK(copy != NULL);
+	CHECK(copy->len == 6 && copy->data_len == 0);
+	CHECK(skb_headroom(copy) == 12);
+	CHECK(memcmp(copy->head, skb->head, 18) == 0);
+	CHECK(memcmp(copy->cb, skb->cb, sizeof(skb->cb)) == 0);
+	CHECK(copy->protocol == skb->protocol &&
+	    copy->priority == skb->priority && copy->qmap == skb->qmap &&
+	    copy->ip_summed == skb->ip_summed);
+	CHECK(copy->mac_header == 12 && copy->l3hdroff == 14 &&
+	    copy->l4hdroff == 16);
+	copy->data[0] = 'L';
+	CHECK(skb->data[0] == 'l');
+
+	trailer = skb;
+	CHECK(skb_cow_data(skb, -1, &trailer) == -EINVAL);
+	CHECK(trailer == NULL);
+	CHECK(skb->len == 6 && memcmp(skb->data, "linear", 6) == 0);
+	CHECK(skb_cow_data(skb, 0, NULL) == -EINVAL);
+	skb->data_len = skb->len + 1;
+	trailer = skb;
+	ret = skb_cow_data(skb, 32, &trailer);
+	skb->data_len = 0;	/* Restore even if validation unexpectedly fails. */
+	CHECK(ret == -EINVAL && trailer == NULL);
+	CHECK(skb->len == 6 && skb_headroom(skb) == 12 &&
+	    memcmp(skb->data, "linear", 6) == 0);
+	trailer = skb;
+	skb_get(skb);
+	ret = skb_cow_data(skb, 32, &trailer);
+	kfree_skb(skb);		/* Drop the extra reference even on failure. */
+	CHECK(ret == -EBUSY);
+	CHECK(trailer == NULL);
+	CHECK(skb->len == 6 && memcmp(skb->data, "linear", 6) == 0);
+	CHECK(skb_cow_data(skb, 32, &trailer) == 1);
+	CHECK(trailer == skb && skb_tailroom(skb) >= 32);
+	CHECK(skb->len == 6 && skb->data_len == 0);
+	CHECK(skb_headroom(skb) == 12 && skb->head[0] == 0xa5 &&
+	    skb->head[11] == 0xa5);
+	CHECK(memcmp(skb->cb, copy->cb, sizeof(skb->cb)) == 0);
+	CHECK(skb->protocol == 0x1234 && skb->priority == 17 &&
+	    skb->qmap == 3 && skb->ip_summed == CHECKSUM_UNNECESSARY);
+	CHECK(skb->mac_header == 12 && skb->l3hdroff == 14 &&
+	    skb->l4hdroff == 16);
+	memcpy(pskb_put(skb, trailer, 4), "tail", 4);
+	CHECK(skb->len == 10 && skb->data_len == 0);
+	CHECK(memcmp(skb->data, "lineartail", 10) == 0);
+	CHECK(copy->len == 6 && memcmp(copy->data, "Linear", 6) == 0);
+
+	empty = alloc_skb(0, GFP_KERNEL);
+	CHECK(empty != NULL);
+	ret = refcount_read(&empty->refcnt);
+	if (ret != 1)
+		refcount_set(&empty->refcnt, 1);	/* Permit safe failure cleanup. */
+	CHECK(ret == 1);
+	empty->m = &frees;
+	empty->m_free_func = skb_test_free;
+	skb_get(empty);
+	kfree_skb(empty);
+	CHECK(frees == 0);
+	kfree_skb(empty);
+	empty = NULL;
+	CHECK(frees == 1);
+	error = 0;
+out:
+	kfree_skb(empty);
+	kfree_skb(copy);
+	kfree_skb(skb);
+	return (error);
+}
+
+static int
+skb_page_test(void)
+{
+	struct sk_buff *skb, *copy;
+	struct page *first, *second;
+	int error;
+
+	error = EINVAL;
+	skb = copy = NULL;
+	first = second = NULL;
+	skb = alloc_skb(64, GFP_KERNEL);
+	CHECK(skb != NULL);
+	first = alloc_page(GFP_KERNEL);
+	CHECK(first != NULL);
+	second = alloc_page(GFP_KERNEL);
+	CHECK(second != NULL);
+	memset(page_address(first), 0xa5, PAGE_SIZE);
+	memset(page_address(second), 0x5a, PAGE_SIZE);
+	memcpy((uint8_t *)page_address(first) + 7, "abc", 3);
+	memcpy((uint8_t *)page_address(second) + 19, "DEFG", 4);
+	skb_reserve(skb, 8);
+	skb_put_data(skb, "head", 4);
+	skb_add_rx_frag(skb, 0, first, 7, 3, PAGE_SIZE);
+	first = NULL;		/* skb owns the page reference now. */
+	skb_add_rx_frag(skb, 1, second, 19, 4, PAGE_SIZE);
+	second = NULL;
+	/* Reject bad address arithmetic before a copy can dereference it. */
+	CHECK(skb_frag_address(&skb_shinfo(skb)->frags[0]) ==
+	    (uint8_t *)page_address(skb_shinfo(skb)->frags[0].page) + 7);
+	CHECK(skb_frag_address(&skb_shinfo(skb)->frags[1]) ==
+	    (uint8_t *)page_address(skb_shinfo(skb)->frags[1].page) + 19);
+	CHECK(skb->len == 11 && skb->data_len == 7);
+
+	copy = skb_copy(skb, GFP_KERNEL);
+	CHECK(copy != NULL);
+	CHECK(copy->len == 11 && copy->data_len == 0 &&
+	    skb_shinfo(copy)->nr_frags == 0);
+	CHECK(skb_headroom(copy) == 8);
+	CHECK(memcmp(copy->data, "headabcDEFG", 11) == 0);
+	CHECK(skb->len == 11 && skb->data_len == 7 &&
+	    skb_shinfo(skb)->nr_frags == 2);
+	CHECK(skb_linearize(skb) == 0);
+	CHECK(skb->len == 11 && skb->data_len == 0 &&
+	    skb_shinfo(skb)->nr_frags == 0);
+	CHECK(skb_headroom(skb) == 8 &&
+	    memcmp(skb->data, "headabcDEFG", 11) == 0);
+	CHECK(skb_linearize(skb) == 0);
+	CHECK(skb->len == 11 && memcmp(skb->data, copy->data, 11) == 0);
+	error = 0;
+out:
+	if (first != NULL)
+		__free_page(first);
+	if (second != NULL)
+		__free_page(second);
+	kfree_skb(copy);
+	kfree_skb(skb);
+	return (error);
+}
+
+static int
+skb_frag_list_test(void)
+{
+	struct sk_buff *skb, *child, *held, *nested, *copy, *trailer;
+	unsigned int frees;
+	int error;
+
+	error = EINVAL;
+	frees = 0;
+	skb = child = held = nested = copy = NULL;
+	skb = alloc_skb(16, GFP_KERNEL);
+	CHECK(skb != NULL);
+	child = alloc_skb(16, GFP_KERNEL);
+	CHECK(child != NULL);
+	child->m = &frees;
+	child->m_free_func = skb_test_free;
+	skb_put_data(skb, "head", 4);
+	skb_put_data(child, "child", 5);
+	nested = alloc_skb(8, GFP_KERNEL);
+	CHECK(nested != NULL);
+	nested->m = &frees;
+	nested->m_free_func = skb_test_free;
+	skb_put_data(nested, "end", 3);
+	nested->next = NULL;
+	skb_shinfo(child)->frag_list = skb_get(nested);
+	child->len += nested->len;
+	child->data_len += nested->len;
+	child->next = NULL;
+	held = skb_get(child);
+	skb_shinfo(skb)->frag_list = child;
+	skb->len += child->len;
+	skb->data_len += child->len;
+	child = NULL;		/* Parent owns one reference; held owns another. */
+	copy = skb_copy(skb, GFP_KERNEL);
+	CHECK(copy != NULL);
+	CHECK(copy->len == 12 && copy->data_len == 0 &&
+	    skb_shinfo(copy)->frag_list == NULL);
+	CHECK(memcmp(copy->data, "headchildend", 12) == 0 && frees == 0);
+	CHECK(refcount_read(&held->refcnt) == 2);
+	CHECK(skb_cow_data(skb, 24, &trailer) == 1);
+	CHECK(trailer == skb && skb_tailroom(skb) >= 24);
+	CHECK(skb->len == 12 && skb->data_len == 0 &&
+	    skb_shinfo(skb)->frag_list == NULL);
+	CHECK(memcmp(skb->data, "headchildend", 12) == 0);
+	CHECK(refcount_read(&held->refcnt) == 1 && frees == 0);
+	skb->data[4] = 'C';
+	CHECK(held->len == 8 && held->data_len == 3 &&
+	    memcmp(held->data, "child", 5) == 0);
+	CHECK(memcmp(nested->data, "end", 3) == 0);
+	CHECK(memcmp(copy->data, "headchildend", 12) == 0);
+	memcpy(pskb_put(skb, trailer, 1), "!", 1);
+	CHECK(skb->len == 13 && skb->data_len == 0 &&
+	    memcmp(skb->data, "headChildend!", 13) == 0);
+	kfree_skb(skb);
+	skb = NULL;
+	kfree_skb(held);
+	held = NULL;
+	CHECK(frees == 1);
+	CHECK(refcount_read(&nested->refcnt) == 1);
+	kfree_skb(nested);
+	nested = NULL;
+	CHECK(frees == 2);
+
+	/* Exercise final parent release independently of flattening. */
+	skb = alloc_skb(16, GFP_KERNEL);
+	CHECK(skb != NULL);
+	child = alloc_skb(16, GFP_KERNEL);
+	CHECK(child != NULL);
+	child->m = &frees;
+	child->m_free_func = skb_test_free;
+	skb_put_data(child, "held", 4);
+	child->next = NULL;
+	held = skb_get(child);
+	skb_shinfo(skb)->frag_list = child;
+	skb->len = skb->data_len = child->len;
+	child = NULL;
+	kfree_skb(skb);
+	skb = NULL;
+	CHECK(refcount_read(&held->refcnt) == 1 && frees == 2);
+	CHECK(memcmp(held->data, "held", 4) == 0);
+	kfree_skb(held);
+	held = NULL;
+	CHECK(frees == 3);
+	error = 0;
+out:
+	kfree_skb(copy);
+	kfree_skb(skb);
+	kfree_skb(child);
+	if (held != NULL) {
+		/* Also reclaim a parent reference leaked by a failed regression. */
+		if (refcount_read(&held->refcnt) == 2)
+			kfree_skb(held);
+		kfree_skb(held);
+	}
+	if (nested != NULL) {
+		if (refcount_read(&nested->refcnt) == 2)
+			kfree_skb(nested);
+		kfree_skb(nested);
+	}
+	return (error);
+}
+
+static int
+skb_pskb_put_test(void)
+{
+	struct sk_buff *skb, *child, *copy;
+	uint8_t *tail;
+	int error;
+
+	error = EINVAL;
+	skb = child = copy = NULL;
+	skb = alloc_skb(32, GFP_KERNEL);
+	CHECK(skb != NULL);
+	child = alloc_skb(32, GFP_KERNEL);
+	CHECK(child != NULL);
+	skb_put_data(skb, "he", 2);
+	tail = skb->tail;
+	CHECK(pskb_put(skb, skb, 0) == tail);
+	memcpy(pskb_put(skb, skb, 2), "ad", 2);
+	CHECK(skb->len == 4 && skb->data_len == 0);
+	skb_put_data(child, "ab", 2);
+	child->next = NULL;
+	skb_shinfo(skb)->frag_list = child;
+	skb->len += child->len;
+	skb->data_len += child->len;
+	tail = child->tail;
+	CHECK(pskb_put(skb, child, 0) == tail);
+	CHECK(skb->len == 6 && skb->data_len == 2 && child->len == 2);
+	CHECK(pskb_put(skb, child, 3) == tail);
+	memcpy(tail, "cde", 3);
+	CHECK(child->len == 5 && child->data_len == 0);
+	CHECK(skb->len == 9 && skb->data_len == 5);
+	copy = skb_copy(skb, GFP_KERNEL);
+	CHECK(copy != NULL);
+	CHECK(copy->len == 9 && copy->data_len == 0 &&
+	    memcmp(copy->data, "headabcde", 9) == 0);
+	error = 0;
+out:
+	/* Keep child locally owned in this accounting-only test. */
+	if (skb != NULL)
+		skb_shinfo(skb)->frag_list = NULL;
+	kfree_skb(copy);
+	kfree_skb(child);
+	kfree_skb(skb);
+	return (error);
+}
+
+static int
+queue_test_modevent(module_t mod, int type, void *arg)
+{
+	int error;
+
+	switch (type) {
+	case MOD_LOAD:
+		error = queue_test();
+		if (error == 0)
+			error = list_test();
+		if (error == 0)
+			error = guard_test();
+		if (error == 0)
+			error = tasklet_test();
+		if (error == 0)
+			error = ie_test();
+		if (error == 0)
+			error = skb_linear_test();
+		if (error == 0)
+			error = skb_page_test();
+		if (error == 0)
+			error = skb_frag_list_test();
+		if (error == 0)
+			error = skb_pskb_put_test();
+		if (error == 0)
+			error = lkpi_rhashtable_test();
+		if (error == 0)
+			printf("lkpi_wlan_test: queue, RCU, list, guard, tasklet, IE, skb and rhashtable tests passed\n");
+		return (error);
+	case MOD_UNLOAD:
+		return (0);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+
+static moduledata_t queue_test_mod = {
+	"lkpi_wlan_test",
+	queue_test_modevent,
+	NULL
+};
+
+DECLARE_MODULE(lkpi_wlan_test, queue_test_mod, SI_SUB_DRIVERS, SI_ORDER_ANY);
+MODULE_VERSION(lkpi_wlan_test, 1);
+MODULE_DEPEND(lkpi_wlan_test, linuxkpi_wlan, 1, 1, 1);
diff --git a/sys/tests/linuxkpi_wlan/dp_cc_test.c b/sys/tests/linuxkpi_wlan/dp_cc_test.c
new file mode 100644
index 00000000000..2fdc590c7c3
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/dp_cc_test.c
@@ -0,0 +1,96 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/* Standalone, host-only cookie-layout tests; no device access.
+ * From the source root: cc -std=c99 -Wall -Wextra -Werror -pedantic
+ * -o dp_cc_test sys/tests/linuxkpi_wlan/dp_cc_test.c && ./dp_cc_test
+ */
+#include <assert.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+
+typedef uint32_t u32;
+typedef uint64_t u64;
+#include "../../contrib/dev/athk/ath12k/dp_cc.h"
+
+static void test_layout(void)
+{
+	struct ath12k_dp_cc_layout layout = { 0 };
+	struct ath12k_dp_cc_layout previous;
+
+	/* Production normal-memory profile: four TX pools, then RX pages. */
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 32768, 4, 0,
+				       0x100000, 4096) == 0);
+	assert(layout.tx_pages == 256 && layout.rx_pages == 24);
+	assert(layout.num_spt_pages == 280 && layout.rx_ppt_base == 0);
+	assert(layout.ppt_entries == 280);
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 32768, 4, 0,
+				       0x113000, 0x5000) == 0);
+
+	/* Partner RX cookies use a remote PPT offset, not extra local SPTs. */
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 32768, 4, 2,
+				       0x100000, 1312) == 0);
+	assert(layout.num_spt_pages == 280 && layout.rx_ppt_base == 48);
+	assert(layout.ppt_entries == 328);
+	previous = layout;
+
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 32768, 4, 2,
+				       0x100000, 1311) == -ERANGE);
+	assert(layout.ppt_entries == previous.ppt_entries &&
+	       layout.rx_ppt_base == previous.rx_ppt_base);
+	assert(ath12k_dp_cc_layout_init(&layout, 12289, 32768, 4, 0,
+				       0x100000, 4096) == -EINVAL);
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 32769, 4, 0,
+				       0x100000, 4096) == -EINVAL);
+	assert(ath12k_dp_cc_layout_init(&layout, 0, 32768, 4, 0,
+				       0x100000, 4096) == -EINVAL);
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 0, 4, 0,
+				       0x100000, 4096) == -EINVAL);
+	assert(ath12k_dp_cc_layout_init(&layout, 12288, 32768, 0, 0,
+				       0x100000, 4096) == -EINVAL);
+	assert(ath12k_dp_cc_layout_init(NULL, 12288, 32768, 4, 0,
+				       0x100000, 4096) == -EINVAL);
+
+	/* An overflowing or overfull layout must not be silently clamped. */
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1023, 0,
+				       0x100000, 4096) == 0);
+	assert(layout.num_spt_pages == 1024 && layout.ppt_entries == 1024);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1024, 0,
+				       0x100000, 8192) == -E2BIG);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, UINT32_MAX,
+				       0x100000, UINT64_MAX) == -E2BIG);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 0xfffffe00,
+				       UINT32_MAX, 0, 0x100000,
+				       UINT64_MAX) == -E2BIG);
+}
+
+static void test_cmem_and_dma_addresses(void)
+{
+	struct ath12k_dp_cc_layout layout;
+
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, 0,
+				       0, 4096) == -ERANGE);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, 0,
+				       0x100000, 0) == -ERANGE);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, 0,
+				       0x100002, 4096) == -ERANGE);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, 0,
+				       0x100000000ULL, 4096) == -ERANGE);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, 0,
+				       0xfffffff8, 8) == 0);
+	assert(ath12k_dp_cc_layout_init(&layout, 512, 512, 1, 0,
+				       0xfffffffc, 8) == -ERANGE);
+
+	assert(ath12k_dp_cc_spt_addr_valid(0x12345000));
+	assert(!ath12k_dp_cc_spt_addr_valid(0x12345001));
+	assert(ath12k_dp_cc_spt_addr_valid(0xffffffff000ULL));
+	assert(!ath12k_dp_cc_spt_addr_valid(0x100000000000ULL));
+	assert(!ath12k_dp_cc_spt_addr_valid(UINT64_MAX));
+}
+
+int main(void)
+{
+	test_layout();
+	test_cmem_and_dma_addresses();
+	puts("DP cookie layout/CMEM/address tests passed (no DMA publication)");
+	return 0;
+}
diff --git a/sys/tests/linuxkpi_wlan/dp_native_test.c b/sys/tests/linuxkpi_wlan/dp_native_test.c
new file mode 100644
index 00000000000..171872e3622
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/dp_native_test.c
@@ -0,0 +1,124 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#include <sys/param.h>
+#include <sys/bus.h>
+#include <sys/systm.h>
+
+#include "../../contrib/dev/athk/ath12k/core.h"
+#include "../../contrib/dev/athk/ath12k/dp.h"
+
+int ath12k_dp_native_lifecycle_test(struct device *dev);
+
+struct dp_reset_model {
+	int error;
+	int calls;
+	unsigned long marker;
+};
+
+static int dp_model_quiesce(struct ath12k_base *ab)
+{
+	struct dp_reset_model *model = (void *)ab->drv_priv;
+
+	model->calls++;
+	return model->error;
+}
+
+static int dp_model_irq_ready(struct ath12k_base *ab __unused)
+{
+	return 0;
+}
+
+#define REQUIRE(test) do {						\
+	if (!(test)) {							\
+		printf("ath12k_dp_native: line %d: %s failed\n",		\
+		       __LINE__, #test);					\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+/* A valid diagnostic device is supplied only for logging. No bus attachment,
+ * DMA mapping/publication, MMIO, real reset, or interrupt request occurs.
+ */
+int ath12k_dp_native_lifecycle_test(struct device *dev)
+{
+	static const struct ath12k_hw_params hw = { .max_tx_ring = 0 };
+	struct ath12k_base *ab;
+	struct ath12k_dp *dp;
+	struct dp_reset_model *model;
+	struct ath12k_spt_info *marker;
+	int error = 0;
+
+	if (!dev)
+		return EINVAL;
+	ab = kzalloc(sizeof(*ab) + sizeof(*model), GFP_KERNEL);
+	dp = kzalloc(sizeof(*dp), GFP_KERNEL);
+	if (!ab || !dp) {
+		kfree(ab);
+		kfree(dp);
+		return ENOMEM;
+	}
+	ab->dev = dev;
+	ab->hw_params = &hw;
+	ab->dp = dp;
+	dp->ab = ab;
+	model = (void *)ab->drv_priv;
+	marker = (void *)&model->marker;
+
+	REQUIRE(ath12k_dp_native_bind(dp, NULL, dp_model_irq_ready) == -EINVAL);
+	REQUIRE(ath12k_dp_native_bind(dp, dp_model_quiesce,
+				     dp_model_irq_ready) == 0);
+	REQUIRE(ath12k_dp_dma_quiesce(ab) == 0 && model->calls == 0);
+	dp->cc_prepared = true;
+	REQUIRE(ath12k_dp_init_prerequisites(ab) == -EAGAIN);
+	dp->native_setup = true;
+	REQUIRE(ath12k_dp_tx_pause(ab) == 0 && dp->native_tx_paused);
+	REQUIRE(ath12k_dp_tx_pause(ab) == -EBUSY);
+	ath12k_dp_tx_resume(ab);
+	REQUIRE(!dp->native_tx_paused);
+	atomic_set(&dp->native_tx_users, 1);
+	REQUIRE(ath12k_dp_tx_pause(ab) == -EBUSY);
+	REQUIRE(!dp->native_tx_paused && !dp->native_quarantined);
+	atomic_set(&dp->native_tx_users, 0);
+	wake_up(&dp->native_tx_wait);
+	dp->native_stopping = true;
+	REQUIRE(ath12k_dp_tx_pause(ab) == -EBUSY);
+	ath12k_dp_tx_resume(ab);
+	REQUIRE(dp->native_stopping);
+	dp->native_stopping = false;
+
+	/* An invalid sentinel catches any teardown that crosses the guard. */
+	dp->spt_info = marker;
+	dp->num_spt_pages = 1;
+	dp->cc_published = true;
+	dp->native_resources = true;
+	dp->native_published = true;
+	dp->native_setup = true;
+	atomic_set(&dp->native_tx_users, 1);
+	REQUIRE(ath12k_dp_dma_quiesce(ab) == -EBUSY);
+	REQUIRE(model->calls == 0 && ath12k_dp_dma_owned(ab));
+	REQUIRE(dp->spt_info == marker && dp->native_quarantined);
+	atomic_set(&dp->native_tx_users, 0);
+	wake_up(&dp->native_tx_wait);
+	model->error = -EIO;
+	ath12k_dp_cmn_device_deinit(dp);
+	REQUIRE(model->calls == 1 && ath12k_dp_dma_owned(ab));
+	REQUIRE(dp->native_stopping && dp->native_quarantined);
+	REQUIRE(dp->spt_info == marker && dp->num_spt_pages == 1);
+	REQUIRE(ath12k_dp_cc_unprepare(dp) == -EBUSY);
+	REQUIRE(ath12k_dp_native_bind(dp, dp_model_quiesce,
+				     dp_model_irq_ready) == -EBUSY);
+
+	/* Proof clears publication, but does not itself release any DP buffer. */
+	model->error = 0;
+	REQUIRE(ath12k_dp_dma_quiesce(ab) == 0 && model->calls == 2);
+	REQUIRE(!ath12k_dp_dma_owned(ab) && dp->native_reset);
+	REQUIRE(!dp->native_setup && !dp->native_quarantined);
+	REQUIRE(dp->spt_info == marker && dp->num_spt_pages == 1);
+	REQUIRE(ath12k_dp_init_prerequisites(ab) == -EAGAIN);
+
+out:
+	/* Only model allocations exist; never call a real DMA destructor. */
+	kfree(dp);
+	kfree(ab);
+	return error;
+}
diff --git a/sys/tests/linuxkpi_wlan/mhi_boot.c b/sys/tests/linuxkpi_wlan/mhi_boot.c
new file mode 100644
index 00000000000..a1b777771d4
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_boot.c
@@ -0,0 +1,1329 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <sys/param.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/firmware.h>
+#include <sys/interrupt.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/module.h>
+#include <sys/rman.h>
+#include <sys/sx.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+#include <sys/time.h>
+#include <machine/atomic.h>
+
+#include <dev/pci/pcireg.h>
+#include <dev/pci/pcivar.h>
+#include <linux/device.h>
+#include <linux/mhi.h>
+
+#include "linux_mhi.h"
+#include "htc.h"
+#include "mhi_ce.h"
+#include "mhi_qmi.h"
+#include "mhi_wmi.h"
+#include "wifi7/mhi.h"
+
+struct mhi_boot_irq {
+	struct mhi_boot_softc *sc;
+	struct resource *resource;
+	void *irq_cookie;
+	u_int interrupts;
+	bool events;
+};
+
+struct mhi_boot_softc {
+	device_t dev;
+	struct resource *mem;
+	struct mhi_boot_irq irqs[3];
+	struct device ldev;
+	struct mhi_controller *ctrl;
+	struct lkpi_mhi_boot boot;
+	struct mhi_lab_qmi qmi;
+	struct lkpi_mhi_dma firmware_memory[MHI_LAB_MEM_MAX];
+	struct lkpi_mhi_dma m3;
+	struct mhi_lab_ce ce;
+	struct mhi_lab_htc htc;
+	struct mhi_lab_wmi wmi;
+	uint8_t qmi_packet[MHI_LAB_QMI_PACKET_MAX];
+	struct sx lock;
+	struct sysctl_ctx_list sysctls;
+	uint16_t command;
+	bool needs_reset, intx_disabled, msi;
+};
+
+static int
+mhi_boot_intr(void *arg)
+{
+	struct mhi_boot_irq *irq = arg;
+
+	atomic_add_int(&irq->interrupts, 1);
+	return (irq->events ? FILTER_SCHEDULE_THREAD : FILTER_HANDLED);
+}
+
+static void
+mhi_boot_events(void *arg)
+{
+	struct mhi_boot_irq *irq = arg;
+
+	(void)linuxkpi_mhi_process_events(irq->sc->ctrl);
+}
+
+static int
+mhi_boot_irq_setup(struct mhi_boot_softc *sc)
+{
+	struct mhi_boot_irq *irq;
+	int count = 4, rid, error;
+	unsigned int i;
+
+	error = pci_alloc_msi(sc->dev, &count);
+	if (error != 0)
+		return (error);
+	sc->msi = true;
+	if (count < nitems(sc->irqs))
+		return (ENXIO);
+	for (i = 0; i < nitems(sc->irqs); i++) {
+		irq = &sc->irqs[i];
+		irq->sc = sc;
+		irq->events = i != 0;
+		atomic_store_rel_int(&irq->interrupts, 0);
+		rid = i + 1;
+		irq->resource = bus_alloc_resource_any(sc->dev, SYS_RES_IRQ,
+		    &rid, RF_ACTIVE);
+		if (irq->resource == NULL)
+			return (ENXIO);
+		error = bus_setup_intr(sc->dev, irq->resource,
+		    INTR_TYPE_NET | INTR_MPSAFE, mhi_boot_intr, mhi_boot_events, irq,
+		    &irq->irq_cookie);
+		if (error != 0) {
+			irq->irq_cookie = NULL;
+			return (error);
+		}
+	}
+	sc->ctrl->nr_irqs = nitems(sc->irqs);
+	return (0);
+}
+
+static int
+mhi_boot_read(struct mhi_controller *ctrl, void *address, uint32_t *value)
+{
+	struct mhi_boot_softc *sc = device_get_softc(ctrl->cntrl_dev->bsddev);
+
+	*value = bus_read_4(sc->mem, (uintptr_t)address - (uintptr_t)ctrl->regs);
+	return (*value == UINT32_MAX ? -EIO : 0);
+}
+
+static void
+mhi_boot_write(struct mhi_controller *ctrl, void *address, uint32_t value)
+{
+	struct mhi_boot_softc *sc = device_get_softc(ctrl->cntrl_dev->bsddev);
+
+	bus_write_4(sc->mem, (uintptr_t)address - (uintptr_t)ctrl->regs, value);
+	(void)bus_read_4(sc->mem, LKPI_MHI_STATUS);
+}
+
+static int
+mhi_boot_wait(struct mhi_boot_softc *sc, uint32_t offset, uint32_t mask,
+    uint32_t expected)
+{
+	sbintime_t deadline = sbinuptime() + 2 * SBT_1S;
+	uint32_t value;
+
+	do {
+		value = bus_read_4(sc->mem, offset);
+		if (value == UINT32_MAX)
+			return (EIO);
+		if ((value & mask) == expected)
+			return (0);
+		pause_sbt("mhireset", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	device_printf(sc->dev, "reset timeout: register %#x=%#x\n",
+	    offset, value);
+	return (ETIMEDOUT);
+}
+
+static int
+mhi_boot_window(struct mhi_boot_softc *sc, uint32_t address, uint32_t *value,
+    bool write)
+{
+	uint32_t saved, window, offset;
+	int error = 0;
+
+	saved = bus_read_4(sc->mem, 0x310c);
+	if (saved == UINT32_MAX)
+		return (EIO);
+	window = (saved & ~0x3fU) | 0x40000000 | ((address >> 19) & 0x3f);
+	bus_write_4(sc->mem, 0x310c, window);
+	if (bus_read_4(sc->mem, 0x310c) != window) {
+		error = EIO;
+		goto out;
+	}
+	offset = 0x80000 + (address & 0x7ffff);
+	if (write) {
+		bus_write_4(sc->mem, offset, *value);
+		(void)bus_read_4(sc->mem, 0x310c);
+	} else {
+		*value = bus_read_4(sc->mem, offset);
+		if (*value == UINT32_MAX)
+			error = EIO;
+	}
+out:
+	bus_write_4(sc->mem, 0x310c, saved);
+	if (bus_read_4(sc->mem, 0x310c) != saved)
+		error = EIO;
+	if (error != 0)
+		device_printf(sc->dev, "window access/restoration failed at %#x\n",
+		    address);
+	return (error);
+}
+
+static int
+mhi_boot_ce_register(void *arg, uint32_t address, uint32_t *value, bool write)
+{
+	return (mhi_boot_window(arg, address, value, write));
+}
+
+static int
+mhi_boot_ce_prepare(struct mhi_boot_softc *sc)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	int error;
+
+	error = mhi_lab_ce_alloc(sc->ctrl, &sc->ce);
+	if (error != 0)
+		return (error);
+	mtx_lock(&context->lock);
+	sc->qmi.shadow_count = nitems(sc->ce.shadow);
+	memcpy(sc->qmi.shadow, sc->ce.shadow, sizeof(sc->ce.shadow));
+	mtx_unlock(&context->lock);
+	device_printf(sc->dev, "CE host DMA allocated: %zu rings and coherent pointer memory\n",
+	    nitems(sc->ce.ring));
+	return (0);
+}
+
+static int
+mhi_boot_wmi_services(struct mhi_boot_softc *sc)
+{
+	uint8_t packet[20];
+	sbintime_t deadline;
+	unsigned int processed;
+	int error, tx_error;
+
+	sc->htc.receive = mhi_lab_wmi_receive;
+	sc->htc.receive_arg = &sc->wmi;
+	error = mhi_lab_htc_setup(&sc->htc, packet);
+	if (error == 0)
+		error = mhi_lab_ce_send(&sc->ce, mhi_boot_ce_register, sc,
+		    0, 0, packet, sizeof(packet));
+	if (error != 0)
+		return (error);
+	deadline = sbinuptime() + 5 * SBT_1S;
+	do {
+		tx_error = mhi_lab_ce_tx_poll(&sc->ce, 0);
+		if (tx_error != 0 && tx_error != EAGAIN)
+			return (tx_error);
+		error = mhi_lab_ce_poll(&sc->ce, mhi_boot_ce_register, sc,
+		    mhi_lab_htc_receive, &sc->htc, 16, &processed);
+		if (error != 0 && error != EAGAIN)
+			return (error);
+		if (mhi_lab_wmi_ready(&sc->wmi) && tx_error == 0)
+			break;
+		pause_sbt("wmisvc", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	if (!mhi_lab_wmi_ready(&sc->wmi) || tx_error != 0) {
+		device_printf(sc->dev,
+		    "WMI service-ready timed out: base=%u available=%u ext=%u ext2=%u last=%#x TX=%d\n",
+		    sc->wmi.base, sc->wmi.available, sc->wmi.extended,
+		    sc->wmi.extended2, sc->wmi.last_event, tx_error);
+		return (ETIMEDOUT);
+	}
+	device_printf(sc->dev,
+	    "actual WMI service-ready confirmed: events=%u firmware=%#x RF_chains=%u memory_requests=%u scan_channels=%u; WMI INIT/vdev/scan not requested\n",
+	    sc->wmi.events, sc->wmi.firmware, sc->wmi.rf_chains,
+	    sc->wmi.memory_requests, sc->wmi.scan_channels);
+	device_printf(sc->dev,
+	    "WMI hardware capabilities decoded: modes=%u MAC/PHY=%u regulatory_PHY=%u complete=%u; not regulatory permission\n",
+	    sc->wmi.mode_count, sc->wmi.mac_phy_count, sc->wmi.reg_count,
+	    sc->wmi.semantic_caps);
+	return (0);
+}
+
+static int
+mhi_boot_htc_services(struct mhi_boot_softc *sc)
+{
+	static const uint16_t services[] = {
+		ATH12K_HTC_SVC_ID_HTT_DATA_MSG, ATH12K_HTC_SVC_ID_WMI_CONTROL
+	};
+	uint8_t packet[16];
+	sbintime_t deadline;
+	unsigned int i, processed;
+	int error, tx_error;
+
+	for (i = 0; i < nitems(services); i++) {
+		error = mhi_lab_htc_connect(&sc->htc, services[i], packet);
+		if (error == 0)
+			error = mhi_lab_ce_send(&sc->ce, mhi_boot_ce_register, sc,
+			    0, 0, packet, sizeof(packet));
+		if (error != 0)
+			return (error);
+		deadline = sbinuptime() + 5 * SBT_1S;
+		do {
+			tx_error = mhi_lab_ce_tx_poll(&sc->ce, 0);
+			if (tx_error != 0 && tx_error != EAGAIN)
+				return (tx_error);
+			error = mhi_lab_ce_poll(&sc->ce, mhi_boot_ce_register, sc,
+			    mhi_lab_htc_receive, &sc->htc, 16, &processed);
+			if (error != 0 && error != EAGAIN)
+				return (error);
+			if (sc->htc.pending_service == 0 && tx_error == 0)
+				break;
+			pause_sbt("htcsvc", SBT_1MS, 0, C_HARDCLOCK);
+		} while (sbinuptime() < deadline);
+		if (sc->htc.pending_service != 0 || tx_error != 0) {
+			device_printf(sc->dev, "HTC service %#x timed out (pending=%#x TX=%d)\n",
+			    services[i], sc->htc.pending_service, tx_error);
+			return (ETIMEDOUT);
+		}
+		device_printf(sc->dev,
+		    "actual HTC service connected: service=%#x endpoint=%u max_message=%u TX_completed=%u\n",
+		    sc->htc.service[i].id, sc->htc.service[i].endpoint,
+		    sc->htc.service[i].max_message, sc->ce.tx[0].packets);
+	}
+	return (0);
+}
+
+static int
+mhi_boot_ce_receive(struct mhi_boot_softc *sc, bool startup)
+{
+	sbintime_t deadline;
+	unsigned int processed, deferred = 0;
+	int error;
+
+	error = mhi_lab_ce_rx_post(&sc->ce, mhi_boot_ce_register, sc);
+	if (error != 0)
+		return (error);
+	deadline = sbinuptime() + (startup ? 5 * SBT_1S : 250 * SBT_1MS);
+	do {
+		error = mhi_lab_ce_poll(&sc->ce, mhi_boot_ce_register, sc,
+		    mhi_lab_htc_receive, &sc->htc, 16, &processed);
+		if (error == EAGAIN)
+			deferred++;
+		else if (error != 0)
+			return (error);
+		if (sc->htc.ready)
+			break;
+		pause_sbt("cerx", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	device_printf(sc->dev,
+	    "CE RX posting/polling confirmed: buffers=%u/%u packets=%u deferred=%u; direct doorbells; WLAN mode/start=%u\n",
+	    sc->ce.rx[0].count, sc->ce.rx[1].count, sc->ce.packets, deferred,
+	    startup);
+	if (sc->htc.ready)
+		device_printf(sc->dev,
+		    "actual HTC READY received: credits=%u credit_size=%u endpoints=%u\n",
+		    sc->htc.credits, sc->htc.credit_size, sc->htc.endpoints);
+	else {
+		device_printf(sc->dev,
+		    "HTC READY not observed; WLAN mode/start=%u\n", startup);
+		if (startup)
+			return (ETIMEDOUT);
+	}
+	return (0);
+}
+
+static int
+mhi_boot_prepare_reset(struct mhi_boot_softc *sc)
+{
+	uint32_t value;
+	unsigned int attempt;
+	int error;
+
+	/* The same WCN7850 preparation already verified by reset-pci.c. */
+	bus_write_4(sc->mem, 0x3004, 1);
+	(void)bus_read_4(sc->mem, LKPI_MHI_STATUS);
+	pause_sbt("mhiwake", 105 * SBT_1MS, 0, C_HARDCLOCK);
+	for (attempt = 0; attempt < 5; attempt++) {
+		error = mhi_boot_window(sc, 0x1e081b0, &value, false);
+		if (error != 0)
+			return (error);
+		if (value == 0x111)
+			break;
+		value = 0x111;
+		error = mhi_boot_window(sc, 0x1e081b0, &value, true);
+		if (error != 0)
+			return (error);
+		pause_sbt("mhiltssm", 5 * SBT_1MS, 0, C_HARDCLOCK);
+	}
+	error = mhi_boot_window(sc, 0x1e081b0, &value, false);
+	if (error != 0)
+		return (error);
+	if (value != 0x111)
+		return (ETIMEDOUT);
+	error = mhi_boot_window(sc, 0x1e40304, &value, false);
+	if (error != 0)
+		return (error);
+	value |= 0x10;
+	error = mhi_boot_window(sc, 0x1e40304, &value, true);
+	if (error != 0)
+		return (error);
+	pause_sbt("mhihot", 5 * SBT_1MS, 0, C_HARDCLOCK);
+	value = UINT32_MAX;
+	error = mhi_boot_window(sc, 0x1e08228, &value, true);
+	if (error != 0)
+		return (error);
+	error = mhi_boot_window(sc, 0x1f8031c, &value, false);
+	if (error != 0)
+		return (error);
+	value &= ~4U;
+	error = mhi_boot_window(sc, 0x1f8031c, &value, true);
+	if (error != 0)
+		return (error);
+	bus_write_4(sc->mem, 0x360, 0);
+	bus_write_4(sc->mem, 0x368, 0);
+	bus_write_4(sc->mem, 0x394, 0);
+	bus_write_4(sc->mem, 0x39c, 0);
+	(void)bus_read_4(sc->mem, LKPI_MHI_STATUS);
+	pause_sbt("mhidebug", 10 * SBT_1MS, 0, C_HARDCLOCK);
+	value = 0;
+	error = mhi_boot_window(sc, 0x1f80504, &value, true);
+	if (error != 0)
+		return (error);
+	pause_sbt("mhidebug", 10 * SBT_1MS, 0, C_HARDCLOCK);
+	error = mhi_boot_window(sc, 0x1f80504, &value, false);
+	if (error != 0)
+		return (error);
+	device_printf(sc->dev, "warm-start entry after clear request: %#x\n",
+	    value);
+	/* Reset-cause is read-to-clear, as in the reference reset sequence. */
+	return (mhi_boot_window(sc, 0x1f8060c, &value, false));
+}
+
+static int
+mhi_boot_reset(struct mhi_boot_softc *sc)
+{
+	uint32_t reset, status, bhi;
+	int error;
+
+	if (!sc->needs_reset)
+		return (0);
+	error = -linuxkpi_mhi_shutdown(sc->ctrl);
+	if (error != 0)
+		device_printf(sc->dev,
+		    "graceful MHI shutdown failed: %d; attempting SoC reset\n",
+		    error);
+	else
+		device_printf(sc->dev,
+		    "MHI shutdown completed: commands=%u state=%u; DMA retained until reset\n",
+		    sc->ctrl->lkpi_context->command_events,
+		    (bus_read_4(sc->mem, LKPI_MHI_STATUS) >> 8) & 0xff);
+	/* Stop event-doorbell writes, but retain device ownership until PBL. */
+	mtx_lock(&sc->ctrl->lkpi_context->lock);
+	sc->ctrl->lkpi_context->quiescing = true;
+	mtx_unlock(&sc->ctrl->lkpi_context->lock);
+	error = mhi_boot_prepare_reset(sc);
+	if (error != 0)
+		return (error);
+	reset = bus_read_4(sc->mem, 0x3008);
+	if (reset == UINT32_MAX || (reset & 1) != 0)
+		return (EIO);
+	bus_write_4(sc->mem, 0x3008, reset | 1);
+	(void)bus_read_4(sc->mem, LKPI_MHI_STATUS);
+	pause_sbt("mhisoc", 10 * SBT_1MS, 0, C_HARDCLOCK);
+	bus_write_4(sc->mem, 0x3008, reset);
+	if (bus_read_4(sc->mem, 0x3008) != reset)
+		return (EIO);
+	pause_sbt("mhisoc", 10 * SBT_1MS, 0, C_HARDCLOCK);
+	status = bus_read_4(sc->mem, LKPI_MHI_STATUS);
+	if (status == UINT32_MAX)
+		return (EIO);
+	if ((status & 4) != 0) {
+		bus_write_4(sc->mem, LKPI_MHI_CTRL, 2);
+		(void)bus_read_4(sc->mem, LKPI_MHI_CTRL);
+	}
+	error = mhi_boot_wait(sc, LKPI_MHI_CTRL, 2, 0);
+	if (error != 0)
+		return (error);
+	error = mhi_boot_wait(sc, LKPI_MHI_STATUS, 4, 0);
+	if (error != 0)
+		return (error);
+	bhi = bus_read_4(sc->mem, LKPI_MHI_BHI_OFFSET);
+	if (bhi < 0x4c || (bhi & 3) != 0 || bhi > 0xfe0 - 0x40)
+		return (EIO);
+	error = mhi_boot_wait(sc, bhi + LKPI_MHI_BHI_EXECENV,
+	    UINT32_MAX, 0);
+	if (error != 0)
+		return (error);
+	sc->boot.pending = false;
+	if (sc->ctrl->lkpi_context != NULL) {
+		mtx_lock(&sc->ctrl->lkpi_context->lock);
+		sc->ctrl->lkpi_context->published = false;
+		mtx_unlock(&sc->ctrl->lkpi_context->lock);
+	}
+	sc->needs_reset = false;
+	device_printf(sc->dev, "SoC reset confirmed PBL; boot DMA is quiescent\n");
+	return (0);
+}
+
+static int
+mhi_boot_cleanup(struct mhi_boot_softc *sc)
+{
+	struct mhi_boot_irq *irq;
+	unsigned int i;
+	int error;
+
+	error = mhi_boot_reset(sc);
+	if (error != 0)
+		return (error);
+	error = mhi_lab_ce_reset_check(sc->ctrl, &sc->ce,
+	    mhi_boot_ce_register, sc);
+	if (error != 0) {
+		sc->needs_reset = true;
+		mtx_lock(&sc->ctrl->lkpi_context->lock);
+		sc->ctrl->lkpi_context->published = true;
+		mtx_unlock(&sc->ctrl->lkpi_context->lock);
+		return (error);
+	}
+	error = -linuxkpi_mhi_boot_free(&sc->boot);
+	if (error != 0)
+		return (error);
+	for (i = 0; i < nitems(sc->firmware_memory); i++) {
+		if (sc->firmware_memory[i].tag == NULL)
+			continue;
+		error = -linuxkpi_mhi_free_memory(sc->ctrl,
+		    &sc->firmware_memory[i]);
+		if (error != 0)
+			return (error);
+	}
+	if (sc->m3.tag != NULL) {
+		error = -linuxkpi_mhi_free_memory(sc->ctrl, &sc->m3);
+		if (error != 0)
+			return (error);
+	}
+	error = mhi_lab_ce_free(sc->ctrl, &sc->ce);
+	if (error != 0)
+		return (error);
+	for (i = nitems(sc->irqs); i > 0; i--) {
+		irq = &sc->irqs[i - 1];
+		if (irq->irq_cookie != NULL) {
+			error = bus_teardown_intr(sc->dev, irq->resource,
+			    irq->irq_cookie);
+			if (error != 0)
+				return (error);
+			irq->irq_cookie = NULL;
+		}
+		if (irq->resource != NULL) {
+			error = bus_release_resource(sc->dev, SYS_RES_IRQ, i,
+			    irq->resource);
+			if (error != 0)
+				return (error);
+			irq->resource = NULL;
+		}
+	}
+	if (sc->msi) {
+		error = pci_release_msi(sc->dev);
+		if (error != 0)
+			return (error);
+		sc->msi = false;
+		sc->ctrl->nr_irqs = 0;
+	}
+	if (sc->intx_disabled) {
+		pci_write_config(sc->dev, PCIR_COMMAND, sc->command, 2);
+		if (pci_read_config(sc->dev, PCIR_COMMAND, 2) != sc->command) {
+			device_printf(sc->dev, "cannot restore original PCI command\n");
+			return (EIO);
+		}
+		sc->intx_disabled = false;
+	}
+	return (0);
+}
+
+static void
+mhi_boot_diagnostic(struct mhi_boot_softc *sc)
+{
+	uint32_t bhi = sc->boot.bhi;
+
+	device_printf(sc->dev,
+	    "BHI diagnostic: CTRL=%#x STATUS=%#x EE=%#x BHI_STATUS=%#x "
+	    "ERROR=%#x DEBUG=%#x/%#x/%#x\n",
+	    bus_read_4(sc->mem, LKPI_MHI_CTRL),
+	    bus_read_4(sc->mem, LKPI_MHI_STATUS),
+	    bus_read_4(sc->mem, bhi + LKPI_MHI_BHI_EXECENV),
+	    bus_read_4(sc->mem, bhi + LKPI_MHI_BHI_STATUS),
+	    bus_read_4(sc->mem, bhi + 0x30),
+	    bus_read_4(sc->mem, bhi + 0x34),
+	    bus_read_4(sc->mem, bhi + 0x38),
+	    bus_read_4(sc->mem, bhi + 0x3c));
+}
+
+static int
+mhi_boot_transport(struct mhi_boot_softc *sc)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	/* A QRTR control HELLO, not a QMI request or a radio operation. */
+	uint32_t hello[13] = {
+		htole32(1), htole32(2), htole32(1), htole32(0xfffffffe),
+		0, htole32(20), htole32(7), htole32(0xfffffffe), htole32(2)
+	};
+	sbintime_t deadline;
+	unsigned int channel, message;
+	uint32_t type, size, header;
+	int error = 0;
+
+	for (channel = 20; channel <= 21; channel++) {
+		error = -linuxkpi_mhi_start_channel(sc->ctrl, channel);
+		if (error != 0)
+			goto fail;
+		deadline = sbinuptime() + 5 * SBT_1S;
+		mtx_lock(&context->lock);
+		while (!context->transfers[channel].started &&
+		    context->event_error == 0) {
+			error = msleep_sbt(context, &context->lock, 0, "mhichan",
+			    deadline, 0, C_ABSOLUTE);
+			if (error != 0)
+				break;
+		}
+		if (context->event_error != 0)
+			error = context->event_error;
+		mtx_unlock(&context->lock);
+		if (error != 0)
+			goto fail;
+	}
+	/* Cross both 64-entry transfer rings within one fixed time budget. */
+	deadline = sbinuptime() + 5 * SBT_1S;
+	for (message = 0; message < 70; message++) {
+		error = -linuxkpi_mhi_submit(sc->ctrl, 20, hello, sizeof(hello));
+		if (error != 0)
+			goto fail;
+		mtx_lock(&context->lock);
+		while ((context->tx_packets <= message ||
+		    context->rx_packets <= message) && context->event_error == 0) {
+			error = msleep_sbt(context, &context->lock, 0, "mhixfer",
+			    deadline, 0, C_ABSOLUTE);
+			if (error != 0)
+				break;
+		}
+		if (context->event_error != 0)
+			error = context->event_error;
+		mtx_unlock(&context->lock);
+		if (error != 0)
+			goto fail;
+	}
+	mtx_lock(&context->lock);
+	if (context->rx_length >= 32 && le32dec(context->rx_sample) == 1) {
+		header = 32;
+		type = le32dec(context->rx_sample + 4);
+		size = le32dec(context->rx_sample + 20);
+	} else if (context->rx_length >= 16 && context->rx_sample[0] == 3 &&
+	    context->rx_sample[3] == 0) {
+		header = 16;
+		type = context->rx_sample[1];
+		size = le32dec(context->rx_sample + 4);
+	} else {
+		error = EPROTO;
+		goto unlock;
+	}
+	if ((type != 2 && type != 4) || size < 4 ||
+	    size > context->rx_length - header ||
+	    le32dec(context->rx_sample + header) != type) {
+		error = EPROTO;
+		goto unlock;
+	}
+	device_printf(sc->dev,
+	    "IPCR transport confirmed: commands=%u TX=%u RX=%u "
+	    "QRTR version=%u type=%u bytes=%u MSI=%u/%u/%u\n",
+	    context->command_events, context->tx_packets, context->rx_packets,
+	    context->rx_sample[0], type, context->rx_length,
+	    atomic_load_acq_int(&sc->irqs[0].interrupts),
+	    atomic_load_acq_int(&sc->irqs[1].interrupts),
+	    atomic_load_acq_int(&sc->irqs[2].interrupts));
+	if (type == 4 && size >= 20)
+		device_printf(sc->dev,
+		    "QRTR service advertisement: service=%#x instance=%#x node=%u port=%u\n",
+		    le32dec(context->rx_sample + header + 4),
+		    le32dec(context->rx_sample + header + 8),
+		    le32dec(context->rx_sample + header + 12),
+		    le32dec(context->rx_sample + header + 16));
+unlock:
+	mtx_unlock(&context->lock);
+fail:
+	if (error != 0) {
+		if (error == EWOULDBLOCK)
+			error = ETIMEDOUT;
+		mtx_lock(&context->lock);
+		device_printf(sc->dev,
+		    "IPCR transport failed: %d (commands=%u TX=%u RX=%u event_error=%d)\n",
+		    error, context->command_events, context->tx_packets,
+		    context->rx_packets, context->event_error);
+		mtx_unlock(&context->lock);
+	}
+	return (error);
+}
+
+static int
+mhi_boot_qmi_wait(struct mhi_boot_softc *sc, const bool *done,
+    unsigned int goal, sbintime_t deadline, unsigned int *resumes)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	struct mhi_lab_qmi *client = &sc->qmi;
+	uint8_t *packet = sc->qmi_packet;
+	int error = 0;
+
+	mtx_lock(&context->lock);
+	goal = MAX(goal, context->tx_packets);
+	while ((!*done || context->tx_packets < goal || client->resume) &&
+	    context->event_error == 0) {
+		if (sbinuptime() >= deadline) {
+			error = ETIMEDOUT;
+			break;
+		}
+		if (client->resume) {
+			error = mhi_lab_qmi_resume(client, packet);
+			if (error != 0)
+				break;
+			goal++;
+			if (resumes != NULL)
+				(*resumes)++;
+			mtx_unlock(&context->lock);
+			error = -linuxkpi_mhi_submit(sc->ctrl, 20, packet, 52);
+			mtx_lock(&context->lock);
+			if (error != 0)
+				break;
+			continue;
+		}
+		error = msleep_sbt(context, &context->lock, 0, "mhiqmi",
+		    deadline, 0, C_ABSOLUTE);
+		if (error != 0)
+			break;
+	}
+	if (context->event_error != 0)
+		error = context->event_error;
+	mtx_unlock(&context->lock);
+	return (error == EWOULDBLOCK ? ETIMEDOUT : error);
+}
+
+static int
+mhi_boot_qmi_exchange(struct mhi_boot_softc *sc, uint16_t message)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	struct mhi_lab_qmi *client = &sc->qmi;
+	size_t length;
+	unsigned int goal, resumes = 0;
+	uint16_t transaction;
+	int error;
+
+	mtx_lock(&context->lock);
+	transaction = client->transaction + 1;
+	if (client->transaction == 0)
+		transaction = arc4random_uniform(UINT16_MAX) + 1;
+	else if (transaction == 0)
+		transaction = 1;
+	error = mhi_lab_qmi_build(client, sc->qmi_packet, sizeof(sc->qmi_packet),
+	    transaction, message, &length);
+	goal = context->tx_packets + 1;
+	mtx_unlock(&context->lock);
+	if (error != 0)
+		goto fail;
+	error = -linuxkpi_mhi_submit(sc->ctrl, 20, sc->qmi_packet, length);
+	if (error != 0)
+		goto fail;
+	error = mhi_boot_qmi_wait(sc, &client->done, goal,
+	    sbinuptime() + 5 * SBT_1S, &resumes);
+	mtx_lock(&context->lock);
+	if (error == 0 && (client->result != 0 || client->error != 0))
+		error = EIO;
+	mtx_unlock(&context->lock);
+	if (error != 0)
+		goto fail;
+	mtx_lock(&context->lock);
+	device_printf(sc->dev,
+	    "QMI reply confirmed: node=%u port=%u transaction=%u "
+	    "message=%#x bytes=%u result=%u error=%u valid=%#x resumes=%u\n",
+	    client->node, client->port, client->transaction,
+	    message,
+	    client->response_length, client->result, client->error,
+	    client->valid, resumes);
+	if (message == 0x57 && (client->valid & 1) != 0)
+		device_printf(sc->dev, "QMI PHY count=%u\n", client->phys);
+	if ((message == 0x57 || message == 0x24) && (client->valid & 2) != 0)
+		device_printf(sc->dev, "QMI board=%#x\n", client->board);
+	if (message == 0x24) {
+		if ((client->valid & 2) == 0)
+			device_printf(sc->dev,
+			    "QMI board ID absent; using Linux/OpenBSD default %#x\n",
+			    client->board);
+		if ((client->valid & 1) != 0)
+			device_printf(sc->dev, "QMI chip=%#x family=%#x\n",
+			    client->chip, client->family);
+		if ((client->valid & 4) != 0)
+			device_printf(sc->dev, "QMI SoC=%#x\n", client->soc);
+		if ((client->valid & 8) != 0)
+			device_printf(sc->dev, "QMI firmware=%#x\n", client->firmware);
+		if (client->dev_mem_valid)
+			for (unsigned int i = 0; i < MHI_LAB_DEV_MEM_MAX; i++)
+				device_printf(sc->dev,
+				    "QMI device memory[%u]: start=%#jx size=%#jx\n",
+				    i, (uintmax_t)client->dev_mem[i].start,
+				    (uintmax_t)client->dev_mem[i].size);
+	}
+	mtx_unlock(&context->lock);
+	return (0);
+fail:
+	if (error == EWOULDBLOCK)
+		error = ETIMEDOUT;
+	mtx_lock(&context->lock);
+	client->pending = false;
+	device_printf(sc->dev,
+	    "QMI exchange %#x failed: %d (done=%u result=%u error=%u event_error=%d)\n",
+	    message, error, client->done, client->result, client->error,
+	    context->event_error);
+	mtx_unlock(&context->lock);
+	return (error);
+}
+
+static int
+mhi_boot_board_download(struct mhi_boot_softc *sc, const uint8_t *data,
+    size_t length, uint8_t type)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	sbintime_t deadline = sbinuptime() + 10 * SBT_1S;
+	size_t offset = 0, chunk;
+	unsigned int segment = 0;
+	int error = 0;
+
+	while (offset < length) {
+		if (sbinuptime() >= deadline) {
+			error = ETIMEDOUT;
+			break;
+		}
+		mtx_lock(&context->lock);
+		sc->qmi.download_data = data + offset;
+		sc->qmi.download_remaining = length - offset;
+		sc->qmi.download_segment = segment;
+		sc->qmi.download_type = type;
+		mtx_unlock(&context->lock);
+		error = mhi_boot_qmi_exchange(sc, 0x25);
+		if (error != 0)
+			break;
+		chunk = MIN(length - offset, MHI_LAB_BDF_CHUNK);
+		offset += chunk;
+		segment++;
+	}
+	mtx_lock(&context->lock);
+	sc->qmi.download_data = NULL;
+	mtx_unlock(&context->lock);
+	if (error != 0)
+		device_printf(sc->dev, "QMI file type=%u download failed: %d at segment=%u\n",
+		    type, error, segment);
+	else
+		device_printf(sc->dev, "QMI file type=%u download confirmed: bytes=%zu segments=%u\n",
+		    type, length, segment);
+	return (error);
+}
+
+static int
+mhi_boot_configure(struct mhi_boot_softc *sc)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	const struct firmware *board_fw, *m3_fw;
+	const uint8_t *board = NULL, *regdb = NULL;
+	size_t board_size, regdb_size;
+	char name[200];
+	int error;
+
+	if ((sc->qmi.valid & 1) == 0) {
+		device_printf(sc->dev, "target chip ID required for exact board selection\n");
+		return (EPROTO);
+	}
+	board_fw = firmware_get("ath12k_lab_board");
+	m3_fw = firmware_get("ath12k_lab_m3");
+	if (board_fw == NULL || m3_fw == NULL) {
+		device_printf(sc->dev, "pinned board-2.bin and m3.bin firmware required\n");
+		error = ENOENT;
+		goto out;
+	}
+	snprintf(name, sizeof(name),
+	    "bus=pci,vendor=%04x,device=%04x,subsystem-vendor=%04x,"
+	    "subsystem-device=%04x,qmi-chip-id=%u,qmi-board-id=%u",
+	    pci_get_vendor(sc->dev), pci_get_device(sc->dev),
+	    pci_get_subvendor(sc->dev), pci_get_subdevice(sc->dev),
+	    sc->qmi.chip, sc->qmi.board);
+	error = mhi_lab_board_find(board_fw->data, board_fw->datasize, 0,
+	    name, &board, &board_size);
+	if (error != 0) {
+		device_printf(sc->dev, "exact board selection failed: %d (%s)\n",
+		    error, name);
+		goto out;
+	}
+	device_printf(sc->dev, "board selected: %s bytes=%zu\n", name, board_size);
+	error = mhi_lab_board_find(board_fw->data, board_fw->datasize, 1,
+	    name, &regdb, &regdb_size);
+	if (error == ENOENT) {
+		/* The reference drivers permit only this explicit regdb fallback. */
+		error = mhi_lab_board_find(board_fw->data, board_fw->datasize, 1,
+		    "bus=pci", &regdb, &regdb_size);
+		if (error == 0)
+			device_printf(sc->dev, "regdb selected: bus=pci bytes=%zu\n",
+			    regdb_size);
+	}
+	if (error != 0) {
+		device_printf(sc->dev, "regdb selection failed: %d\n", error);
+		goto out;
+	}
+	if (m3_fw->datasize == 0 || m3_fw->datasize > MHI_LAB_M3_LIMIT) {
+		device_printf(sc->dev, "invalid M3 firmware size: %zu\n", m3_fw->datasize);
+		error = EINVAL;
+		goto out;
+	}
+	error = mhi_boot_board_download(sc, regdb, regdb_size, 4);
+	if (error == 0)
+		error = mhi_boot_board_download(sc, board, board_size,
+		    board_size >= 4 && memcmp(board, "\177ELF", 4) == 0 ? 1 : 0);
+	if (error != 0)
+		goto out;
+	/* WCN7850, like the reference driver, does not upload a separate cal file. */
+	error = -linuxkpi_mhi_alloc_memory(sc->ctrl, &sc->m3, m3_fw->datasize);
+	if (error != 0)
+		goto out;
+	bus_dmamap_sync(sc->m3.tag, sc->m3.map,
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	sc->m3.synced = false;
+	memcpy(sc->m3.vaddr, m3_fw->data, m3_fw->datasize);
+	bus_dmamap_sync(sc->m3.tag, sc->m3.map,
+	    BUS_DMASYNC_PREREAD | BUS_DMASYNC_PREWRITE);
+	sc->m3.synced = true;
+	mtx_lock(&context->lock);
+	sc->qmi.m3_address = sc->m3.address;
+	sc->qmi.m3_size = sc->m3.size;
+	mtx_unlock(&context->lock);
+	error = mhi_boot_qmi_exchange(sc, 0x3c);
+	if (error != 0)
+		goto out;
+	error = mhi_boot_qmi_wait(sc, &sc->qmi.fw_ready, 0,
+	    sbinuptime() + 10 * SBT_1S, NULL);
+	if (error == 0)
+		device_printf(sc->dev,
+		    "QMI firmware-ready indication confirmed; M3 bytes=%zu; no WLAN mode/start requested\n",
+		    sc->m3.size);
+	else {
+		if (error == EWOULDBLOCK)
+			error = ETIMEDOUT;
+		device_printf(sc->dev, "QMI firmware-ready wait failed: %d\n", error);
+	}
+out:
+	if (m3_fw != NULL)
+		firmware_put(m3_fw, 0);
+	if (board_fw != NULL)
+		firmware_put(board_fw, 0);
+	return (error);
+}
+
+static int
+mhi_boot_memory_wait(struct mhi_boot_softc *sc, bool ready)
+{
+	int error;
+
+	error = mhi_boot_qmi_wait(sc,
+	    ready ? &sc->qmi.mem_ready : &sc->qmi.mem_requested, 0,
+	    sbinuptime() + 5 * SBT_1S, NULL);
+	if (error != 0) {
+		if (error == EWOULDBLOCK)
+			error = ETIMEDOUT;
+		device_printf(sc->dev, "QMI memory %s indication failed: %d\n",
+		    ready ? "ready" : "request", error);
+	}
+	return (error);
+}
+
+static int
+mhi_boot_initialize(struct mhi_boot_softc *sc)
+{
+	struct lkpi_mhi_context *context = sc->ctrl->lkpi_context;
+	struct mhi_lab_qmi *client = &sc->qmi;
+	unsigned int i;
+	int error;
+
+	error = mhi_boot_qmi_exchange(sc, 0x20);
+	if (error == 0)
+		error = mhi_boot_qmi_exchange(sc, 0x34);
+	if (error == 0)
+		error = mhi_boot_memory_wait(sc, false);
+	if (error != 0)
+		return (error);
+	device_printf(sc->dev, "QMI firmware memory request: segments=%u bytes=%u\n",
+	    client->memory_count, client->memory_total);
+	for (i = 0; i < client->memory_count; i++) {
+		device_printf(sc->dev, "QMI memory segment=%u type=%u bytes=%u\n",
+		    i, client->memory[i].type, client->memory[i].size);
+		error = -linuxkpi_mhi_alloc_memory(sc->ctrl,
+		    &sc->firmware_memory[i], client->memory[i].size);
+		if (error != 0)
+			return (error);
+	}
+	mtx_lock(&context->lock);
+	error = context->event_error;
+	if (error == 0)
+		for (i = 0; i < client->memory_count; i++)
+			client->memory[i].address = sc->firmware_memory[i].address;
+	mtx_unlock(&context->lock);
+	if (error != 0)
+		return (error);
+	error = mhi_boot_qmi_exchange(sc, 0x36);
+	if (error == 0)
+		error = mhi_boot_memory_wait(sc, true);
+	if (error != 0)
+		return (error);
+	device_printf(sc->dev,
+	    "QMI firmware memory ready confirmed; retaining DMA until SoC reset\n");
+	return (mhi_boot_qmi_exchange(sc, 0x24));
+}
+
+static int
+mhi_boot_run(SYSCTL_HANDLER_ARGS)
+{
+	struct mhi_boot_softc *sc = arg1;
+	const struct firmware *fw;
+	const uint8_t *data;
+	size_t length;
+	int action = 0, error, cleanup;
+
+	error = sysctl_handle_int(oidp, &action, 0, req);
+	if (error != 0 || req->newptr == NULL)
+		return (error);
+	if (action != 1)
+		return (EINVAL);
+	sx_xlock(&sc->lock);
+	if (sc->needs_reset) {
+		error = EBUSY;
+		goto out;
+	}
+	if (pci_read_config(sc->dev, PCIR_COMMAND, 2) != sc->command) {
+		device_printf(sc->dev, "PCI command changed since attach\n");
+		error = EBUSY;
+		goto out;
+	}
+	fw = firmware_get("ath12k_lab_amss");
+	if (fw == NULL) {
+		device_printf(sc->dev, "load ath12k_lab_fw.ko before requesting BHI\n");
+		error = ENOENT;
+		goto out;
+	}
+	if (fw->datasize < LKPI_MHI_BHI_SIZE) {
+		device_printf(sc->dev, "AMSS firmware is shorter than the SBL image\n");
+		firmware_put(fw, 0);
+		error = EINVAL;
+		goto out;
+	}
+	linuxkpi_mhi_free_context(sc->ctrl);
+	error = -linuxkpi_mhi_alloc_context(sc->ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850);
+	if (error != 0) {
+		firmware_put(fw, 0);
+		goto out;
+	}
+	if (arg2 != 0) {
+		error = -linuxkpi_mhi_alloc_transfer(sc->ctrl, 20);
+		if (error == 0)
+			error = -linuxkpi_mhi_alloc_transfer(sc->ctrl, 21);
+		if (error != 0) {
+			firmware_put(fw, 0);
+			goto out;
+		}
+	}
+	if (arg2 >= 2) {
+		memset(&sc->qmi, 0, sizeof(sc->qmi));
+		memset(&sc->htc, 0, sizeof(sc->htc));
+		memset(&sc->wmi, 0, sizeof(sc->wmi));
+		sc->qmi.configure = arg2 >= 4;
+		sc->qmi.control = arg2 >= 5;
+		sc->qmi.start = arg2 >= 8;
+		sc->ctrl->lkpi_context->receive = mhi_lab_qmi_receive;
+		sc->ctrl->lkpi_context->receive_arg = &sc->qmi;
+	}
+	if ((sc->command & PCIM_CMD_INTxDIS) == 0) {
+		sc->intx_disabled = true;
+		pci_write_config(sc->dev, PCIR_COMMAND,
+		    sc->command | PCIM_CMD_INTxDIS, 2);
+		if (pci_read_config(sc->dev, PCIR_COMMAND, 2) !=
+		    (sc->command | PCIM_CMD_INTxDIS)) {
+			device_printf(sc->dev, "cannot mask legacy PCI interrupts\n");
+			firmware_put(fw, 0);
+			error = EIO;
+			goto cleanup;
+		}
+	}
+	sc->intx_disabled = true;
+	error = mhi_boot_irq_setup(sc);
+	if (error != 0) {
+		device_printf(sc->dev, "cannot initialize boot MSI: %d\n", error);
+		firmware_put(fw, 0);
+		goto cleanup;
+	}
+	error = -linuxkpi_mhi_boot_bhi(sc->ctrl, &sc->boot, fw->data,
+	    LKPI_MHI_BHI_SIZE);
+	sc->needs_reset = sc->boot.pending;
+	if (error == 0)
+		device_printf(sc->dev,
+		    "BHI accepted %u bytes: DMA=%#jx status=%#x EE=%u "
+		    "MHISTATUS=%#x MSI=%u\n",
+		    LKPI_MHI_BHI_SIZE, (uintmax_t)sc->boot.image.address,
+		    sc->boot.status, sc->boot.ee,
+		    bus_read_4(sc->mem, LKPI_MHI_STATUS),
+		    atomic_load_acq_int(&sc->irqs[0].interrupts));
+	else if (sc->boot.pending) {
+		mhi_boot_diagnostic(sc);
+	}
+	if (error == 0) {
+		error = -linuxkpi_mhi_boot_ready(sc->ctrl, &sc->boot);
+		if (error == 0) {
+			mtx_lock(&sc->ctrl->lkpi_context->lock);
+			device_printf(sc->dev,
+			    "M0/SBL confirmed: MHISTATUS=%#x EE=%u events=%u/%u "
+			    "MSI=%u/%u/%u\n",
+			    bus_read_4(sc->mem, LKPI_MHI_STATUS), sc->boot.ee,
+			    sc->ctrl->lkpi_context->state_events,
+			    sc->ctrl->lkpi_context->ee_events,
+			    atomic_load_acq_int(&sc->irqs[0].interrupts),
+			    atomic_load_acq_int(&sc->irqs[1].interrupts),
+			    atomic_load_acq_int(&sc->irqs[2].interrupts));
+			mtx_unlock(&sc->ctrl->lkpi_context->lock);
+		}
+	}
+	if (error == 0) {
+		data = fw->data;
+		length = fw->datasize;
+		/* Match the MHI FBC path for combined SBL + WLAN ELF images. */
+		if (length >= LKPI_MHI_BHI_SIZE + 4 &&
+		    memcmp(data + LKPI_MHI_BHI_SIZE, "\177ELF", 4) == 0) {
+			data += LKPI_MHI_BHI_SIZE;
+			length -= LKPI_MHI_BHI_SIZE;
+		}
+		error = -linuxkpi_mhi_boot_bhie(sc->ctrl, &sc->boot, data, length);
+		if (error == 0) {
+			mtx_lock(&sc->ctrl->lkpi_context->lock);
+			device_printf(sc->dev,
+			    "BHIE/AMSS confirmed: bytes=%zu vectors=%u status=%#x "
+			    "MHISTATUS=%#x EE=%u events=%u/%u MSI=%u/%u/%u\n",
+			    length, sc->boot.num_segments, sc->boot.bhie_status,
+			    bus_read_4(sc->mem, LKPI_MHI_STATUS), sc->boot.ee,
+			    sc->ctrl->lkpi_context->state_events,
+			    sc->ctrl->lkpi_context->ee_events,
+			    atomic_load_acq_int(&sc->irqs[0].interrupts),
+			    atomic_load_acq_int(&sc->irqs[1].interrupts),
+			    atomic_load_acq_int(&sc->irqs[2].interrupts));
+			mtx_unlock(&sc->ctrl->lkpi_context->lock);
+		}
+	}
+	if (error == 0 && arg2 != 0)
+		error = mhi_boot_transport(sc);
+	if (error == 0 && arg2 >= 2)
+		error = mhi_boot_qmi_exchange(sc, 0x57);
+	if (error == 0 && arg2 >= 3)
+		error = mhi_boot_initialize(sc);
+	if (error == 0 && arg2 >= 4)
+		error = mhi_boot_configure(sc);
+	if (error == 0 && arg2 >= 6)
+		error = mhi_boot_ce_prepare(sc);
+	if (error == 0 && arg2 >= 7)
+		error = mhi_lab_ce_rx_alloc(sc->ctrl, &sc->ce);
+	if (error == 0 && arg2 >= 9)
+		error = mhi_lab_ce_tx_alloc(sc->ctrl, &sc->ce);
+	if (error == 0 && arg2 >= 5)
+		error = mhi_boot_qmi_exchange(sc, 0x2f);
+	if (error == 0 && arg2 >= 5)
+		error = mhi_boot_qmi_exchange(sc, 0x23);
+	if (error == 0 && arg2 >= 8)
+		error = mhi_boot_qmi_exchange(sc, 0x22);
+	if (error == 0 && arg2 == 5)
+		device_printf(sc->dev,
+		    "QMI target CE configuration accepted; host SRNG/HTC not initialized; no WLAN mode/start requested\n");
+	if (error == 0 && arg2 >= 6)
+		error = mhi_lab_ce_init(sc->ctrl, &sc->ce, mhi_boot_ce_register, sc);
+	if (error == 0 && arg2 == 6)
+		device_printf(sc->dev,
+		    "CE SRNG initialization/readback confirmed: rings=%zu shadows=%u; polling, no RX buffers posted, no WLAN mode/start requested\n",
+		    nitems(sc->ce.ring), sc->qmi.shadow_count);
+	if (error == 0 && arg2 >= 7)
+		error = mhi_boot_ce_receive(sc, arg2 >= 8);
+	if (error == 0 && arg2 >= 9)
+		error = mhi_boot_htc_services(sc);
+	if (error == 0 && arg2 >= 10)
+		error = mhi_boot_wmi_services(sc);
+	firmware_put(fw, 0);
+cleanup:
+	cleanup = mhi_boot_cleanup(sc);
+	if (cleanup != 0) {
+		device_printf(sc->dev,
+		    "reset failed: %d; retaining DMA and BAR, retry detach\n",
+		    cleanup);
+		if (error == 0)
+			error = cleanup;
+		goto out;
+	}
+out:
+	sx_xunlock(&sc->lock);
+	return (error);
+}
+
+static int
+mhi_boot_probe(device_t dev)
+{
+	if (vm_guest != VM_GUEST_BHYVE || strcmp(kern_ident, "ATH12KLAB") != 0 ||
+	    pci_get_domain(dev) != 0 || pci_get_bus(dev) != 0 ||
+	    pci_get_slot(dev) != 6 || pci_get_function(dev) != 0 ||
+	    pci_get_vendor(dev) != 0x17cb || pci_get_device(dev) != 0x1107 ||
+	    pci_get_subvendor(dev) != 0x17aa || pci_get_subdevice(dev) != 0xe0e6)
+		return (ENXIO);
+	device_set_desc(dev, "WCN7850 isolated MHI firmware boot experiment");
+	return (BUS_PROBE_SPECIFIC);
+}
+
+static int
+mhi_boot_attach(device_t dev)
+{
+	struct mhi_boot_softc *sc = device_get_softc(dev);
+	int rid = PCIR_BAR(0), cap, error;
+
+	sc->dev = dev;
+	sc->command = pci_read_config(dev, PCIR_COMMAND, 2);
+	if ((sc->command & (PCIM_CMD_MEMEN | PCIM_CMD_BUSMASTEREN)) !=
+	    (PCIM_CMD_MEMEN | PCIM_CMD_BUSMASTEREN) ||
+	    pci_find_cap(dev, PCIY_MSI, &cap) != 0 ||
+	    (pci_read_config(dev, cap + PCIR_MSI_CTRL, 2) &
+	    PCIM_MSICTRL_MSI_ENABLE) != 0) {
+		device_printf(dev, "require existing memory/bus-master enable and disabled MSI\n");
+		return (ENXIO);
+	}
+	if (pci_find_cap(dev, PCIY_MSIX, &cap) == 0 &&
+	    (pci_read_config(dev, cap + PCIR_MSIX_CTRL, 2) &
+	    PCIM_MSIXCTRL_MSIX_ENABLE) != 0)
+		return (ENXIO);
+	sc->mem = bus_alloc_resource_any(dev, SYS_RES_MEMORY, &rid, RF_ACTIVE);
+	if (sc->mem == NULL)
+		return (ENXIO);
+	if (rman_get_size(sc->mem) != 0x200000) {
+		error = ENXIO;
+		goto fail;
+	}
+	sc->ctrl = mhi_alloc_controller();
+	if (sc->ctrl == NULL) {
+		error = ENOMEM;
+		goto fail;
+	}
+	sc->ldev.bsddev = dev;
+	sc->ctrl->cntrl_dev = &sc->ldev;
+	sc->ctrl->regs = rman_get_virtual(sc->mem);
+	sc->ctrl->reg_len = 0xfe0;
+	sc->ctrl->iova_stop = BUS_SPACE_MAXADDR_32BIT;
+	sc->ctrl->timeout_ms = 5000;
+	sc->ctrl->read_reg = mhi_boot_read;
+	sc->ctrl->write_reg = mhi_boot_write;
+	error = -linuxkpi_mhi_alloc_context(sc->ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850);
+	if (error != 0)
+		goto fail;
+	sx_init(&sc->lock, "mhi boot lab");
+	sysctl_ctx_init(&sc->sysctls);
+	if (SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "bhi", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 0,
+	    mhi_boot_run, "I", "Write 1 to boot SBL/BHI and AMSS/BHIE, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "transport", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 1,
+	    mhi_boot_run, "I", "Write 1 to boot AMSS, exchange IPCR control, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "qmi", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 2,
+	    mhi_boot_run, "I", "Write 1 to request WLANFW PHY capabilities, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "initialize", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 3,
+	    mhi_boot_run, "I", "Write 1 to negotiate firmware memory and capabilities, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "configure", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 4,
+	    mhi_boot_run, "I", "Write 1 to load board/regdb/M3 and await firmware ready, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "control", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 5,
+	    mhi_boot_run, "I", "Write 1 to stage WLAN INI/target CE tables without mode/start, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "rings", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 6,
+	    mhi_boot_run, "I", "Write 1 to initialize empty CE rings and shadow configuration, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "receive", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 7,
+	    mhi_boot_run, "I", "Write 1 to post CE RX buffers and poll without WLAN mode/start, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "startup", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 8,
+	    mhi_boot_run, "I", "Write 1 to start normal WLAN firmware and require HTC READY, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "services", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 9,
+	    mhi_boot_run, "I", "Write 1 to connect real HTC HTT/WMI services with native CE TX, then reset") ==
+	    NULL || SYSCTL_ADD_PROC(&sc->sysctls,
+	    SYSCTL_CHILDREN(device_get_sysctl_tree(dev)), OID_AUTO,
+	    "wmi", CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_MPSAFE, sc, 10,
+	    mhi_boot_run, "I", "Write 1 to complete HTC setup and require WMI service-ready, then reset") ==
+	    NULL) {
+		sysctl_ctx_free(&sc->sysctls);
+		sx_destroy(&sc->lock);
+		error = ENOMEM;
+		goto fail;
+	}
+	device_printf(dev, "attached without MMIO writes or interrupts; BHI requires explicit sysctl\n");
+	return (0);
+fail:
+	device_printf(dev, "lab attachment failed: %d\n", error);
+	mhi_free_controller(sc->ctrl);
+	bus_release_resource(dev, SYS_RES_MEMORY, rid, sc->mem);
+	return (error);
+}
+
+static int
+mhi_boot_detach(device_t dev)
+{
+	struct mhi_boot_softc *sc = device_get_softc(dev);
+	int error;
+
+	/* Drain handlers before freeing their lock, DMA, or MMIO resources. */
+	error = sysctl_ctx_free(&sc->sysctls);
+	if (error != 0)
+		return (error);
+	error = mhi_boot_cleanup(sc);
+	if (error != 0) {
+		device_printf(dev, "cannot detach active DMA: %d\n", error);
+		return (error);
+	}
+	mhi_free_controller(sc->ctrl);
+	sc->ctrl = NULL;
+	error = bus_release_resource(dev, SYS_RES_MEMORY, PCIR_BAR(0), sc->mem);
+	if (error != 0)
+		return (error);
+	sx_destroy(&sc->lock);
+	if (pci_read_config(dev, PCIR_COMMAND, 2) != sc->command)
+		device_printf(dev, "WARNING: PCI command changed during experiment\n");
+	return (0);
+}
+
+static device_method_t mhi_boot_methods[] = {
+	DEVMETHOD(device_probe, mhi_boot_probe),
+	DEVMETHOD(device_attach, mhi_boot_attach),
+	DEVMETHOD(device_detach, mhi_boot_detach),
+	DEVMETHOD_END
+};
+
+static driver_t mhi_boot_driver = {
+	"lkpi_mhi_boot", mhi_boot_methods, sizeof(struct mhi_boot_softc)
+};
+
+DRIVER_MODULE(lkpi_mhi_boot, pci, mhi_boot_driver, NULL, NULL);
+MODULE_VERSION(lkpi_mhi_boot, 1);
+MODULE_DEPEND(lkpi_mhi_boot, linuxkpi, 1, 1, 1);
+MODULE_DEPEND(lkpi_mhi_boot, firmware, 1, 1, 1);
diff --git a/sys/tests/linuxkpi_wlan/mhi_ce.c b/sys/tests/linuxkpi_wlan/mhi_ce.c
new file mode 100644
index 00000000000..d1e8c018ab4
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_ce.c
@@ -0,0 +1,759 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * Copyright (c) 2018-2021 The Linux Foundation. All rights reserved.
+ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
+ *
+ * Native, polling CE setup follows ath12k_wifi7_hal_srng_{src,dst}_hw_init.
+ */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/errno.h>
+#include <sys/malloc.h>
+#include <sys/systm.h>
+#include <machine/atomic.h>
+
+#include "core.h"
+#include "wifi7/hal_wcn7850.h"
+#include "ce_config.h"
+#include "mhi_ce.h"
+
+static const struct {
+	unsigned int pipe, entries;
+	enum mhi_lab_ce_kind kind;
+} mhi_ce_layout[MHI_LAB_CE_RINGS] = {
+	{ 0, ATH12K_WCN7850_CE0_SRC_ENTRIES, MHI_LAB_CE_SEND },
+	{ 1, ATH12K_WCN7850_CE1_DST_ENTRIES, MHI_LAB_CE_RECEIVE },
+	{ 1, ATH12K_WCN7850_CE1_DST_ENTRIES, MHI_LAB_CE_STATUS },
+	{ 2, ATH12K_WCN7850_CE2_DST_ENTRIES, MHI_LAB_CE_RECEIVE },
+	{ 2, ATH12K_WCN7850_CE2_DST_ENTRIES, MHI_LAB_CE_STATUS },
+	{ 3, ATH12K_WCN7850_CE3_SRC_ENTRIES, MHI_LAB_CE_SEND },
+	{ 4, ATH12K_WCN7850_CE4_SRC_ENTRIES, MHI_LAB_CE_SEND }
+};
+
+int
+mhi_lab_ce_alloc(struct mhi_controller *ctrl, struct mhi_lab_ce *ce)
+{
+	const struct ath12k_hw_regs *regs = &wcn7850_regs;
+	struct mhi_lab_ce_ring *ring;
+	uint32_t pipe, stride;
+	unsigned int i;
+	int error;
+
+	if (ce->rdp.tag != NULL || ce->allocated) {
+		printf("mhi_lab_ce: refusing to replace allocated rings\n");
+		return (EBUSY);
+	}
+	error = -linuxkpi_mhi_alloc_memory(ctrl, &ce->rdp,
+	    HAL_SRNG_RING_ID_MAX * sizeof(uint32_t));
+	if (error != 0)
+		return (error);
+	for (i = 0; i < nitems(ce->ring); i++) {
+		ring = &ce->ring[i];
+		pipe = mhi_ce_layout[i].pipe;
+		ring->entries = mhi_ce_layout[i].entries;
+		ring->kind = mhi_ce_layout[i].kind;
+		if (ring->kind == MHI_LAB_CE_SEND) {
+			stride = regs->umac_ce1_src_reg_base - regs->umac_ce0_src_reg_base;
+			ring->base = regs->umac_ce0_src_reg_base + pipe * stride;
+			ring->pointers = ring->base + HAL_CE_DST_RING_HP;
+			ring->id = HAL_SRNG_RING_ID_CE0_SRC + pipe;
+			ring->entry_bytes = sizeof(struct hal_ce_srng_src_desc);
+		} else {
+			stride = regs->umac_ce1_dest_reg_base - regs->umac_ce0_dest_reg_base;
+			ring->base = regs->umac_ce0_dest_reg_base + pipe * stride;
+			ring->pointers = ring->base + HAL_CE_DST_RING_HP;
+			ring->id = HAL_SRNG_RING_ID_CE0_DST + pipe;
+			ring->entry_bytes = sizeof(struct hal_ce_srng_dest_desc);
+			if (ring->kind == MHI_LAB_CE_STATUS) {
+				ring->pointers = ring->base + HAL_CE_DST_STATUS_RING_HP;
+				ring->base += HAL_CE_DST_STATUS_RING_BASE_LSB;
+				ring->id = HAL_SRNG_RING_ID_CE0_DST_STATUS + pipe;
+				ring->entry_bytes = sizeof(struct hal_ce_srng_dst_status_desc);
+			}
+		}
+		ce->shadow[i] = ring->pointers +
+		    (ring->kind == MHI_LAB_CE_STATUS ? HAL_OFFSET_FROM_HP_TO_TP : 0);
+		error = -linuxkpi_mhi_alloc_memory(ctrl, &ring->dma,
+		    ring->entries * ring->entry_bytes);
+		if (error != 0)
+			return (error);
+	}
+	ce->allocated = true;
+	return (0);
+}
+
+static int
+mhi_ce_write(mhi_lab_ce_register access, void *arg, uint32_t address,
+    uint32_t value, uint32_t mask)
+{
+	uint32_t actual;
+	int error;
+
+	error = access(arg, address, &value, true);
+	if (error == 0)
+		error = access(arg, address, &actual, false);
+	if (error == 0 && (actual & mask) != (value & mask))
+		error = EIO;
+	if (error != 0)
+		printf("mhi_lab_ce: register %#x write/readback failed: %d\n",
+		    address, error);
+	return (error);
+}
+
+int
+mhi_lab_ce_init(struct mhi_controller *ctrl, struct mhi_lab_ce *ce,
+    mhi_lab_ce_register access, void *arg)
+{
+	const struct ath12k_hw_regs *regs = &wcn7850_regs;
+	struct mhi_lab_ce_ring *ring;
+	uint32_t base, id, misc, pointer, msi, interrupt, value, size;
+	bool status;
+	unsigned int i;
+	int error;
+
+	if (!ce->allocated || ce->initialized || access == NULL ||
+	    ctrl->lkpi_context == NULL || !ctrl->lkpi_context->published) {
+		printf("mhi_lab_ce: allocated rings and active reset ownership required\n");
+		return (EPROTO);
+	}
+	/* Refuse every active ring before publishing any new DMA addresses. */
+	for (i = 0; i < nitems(ce->ring); i++) {
+		ring = &ce->ring[i];
+		misc = regs->tcl1_ring_misc - regs->tcl1_ring_base_lsb;
+		error = access(arg, ring->base + misc, &value, false);
+		if (error != 0)
+			return (error);
+		if ((value & HAL_TCL1_RING_MISC_SRNG_ENABLE) != 0) {
+			printf("mhi_lab_ce: ring %u already enabled (%#x)\n", i, value);
+			return (EBUSY);
+		}
+	}
+	for (i = 0; i < nitems(ce->ring); i++) {
+		ring = &ce->ring[i];
+		base = ring->base;
+		ce->touched = true;
+		status = ring->kind == MHI_LAB_CE_STATUS;
+		id = status ? regs->reo1_ring_id - regs->reo1_ring_base_lsb :
+		    regs->tcl1_ring_id - regs->tcl1_ring_base_lsb;
+		misc = status ? regs->reo1_ring_misc - regs->reo1_ring_base_lsb :
+		    regs->tcl1_ring_misc - regs->tcl1_ring_base_lsb;
+		pointer = status ? regs->reo1_ring_hp_addr_lsb - regs->reo1_ring_base_lsb :
+		    regs->tcl1_ring_tp_addr_lsb - regs->tcl1_ring_base_lsb;
+		msi = status ? regs->reo1_ring_msi1_base_lsb - regs->reo1_ring_base_lsb :
+		    regs->tcl1_ring_msi1_base_lsb - regs->tcl1_ring_base_lsb;
+		interrupt = status ?
+		    regs->reo1_ring_producer_int_setup - regs->reo1_ring_base_lsb :
+		    regs->tcl1_ring_consumer_int_setup_ix0 - regs->tcl1_ring_base_lsb;
+		size = ring->entries * (ring->entry_bytes / 4);
+#define CE_WRITE(address, data, mask) do {				\
+	error = mhi_ce_write(access, arg, (address), (data), (mask));	\
+	if (error != 0)							\
+		return (error);						\
+} while (0)
+		/* Polling only: do not route CE events onto the MHI MSI vectors. */
+		CE_WRITE(base + msi, 0, UINT32_MAX);
+		CE_WRITE(base + msi + 4, 0, UINT32_MAX);
+		CE_WRITE(base + msi + 8, 0, UINT32_MAX);
+		CE_WRITE(base, ring->dma.address, UINT32_MAX);
+		CE_WRITE(base + 4, size << 8, UINT32_MAX);
+		CE_WRITE(base + id, ring->entry_bytes / 4 |
+		    (status ? ring->id << 8 : 0), UINT32_MAX);
+		CE_WRITE(base + interrupt, 0, UINT32_MAX);
+		if (!status)
+			CE_WRITE(base + interrupt + 4, 0, UINT32_MAX);
+		CE_WRITE(base + pointer, ce->rdp.address + 4 * ring->id, UINT32_MAX);
+		CE_WRITE(base + pointer + 4, 0, UINT32_MAX);
+		CE_WRITE(ring->pointers, 0, UINT32_MAX);
+		CE_WRITE(ring->pointers + 4, 0, UINT32_MAX);
+		if (ring->kind == MHI_LAB_CE_RECEIVE) {
+			error = access(arg, base + HAL_CE_DST_RING_CTRL, &value, false);
+			if (error != 0)
+				return (error);
+			value &= ~HAL_CE_DST_R0_DEST_CTRL_MAX_LEN;
+			value |= ATH12K_WCN7850_CE_BUFFER_SIZE;
+			CE_WRITE(base + HAL_CE_DST_RING_CTRL, value, UINT32_MAX);
+		}
+		value = HAL_TCL1_RING_MISC_SRNG_ENABLE;
+		if (!status)
+			value |= HAL_TCL1_RING_MISC_MSI_LOOPCNT_DISABLE;
+		CE_WRITE(base + misc, value, HAL_TCL1_RING_MISC_SRNG_ENABLE |
+		    HAL_TCL1_RING_MISC_MSI_LOOPCNT_DISABLE);
+#undef CE_WRITE
+	}
+	ce->initialized = true;
+	return (0);
+}
+
+static void
+mhi_ce_cpu(struct lkpi_mhi_dma *dma)
+{
+	KASSERT(dma->synced, ("CE DMA already CPU-owned"));
+	bus_dmamap_sync(dma->tag, dma->map,
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	dma->synced = false;
+}
+
+static void
+mhi_ce_device(struct lkpi_mhi_dma *dma)
+{
+	KASSERT(!dma->synced, ("CE DMA already device-owned"));
+	bus_dmamap_sync(dma->tag, dma->map,
+	    BUS_DMASYNC_PREREAD | BUS_DMASYNC_PREWRITE);
+	dma->synced = true;
+}
+
+static int
+mhi_ce_pointer(struct mhi_lab_ce *ce, struct mhi_lab_ce_ring *ring, uint32_t *value)
+{
+	mhi_ce_cpu(&ce->rdp);
+	*value = le32toh(atomic_load_acq_32(
+	    (volatile uint32_t *)ce->rdp.vaddr + ring->id));
+	mhi_ce_device(&ce->rdp);
+	if (*value >= ring->dma.size / 4 ||
+	    *value % (ring->entry_bytes / 4) != 0) {
+		printf("mhi_lab_ce: corrupt ring %u pointer %#x\n", ring->id, *value);
+		return (EPROTO);
+	}
+	return (0);
+}
+
+int
+mhi_lab_ce_tx_alloc(struct mhi_controller *ctrl, struct mhi_lab_ce *ce)
+{
+	unsigned int i;
+	int error;
+
+	if (!ce->allocated || ce->initialized ||
+	    ce->tx[0].buffer.tag != NULL || ce->tx[1].buffer.tag != NULL) {
+		printf("mhi_lab_ce: TX allocation requires fresh CE rings\n");
+		return (EPROTO);
+	}
+	for (i = 0; i < nitems(ce->tx); i++) {
+		error = -linuxkpi_mhi_alloc_memory(ctrl, &ce->tx[i].buffer,
+		    ATH12K_WCN7850_CE_BUFFER_SIZE);
+		if (error != 0)
+			return (error);
+	}
+	return (0);
+}
+
+int
+mhi_lab_ce_tx_poll(struct mhi_lab_ce *ce, unsigned int pipe)
+{
+	struct mhi_lab_ce_ring *ring;
+	struct mhi_lab_ce_tx *tx;
+	uint32_t tail;
+	int error;
+
+	if (ce->error != 0)
+		return (ce->error);
+	if (!ce->initialized || !ce->touched || (pipe != 0 && pipe != 3)) {
+		printf("mhi_lab_ce: invalid TX polling state/pipe\n");
+		return (EINVAL);
+	}
+	tx = &ce->tx[pipe == 3];
+	ring = &ce->ring[pipe == 3 ? 5 : 0];
+	error = mhi_ce_pointer(ce, ring, &tail);
+	if (error != 0)
+		goto fail;
+	if (tail == tx->write) {
+		if (tx->busy) {
+			tx->packets++;
+			tx->busy = false;
+		}
+		return (0);
+	}
+	if (tx->busy && tail == tx->tail)
+		return (EAGAIN);
+	error = EPROTO;
+fail:
+	ce->error = error;
+	printf("mhi_lab_ce: invalid TX completion on pipe %u: %d\n", pipe, error);
+	return (error);
+}
+
+int
+mhi_lab_ce_send(struct mhi_lab_ce *ce, mhi_lab_ce_register access, void *arg,
+    unsigned int pipe, uint16_t endpoint, const void *data, size_t length)
+{
+	struct mhi_lab_ce_ring *ring;
+	struct mhi_lab_ce_tx *tx;
+	struct hal_ce_srng_src_desc *descriptor;
+	int error;
+
+	if (ce->error != 0)
+		return (ce->error);
+	if (access == NULL || data == NULL || length == 0 ||
+	    length > ATH12K_WCN7850_CE_BUFFER_SIZE || (pipe != 0 && pipe != 3) ||
+	    endpoint >= ATH12K_HTC_EP_COUNT) {
+		printf("mhi_lab_ce: invalid TX arguments\n");
+		return (EINVAL);
+	}
+	error = mhi_lab_ce_tx_poll(ce, pipe);
+	if (error != 0)
+		return (error);
+	tx = &ce->tx[pipe == 3];
+	ring = &ce->ring[pipe == 3 ? 5 : 0];
+	if (tx->buffer.tag == NULL) {
+		printf("mhi_lab_ce: TX buffer not allocated\n");
+		return (EPROTO);
+	}
+	mhi_ce_cpu(&tx->buffer);
+	memcpy(tx->buffer.vaddr, data, length);
+	mhi_ce_device(&tx->buffer);
+	mhi_ce_cpu(&ring->dma);
+	descriptor = (void *)((uint8_t *)ring->dma.vaddr + 4 * tx->write);
+	memset(descriptor, 0, sizeof(*descriptor));
+	descriptor->buffer_addr_low = htole32(tx->buffer.address);
+	descriptor->buffer_addr_info =
+	    le32_encode_bits(length, HAL_CE_SRC_DESC_ADDR_INFO_LEN);
+	descriptor->meta_info =
+	    le32_encode_bits(endpoint, HAL_CE_SRC_DESC_META_INFO_DATA);
+	mhi_ce_device(&ring->dma);
+	tx->tail = tx->write;
+	tx->write = (tx->write + ring->entry_bytes / 4) % (ring->dma.size / 4);
+	tx->busy = true;
+	error = mhi_ce_write(access, arg, ring->pointers, tx->write, UINT32_MAX);
+	if (error != 0) {
+		ce->error = error;
+		printf("mhi_lab_ce: TX doorbell failed: %d; retaining DMA\n", error);
+	}
+	return (error);
+}
+
+int
+mhi_lab_ce_rx_alloc(struct mhi_controller *ctrl, struct mhi_lab_ce *ce)
+{
+	struct mhi_lab_ce_rx *rx;
+	unsigned int p, i;
+	int error;
+
+	if (!ce->allocated || ce->initialized ||
+	    ce->rx[0].buffers != NULL || ce->rx[1].buffers != NULL) {
+		printf("mhi_lab_ce: RX allocation requires fresh CE rings\n");
+		return (EPROTO);
+	}
+	for (p = 0; p < nitems(ce->rx); p++) {
+		rx = &ce->rx[p];
+		rx->count = ce->ring[1 + 2 * p].entries - 2;
+		rx->buffers = mallocarray(rx->count, sizeof(*rx->buffers),
+		    M_DEVBUF, M_NOWAIT | M_ZERO);
+		if (rx->buffers == NULL) {
+			printf("mhi_lab_ce: RX metadata allocation failed for pipe %u\n", p + 1);
+			return (ENOMEM);
+		}
+		for (i = 0; i < rx->count; i++) {
+			error = -linuxkpi_mhi_alloc_memory(ctrl, &rx->buffers[i],
+			    ATH12K_WCN7850_CE_BUFFER_SIZE);
+			if (error != 0)
+				return (error);
+		}
+	}
+	return (0);
+}
+
+int
+mhi_lab_ce_rx_post(struct mhi_lab_ce *ce, mhi_lab_ce_register access, void *arg)
+{
+	struct mhi_lab_ce_rx *rx;
+	struct mhi_lab_ce_ring *ring;
+	struct hal_ce_srng_dest_desc *desc;
+	uint32_t pointer;
+	unsigned int p, i;
+	int error;
+
+	if (!ce->initialized || !ce->touched || ce->posted || ce->error != 0 ||
+	    access == NULL) {
+		printf("mhi_lab_ce: RX posting requires initialized, unposted rings\n");
+		return (EPROTO);
+	}
+	/* Validate both complete pools before making either available to hardware. */
+	for (p = 0; p < nitems(ce->rx); p++) {
+		rx = &ce->rx[p];
+		ring = &ce->ring[1 + 2 * p];
+		if (rx->buffers == NULL || rx->count != ring->entries - 2) {
+			printf("mhi_lab_ce: RX pool %u incomplete\n", p + 1);
+			return (EPROTO);
+		}
+		for (i = 0; i < rx->count; i++)
+			if (!rx->buffers[i].loaded || !rx->buffers[i].synced) {
+				printf("mhi_lab_ce: RX buffer %u:%u unavailable\n", p + 1, i);
+				return (EPROTO);
+			}
+		error = mhi_ce_pointer(ce, ring, &pointer);
+		if (error != 0 || pointer != 0) {
+			if (error == 0)
+				error = EPROTO;
+			goto fail;
+		}
+	}
+	for (p = 0; p < nitems(ce->rx); p++) {
+		rx = &ce->rx[p];
+		ring = &ce->ring[1 + 2 * p];
+		mhi_ce_cpu(&ring->dma);
+		desc = ring->dma.vaddr;
+		for (i = 0; i < rx->count; i++) {
+			desc[i].buffer_addr_low = htole32(rx->buffers[i].address);
+			desc[i].buffer_addr_info = 0;
+		}
+		mhi_ce_device(&ring->dma);
+		rx->write = rx->count * (ring->entry_bytes / 4);
+		/* Direct CE doorbells do not depend on runtime shadow forwarding. */
+		error = mhi_ce_write(access, arg, ring->pointers, rx->write, UINT32_MAX);
+		if (error != 0)
+			goto fail;
+	}
+	ce->posted = true;
+	return (0);
+fail:
+	ce->error = error;
+	printf("mhi_lab_ce: RX posting failed: %d\n", error);
+	return (error);
+}
+
+int
+mhi_lab_ce_poll(struct mhi_lab_ce *ce, mhi_lab_ce_register access, void *arg,
+    mhi_lab_ce_receive receive, void *receive_arg, unsigned int budget,
+    unsigned int *processed)
+{
+	struct mhi_lab_ce_rx *rx;
+	struct mhi_lab_ce_ring *ring, *status;
+	struct lkpi_mhi_dma *buffer;
+	struct hal_ce_srng_dest_desc *destination;
+	struct hal_ce_srng_dst_status_desc *completion;
+	uint32_t head, tail, next, length;
+	unsigned int p, turn, start;
+	int error;
+
+	if (processed == NULL) {
+		printf("mhi_lab_ce: RX completion count required\n");
+		return (EINVAL);
+	}
+	*processed = 0;
+	if (ce->error != 0)
+		return (ce->error);
+	if (!ce->posted || !ce->touched || ce->polling || budget == 0 ||
+	    access == NULL || receive == NULL) {
+		printf("mhi_lab_ce: invalid RX polling state/arguments\n");
+		return (EINVAL);
+	}
+	ce->polling = true;
+	start = ce->poll_pipe;
+	ce->poll_pipe = (start + 1) % nitems(ce->rx);
+	for (turn = 0; turn < nitems(ce->rx) && *processed < budget; turn++) {
+		p = (start + turn) % nitems(ce->rx);
+		rx = &ce->rx[p];
+		ring = &ce->ring[1 + 2 * p];
+		status = &ce->ring[2 + 2 * p];
+		error = mhi_ce_pointer(ce, status, &head);
+		if (error != 0)
+			goto fail;
+		while (rx->tail != head && *processed < budget) {
+			next = (rx->write + ring->entry_bytes / 4) % (ring->dma.size / 4);
+			error = mhi_ce_pointer(ce, ring, &tail);
+			if (error != 0)
+				goto fail;
+			if (next == tail) {
+				ce->polling = false;
+				return (EAGAIN);
+			}
+			mhi_ce_cpu(&status->dma);
+			completion = (void *)((uint8_t *)status->dma.vaddr + 4 * rx->tail);
+			length = le32_get_bits(completion->flags,
+			    HAL_CE_DST_STATUS_DESC_FLAGS_LEN);
+			mhi_ce_device(&status->dma);
+			if (length == 0 || length > ATH12K_WCN7850_CE_BUFFER_SIZE) {
+				error = EMSGSIZE;
+				goto fail;
+			}
+			/* CE completion order is FIFO; keep buffer identities stable. */
+			buffer = &rx->buffers[rx->next_buffer];
+			mhi_ce_cpu(buffer);
+			error = receive(receive_arg, p + 1, buffer->vaddr, length);
+			mhi_ce_device(buffer);
+			if (error != 0)
+				goto fail;
+			ce->packets++;
+			(*processed)++;
+			mhi_ce_cpu(&status->dma);
+			completion->flags &= ~cpu_to_le32(HAL_CE_DST_STATUS_DESC_FLAGS_LEN);
+			mhi_ce_device(&status->dma);
+			rx->tail = (rx->tail + status->entry_bytes / 4) %
+			    (status->dma.size / 4);
+			error = mhi_ce_write(access, arg, status->pointers + 4,
+			    rx->tail, UINT32_MAX);
+			if (error != 0)
+				goto fail;
+			mhi_ce_cpu(&ring->dma);
+			destination = (void *)((uint8_t *)ring->dma.vaddr + 4 * rx->write);
+			destination->buffer_addr_low = htole32(buffer->address);
+			destination->buffer_addr_info = 0;
+			mhi_ce_device(&ring->dma);
+			error = mhi_ce_write(access, arg, ring->pointers, next, UINT32_MAX);
+			if (error != 0)
+				goto fail;
+			rx->write = next;
+			rx->next_buffer = (rx->next_buffer + 1) % rx->count;
+		}
+	}
+	ce->polling = false;
+	return (0);
+fail:
+	ce->error = error;
+	ce->polling = false;
+	printf("mhi_lab_ce: RX completion failed: %d; reset required\n", error);
+	return (error);
+}
+
+int
+mhi_lab_htc_connect(struct mhi_lab_htc *htc, uint16_t service, uint8_t packet[16])
+{
+	unsigned int index;
+	uint16_t flags;
+
+	index = service == ATH12K_HTC_SVC_ID_WMI_CONTROL ? 1 : 0;
+	if (!htc->ready || htc->pending_service != 0 || htc->setup ||
+	    (service != ATH12K_HTC_SVC_ID_HTT_DATA_MSG &&
+	    service != ATH12K_HTC_SVC_ID_WMI_CONTROL) ||
+	    htc->service[index].id != 0 ||
+	    (index == 1 && htc->service[0].id == 0) ||
+	    htc->credits > UINT8_MAX) {
+		printf("mhi_lab_htc: invalid service connection state (%#x)\n", service);
+		return (EPROTO);
+	}
+	flags = index == 1 ? htc->credits << 8 :
+	    ATH12K_HTC_CONN_FLAGS_DISABLE_CREDIT_FLOW_CTRL;
+	memset(packet, 0, 16);
+	le32enc(packet, 8U << 16);
+	le32enc(packet + 4, (uint32_t)htc->sequence++ << 8);
+	le32enc(packet + 8, (uint32_t)service << 16 |
+	    ATH12K_HTC_MSG_CONNECT_SERVICE_ID);
+	le32enc(packet + 12, flags);
+	htc->pending_service = service;
+	return (0);
+}
+
+int
+mhi_lab_htc_setup(struct mhi_lab_htc *htc, uint8_t packet[20])
+{
+	if (!htc->ready || htc->pending_service != 0 || htc->setup ||
+	    htc->service[0].id != ATH12K_HTC_SVC_ID_HTT_DATA_MSG ||
+	    htc->service[1].id != ATH12K_HTC_SVC_ID_WMI_CONTROL ||
+	    htc->receive == NULL) {
+		printf("mhi_lab_htc: services and receiver required before setup\n");
+		return (EPROTO);
+	}
+	memset(packet, 0, 20);
+	le32enc(packet, 12U << 16);
+	le32enc(packet + 4, (uint32_t)htc->sequence++ << 8);
+	le32enc(packet + 8, ATH12K_HTC_MSG_SETUP_COMPLETE_EX_ID);
+	htc->setup = true;
+	return (0);
+}
+
+static int
+mhi_htc_trailer(struct mhi_lab_htc *htc, const uint8_t *data, size_t size)
+{
+	size_t offset = 0, length, i;
+	unsigned int endpoint, credits = htc->wmi_credits;
+
+	while (offset < size) {
+		if (size - offset < sizeof(struct ath12k_htc_record_hdr))
+			return (EPROTO);
+		length = data[offset + 1];
+		if (length > size - offset - sizeof(struct ath12k_htc_record_hdr))
+			return (EPROTO);
+		if (data[offset] == ATH12K_HTC_RECORD_CREDITS) {
+			if (length == 0 || length % sizeof(struct ath12k_htc_credit_report) != 0)
+				return (EPROTO);
+			for (i = offset + 4; i < offset + 4 + length; i += 4) {
+				endpoint = data[i];
+				if (endpoint >= htc->endpoints ||
+				    endpoint >= ATH12K_HTC_EP_COUNT)
+					return (EPROTO);
+				if (endpoint == htc->service[1].endpoint) {
+					if (credits > UINT16_MAX - data[i + 1])
+						return (EPROTO);
+					credits += data[i + 1];
+				}
+			}
+		} else if (data[offset] != ATH12K_HTC_RECORD_NULL)
+			return (EOPNOTSUPP);
+		offset += 4 + length;
+	}
+	htc->wmi_credits = credits;
+	return (0);
+}
+
+int
+mhi_lab_htc_receive(void *arg, unsigned int pipe, const void *data, size_t length)
+{
+	struct mhi_lab_htc *htc = arg;
+	const uint8_t *packet = data;
+	uint32_t info, credits, resources, payload, message, flags, endpoint;
+	unsigned int index, trailer;
+	int error;
+
+	if (htc == NULL || packet == NULL ||
+	    length < sizeof(struct ath12k_htc_hdr))
+		goto invalid;
+	info = le32dec(packet);
+	payload = info >> 16;
+	endpoint = info & 0xff;
+	flags = (info >> 8) & 0xff;
+	if (length != sizeof(struct ath12k_htc_hdr) + payload ||
+	    (flags & ~ATH12K_HTC_FLAG_TRAILER_PRESENT) != 0)
+		goto invalid;
+	if (flags & ATH12K_HTC_FLAG_TRAILER_PRESENT) {
+		trailer = packet[4];
+		if (!htc->setup || trailer < sizeof(struct ath12k_htc_record_hdr) ||
+		    trailer > payload)
+			goto invalid;
+		error = mhi_htc_trailer(htc, packet + length - trailer, trailer);
+		if (error != 0)
+			goto invalid;
+		payload -= trailer;
+	}
+	if (endpoint != 0) {
+		if (!htc->setup || htc->receive == NULL)
+			goto invalid;
+		for (index = 0; index < nitems(htc->service); index++)
+			if (htc->service[index].id != 0 &&
+			    endpoint == htc->service[index].endpoint)
+				break;
+		if (index == nitems(htc->service) || pipe != (index == 0 ? 1 : 2) ||
+		    payload > htc->service[index].max_message)
+			goto invalid;
+		if (payload == 0)
+			return (0);
+		return (htc->receive(htc->receive_arg, htc->service[index].id,
+		    packet + sizeof(struct ath12k_htc_hdr), payload));
+	}
+	if (pipe == 2 && payload == 0 && htc->setup &&
+	    (flags & ATH12K_HTC_FLAG_TRAILER_PRESENT) != 0)
+		return (0);
+	if (pipe != 2 || payload < sizeof(struct ath12k_htc_ready))
+		goto invalid;
+	message = le32dec(packet + 8);
+	if ((message & 0xffff) == ATH12K_HTC_MSG_CONNECT_SERVICE_RESP_ID) {
+		if (!htc->ready || htc->pending_service == 0 ||
+		    payload < sizeof(struct ath12k_htc_conn_svc_resp) ||
+		    (message >> 16) != htc->pending_service ||
+		    payload != sizeof(struct ath12k_htc_conn_svc_resp) + packet[16])
+			goto invalid;
+		flags = le32dec(packet + 12);
+		endpoint = (flags >> 8) & 0xff;
+		if ((flags & 0xff) != ATH12K_HTC_CONN_SVC_STATUS_SUCCESS ||
+		    endpoint == 0 || endpoint >= htc->endpoints ||
+		    endpoint >= ATH12K_HTC_EP_COUNT || (flags >> 16) == 0 ||
+		    endpoint == htc->service[0].endpoint ||
+		    endpoint == htc->service[1].endpoint)
+			goto invalid;
+		index = htc->pending_service == ATH12K_HTC_SVC_ID_WMI_CONTROL ? 1 : 0;
+		htc->service[index].id = htc->pending_service;
+		htc->service[index].endpoint = endpoint;
+		htc->service[index].max_message = flags >> 16;
+		if (index == 1)
+			htc->wmi_credits = htc->credits;
+		htc->pending_service = 0;
+		return (0);
+	}
+	if (htc->ready ||
+	    (payload != sizeof(struct ath12k_htc_ready) &&
+	    payload != sizeof(struct ath12k_htc_ready_extended)))
+		goto invalid;
+	credits = le32dec(packet + 8);
+	resources = le32dec(packet + 12);
+	if ((credits & 0xffff) != ATH12K_HTC_MSG_READY_ID || (credits >> 16) == 0 ||
+	    (resources & 0xffff) == 0 || ((resources >> 16) & 0xff) == 0 ||
+	    (payload == sizeof(struct ath12k_htc_ready_extended) &&
+	    packet[16] > ATH12K_HTC_VERSION_2P1))
+		goto invalid;
+	htc->credits = credits >> 16;
+	htc->credit_size = resources & 0xffff;
+	htc->endpoints = (resources >> 16) & 0xff;
+	if (payload == sizeof(struct ath12k_htc_ready_extended)) {
+		htc->extended = true;
+		htc->version = packet[16];
+		htc->bundle = packet[17];
+	}
+	htc->ready = true;
+	return (0);
+invalid:
+	printf("mhi_lab_htc: invalid/unexpected control frame (pipe=%u length=%zu)\n",
+	    pipe, length);
+	return (EPROTO);
+}
+
+int
+mhi_lab_ce_reset_check(struct mhi_controller *ctrl, struct mhi_lab_ce *ce,
+    mhi_lab_ce_register access, void *arg)
+{
+	uint32_t value, misc;
+	unsigned int i;
+	int error;
+
+	if (!ce->touched)
+		return (0);
+	if (ctrl->lkpi_context == NULL || ctrl->lkpi_context->published) {
+		printf("mhi_lab_ce: SoC reset required before CE quiescence check\n");
+		return (EBUSY);
+	}
+	misc = wcn7850_regs.tcl1_ring_misc - wcn7850_regs.tcl1_ring_base_lsb;
+	for (i = 0; i < nitems(ce->ring); i++) {
+		error = access(arg, ce->ring[i].base + misc, &value, false);
+		if (error != 0 || (value & HAL_TCL1_RING_MISC_SRNG_ENABLE) != 0) {
+			printf("mhi_lab_ce: reset did not prove ring %u quiescent (error=%d)\n",
+			    i, error);
+			return (error != 0 ? error : EBUSY);
+		}
+	}
+	ce->touched = false;
+	return (0);
+}
+
+int
+mhi_lab_ce_free(struct mhi_controller *ctrl, struct mhi_lab_ce *ce)
+{
+	unsigned int i, j;
+	int error;
+
+	if (ce->touched) {
+		printf("mhi_lab_ce: CE reset confirmation required before DMA free\n");
+		return (EBUSY);
+	}
+	for (i = 0; i < nitems(ce->tx); i++) {
+		if (ce->tx[i].buffer.tag == NULL)
+			continue;
+		error = -linuxkpi_mhi_free_memory(ctrl, &ce->tx[i].buffer);
+		if (error != 0)
+			return (error);
+	}
+	for (i = 0; i < nitems(ce->rx); i++) {
+		if (ce->rx[i].buffers == NULL)
+			continue;
+		for (j = 0; j < ce->rx[i].count; j++) {
+			if (ce->rx[i].buffers[j].tag == NULL)
+				continue;
+			error = -linuxkpi_mhi_free_memory(ctrl, &ce->rx[i].buffers[j]);
+			if (error != 0)
+				return (error);
+		}
+		free(ce->rx[i].buffers, M_DEVBUF);
+		ce->rx[i].buffers = NULL;
+	}
+	for (i = nitems(ce->ring); i > 0; i--) {
+		if (ce->ring[i - 1].dma.tag == NULL)
+			continue;
+		error = -linuxkpi_mhi_free_memory(ctrl, &ce->ring[i - 1].dma);
+		if (error != 0)
+			return (error);
+	}
+	if (ce->rdp.tag != NULL) {
+		error = -linuxkpi_mhi_free_memory(ctrl, &ce->rdp);
+		if (error != 0)
+			return (error);
+	}
+	memset(ce, 0, sizeof(*ce));
+	return (0);
+}
diff --git a/sys/tests/linuxkpi_wlan/mhi_ce.h b/sys/tests/linuxkpi_wlan/mhi_ce.h
new file mode 100644
index 00000000000..18c9a20eb42
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_ce.h
@@ -0,0 +1,85 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#ifndef _MHI_LAB_CE_H_
+#define _MHI_LAB_CE_H_
+
+#include "linux_mhi.h"
+
+#define MHI_LAB_CE_RINGS 7
+#define MHI_LAB_CE_RX_PIPES 2
+
+enum mhi_lab_ce_kind {
+	MHI_LAB_CE_SEND,
+	MHI_LAB_CE_RECEIVE,
+	MHI_LAB_CE_STATUS
+};
+
+struct mhi_lab_ce_ring {
+	struct lkpi_mhi_dma dma;
+	uint32_t base, pointers, entries, entry_bytes, id;
+	enum mhi_lab_ce_kind kind;
+};
+
+struct mhi_lab_ce_rx {
+	struct lkpi_mhi_dma *buffers;
+	uint32_t count, next_buffer, write, tail;
+};
+
+struct mhi_lab_ce_tx {
+	struct lkpi_mhi_dma buffer;
+	uint32_t write, tail, packets;
+	bool busy;
+};
+
+struct mhi_lab_ce {
+	struct lkpi_mhi_dma rdp;
+	struct mhi_lab_ce_ring ring[MHI_LAB_CE_RINGS];
+	uint32_t shadow[MHI_LAB_CE_RINGS];
+	struct mhi_lab_ce_rx rx[MHI_LAB_CE_RX_PIPES];
+	struct mhi_lab_ce_tx tx[2];
+	unsigned int packets, poll_pipe;
+	int error;
+	bool allocated, initialized, touched, posted, polling;
+};
+
+struct mhi_lab_htc_service {
+	uint16_t id, max_message;
+	uint8_t endpoint;
+};
+
+struct mhi_lab_htc {
+	uint16_t credits, credit_size;
+	uint16_t pending_service;
+	struct mhi_lab_htc_service service[2];
+	uint8_t endpoints, version, bundle;
+	uint8_t sequence;
+	uint16_t wmi_credits;
+	bool ready, extended, setup;
+	int (*receive)(void *, uint16_t, const void *, size_t);
+	void *receive_arg;
+};
+
+typedef int (*mhi_lab_ce_register)(void *, uint32_t, uint32_t *, bool);
+/* Synchronous delivery: positive errno, no sleep/reentry/retained DMA pointer. */
+typedef int (*mhi_lab_ce_receive)(void *, unsigned int, const void *, size_t);
+
+int mhi_lab_ce_alloc(struct mhi_controller *, struct mhi_lab_ce *);
+int mhi_lab_ce_init(struct mhi_controller *, struct mhi_lab_ce *,
+    mhi_lab_ce_register, void *);
+int mhi_lab_ce_rx_alloc(struct mhi_controller *, struct mhi_lab_ce *);
+int mhi_lab_ce_tx_alloc(struct mhi_controller *, struct mhi_lab_ce *);
+int mhi_lab_ce_send(struct mhi_lab_ce *, mhi_lab_ce_register, void *,
+    unsigned int, uint16_t, const void *, size_t);
+int mhi_lab_ce_tx_poll(struct mhi_lab_ce *, unsigned int);
+int mhi_lab_ce_rx_post(struct mhi_lab_ce *, mhi_lab_ce_register, void *);
+int mhi_lab_ce_poll(struct mhi_lab_ce *, mhi_lab_ce_register, void *,
+    mhi_lab_ce_receive, void *, unsigned int, unsigned int *);
+int mhi_lab_htc_receive(void *, unsigned int, const void *, size_t);
+int mhi_lab_htc_connect(struct mhi_lab_htc *, uint16_t, uint8_t [16]);
+int mhi_lab_htc_setup(struct mhi_lab_htc *, uint8_t [20]);
+int mhi_lab_ce_reset_check(struct mhi_controller *, struct mhi_lab_ce *,
+    mhi_lab_ce_register, void *);
+int mhi_lab_ce_free(struct mhi_controller *, struct mhi_lab_ce *);
+
+#endif
diff --git a/sys/tests/linuxkpi_wlan/mhi_lifecycle_test.c b/sys/tests/linuxkpi_wlan/mhi_lifecycle_test.c
new file mode 100644
index 00000000000..5e580f2d7aa
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_lifecycle_test.c
@@ -0,0 +1,170 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <sys/param.h>
+#include <sys/bus.h>
+#include <sys/kernel.h>
+#include <sys/systm.h>
+
+#include <linux/device.h>
+#include <linux/dma-mapping.h>
+#include <linux/mhi.h>
+
+#include "linux_mhi.h"
+
+int linuxkpi_mhi_lifecycle_test(void);
+
+#define REQUIRE(expr) do {						\
+	if (!(expr)) {							\
+		printf("lkpi_mhi_lifecycle: line %d: %s failed\n",		\
+		    __LINE__, #expr);					\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+struct mhi_lifecycle_model {
+	uint32_t regs[0x200 / 4];
+	bool fail_read;
+};
+
+static int
+mhi_lifecycle_read(struct mhi_controller *ctrl, void *address, uint32_t *value)
+{
+	struct mhi_lifecycle_model *model = ctrl->cntrl_dev->driver_data;
+	uintptr_t offset = (uintptr_t)address - (uintptr_t)ctrl->regs;
+
+	if (model->fail_read || offset >= sizeof(model->regs) || (offset & 3))
+		return (-EIO);
+	*value = model->regs[offset / 4];
+	return (0);
+}
+
+static void
+mhi_lifecycle_write(struct mhi_controller *ctrl __unused,
+    void *address __unused, uint32_t value __unused)
+{
+	panic("MHI lifecycle guard tests must not write registers");
+}
+
+static int
+mhi_lifecycle_receive(void *arg __unused, const void *data __unused,
+    size_t length __unused)
+{
+	return (0);
+}
+
+static int
+mhi_lifecycle_get(struct mhi_controller *ctrl __unused)
+{
+	return (0);
+}
+
+static void
+mhi_lifecycle_put(struct mhi_controller *ctrl __unused)
+{
+}
+
+static void
+mhi_lifecycle_status(struct mhi_controller *ctrl __unused,
+    enum mhi_callback status __unused)
+{
+	panic("MHI guard tests must not announce mission mode");
+}
+
+/* No bus attachment, IRQ request, DMA allocation/publication, or MMIO. */
+int
+linuxkpi_mhi_lifecycle_test(void)
+{
+	struct mhi_lifecycle_model model = { 0 };
+	struct device device = { .driver_data = &model };
+	struct lkpi_mhi_context context = { 0 };
+	struct lkpi_mhi_runtime *runtime;
+	struct mhi_channel_config channels[2] = {
+		{ .num = 20, .num_elements = 64, .event_ring = 1,
+		  .dir = DMA_TO_DEVICE, .doorbell = MHI_DB_BRST_DISABLE },
+		{ .num = 21, .num_elements = 64, .event_ring = 1,
+		  .dir = DMA_FROM_DEVICE, .doorbell = MHI_DB_BRST_DISABLE },
+	};
+	struct mhi_event_config events[2] = {
+		{ .num_elements = 32, .irq = 1, .mode = MHI_DB_BRST_DISABLE,
+		  .data_type = MHI_ER_CTRL },
+		{ .num_elements = 256, .irq = 2, .mode = MHI_DB_BRST_DISABLE,
+		  .data_type = MHI_ER_DATA },
+	};
+	struct mhi_controller_config config = {
+		.max_channels = 128, .buf_len = 8192,
+		.num_channels = 2, .ch_cfg = channels,
+		.num_events = 2, .event_cfg = events,
+	};
+	int irqs[3] = { 101, 102, 102 };
+	struct mhi_controller ctrl = {
+		.cntrl_dev = &device, .regs = model.regs,
+		.reg_len = sizeof(model.regs), .nr_irqs = 3, .irq = irqs,
+		.read_reg = mhi_lifecycle_read, .write_reg = mhi_lifecycle_write,
+		.runtime_get = mhi_lifecycle_get, .runtime_put = mhi_lifecycle_put,
+		.status_cb = mhi_lifecycle_status,
+	};
+	int error = 0;
+
+	mtx_init(&context.lock, "MHI lifecycle test", NULL, MTX_DEF);
+	REQUIRE(mhi_register_controller(&ctrl, &config) == -EOPNOTSUPP);
+	REQUIRE(ctrl.lkpi_runtime == NULL);
+	irqs[2] = 103;
+	REQUIRE(mhi_register_controller(&ctrl, &config) == 0);
+	runtime = ctrl.lkpi_runtime;
+	REQUIRE(mhi_register_controller(&ctrl, &config) == -EINVAL);
+	REQUIRE(linuxkpi_mhi_set_receive(&ctrl, mhi_lifecycle_receive, &model) == 0);
+	REQUIRE(runtime->receive_arg == &model);
+	REQUIRE(linuxkpi_mhi_set_receive(&ctrl, NULL, NULL) == 0);
+	ctrl.lkpi_context = &context;
+	REQUIRE(!linuxkpi_mhi_dma_owned(&ctrl));
+	context.published = true;
+	REQUIRE(linuxkpi_mhi_dma_owned(&ctrl));
+	REQUIRE(linuxkpi_mhi_set_receive(&ctrl, mhi_lifecycle_receive, NULL) ==
+	    -EBUSY);
+	context.published = false;
+	runtime->boot.pending = true;
+	REQUIRE(linuxkpi_mhi_dma_owned(&ctrl));
+	linuxkpi_mhi_unprepare(&ctrl);
+	REQUIRE(ctrl.lkpi_context == &context && runtime->boot.pending);
+	runtime->prepared = true;
+	REQUIRE(mhi_sync_power_up(&ctrl) == -ENXIO);
+	runtime->boot.pending = false;
+	REQUIRE(linuxkpi_mhi_set_receive(&ctrl, mhi_lifecycle_receive, &model) == 0);
+	REQUIRE(context.receive_arg == &model);
+	REQUIRE(linuxkpi_mhi_set_receive(&ctrl, mhi_lifecycle_receive, NULL) ==
+	    -EBUSY);
+	runtime->boot.pending = true;
+	REQUIRE(mhi_sync_power_up(&ctrl) == -EBUSY);
+	REQUIRE(linuxkpi_mhi_start_transport(&ctrl) == -ENXIO);
+	REQUIRE(linuxkpi_mhi_reset_complete(&ctrl) == -EBUSY);
+	linuxkpi_mhi_power_down(&ctrl);
+	REQUIRE(context.quiescing && runtime->boot.pending);
+	REQUIRE(linuxkpi_mhi_reset_complete(&ctrl) == -EIO);
+	REQUIRE(runtime->boot.pending);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+	model.fail_read = true;
+	REQUIRE(linuxkpi_mhi_reset_complete(&ctrl) == -EIO);
+	REQUIRE(runtime->boot.pending);
+	model.fail_read = false;
+	runtime->powered = runtime->transport_started = true;
+	context.published = true;
+	REQUIRE(linuxkpi_mhi_reset_complete(&ctrl) == 0);
+	REQUIRE(!linuxkpi_mhi_dma_owned(&ctrl));
+	REQUIRE(!runtime->powered && !runtime->transport_started);
+	REQUIRE(linuxkpi_mhi_set_receive(&ctrl, NULL, NULL) == 0);
+	REQUIRE(context.receive == NULL && runtime->receive == NULL);
+	REQUIRE(mhi_pm_suspend(&ctrl) == -EOPNOTSUPP);
+	REQUIRE(mhi_async_power_up(&ctrl) == -EOPNOTSUPP);
+out:
+	/* The context is stack-owned and contains no DMA or IRQ resources. */
+	ctrl.lkpi_context = NULL;
+	if (ctrl.lkpi_runtime != NULL) {
+		ctrl.lkpi_runtime->boot.pending = false;
+		ctrl.lkpi_runtime->prepared = false;
+		mhi_unregister_controller(&ctrl);
+	}
+	mtx_destroy(&context.lock);
+	return (error);
+}
diff --git a/sys/tests/linuxkpi_wlan/mhi_qmi.c b/sys/tests/linuxkpi_wlan/mhi_qmi.c
new file mode 100644
index 00000000000..ade2660f42b
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_qmi.c
@@ -0,0 +1,693 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+
+#include "ce_config.h"
+#include "mhi_qmi.h"
+
+CTASSERT(offsetof(struct ce_pipe_config, reserved) == 20);
+CTASSERT(sizeof(struct service_to_pipe) == 12);
+
+static void
+mhi_qrtr_header(uint8_t *packet, uint32_t type, uint32_t length,
+    const struct mhi_lab_qmi *client)
+{
+	le32enc(packet, 1);
+	le32enc(packet + 4, type);
+	le32enc(packet + 8, 1);
+	le32enc(packet + 12, 0x4000);
+	le32enc(packet + 20, length);
+	le32enc(packet + 24, client->node);
+	le32enc(packet + 28, client->port);
+}
+
+static void
+mhi_qmi_tlv(uint8_t *body, size_t *length, uint8_t type, uint64_t value,
+    size_t width)
+{
+	uint8_t encoded[8];
+
+	body[*length] = type;
+	le16enc(body + *length + 1, width);
+	le64enc(encoded, value);
+	memcpy(body + *length + 3, encoded, width);
+	*length += 3 + width;
+}
+
+int
+mhi_lab_qmi_build(struct mhi_lab_qmi *client, uint8_t *packet, size_t capacity,
+    uint16_t transaction, uint16_t message, size_t *length)
+{
+	uint8_t *body;
+	struct mhi_lab_mem *mem;
+	size_t size = 0, required, total, chunk = 0;
+	unsigned int i;
+
+	if (!client->service || client->pending || transaction == 0) {
+		printf("mhi_lab_qmi: request unavailable\n");
+		return (EBUSY);
+	}
+	switch (message) {
+	case 0x57:
+	case 0x24:
+		required = 0;
+		break;
+	case 0x20:
+		required = client->configure ? 19 : 15;
+		break;
+	case 0x34:
+		required = 42;
+		break;
+	case 0x36:
+		if (client->memory_count > MHI_LAB_MEM_MAX)
+			goto unavailable;
+		required = 4 + 17 * client->memory_count;
+		break;
+	case 0x25:
+		if (!client->configure || !client->target_ready ||
+		    client->download_data == NULL || client->download_remaining == 0 ||
+		    client->download_remaining > MHI_LAB_BOARD_LIMIT ||
+		    (client->download_type != 0 && client->download_type != 1 &&
+		    client->download_type != 4) ||
+		    (client->download_type != 4 && !client->regdb_loaded))
+			goto unavailable;
+		chunk = MIN(client->download_remaining, MHI_LAB_BDF_CHUNK);
+		required = 38 + chunk;
+		break;
+	case 0x3c:
+		if (!client->configure || !client->board_loaded ||
+		    client->m3_published || client->m3_address == 0 ||
+		    (client->m3_address & 65535) != 0 ||
+		    client->m3_address > UINT32_MAX || client->m3_size == 0 ||
+		    client->m3_size > MHI_LAB_M3_LIMIT ||
+		    client->m3_size - 1 > UINT32_MAX - client->m3_address)
+			goto unavailable;
+		required = 18;
+		break;
+	case 0x2f:
+		if (!client->control || !client->configure || !client->fw_ready ||
+		    !client->m3_accepted || client->ini_accepted)
+			goto unavailable;
+		required = 4;
+		break;
+	case 0x23:
+		if (!client->control || !client->configure || !client->fw_ready ||
+		    !client->m3_accepted || !client->ini_accepted ||
+		    client->ce_accepted || client->shadow_count > MHI_LAB_SHADOW_MAX)
+			goto unavailable;
+		for (i = 0; i < client->shadow_count; i++)
+			if (client->shadow[i] == 0 || (client->shadow[i] & 3) != 0)
+				goto unavailable;
+		required = 6 + 4 + 20 * ATH12K_WCN7850_TARGET_CE_COUNT +
+		    4 + 12 * ATH12K_WCN7850_SERVICE_COUNT;
+		if (client->shadow_count != 0)
+			required += 4 + 4 * client->shadow_count;
+		break;
+	case 0x22:
+		if (!client->start || !client->control || !client->configure ||
+		    !client->fw_ready || !client->m3_accepted ||
+		    !client->ini_accepted || !client->ce_accepted ||
+		    client->mode_accepted)
+			goto unavailable;
+		required = 11;
+		break;
+	default:
+		printf("mhi_lab_qmi: unsupported request %#x\n", message);
+		return (EOPNOTSUPP);
+	}
+	total = roundup2(39 + required, 4);
+	if (total > capacity) {
+		printf("mhi_lab_qmi: request buffer too small\n");
+		return (EMSGSIZE);
+	}
+	memset(packet, 0, total);
+	body = packet + 39;
+	switch (message) {
+	case 0x57:
+		break;
+	case 0x20:
+		/* Subscribe only to the memory indications handled by this lab. */
+		mhi_qmi_tlv(body, &size, 0x15, 0x4b4e454c, 4);
+		mhi_qmi_tlv(body, &size, 0x16, 1, 1);
+		mhi_qmi_tlv(body, &size, 0x17, 1, 1);
+		if (client->configure)
+			mhi_qmi_tlv(body, &size, 0x18, 1, 1);
+		break;
+	case 0x34:
+		if (!client->registered || client->host_sent)
+			goto unavailable;
+		mhi_qmi_tlv(body, &size, 0x10, 1, 4);
+		mhi_qmi_tlv(body, &size, 0x13, 0x0e, 1);
+		mhi_qmi_tlv(body, &size, 0x14, 1, 1);
+		mhi_qmi_tlv(body, &size, 0x16, 1, 1);
+		mhi_qmi_tlv(body, &size, 0x17, 1, 1);
+		mhi_qmi_tlv(body, &size, 0x1a, 0, 1);
+		mhi_qmi_tlv(body, &size, 0x1c, 0, 1);
+		mhi_qmi_tlv(body, &size, 0x27, 0x18, 8);
+		break;
+	case 0x36:
+		if (!client->host_accepted || !client->mem_requested ||
+		    client->mem_published || client->memory_count == 0 ||
+		    client->memory_count > MHI_LAB_MEM_MAX)
+			goto unavailable;
+		body[0] = 1;
+		le16enc(body + 1, 1 + 17 * client->memory_count);
+		body[3] = client->memory_count;
+		size = 4;
+		for (i = 0; i < client->memory_count; i++) {
+			mem = &client->memory[i];
+			if (mem->address == 0 || (mem->address & 65535) != 0 ||
+			    mem->address > UINT32_MAX || mem->size == 0 ||
+			    mem->size - 1 > UINT32_MAX - mem->address) {
+				printf("mhi_lab_qmi: invalid memory response segment %u\n", i);
+				return (ERANGE);
+			}
+			le64enc(body + size, mem->address);
+			le32enc(body + size + 8, mem->size);
+			le32enc(body + size + 12, mem->type);
+			body[size + 16] = 0;
+			size += 17;
+		}
+		break;
+	case 0x24:
+		if (!client->mem_ready)
+			goto unavailable;
+		break;
+	case 0x25:
+		mhi_qmi_tlv(body, &size, 1, 1, 1);
+		mhi_qmi_tlv(body, &size, 0x10, client->board, 4);
+		mhi_qmi_tlv(body, &size, 0x11, client->download_remaining, 4);
+		mhi_qmi_tlv(body, &size, 0x12, client->download_segment, 4);
+		body[size] = 0x13;
+		le16enc(body + size + 1, chunk + 2);
+		le16enc(body + size + 3, chunk);
+		memcpy(body + size + 5, client->download_data, chunk);
+		size += 5 + chunk;
+		mhi_qmi_tlv(body, &size, 0x14,
+		    chunk == client->download_remaining, 1);
+		mhi_qmi_tlv(body, &size, 0x15, client->download_type, 1);
+		break;
+	case 0x3c:
+		mhi_qmi_tlv(body, &size, 1, client->m3_address, 8);
+		mhi_qmi_tlv(body, &size, 2, client->m3_size, 4);
+		break;
+	case 0x2f:
+		mhi_qmi_tlv(body, &size, 0x10, 1, 1);
+		break;
+	case 0x22:
+		/* Normal firmware mode, with hardware debugging disabled. */
+		mhi_qmi_tlv(body, &size, 1, 0, 4);
+		mhi_qmi_tlv(body, &size, 0x10, 0, 1);
+		break;
+	case 0x23:
+		body[0] = 0x10;
+		le16enc(body + 1, 3);
+		memcpy(body + 3, "WIN", 3);
+		size = 6;
+		body[size] = 0x11;
+		le16enc(body + size + 1, 1 + 20 * ATH12K_WCN7850_TARGET_CE_COUNT);
+		body[size + 3] = ATH12K_WCN7850_TARGET_CE_COUNT;
+		size += 4;
+		/* QMI omits the source table's reserved word. */
+		for (i = 0; i < ATH12K_WCN7850_TARGET_CE_COUNT; i++) {
+			memcpy(body + size,
+			    &ath12k_wifi7_target_ce_config_wlan_wcn7850[i], 20);
+			size += 20;
+		}
+		body[size] = 0x12;
+		le16enc(body + size + 1, 1 + 12 * ATH12K_WCN7850_SERVICE_COUNT);
+		body[size + 3] = ATH12K_WCN7850_SERVICE_COUNT;
+		size += 4;
+		for (i = 0; i < ATH12K_WCN7850_SERVICE_COUNT; i++) {
+			memcpy(body + size,
+			    &ath12k_wifi7_target_service_to_ce_map_wlan_wcn7850[i],
+			    12);
+			size += 12;
+		}
+		if (client->shadow_count != 0) {
+			body[size] = 0x17;
+			le16enc(body + size + 1, 1 + 4 * client->shadow_count);
+			body[size + 3] = client->shadow_count;
+			size += 4;
+			for (i = 0; i < client->shadow_count; i++) {
+				le32enc(body + size, client->shadow[i]);
+				size += 4;
+			}
+		}
+		break;
+	default:
+		printf("mhi_lab_qmi: unsupported request %#x\n", message);
+		return (EOPNOTSUPP);
+	}
+	KASSERT(size == required, ("QMI encoded size mismatch"));
+	mhi_qrtr_header(packet, 1, 7 + size, client);
+	le16enc(packet + 33, transaction);
+	le16enc(packet + 35, message);
+	le16enc(packet + 37, size);
+	client->transaction = transaction;
+	client->message = message;
+	client->pending = true;
+	client->done = false;
+	client->valid = 0;
+	client->result = client->error = client->response_length = 0;
+	if (message == 0x34)
+		client->host_sent = true;
+	if (message == 0x36)
+		client->mem_published = true;
+	if (message == 0x25 && client->download_type != 4 &&
+	    chunk == client->download_remaining)
+		client->board_sent = true;
+	if (message == 0x3c)
+		client->m3_published = true;
+	*length = total;
+	return (0);
+unavailable:
+	printf("mhi_lab_qmi: request %#x invalid in current initialization state\n",
+	    message);
+	return (EPROTO);
+}
+
+int
+mhi_lab_qmi_request(struct mhi_lab_qmi *client, uint8_t packet[40],
+    uint16_t transaction)
+{
+	size_t length;
+
+	return (mhi_lab_qmi_build(client, packet, 40, transaction, 0x57, &length));
+}
+
+int
+mhi_lab_qmi_resume(struct mhi_lab_qmi *client, uint8_t packet[52])
+{
+	if (!client->resume || !client->service) {
+		printf("mhi_lab_qmi: no flow-control acknowledgement pending\n");
+		return (EINVAL);
+	}
+	memset(packet, 0, 52);
+	mhi_qrtr_header(packet, 7, 20, client);
+	le32enc(packet + 32, 7);
+	le32enc(packet + 36, 1);
+	le32enc(packet + 40, 0x4000);
+	client->resume = false;
+	return (0);
+}
+
+static int
+mhi_qmi_response(struct mhi_lab_qmi *client, const uint8_t *data, size_t size)
+{
+	struct mhi_lab_dev_mem dev_mem[MHI_LAB_DEV_MEM_MAX] = { 0 };
+	uint8_t seen[32] = { 0 };
+	uint8_t type;
+	size_t length, offset = 7;
+	unsigned int i;
+	bool dev_mem_valid = false;
+
+	if (size < 7 || !client->pending || data[0] != 2 ||
+	    le16dec(data + 1) != client->transaction ||
+	    le16dec(data + 3) != client->message ||
+	    le16dec(data + 5) != size - 7)
+		return (EPROTO);
+	while (offset < size) {
+		if (size - offset < 3)
+			return (EPROTO);
+		type = data[offset];
+		length = le16dec(data + offset + 1);
+		offset += 3;
+		if (length > size - offset || (seen[type / 8] & (1U << (type % 8))))
+			return (EPROTO);
+		seen[type / 8] |= 1U << (type % 8);
+		if (type == 2) {
+			if (length != 4)
+				return (EPROTO);
+			client->result = le16dec(data + offset);
+			client->error = le16dec(data + offset + 2);
+		} else if (type < 0x10)
+			return (EOPNOTSUPP);
+		else if (client->message == 0x57) {
+			switch (type) {
+			case 0x10:
+			case 0x13:
+				if (length != 1)
+					return (EPROTO);
+				if (type == 0x10)
+					client->phys = data[offset];
+				else
+					client->mlo = data[offset];
+				client->valid |= type == 0x10 ? 1 : 4;
+				break;
+			case 0x11:
+				if (length != 4)
+					return (EPROTO);
+				client->board = le32dec(data + offset);
+				client->valid |= 2;
+				break;
+			}
+		} else if (client->message == 0x20 && type == 0x10) {
+			if (length != 8)
+				return (EPROTO);
+			client->fw_status = le64dec(data + offset);
+		} else if (client->message == 0x24) {
+			switch (type) {
+			case 0x10:
+				if (length != 8)
+					return (EPROTO);
+				client->chip = le32dec(data + offset);
+				client->family = le32dec(data + offset + 4);
+				client->valid |= 1;
+				break;
+			case 0x11:
+			case 0x12:
+				if (length != 4)
+					return (EPROTO);
+				if (type == 0x11)
+					client->board = le32dec(data + offset);
+				else
+					client->soc = le32dec(data + offset);
+				client->valid |= type == 0x11 ? 2 : 4;
+				break;
+			case 0x13:
+				if (length < 5 || data[offset + 4] > 32 ||
+				    length != 5 + data[offset + 4])
+					return (EPROTO);
+				client->firmware = le32dec(data + offset);
+				client->valid |= 8;
+				break;
+			case 0x1c:
+				if (length != MHI_LAB_DEV_MEM_MAX * 16)
+					return (EPROTO);
+				for (i = 0; i < MHI_LAB_DEV_MEM_MAX; i++) {
+					dev_mem[i].start =
+					    le64dec(data + offset + i * 16);
+					dev_mem[i].size =
+					    le64dec(data + offset + i * 16 + 8);
+					if (dev_mem[i].size >
+					    UINT64_MAX - dev_mem[i].start)
+						return (EPROTO);
+				}
+				dev_mem_valid = true;
+				break;
+			}
+		}
+		offset += length;
+	}
+	if ((seen[0] & (1U << 2)) == 0)
+		return (EPROTO);
+	client->response_length = size;
+	client->pending = false;
+	client->done = true;
+	if (client->result == 0 && client->error == 0) {
+		if (client->message == 0x20)
+			client->registered = true;
+		if (client->message == 0x34)
+			client->host_accepted = true;
+		if (client->message == 0x3c)
+			client->m3_accepted = true;
+		if (client->message == 0x2f)
+			client->ini_accepted = true;
+		if (client->message == 0x23)
+			client->ce_accepted = true;
+		if (client->message == 0x22)
+			client->mode_accepted = true;
+		if (client->message == 0x24) {
+			memcpy(client->dev_mem, dev_mem, sizeof(dev_mem));
+			client->dev_mem_valid = dev_mem_valid;
+			/* Linux and OpenBSD use 0xff when firmware omits board ID. */
+			if ((client->valid & 2) == 0)
+				client->board = 0xff;
+			client->target_ready = true;
+		}
+		if (client->message == 0x25 &&
+		    client->download_remaining <= MHI_LAB_BDF_CHUNK) {
+			if (client->download_type == 4)
+				client->regdb_loaded = true;
+			else
+				client->board_loaded = true;
+		}
+	}
+	return (0);
+}
+
+static int
+mhi_qmi_memory(struct mhi_lab_qmi *client, const uint8_t *data, size_t size)
+{
+	struct mhi_lab_mem memory[MHI_LAB_MEM_MAX] = { 0 };
+	size_t offset = 1;
+	uint64_t start;
+	uint32_t bytes, total = 0;
+	unsigned int i, j, configs, count;
+
+	if (!client->host_sent || client->mem_requested || size == 0)
+		return (EPROTO);
+	count = data[0];
+	if (count == 0 || count > MHI_LAB_MEM_MAX)
+		return (EPROTO);
+	for (i = 0; i < count; i++) {
+		if (size - offset < 9)
+			return (EPROTO);
+		memory[i].size = le32dec(data + offset);
+		memory[i].type = le32dec(data + offset + 4);
+		configs = data[offset + 8];
+		offset += 9;
+		if (memory[i].size == 0 ||
+		    memory[i].size > MHI_LAB_MEM_SEG_LIMIT ||
+		    memory[i].size > MHI_LAB_MEM_TOTAL_LIMIT - total ||
+		    configs > 2 || size - offset < 13 * configs)
+			return (EPROTO);
+		switch (memory[i].type) {
+		case 1:	/* Host DDR. */
+		case 2:	/* Board data. */
+		case 3:	/* M3 dump. */
+		case 4:	/* Calibration database. */
+		case 9:	/* Pageable firmware memory. */
+		case 11: /* LPASS shared memory. */
+			break;
+		default:
+			printf("mhi_lab_qmi: unsupported firmware memory type %u\n",
+			    memory[i].type);
+			return (EOPNOTSUPP);
+		}
+		for (j = 0; j < configs; j++) {
+			start = le64dec(data + offset);
+			bytes = le32dec(data + offset + 8);
+			if (start > memory[i].size || bytes > memory[i].size - start)
+				return (EPROTO);
+			if (data[offset + 12] != 0) {
+				printf("mhi_lab_qmi: secure firmware memory unsupported\n");
+				return (EOPNOTSUPP);
+			}
+			offset += 13;
+		}
+		total += memory[i].size;
+	}
+	if (offset != size)
+		return (EPROTO);
+	memcpy(client->memory, memory, sizeof(memory));
+	client->memory_count = count;
+	client->memory_total = total;
+	client->mem_requested = true;
+	return (0);
+}
+
+static int
+mhi_qmi_indication(struct mhi_lab_qmi *client, const uint8_t *data, size_t size)
+{
+	const uint8_t *memory = NULL;
+	uint8_t seen[32] = { 0 }, type;
+	size_t length, memory_length = 0, offset;
+
+	if (size < 7 || le16dec(data + 5) != size - 7)
+		return (EPROTO);
+	switch (le16dec(data + 3)) {
+	case 0x35:
+		offset = 7;
+		while (offset < size) {
+			if (size - offset < 3)
+				return (EPROTO);
+			length = le16dec(data + offset + 1);
+			type = data[offset];
+			if (length > size - offset - 3 ||
+			    (seen[type / 8] & (1U << (type % 8))))
+				return (EPROTO);
+			seen[type / 8] |= 1U << (type % 8);
+			if (type == 1) {
+				memory = data + offset + 3;
+				memory_length = length;
+			} else if (type < 0x10)
+				return (EOPNOTSUPP);
+			offset += 3 + length;
+		}
+		return (memory != NULL ?
+		    mhi_qmi_memory(client, memory, memory_length) : EPROTO);
+	case 0x37:
+		if (size != 7 || !client->mem_published || client->mem_ready)
+			return (EPROTO);
+		client->mem_ready = true;
+		return (0);
+	case 0x38:
+		if (size != 7 || !client->configure || !client->board_sent ||
+		    client->fw_ready)
+			return (EPROTO);
+		client->fw_ready = true;
+		return (0);
+	default:
+		return (EPROTO);
+	}
+}
+
+int
+mhi_lab_board_find(const void *buffer, size_t size, uint32_t kind,
+    const char *name, const uint8_t **result, size_t *result_size)
+{
+	static const char magic[] = "QCA-ATH12K-BOARD";
+	const uint8_t *data = buffer, *candidate = NULL, *entry;
+	size_t offset = roundup2(sizeof(magic), 4), length, padded, sub;
+	size_t entry_size, name_size = strlen(name), candidate_size = 0;
+	uint32_t id;
+	bool match;
+
+	*result = NULL;
+	*result_size = 0;
+	if (size < offset || memcmp(data, magic, sizeof(magic)) != 0 ||
+	    kind > 1 || name_size == 0)
+		return (EPROTO);
+	while (offset < size) {
+		if (size - offset < 8)
+			return (EPROTO);
+		id = le32dec(data + offset);
+		length = le32dec(data + offset + 4);
+		offset += 8;
+		if (length > SIZE_MAX - 3)
+			return (EPROTO);
+		padded = roundup2(length, 4);
+		if (padded > size - offset)
+			return (EPROTO);
+		if (id == kind) {
+			entry = data + offset;
+			sub = 0;
+			match = false;
+			while (sub < length) {
+				if (length - sub < 8)
+					return (EPROTO);
+				id = le32dec(entry + sub);
+				entry_size = le32dec(entry + sub + 4);
+				sub += 8;
+				if (entry_size > SIZE_MAX - 3 ||
+				    roundup2(entry_size, 4) > length - sub)
+					return (EPROTO);
+				if (id == 0 && entry_size == name_size &&
+				    memcmp(entry + sub, name, name_size) == 0)
+					match = true;
+				else if (id == 1 && match) {
+					if (entry_size == 0 || entry_size > MHI_LAB_BOARD_LIMIT)
+						return (EPROTO);
+					if (candidate != NULL)
+						return (EEXIST);
+					candidate = entry + sub;
+					candidate_size = entry_size;
+				}
+				sub += roundup2(entry_size, 4);
+			}
+		}
+		offset += padded;
+	}
+	if (candidate == NULL)
+		return (ENOENT);
+	*result = candidate;
+	*result_size = candidate_size;
+	return (0);
+}
+
+static int
+mhi_qrtr_receive(struct mhi_lab_qmi *client, const uint8_t *data, size_t length)
+{
+	const uint8_t *payload;
+	uint32_t type, size, src_node, src_port, dst_node, dst_port, confirm;
+	size_t header;
+	int error;
+
+	if (length >= 32 && le32dec(data) == 1) {
+		header = 32;
+		type = le32dec(data + 4);
+		src_node = le32dec(data + 8);
+		src_port = le32dec(data + 12);
+		confirm = le32dec(data + 16);
+		size = le32dec(data + 20);
+		dst_node = le32dec(data + 24);
+		dst_port = le32dec(data + 28);
+	} else if (length >= 16 && data[0] == 3 && data[3] == 0) {
+		header = 16;
+		type = data[1];
+		confirm = data[2] & 1;
+		size = le32dec(data + 4);
+		src_node = le16dec(data + 8);
+		src_port = le16dec(data + 10);
+		dst_node = le16dec(data + 12);
+		dst_port = le16dec(data + 14);
+	} else
+		return (EPROTONOSUPPORT);
+	if (size > length - header || (length != header + size &&
+	    length != roundup2(header + size, 4)))
+		return (EPROTO);
+	payload = data + header;
+	switch (type) {
+	case 2:
+		if (size != 20 || le32dec(payload) != type)
+			return (EPROTO);
+		client->hellos++;
+		return (0);
+	case 4:
+	case 5:
+		if (size != 20 || le32dec(payload) != type)
+			return (EPROTO);
+		if (le32dec(payload + 4) != 0x45 ||
+		    le32dec(payload + 8) != 0x101)
+			return (0);
+		if (le32dec(payload + 12) != src_node ||
+		    le32dec(payload + 16) == 0 ||
+		    le32dec(payload + 16) >= 0xfffffffeU)
+			return (EPROTO);
+		if (client->service && (client->node != le32dec(payload + 12) ||
+		    client->port != le32dec(payload + 16)))
+			return (EPROTO);
+		if (type == 5) {
+			client->service = false;
+			return (ENXIO);
+		}
+		client->node = le32dec(payload + 12);
+		client->port = le32dec(payload + 16);
+		client->instance = le32dec(payload + 8);
+		client->service = true;
+		client->advertisements++;
+		return (0);
+	case 1:
+		if (!client->service || src_node != client->node ||
+		    src_port != client->port || dst_node != 1 || dst_port != 0x4000)
+			return (EPROTO);
+		if (size < 7)
+			return (EPROTO);
+		error = payload[0] == 4 ?
+		    mhi_qmi_indication(client, payload, size) :
+		    mhi_qmi_response(client, payload, size);
+		if (error == 0 && confirm != 0)
+			client->resume = true;
+		return (error);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+
+int
+mhi_lab_qmi_receive(void *arg, const void *data, size_t length)
+{
+	int error;
+
+	error = mhi_qrtr_receive(arg, data, length);
+	if (error != 0)
+		printf("mhi_lab_qmi: receive rejected: %d (bytes=%zu)\n",
+		    error, length);
+	return (error);
+}
diff --git a/sys/tests/linuxkpi_wlan/mhi_qmi.h b/sys/tests/linuxkpi_wlan/mhi_qmi.h
new file mode 100644
index 00000000000..bd799679d23
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_qmi.h
@@ -0,0 +1,61 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#ifndef _MHI_LAB_QMI_H_
+#define _MHI_LAB_QMI_H_
+
+#define MHI_LAB_MEM_MAX	52
+#define MHI_LAB_MEM_SEG_LIMIT	(64U * 1024 * 1024)
+#define MHI_LAB_MEM_TOTAL_LIMIT	(128U * 1024 * 1024)
+#define MHI_LAB_QMI_PACKET_MAX	8192
+#define MHI_LAB_BDF_CHUNK	6144
+#define MHI_LAB_BOARD_LIMIT	(256U * 1024)
+#define MHI_LAB_M3_LIMIT	(1024U * 1024)
+#define MHI_LAB_SHADOW_MAX 60
+#define MHI_LAB_DEV_MEM_MAX 4
+
+struct mhi_lab_dev_mem {
+	uint64_t start, size;
+};
+
+struct mhi_lab_mem {
+	uint64_t address;
+	uint32_t size, type;
+};
+
+/* Serialized by the MHI context lock, including the receive callback. */
+struct mhi_lab_qmi {
+	uint32_t node, port, instance, hellos, advertisements;
+	uint32_t board;
+	uint16_t transaction, result, error, response_length;
+	uint8_t valid, phys, mlo;
+	uint16_t message;
+	uint64_t fw_status;
+	uint32_t chip, family, soc, firmware, memory_count, memory_total;
+	struct mhi_lab_mem memory[MHI_LAB_MEM_MAX];
+	struct mhi_lab_dev_mem dev_mem[MHI_LAB_DEV_MEM_MAX];
+	bool dev_mem_valid;
+	bool service, pending, done, resume;
+	bool registered, host_sent, host_accepted, mem_requested, mem_published;
+	bool mem_ready;
+	bool configure, target_ready, regdb_loaded, board_loaded, board_sent;
+	bool m3_published, m3_accepted, fw_ready;
+	bool control, ini_accepted, ce_accepted;
+	bool start, mode_accepted;
+	uint8_t shadow_count;
+	uint32_t shadow[MHI_LAB_SHADOW_MAX];
+	const uint8_t *download_data;
+	uint32_t download_remaining, download_segment, m3_size;
+	uint64_t m3_address;
+	uint8_t download_type;
+};
+
+int mhi_lab_qmi_receive(void *, const void *, size_t);
+int mhi_lab_qmi_request(struct mhi_lab_qmi *, uint8_t [40], uint16_t);
+int mhi_lab_qmi_resume(struct mhi_lab_qmi *, uint8_t [52]);
+int mhi_lab_qmi_build(struct mhi_lab_qmi *, uint8_t *, size_t, uint16_t,
+    uint16_t, size_t *);
+int mhi_lab_board_find(const void *, size_t, uint32_t, const char *,
+    const uint8_t **, size_t *);
+
+#endif
diff --git a/sys/tests/linuxkpi_wlan/mhi_test.c b/sys/tests/linuxkpi_wlan/mhi_test.c
new file mode 100644
index 00000000000..9219ffdaa55
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_test.c
@@ -0,0 +1,1958 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <sys/param.h>
+#include <sys/bus.h>
+#include <sys/endian.h>
+#include <sys/kernel.h>
+#include <sys/malloc.h>
+#include <sys/module.h>
+#include <sys/systm.h>
+#include <sys/time.h>
+
+#include <dev/pci/pcivar.h>
+#include <linux/device.h>
+#include <linux/mhi.h>
+
+#include "linux_mhi.h"
+#include "mhi_ce.h"
+#include "htc.h"
+#include "core.h"
+#include "mhi_qmi.h"
+#include "mhi_wmi.h"
+#include "wifi7/mhi.h"
+
+int linuxkpi_mhi_lifecycle_test(void);
+int ath12k_wmi_protocol_test(void);
+
+#define CHECK(condition) do {						\
+	if (!(condition)) {						\
+		printf("lkpi_mhi_test: line %d: %s failed\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+static bool
+check_buffer(struct lkpi_mhi_dma *buffer, size_t alignment, bool zero)
+{
+	const uint8_t *bytes = buffer->vaddr;
+	size_t i;
+
+	if (buffer->vaddr == NULL || !buffer->loaded || !buffer->synced ||
+	    (buffer->address & (alignment - 1)) != 0 ||
+	    ((uintptr_t)buffer->vaddr & (MIN(alignment, PAGE_SIZE) - 1)) != 0 ||
+	    buffer->address > BUS_SPACE_MAXADDR_32BIT ||
+	    buffer->size - 1 > BUS_SPACE_MAXADDR_32BIT - buffer->address)
+		return (false);
+	bus_dmamap_sync(buffer->tag, buffer->map,
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	buffer->synced = false;
+	if (zero)
+		for (i = 0; i < buffer->size; i++)
+			if (bytes[i] != 0)
+				return (false);
+	return (true);
+}
+
+#define MHI_MODEL_REG_LEN	0xfe0
+
+struct mhi_boot_model {
+	uint32_t *regs;
+	uint32_t offsets[128], values[128], reply, bhie_reply;
+	unsigned int writes;
+	bool fail_read, hold_ee, hold_ee_event, ee_event_sent, reply_m3;
+};
+
+static int
+mhi_model_read(struct mhi_controller *ctrl, void *address, uint32_t *value)
+{
+	struct mhi_boot_model *model = ctrl->cntrl_dev->driver_data;
+	struct lkpi_mhi_context *context = ctrl->lkpi_context;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_event_ring *event;
+	struct lkpi_mhi_tre *tre;
+	uintptr_t offset = (uintptr_t)address - (uintptr_t)ctrl->regs;
+
+	if (model->fail_read || offset >= MHI_MODEL_REG_LEN)
+		return (-EIO);
+	*value = model->regs[offset / 4];
+	/* Publish after the boot wait has polled events, before its EE read. */
+	if (offset == 0x128 && *value == 2 && context != NULL &&
+	    context->published && !model->hold_ee_event &&
+	    !model->ee_event_sent) {
+		event = &context->event_rings[0];
+		if (!check_buffer(&context->events, 64, false) ||
+		    !check_buffer(&event->dma, event->dma.size, false))
+			return (-EIO);
+		events = context->events.vaddr;
+		tre = event->dma.vaddr;
+		tre[0].dword[0] = htole32(2U << 24);
+		tre[0].dword[1] = htole32(0x20U << 16);
+		tre[1].dword[0] = htole32(2U << 24);
+		tre[1].dword[1] = htole32(0x40U << 16);
+		events[0].rp = htole64(event->dma.address + 32);
+		model->ee_event_sent = true;
+	}
+	return (0);
+}
+
+static void
+mhi_model_write(struct mhi_controller *ctrl, void *address, uint32_t value)
+{
+	struct mhi_boot_model *model = ctrl->cntrl_dev->driver_data;
+	uintptr_t offset = (uintptr_t)address - (uintptr_t)ctrl->regs;
+
+	KASSERT(model->writes < nitems(model->offsets), ("extra BHI write"));
+	model->offsets[model->writes] = offset;
+	model->values[model->writes++] = value;
+	model->regs[offset / 4] = value;
+	if (offset == 0x118)
+		model->regs[0x12c / 4] = model->reply;
+	if (offset == LKPI_MHI_CTRL && (value & 0xff00) == 0x200)
+		model->regs[LKPI_MHI_STATUS / 4] = 0x200;
+	if (offset == LKPI_MHI_CTRL && (value & 0xff00) == 0x500 &&
+	    model->reply_m3)
+		model->regs[LKPI_MHI_STATUS / 4] = 0x500;
+	if (offset == 0x260) {
+		model->regs[0x268 / 4] = model->bhie_reply;
+		if ((model->bhie_reply >> 30) == 2 && !model->hold_ee)
+			model->regs[0x128 / 4] = 2;
+	}
+}
+
+static int
+mhi_boot_test(struct mhi_controller *ctrl)
+{
+	const uint32_t offsets[] = { 0x120, 0x12c, 0x10c, 0x108, 0x110, 0x118 };
+	const uint32_t bhie_replies[] = {
+		0x80000000, 0xc0000000, 0, 0x80000000, UINT32_MAX,
+		0x80000000
+	};
+	const int bhie_results[] = {
+		0, -EIO, -ETIMEDOUT, -ETIMEDOUT, -EIO, -ETIMEDOUT
+	};
+	struct mhi_boot_model model = { 0 };
+	struct lkpi_mhi_boot boot = { 0 };
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_event_ring *event;
+	struct lkpi_mhi_tre *tre;
+	struct lkpi_mhi_vector *vectors;
+	uint8_t *payload = NULL;
+	uint8_t data[64] = { 0x7f, 'E', 'L', 'F', 0x12, 0x34 };
+	sbintime_t start;
+	size_t length = LKPI_MHI_BHI_SIZE + 64;
+	unsigned int i, j, writes;
+	int expected, error = 0;
+
+	model.regs = malloc(MHI_MODEL_REG_LEN, M_TEMP, M_WAITOK | M_ZERO);
+	ctrl->regs = model.regs;
+	ctrl->reg_len = MHI_MODEL_REG_LEN;
+	ctrl->timeout_ms = 1;
+	ctrl->read_reg = mhi_model_read;
+	ctrl->write_reg = mhi_model_write;
+	ctrl->cntrl_dev->driver_data = &model;
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x10000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EINVAL);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x50;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EINVAL);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+	model.regs[LKPI_MHI_CTRL / 4] = 2;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EBUSY);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_CTRL / 4] = 0;
+	model.regs[0x128 / 4] = 2;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EBUSY);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[0x128 / 4] = 0;
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = UINT32_MAX;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EIO);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+	model.fail_read = true;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EIO);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.fail_read = false;
+	model.reply = 0x80000000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == 0);
+	CHECK(model.writes == nitems(offsets) &&
+	    memcmp(model.offsets, offsets, sizeof(offsets)) == 0);
+	CHECK(model.values[0] == 0 && model.values[1] == 0 &&
+	    model.values[2] == 0 && model.values[3] == boot.image.address &&
+	    model.values[4] == sizeof(data) && model.values[5] > 0 &&
+	    model.values[5] <= 0x3fffffff);
+	CHECK(boot.pending && check_buffer(&boot.image, 64, false) &&
+	    memcmp(boot.image.vaddr, data, sizeof(data)) == 0);
+	CHECK(linuxkpi_mhi_boot_free(&boot) == -EBUSY);
+	/* The model never performs DMA; simulate confirmed reset for cleanup. */
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0 && boot.image.vaddr == NULL);
+	model.writes = 0;
+	model.reply = 0xc0000000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EIO &&
+	    boot.pending);
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0);
+	model.writes = 0;
+	model.reply = 0;
+	start = sbinuptime();
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) ==
+	    -ETIMEDOUT && boot.pending);
+	CHECK(sbinuptime() - start >= SBT_1MS &&
+	    sbinuptime() - start < SBT_1S);
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0);
+	model.writes = 0;
+	model.reply = 0x80000000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == 0);
+	CHECK(linuxkpi_mhi_alloc_context(ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+	context = ctrl->lkpi_context;
+	ctrl->nr_irqs = 3;
+	model.regs[0x2c / 4] = 0x224;
+	model.regs[0x18 / 4] = 0x400;
+	model.regs[0x20 / 4] = 0x800;
+	CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == -ETIMEDOUT &&
+	    !context->published && model.writes == 6);
+	model.regs[LKPI_MHI_STATUS / 4] = 0x101;
+	model.regs[0x128 / 4] = 1;
+	model.regs[0x18 / 4] = 0x10000;
+	CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == -EINVAL &&
+	    !context->published && model.writes == 6);
+	model.regs[0x18 / 4] = 0x400;
+	model.regs[0x10 / 4] = 0xffff55aa;
+	CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == 0 && context->published);
+	CHECK(model.regs[0x58 / 4] == context->channels.address &&
+	    model.regs[0x60 / 4] == context->events.address &&
+	    model.regs[0x68 / 4] == context->commands.address &&
+	    model.regs[0x88 / 4] == UINT32_MAX &&
+	    model.regs[0x10 / 4] == 0x255aa &&
+	    model.regs[0x7f8 / 4] == 1);
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == context);
+	CHECK(check_buffer(&context->events, 64, false));
+	event = &context->event_rings[0];
+	CHECK(check_buffer(&event->dma, event->dma.size, false));
+	events = context->events.vaddr;
+	tre = event->dma.vaddr;
+	tre[0].dword[0] = htole32(2U << 24);
+	tre[0].dword[1] = htole32(0x20U << 16);
+	tre[1].dword[0] = htole32(1U << 24);
+	tre[1].dword[1] = htole32(0x40U << 16);
+	events[0].rp = htole64(event->dma.address + 32);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == 0);
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(context->state == 2 && context->ee == 1 &&
+	    context->state_events == 1 && context->ee_events == 1 &&
+	    event->read_offset == 32 && event->write_offset == 16 &&
+	    le64toh(events[0].wp) == event->dma.address + 16);
+	events[0].rp = htole64(event->dma.address + 1);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == -EIO &&
+	    event->read_offset == 32);
+	context->event_error = 0;
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(check_buffer(&event->dma, event->dma.size, false));
+	event->read_offset = event->dma.size - 16;
+	event->write_offset = event->dma.size - 32;
+	tre[event->read_offset / 16] = tre[0];
+	tre[0] = tre[1];
+	events[0].rp = htole64(event->dma.address + 16);
+	events[0].wp = htole64(event->dma.address + event->write_offset);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == 0 &&
+	    event->read_offset == 16 && event->write_offset == 0 &&
+	    context->state_events == 2 && context->ee_events == 2);
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(check_buffer(&event->dma, event->dma.size, false));
+	tre[1].dword[1] = htole32(0x99U << 16);
+	events[0].rp = htole64(event->dma.address + 32);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == -EOPNOTSUPP &&
+	    event->read_offset == 16);
+	context->published = false;
+	linuxkpi_mhi_free_context(ctrl);
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0);
+	payload = malloc(length, M_TEMP, M_WAITOK | M_ZERO);
+	payload[0] = 0x41;
+	payload[LKPI_MHI_BHI_SIZE] = 0x42;
+	payload[length - 1] = 0x43;
+	for (i = 0; i < nitems(bhie_replies); i++) {
+		memset(model.regs, 0, MHI_MODEL_REG_LEN);
+		model.writes = 0;
+		model.reply = 0x80000000;
+		model.bhie_reply = bhie_replies[i];
+		model.hold_ee = i == 3;
+		model.hold_ee_event = i == 5;
+		model.ee_event_sent = false;
+		model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+		CHECK(linuxkpi_mhi_alloc_context(ctrl,
+		    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+		context = ctrl->lkpi_context;
+		CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == 0);
+		model.regs[0x2c / 4] = 0x224;
+		model.regs[0x18 / 4] = 0x400;
+		model.regs[0x20 / 4] = 0x800;
+		model.regs[LKPI_MHI_STATUS / 4] = 0x101;
+		model.regs[0x128 / 4] = 1;
+		CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == 0);
+		writes = model.writes;
+		model.regs[0x2c / 4] = 0x400;
+		CHECK(linuxkpi_mhi_boot_bhie(ctrl, &boot, payload, length) ==
+		    -EINVAL && model.writes == writes && boot.segments == NULL);
+		model.regs[0x2c / 4] = 0x224;
+		model.regs[0x260 / 4] = 0x80000000;
+		expected = bhie_results[i];
+		ctrl->timeout_ms = expected == 0 ? 100 : 1;
+		start = sbinuptime();
+		CHECK(linuxkpi_mhi_boot_bhie(ctrl, &boot, payload, length) ==
+		    expected);
+		if (expected == 0)
+			CHECK(model.ee_event_sent && context->state == 2 &&
+			    context->ee == 2 && context->state_events == 1 &&
+			    context->ee_events == 1);
+		if (model.hold_ee_event)
+			CHECK(boot.ee == 2 && context->ee == 0);
+		if (expected == -ETIMEDOUT)
+			CHECK(sbinuptime() - start >= SBT_1MS &&
+			    sbinuptime() - start < SBT_1S);
+		if (model.hold_ee)
+			CHECK((boot.bhie_status >> 30) == 2 && boot.ee == 1);
+		CHECK(boot.pending && boot.num_segments == 2 &&
+		    boot.vectors.size == 2 * sizeof(*vectors) &&
+		    model.writes == writes + (expected == 0 ? 6 : 4) &&
+		    model.offsets[writes] == 0x254 &&
+		    model.offsets[writes + 1] == 0x250 &&
+		    model.offsets[writes + 2] == 0x258 &&
+		    model.offsets[writes + 3] == 0x260 &&
+		    model.values[writes] == 0 &&
+		    model.values[writes + 1] == boot.vectors.address &&
+		    model.values[writes + 2] == boot.vectors.size &&
+		    (model.values[writes + 3] & 0xc0000000) == 0x80000000 &&
+		    (model.values[writes + 3] & 0x3fffffff) != 0);
+		CHECK(check_buffer(&boot.vectors, 64, false));
+		vectors = boot.vectors.vaddr;
+		for (j = 0; j < boot.num_segments; j++) {
+			CHECK(check_buffer(&boot.segments[j], 64, false) &&
+			    boot.segments[j].size == (j == 0 ?
+			    LKPI_MHI_BHI_SIZE : 64) &&
+			    le64toh(vectors[j].address) == boot.segments[j].address &&
+			    le64toh(vectors[j].length) == boot.segments[j].size &&
+			    memcmp(boot.segments[j].vaddr,
+			    payload + j * LKPI_MHI_BHI_SIZE,
+			    boot.segments[j].size) == 0);
+		}
+		CHECK(linuxkpi_mhi_boot_free(&boot) == -EBUSY &&
+		    boot.num_segments == 2 && boot.image.vaddr != NULL);
+		context->published = false;
+		linuxkpi_mhi_free_context(ctrl);
+		boot.pending = false;
+		CHECK(linuxkpi_mhi_boot_free(&boot) == 0 &&
+		    boot.segments == NULL && boot.vectors.vaddr == NULL);
+	}
+out:
+	/* All context publication above targets the model, not the PCI device. */
+	if (ctrl->lkpi_context != NULL)
+		ctrl->lkpi_context->published = false;
+	linuxkpi_mhi_free_context(ctrl);
+	boot.pending = false;
+	linuxkpi_mhi_boot_free(&boot);
+	ctrl->cntrl_dev->driver_data = NULL;
+	ctrl->regs = NULL;
+	ctrl->read_reg = NULL;
+	ctrl->write_reg = NULL;
+	free(payload, M_TEMP);
+	free(model.regs, M_TEMP);
+	if (error == 0)
+		printf("lkpi_mhi_test: BHI MMIO bounds, write order, payload, errors, timeout and DMA retention passed (model only)\n");
+	if (error == 0)
+		printf("lkpi_mhi_test: READY/M0 publication, active-context protection, event decoding, wrap and corruption checks passed (model only)\n");
+	if (error == 0)
+		printf("lkpi_mhi_test: BHIE vector order, chunk payload/tail, doorbell preservation, AMSS, errors, timeout and DMA retention passed (model only)\n");
+	return (error);
+}
