+static int
+mhi_ce_rx_test(struct mhi_controller *ctrl)
+{
+	struct mhi_lab_ce ce = { 0 };
+	struct mhi_ce_rx_delivery delivery;
+	struct mhi_ce_model *model;
+	unsigned int pass, i, p, processed, writes, total;
+	uint32_t saved;
+	int expected, error = 0;
+
+	model = malloc(sizeof(*model), M_TEMP, M_WAITOK);
+	CHECK(linuxkpi_mhi_alloc_context(ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+	for (pass = 0; pass < 10; pass++) {
+		memset(model, 0, sizeof(*model));
+		memset(&delivery, 0, sizeof(delivery));
+		CHECK(mhi_lab_ce_alloc(ctrl, &ce) == 0);
+		CHECK(mhi_lab_ce_rx_alloc(ctrl, &ce) == 0);
+		CHECK(ce.rx[0].count == 510 && ce.rx[1].count == 62);
+		ctrl->lkpi_context->published = true;
+		CHECK(mhi_lab_ce_init(ctrl, &ce, mhi_ce_model_register, model) == 0);
+		if (pass >= 8) {
+			model->fail_at = model->writes + pass - 7;
+			CHECK(mhi_lab_ce_rx_post(&ce, mhi_ce_model_register, model) ==
+			    EIO && ce.error == EIO && !ce.posted);
+			if (pass == 9)
+				CHECK(model->regs[0x3400 / 4] == 1020);
+			goto reset_rx;
+		}
+		CHECK(mhi_lab_ce_rx_post(&ce, mhi_ce_model_register, model) == 0);
+		CHECK(model->regs[0x3400 / 4] == 1020 &&
+		    model->regs[0x5400 / 4] == 124);
+		writes = model->writes;
+		CHECK(mhi_lab_ce_rx_post(&ce, mhi_ce_model_register, model) == EPROTO &&
+		    model->writes == writes);
+		CHECK(mhi_lab_ce_poll(&ce, mhi_ce_model_register, model,
+		    mhi_ce_rx_delivery, &delivery, 3, &processed) == 0 &&
+		    processed == 0 && model->writes == writes);
+		if (pass == 0) {
+			for (i = 0; i < 1100; i++) {
+				for (p = 0; p < 2; p++)
+					CHECK(mhi_ce_fake_receive(&ce, model, p, 1,
+					    delivery.packets[p] + 1, 4) == 0);
+				for (p = 0; p < 2; p++)
+					CHECK(mhi_lab_ce_poll(&ce, mhi_ce_model_register,
+					    model, mhi_ce_rx_delivery, &delivery, 1,
+					    &processed) == 0 && processed == 1);
+			}
+			CHECK(delivery.packets[0] == 1100 && delivery.packets[1] == 1100 &&
+			    ce.packets == 2200 && ce.rx[0].next_buffer == 1100 % 510 &&
+			    ce.rx[1].next_buffer == 1100 % 62);
+			CHECK(mhi_ce_fake_receive(&ce, model, 0, 5, 1101, 4) == 0);
+			CHECK(mhi_ce_fake_receive(&ce, model, 1, 5, 1101, 4) == 0);
+			total = 0;
+			while (total < 10) {
+				CHECK(mhi_lab_ce_poll(&ce, mhi_ce_model_register, model,
+				    mhi_ce_rx_delivery, &delivery, 3, &processed) == 0 &&
+				    processed > 0 && processed <= 3);
+				total += processed;
+				if (total == 6)
+					CHECK(delivery.packets[0] == 1103 &&
+					    delivery.packets[1] == 1103);
+			}
+			CHECK(total == 10 && delivery.packets[0] == 1105 &&
+			    delivery.packets[1] == 1105);
+		} else {
+			CHECK(mhi_ce_fake_receive(&ce, model, 0, 1, 1,
+			    pass == 3 ? 0 : pass == 4 ? 2049 : 4) == 0);
+			expected = EPROTO;
+			switch (pass) {
+			case 1: le32enc((uint8_t *)ce.rdp.vaddr + 4 * ce.ring[2].id,
+				    ce.ring[2].dma.size / 4); break;
+			case 2: le32enc((uint8_t *)ce.rdp.vaddr + 4 * ce.ring[1].id, 1); break;
+			case 3:
+			case 4: expected = EMSGSIZE; break;
+			case 5: delivery.reject = true; expected = EIO; break;
+			case 6: model->fail_at = model->writes + 1; expected = EIO; break;
+			case 7:
+				expected = EAGAIN;
+				saved = le32dec((uint8_t *)ce.rdp.vaddr + 4 * ce.ring[1].id);
+				le32enc((uint8_t *)ce.rdp.vaddr + 4 * ce.ring[1].id,
+				    (ce.rx[0].write + 2) % (ce.ring[1].dma.size / 4));
+				break;
+			}
+			CHECK(mhi_lab_ce_poll(&ce, mhi_ce_model_register, model,
+			    mhi_ce_rx_delivery, &delivery, 3, &processed) == expected);
+			if (pass == 7) {
+				CHECK(ce.error == 0 && processed == 0);
+				le32enc((uint8_t *)ce.rdp.vaddr + 4 * ce.ring[1].id, saved);
+				CHECK(mhi_lab_ce_poll(&ce, mhi_ce_model_register, model,
+				    mhi_ce_rx_delivery, &delivery, 3, &processed) == 0 &&
+				    processed == 1 && delivery.packets[0] == 1);
+			} else {
+				CHECK(ce.error == expected);
+				writes = model->writes;
+				total = delivery.packets[0];
+				CHECK(mhi_lab_ce_poll(&ce, mhi_ce_model_register, model,
+				    mhi_ce_rx_delivery, &delivery, 3, &processed) == expected &&
+				    processed == 0 && writes == model->writes &&
+				    total == delivery.packets[0]);
+			}
+		}
+reset_rx:
+		CHECK(mhi_lab_ce_free(ctrl, &ce) == EBUSY && ce.rx[0].buffers != NULL);
+		ctrl->lkpi_context->published = false;
+		memset(model, 0, sizeof(*model));
+		CHECK(mhi_lab_ce_reset_check(ctrl, &ce, mhi_ce_model_register, model) == 0);
+		CHECK(mhi_lab_ce_free(ctrl, &ce) == 0 && ce.rx[0].buffers == NULL);
+	}
+out:
+	if (ctrl->lkpi_context != NULL) {
+		ctrl->lkpi_context->published = false;
+		memset(model, 0, sizeof(*model));
+		(void)mhi_lab_ce_reset_check(ctrl, &ce, mhi_ce_model_register, model);
+		(void)mhi_lab_ce_free(ctrl, &ce);
+		linuxkpi_mhi_free_context(ctrl);
+	}
+	free(model, M_TEMP);
+	if (error == 0)
+		printf("lkpi_mhi_test: CE RX descriptor-driven DMA delivery, both ring/pool wraps, budget/fairness, backpressure, malformed completions, callback/I/O errors and retention passed (model only)\n");
+	return (error);
+}
