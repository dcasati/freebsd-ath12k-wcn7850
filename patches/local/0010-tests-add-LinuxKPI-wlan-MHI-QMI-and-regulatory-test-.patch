+static int
+mhi_qmi_initialization_test(void)
+{
+	struct mhi_lab_qmi client = { .service = true, .node = 7, .port = 1 };
+	struct mhi_lab_qmi awaiting, capability;
+	uint8_t packet[1024], indication[128], good[128], response[160];
+	size_t length, ind_length, response_length, offset;
+	unsigned int i, j;
+	int error = 0, expected;
+
+	CHECK(mhi_lab_qmi_build(&client, packet, sizeof(packet), 1, 0x34,
+	    &length) == EPROTO);
+	CHECK(mhi_lab_qmi_build(&client, packet, sizeof(packet), 1, 0x20,
+	    &length) == 0 && length == 56 && packet[39] == 0x15 &&
+	    le32dec(packet + 42) == 0x4b4e454c);
+	response_length = mhi_qmi_model_packet(response, 2, 1, 0x20, 7);
+	CHECK(mhi_lab_qmi_receive(&client, response, response_length) == 0 &&
+	    client.registered);
+	CHECK(mhi_lab_qmi_build(&client, packet, sizeof(packet), 2, 0x34,
+	    &length) == 0);
+	for (offset = 39; offset < 39 + le16dec(packet + 37);
+	    offset += 3 + le16dec(packet + offset + 1))
+		CHECK(packet[offset] < 0x21 || packet[offset] > 0x26);
+	awaiting = client;
+	ind_length = mhi_qmi_model_packet(indication, 4, 0, 0x35, 26);
+	indication[39] = 1;
+	le16enc(indication + 40, 23);
+	indication[42] = 1;
+	le32enc(indication + 43, 65536);
+	le32enc(indication + 47, 1);
+	indication[51] = 1;
+	le64enc(indication + 52, 4096);
+	le32enc(indication + 60, 8192);
+	memcpy(good, indication, ind_length);
+	for (i = 0; i < 14; i++) {
+		client = awaiting;
+		memcpy(indication, good, ind_length);
+		length = ind_length;
+		expected = EPROTO;
+		switch (i) {
+		case 0: indication[42] = 0; break;
+		case 1: indication[42] = MHI_LAB_MEM_MAX + 1; break;
+		case 2: le32enc(indication + 43, 0); break;
+		case 3: le32enc(indication + 43, MHI_LAB_MEM_SEG_LIMIT + 1); break;
+		case 4:
+			le32enc(indication + 47, 8);
+			expected = EOPNOTSUPP;
+			break;
+		case 5: indication[51] = 3; break;
+		case 6: le64enc(indication + 52, 65537); break;
+		case 7: le32enc(indication + 60, 65536); break;
+		case 8:
+			indication[64] = 1;
+			expected = EOPNOTSUPP;
+			break;
+		case 9: le16enc(indication + 40, 24); break;
+		case 10:
+			le32enc(indication + 20, 36);
+			le16enc(indication + 37, 29);
+			indication[65] = 1;
+			le16enc(indication + 66, 0);
+			length = 68;
+			break;
+		case 11: indication[39] = 0x80; break;
+		case 12:
+			le32enc(indication + 20, 34);
+			le16enc(indication + 37, 27);
+			indication[65] = 0x10;
+			break;
+		case 13: le64enc(indication + 52, UINT64_MAX); break;
+		}
+		CHECK(mhi_lab_qmi_receive(&client, indication, length) == expected &&
+		    !client.mem_requested && client.pending);
+	}
+	client = awaiting;
+	CHECK(mhi_lab_qmi_receive(&client, good, ind_length) == 0 &&
+	    client.pending && client.message == 0x34 && client.mem_requested &&
+	    client.memory_count == 1 && client.memory_total == 65536);
+	CHECK(mhi_lab_qmi_receive(&client, good, ind_length) == EPROTO);
+	response_length = mhi_qmi_model_packet(response, 2, 2, 0x34, 7);
+	CHECK(mhi_lab_qmi_receive(&client, response, response_length) == 0 &&
+	    client.host_accepted);
+	CHECK(mhi_lab_qmi_build(&client, packet, sizeof(packet), 3, 0x36,
+	    &length) == ERANGE && !client.mem_published && !client.pending);
+	client.memory[0].address = 0x20000;
+	CHECK(mhi_lab_qmi_build(&client, packet, 40, 3, 0x36, &length) ==
+	    EMSGSIZE && !client.mem_published && !client.pending);
+	CHECK(mhi_lab_qmi_build(&client, packet, sizeof(packet), 3, 0x36,
+	    &length) == 0 && length == 60 && packet[42] == 1 &&
+	    le64dec(packet + 43) == 0x20000 && le32dec(packet + 51) == 65536 &&
+	    le32dec(packet + 55) == 1 && packet[59] == 0);
+	length = mhi_qmi_model_packet(indication, 4, 0, 0x37, 0);
+	CHECK(mhi_lab_qmi_receive(&client, indication, length) == 0 &&
+	    client.mem_ready && client.pending && client.message == 0x36);
+	response_length = mhi_qmi_model_packet(response, 2, 3, 0x36, 7);
+	CHECK(mhi_lab_qmi_receive(&client, response, response_length) == 0 &&
+	    client.done && !client.pending);
+	CHECK(mhi_lab_qmi_build(&client, packet, sizeof(packet), 4, 0x24,
+	    &length) == 0);
+	capability = client;
+	length = mhi_qmi_model_packet(response, 2, 4, 0x24, 40);
+	response[46] = 0x10;
+	le16enc(response + 47, 8);
+	le32enc(response + 49, 0x7850);
+	le32enc(response + 53, 2);
+	response[57] = 0x11;
+	le16enc(response + 58, 4);
+	le32enc(response + 60, 0x108);
+	response[64] = 0x12;
+	le16enc(response + 65, 4);
+	le32enc(response + 67, 0x400);
+	response[71] = 0x13;
+	le16enc(response + 72, 5);
+	le32enc(response + 74, 0x1234);
