+	le16enc(response + 80, 64);
+	le64enc(response + 82, 0x100000);
+	le64enc(response + 90, 0x20000);
+	le32enc(response + 20, 114);
+	le16enc(response + 37, 107);
+	client = capability;
+	CHECK(mhi_lab_qmi_receive(&client, response, 148) == 0 &&
+	    client.dev_mem_valid && client.dev_mem[0].start == 0x100000 &&
+	    client.dev_mem[0].size == 0x20000 &&
+	    client.dev_mem[3].size == 0);
+	client = capability;
+	le16enc(response + 80, 63);
+	le32enc(response + 20, 113);
+	le16enc(response + 37, 106);
+	CHECK(mhi_lab_qmi_receive(&client, response, 148) == EPROTO &&
+	    !client.dev_mem_valid && client.pending);
+	client = capability;
+	le16enc(response + 80, 64);
+	le32enc(response + 20, 114);
+	le16enc(response + 37, 107);
+	le64enc(response + 82, UINT64_MAX);
+	CHECK(mhi_lab_qmi_receive(&client, response, 148) == EPROTO &&
