+static int
+mhi_wmi_caps(struct mhi_lab_wmi *wmi, uint32_t tag, const uint8_t *p,
+    size_t len, unsigned int depth, bool decode)
+{
+	struct mhi_lab_wmi_mode *mode;
+	struct mhi_lab_wmi_mac_phy *mac;
+	struct mhi_lab_wmi_reg_cap *reg;
+	uint32_t header;
+	unsigned int i;
+	size_t n;
+
+	if (!decode && tag != WMI_TAG_ARRAY_STRUCT) {
+		if (tag == WMI_TAG_MAC_PHY_CAPABILITIES_EXT &&
+		    len < sizeof(struct ath12k_wmi_caps_ext_params))
+			return (EPROTO);
+		return (0);
+	}
+	switch (tag) {
+	case WMI_TAG_ARRAY_STRUCT:
+		if (depth >= 4)
+			return (EPROTO);
+		while (len != 0) {
+			if (len < 4)
+				return (EPROTO);
+			header = le32dec(p);
+			n = header & 0xffff;
+			if ((n & 3) != 0 || n > len - 4 ||
+			    mhi_wmi_caps(wmi, header >> 16, p + 4, n,
+			    depth + 1, decode) != 0)
+				return (EPROTO);
+			p += n + 4;
+			len -= n + 4;
+		}
+		break;
+	case WMI_TAG_SOC_MAC_PHY_HW_MODE_CAPS:
+		if (wmi->soc_modes ||
+		    len < sizeof(struct ath12k_wmi_soc_mac_phy_hw_mode_caps_params))
+			return (EPROTO);
+		wmi->num_modes = le32dec(p);
+		if (wmi->num_modes == 0 || wmi->num_modes > MHI_WMI_MAX_MODES)
+			return (EPROTO);
+		wmi->soc_modes = true;
+		break;
+	case WMI_TAG_SOC_HAL_REG_CAPABILITIES:
+		if (wmi->soc_reg ||
+		    len < sizeof(struct ath12k_wmi_soc_hal_reg_caps_params))
+			return (EPROTO);
+		wmi->num_phys = le32dec(p);
+		if (wmi->num_phys == 0 || wmi->num_phys > MHI_WMI_MAX_PHY)
+			return (EPROTO);
+		wmi->soc_reg = true;
+		break;
+	case WMI_TAG_HW_MODE_CAPABILITIES:
+		if (len < sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4 ||
+		    wmi->mode_count == MHI_WMI_MAX_MODES)
+			return (EPROTO);
+		mode = &wmi->modes[wmi->mode_count];
+		mode->id = le32dec(p);
+		mode->phys = le32dec(p + 4);
+		mode->config = le32dec(p + 8) & WMI_HW_MODE_CAP_CFG_TYPE;
+		/* New firmware modes are advertisements, not host mode selectors. */
+		if (mode->phys == 0 || mode->phys >> MHI_WMI_MAX_PHY) {
+			printf("mhi_lab_wmi: invalid mode id=%u phys=%#x config=%u\n",
+			    mode->id, mode->phys, mode->config);
+			return (EPROTO);
+		}
+		for (i = 0; i < wmi->mode_count; i++)
+			if (wmi->modes[i].id == mode->id)
+				return (EPROTO);
+		wmi->mode_count++;
+		break;
+	case WMI_TAG_MAC_PHY_CAPABILITIES:
+		if (len < sizeof(struct ath12k_wmi_mac_phy_caps_params) ||
+		    wmi->mac_phy_count == MHI_WMI_MAX_MAC_PHY)
+			return (EPROTO);
+		mac = &wmi->mac_phys[wmi->mac_phy_count];
+#define MHI_WMI_MAC(field) le32dec(p + offsetof(struct ath12k_wmi_mac_phy_caps_params, field))
+		mac->mode = MHI_WMI_MAC(hw_mode_id);
+		mac->pdev = MHI_WMI_MAC(pdev_and_hw_link_ids) & WMI_CAPS_PARAMS_PDEV_ID;
+		mac->phy = MHI_WMI_MAC(phy_id);
+		mac->bands = MHI_WMI_MAC(supported_bands);
+		mac->tx2 = MHI_WMI_MAC(tx_chain_mask_2g);
+		mac->rx2 = MHI_WMI_MAC(rx_chain_mask_2g);
+		mac->tx5 = MHI_WMI_MAC(tx_chain_mask_5g);
+		mac->rx5 = MHI_WMI_MAC(rx_chain_mask_5g);
+		mac->low2 = MHI_WMI_MAC(low_2ghz_chan_freq);
+		mac->high2 = MHI_WMI_MAC(high_2ghz_chan_freq);
+		mac->low5 = MHI_WMI_MAC(low_5ghz_chan_freq);
+		mac->high5 = MHI_WMI_MAC(high_5ghz_chan_freq);
+#undef MHI_WMI_MAC
+		if (mac->phy >= MHI_WMI_MAX_PHY || mac->pdev == 0 ||
+		    mac->pdev > MHI_WMI_MAX_PHY || mac->bands == 0 ||
+		    (mac->bands & ~WMI_HOST_WLAN_2GHZ_5GHZ_CAP) != 0 ||
+		    ((mac->bands & WMI_HOST_WLAN_2GHZ_CAP) != 0 &&
+		    (mac->tx2 == 0 || mac->rx2 == 0 ||
+		    ((mac->tx2 | mac->rx2) & ~0xffU) != 0 ||
+		    (mac->low2 != 0 && mac->high2 != 0 &&
+		    mac->low2 > mac->high2))) ||
+		    ((mac->bands & WMI_HOST_WLAN_5GHZ_CAP) != 0 &&
+		    (mac->tx5 == 0 || mac->rx5 == 0 ||
+		    ((mac->tx5 | mac->rx5) & ~0xffU) != 0 ||
+		    (mac->low5 != 0 && mac->high5 != 0 &&
+		    mac->low5 > mac->high5)))) {
+			printf("mhi_lab_wmi: invalid MAC/PHY mode=%u pdev=%u "
+			    "phy=%u bands=%#x chains=%#x/%#x/%#x/%#x "
+			    "ranges=%u-%u/%u-%u\n",
+			    mac->mode, mac->pdev, mac->phy, mac->bands,
+			    mac->tx2, mac->rx2, mac->tx5, mac->rx5,
+			    mac->low2, mac->high2, mac->low5, mac->high5);
+			return (EPROTO);
+		}
+		for (i = 0; i < wmi->mac_phy_count; i++)
+			if (wmi->mac_phys[i].mode == mac->mode &&
+			    wmi->mac_phys[i].phy == mac->phy)
+				return (EPROTO);
+		wmi->mac_phy_count++;
+		break;
+	case WMI_TAG_HAL_REG_CAPABILITIES_EXT:
+		if (len < sizeof(struct ath12k_wmi_hal_reg_caps_ext_params) - 4 ||
+		    wmi->reg_count == MHI_WMI_MAX_PHY)
+			return (EPROTO);
+		reg = &wmi->reg_caps[wmi->reg_count];
+#define REG(field) le32dec(p + offsetof(struct ath12k_wmi_hal_reg_caps_ext_params, field) - 4)
+		reg->phy = REG(phy_id);
+		reg->domain = REG(eeprom_reg_domain);
+		reg->domain_ext = REG(eeprom_reg_domain_ext);
+		reg->cap1 = REG(regcap1);
+		reg->cap2 = REG(regcap2);
+		reg->low2 = REG(low_2ghz_chan);
+		reg->high2 = REG(high_2ghz_chan);
+		reg->low5 = REG(low_5ghz_chan);
+		reg->high5 = REG(high_5ghz_chan);
+#undef REG
+		if (reg->phy >= MHI_WMI_MAX_PHY ||
+		    reg->low2 > reg->high2 || reg->low5 > reg->high5)
+			return (EPROTO);
+		for (i = 0; i < wmi->reg_count; i++)
+			if (wmi->reg_caps[i].phy == reg->phy)
+				return (EPROTO);
+		wmi->reg_count++;
+		break;
+	}
+	return (0);
+}
+
+static bool
+mhi_wmi_caps_complete(const struct mhi_lab_wmi *wmi)
+{
+	unsigned int i, j, count = 0;
+	uint32_t phys, reg_phys = 0;
+
+	if (!wmi->soc_modes || !wmi->soc_reg ||
+	    wmi->num_modes != wmi->mode_count || wmi->num_phys != wmi->reg_count)
+		return (false);
+	for (i = 0; i < wmi->reg_count; i++)
+		reg_phys |= 1U << wmi->reg_caps[i].phy;
+	for (i = 0; i < wmi->mode_count; i++) {
+		phys = wmi->modes[i].phys;
+		if ((phys & ~reg_phys) != 0)
+			return (false);
+		for (j = 0; j < wmi->mac_phy_count; j++) {
+			if (wmi->mac_phys[j].mode != wmi->modes[i].id)
+				continue;
+			if ((phys & (1U << wmi->mac_phys[j].phy)) == 0)
+				return (false);
+			phys &= ~(1U << wmi->mac_phys[j].phy);
+			count++;
+		}
+		if (phys != 0)
+			return (false);
+	}
+	return (count == wmi->mac_phy_count);
+}
+
+int
+mhi_lab_wmi_init(struct mhi_lab_wmi *wmi, const struct mhi_lab_wmi_owner *owner,
+    const struct ath12k_wmi_resource_config_params *cfg, bool single_pdev_only)
+{
+	uint8_t packet[4 + sizeof(struct wmi_init_cmd) +
+	    sizeof(struct ath12k_wmi_resource_config_params) + 4] = { 0 };
+	size_t offset;
+	int error;
+
+	if (wmi == NULL || cfg == NULL)
+		return (EINVAL);
+	if (wmi->init_attempted)
+		return (EALREADY);
+	if (!mhi_lab_wmi_ready(wmi) || !wmi->semantic_caps)
+		return (EAGAIN);
+	/* Only the reference single-pdev/zero-host-memory path is implemented. */
+	if (!single_pdev_only || wmi->memory_requests != 0)
+		return (EOPNOTSUPP);
+	if (owner == NULL || owner->check == NULL || owner->send == NULL)
+		return (ENXIO);
+	if (le32dec(&cfg->num_vdevs) == 0 || le32dec(&cfg->num_peers) == 0 ||
+	    le32dec(&cfg->num_tids) == 0 || le32dec(&cfg->num_msdu_desc) == 0 ||
+	    le32dec(&cfg->tx_chain_mask) == 0 || le32dec(&cfg->rx_chain_mask) == 0)
+		return (EINVAL);
+	error = owner->check(owner->arg);
+	if (error != 0)
+		return (error);
+	le32enc(packet, WMI_INIT_CMDID);
+	le32enc(packet + 4, WMI_TAG_INIT_CMD << 16 |
+	    (sizeof(struct wmi_init_cmd) - 4));
+	/* qwz leaves host ABI and num_host_mem_chunks zero. */
+	offset = 4 + sizeof(struct wmi_init_cmd);
+	memcpy(packet + offset, cfg, sizeof(*cfg));
+	le32enc(packet + offset, WMI_TAG_RESOURCE_CONFIG << 16 | (sizeof(*cfg) - 4));
+	offset += sizeof(*cfg);
+	le32enc(packet + offset, WMI_TAG_ARRAY_STRUCT << 16);
+	/* HW_MODE_MAX means omit HW_MODE and band-to-MAC TLVs, not SINGLE. */
+	wmi->init_attempted = true;
+	error = owner->send(owner->arg, packet, sizeof(packet));
+	if (error == 0) {
+		wmi->single_pdev_only = true;
+		wmi->init_sent = true;
+	}
+	return (error);
+}
+
+static bool
+mhi_wmi_service(const struct mhi_lab_wmi *wmi, unsigned int service)
+{
+	return ((wmi->services[service / 8] & (1U << (service % 8))) != 0);
+}
+
+bool
+mhi_lab_wmi_ready(const struct mhi_lab_wmi *wmi)
+{
+	return (wmi->base && wmi->available &&
+	    (!mhi_wmi_service(wmi, WMI_TLV_SERVICE_EXT_MSG) || wmi->extended) &&
+	    (!mhi_wmi_service(wmi, WMI_TLV_SERVICE_EXT2_MSG) || wmi->extended2));
+}
+
+int
+mhi_lab_wmi_receive(void *arg, uint16_t service, const void *data, size_t size)
+{
+	struct mhi_lab_wmi *wmi = arg, next;
+	const uint8_t *packet = data, *value;
+	uint32_t event, header, tag, expected, word;
+	size_t offset, length, minimum;
+	unsigned int i, b, bit, bits, start, words;
+	bool fixed = false, bitmap = false, addresses = false;
+	uint32_t extra_addresses = 0;
+
+	if (wmi == NULL || packet == NULL ||
+	    service != ATH12K_HTC_SVC_ID_WMI_CONTROL || size < 4)
+		goto invalid;
+	next = *wmi;
+	event = le32dec(packet) & 0xffffff;
+	switch (event) {
+	case WMI_SERVICE_READY_EVENTID:
+		if (wmi->base)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_READY_EVENT;
+		minimum = sizeof(struct wmi_service_ready_event);
+		break;
+	case WMI_SERVICE_AVAILABLE_EVENTID:
+		if (wmi->available)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_AVAILABLE_EVENT;
+		minimum = sizeof(struct wmi_service_available_event);
+		break;
+	case WMI_SERVICE_READY_EXT_EVENTID:
+		if (!wmi->base || wmi->extended)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_READY_EXT_EVENT;
+		minimum = sizeof(struct wmi_service_ready_ext_event);
+		break;
+	case WMI_SERVICE_READY_EXT2_EVENTID:
+		if (!wmi->extended || wmi->extended2)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_READY_EXT2_EVENT;
+		minimum = sizeof(struct wmi_service_ready_ext2_event);
+		break;
+	case WMI_READY_EVENTID:
+		if (!wmi->init_sent || wmi->ready_received)
+			goto invalid;
+		expected = WMI_TAG_READY_EVENT;
+		minimum = sizeof(struct ath12k_wmi_ready_event_min_params);
+		break;
+	default:
+		printf("mhi_lab_wmi: unsupported startup event %#x\n", event);
+		return (EOPNOTSUPP);
+	}
+	offset = 4;
+	while (offset < size) {
+		if (size - offset < 4)
+			goto invalid;
+		header = le32dec(packet + offset);
+		tag = header >> 16;
+		length = header & 0xffff;
+		offset += 4;
+		if (length > size - offset || (length & 3) != 0)
+			goto invalid;
+		value = packet + offset;
+		if ((event == WMI_SERVICE_READY_EXT_EVENTID ||
+		    event == WMI_SERVICE_READY_EXT2_EVENTID) &&
+		    mhi_wmi_caps(&next, tag, value, length, 0,
+		    event == WMI_SERVICE_READY_EXT_EVENTID) != 0) {
+			printf("mhi_lab_wmi: invalid capability tag=%u "
+			    "length=%zu offset=%zu\n",
+			    tag, length, offset);
+			goto invalid;
+		}
+		if (tag == expected) {
+			if (fixed || length < minimum)
+				goto invalid;
+			fixed = true;
+			if (event == WMI_SERVICE_READY_EXT2_EVENTID) {
+				next.reg_db_version = le32dec(value +
+				    offsetof(struct wmi_service_ready_ext2_event, reg_db_version));
+				next.target_cap_flags = le32dec(value +
+				    offsetof(struct wmi_service_ready_ext2_event, target_cap_flags));
+			}
+			if (event == WMI_READY_EVENTID) {
+				for (i = 0; i < nitems(next.abi); i++)
+					if (le32dec(value + 4 * i) != next.abi[i])
+						goto invalid;
+				next.ready_status = le32dec(value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, status));
+				next.ready_peers = le32dec(value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, num_total_peers));
+				extra_addresses = le32dec(value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, num_extra_mac_addr));
+				memcpy(next.mac, value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, mac_addr), 6);
+				if ((next.mac[0] & 1) != 0 ||
+				    memcmp(next.mac, "\0\0\0\0\0\0", 6) == 0)
+					goto invalid;
+				next.unified_ready = next.ready_status == 0;
+				next.ready_received = true;
+			}
+			if (event == WMI_SERVICE_READY_EVENTID) {
+#define WMI_BASE(field) le32dec(value + offsetof(struct wmi_service_ready_event, field))
+				next.firmware = WMI_BASE(fw_build_vers);
+				next.rf_chains = WMI_BASE(num_rf_chains);
+				next.memory_requests = WMI_BASE(num_mem_reqs);
+				next.scan_channels = WMI_BASE(max_num_scan_channels);
+#undef WMI_BASE
+				for (i = 0; i < nitems(next.abi); i++)
+					next.abi[i] = le32dec(value +
+					    offsetof(struct wmi_service_ready_event, fw_abi_vers) + 4 * i);
+				if (next.rf_chains == 0 || next.rf_chains > 8 ||
+				    next.scan_channels == 0)
+					goto invalid;
+			}
+		}
+		if (event == WMI_READY_EVENTID && tag == WMI_TAG_ARRAY_FIXED_STRUCT) {
+			if (!fixed || addresses ||
+			    length % sizeof(struct ath12k_wmi_mac_addr_params) != 0 ||
+			    extra_addresses > length / sizeof(struct ath12k_wmi_mac_addr_params))
+				goto invalid;
+			addresses = true;
+		}
+		start = bits = words = 0;
+		if (event == WMI_SERVICE_READY_EVENTID && tag == WMI_TAG_ARRAY_UINT32 &&
+		    !bitmap) {
+			if (length < WMI_SERVICE_BM_SIZE * sizeof(uint32_t))
+				goto invalid;
+			bits = WMI_SERVICE_BITS_IN_SIZE32;
+			words = WMI_SERVICE_BM_SIZE;
+			bitmap = true;
+		} else if (event == WMI_SERVICE_AVAILABLE_EVENTID && tag == expected) {
+			start = le32dec(value);
+			if (start != WMI_MAX_SERVICE)
+				goto invalid;
+			bits = 32;
+			words = WMI_SERVICE_SEGMENT_BM_SIZE32;
+			value += offsetof(struct wmi_service_available_event,
+			    wmi_service_segment_bitmap);
+		} else if (event == WMI_SERVICE_AVAILABLE_EVENTID &&
+		    tag == WMI_TAG_ARRAY_UINT32) {
+			if (bitmap)
+				goto invalid;
+			start = WMI_MAX_EXT_SERVICE;
+			bits = 32;
+			words = length / 4;
+			bitmap = true;
+		}
+		if (bits != 0) {
+			for (i = 0; i < words; i++) {
+				word = le32dec(value + 4 * i);
+				for (b = 0; b < bits; b++) {
+					bit = start + bits * i + b;
+					if ((word & (1U << b)) == 0)
+						continue;
+					if (bit >= sizeof(next.services) * 8)
+						goto invalid;
+					next.services[bit / 8] |= 1U << (bit % 8);
+				}
+			}
+		}
+		offset += length;
+	}
+	if (!fixed || (event == WMI_SERVICE_READY_EVENTID && !bitmap))
+		goto invalid;
+	if (event == WMI_READY_EVENTID && extra_addresses != 0 && !addresses)
+		goto invalid;
+	if (event == WMI_SERVICE_READY_EXT_EVENTID) {
+		next.semantic_caps = mhi_wmi_caps_complete(&next);
+		if ((next.soc_modes || next.soc_reg || next.mode_count != 0 ||
+		    next.mac_phy_count != 0 || next.reg_count != 0) &&
+		    !next.semantic_caps) {
+			printf("mhi_lab_wmi: incomplete capabilities "
+			    "modes=%u/%u MAC/PHY=%u regulatory=%u/%u\n",
+			    next.mode_count, next.num_modes, next.mac_phy_count,
+			    next.reg_count, next.num_phys);
+			goto invalid;
+		}
+	}
+	next.base |= event == WMI_SERVICE_READY_EVENTID;
+	next.available |= event == WMI_SERVICE_AVAILABLE_EVENTID;
+	next.extended |= event == WMI_SERVICE_READY_EXT_EVENTID;
+	next.extended2 |= event == WMI_SERVICE_READY_EXT2_EVENTID;
+	next.events++;
+	next.last_event = event;
+	*wmi = next;
+	if (event == WMI_READY_EVENTID && next.ready_status != 0)
+		return (EIO);
+	printf("mhi_lab_wmi: startup event %#x bytes=%zu validated\n",
+	    event, size);
+	return (0);
+invalid:
+	printf("mhi_lab_wmi: invalid startup event (service=%#x bytes=%zu)\n", service, size);
+	return (EPROTO);
+}
diff --git a/sys/tests/linuxkpi_wlan/mhi_wmi.h b/sys/tests/linuxkpi_wlan/mhi_wmi.h
new file mode 100644
index 00000000000..97869305db9
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_wmi.h
@@ -0,0 +1,65 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#ifndef _MHI_LAB_WMI_H_
+#define _MHI_LAB_WMI_H_
+
+#define MHI_WMI_MAX_MODES 8
+#define MHI_WMI_MAX_MAC_PHY 16
+#define MHI_WMI_MAX_PHY 3
+
+struct mhi_lab_wmi_mode {
+	uint32_t id, phys, config;
+};
+
+struct mhi_lab_wmi_mac_phy {
+	uint32_t mode, pdev, phy, bands;
+	uint32_t tx2, rx2, tx5, rx5;
+	uint32_t low2, high2, low5, high5;
+};
+
+/* These are hardware capabilities, never regulatory permission to transmit. */
+struct mhi_lab_wmi_reg_cap {
+	uint32_t phy, domain, domain_ext, cap1, cap2;
+	uint32_t low2, high2, low5, high5;
+};
+
+struct mhi_lab_wmi {
+	uint32_t firmware, abi[6], rf_chains, memory_requests, scan_channels;
+	uint32_t events, last_event;
+	uint32_t num_modes, num_phys, mode_count, mac_phy_count, reg_count;
+	struct mhi_lab_wmi_mode modes[MHI_WMI_MAX_MODES];
+	struct mhi_lab_wmi_mac_phy mac_phys[MHI_WMI_MAX_MAC_PHY];
+	struct mhi_lab_wmi_reg_cap reg_caps[MHI_WMI_MAX_PHY];
+	uint32_t ready_status, ready_peers, reg_db_version, target_cap_flags;
+	uint8_t mac[6];
+	uint8_t services[64];
+	bool base, available, extended, extended2;
+	bool soc_modes, soc_reg, semantic_caps;
+	bool init_attempted, init_sent, ready_received, unified_ready, single_pdev_only;
+};
+
+struct ath12k_wmi_resource_config_params;
+
+/*
+ * The owner must verify live production DP allocation/publication, cookie
+ * conversion, REO, RX descriptors, CE3 and reset-before-free retention on
+ * every invocation. No owner/check means no INIT. Serialize with RX/reset.
+ * cfg is the complete little-endian resource config matching actual owner
+ * allocations, not a set of guessed firmware defaults. send copies the raw
+ * WMI message before returning; zero means accepted.
+ * After an ambiguous TX failure the owner must reset, not retry INIT.
+ */
+struct mhi_lab_wmi_owner {
+	void *arg;
+	int (*check)(void *);
+	int (*send)(void *, const void *, size_t);
+};
+
+int mhi_lab_wmi_receive(void *, uint16_t, const void *, size_t);
+/* Capability exchange only; not unified READY, HTT or transmit permission. */
+bool mhi_lab_wmi_ready(const struct mhi_lab_wmi *);
+int mhi_lab_wmi_init(struct mhi_lab_wmi *, const struct mhi_lab_wmi_owner *,
+    const struct ath12k_wmi_resource_config_params *, bool);
+
+#endif
diff --git a/sys/tests/linuxkpi_wlan/mhi_wmi_cases.h b/sys/tests/linuxkpi_wlan/mhi_wmi_cases.h
new file mode 100644
index 00000000000..091cea194a9
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_wmi_cases.h
@@ -0,0 +1,291 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Focused WMI-only cases; MHI_WMI_STANDALONE runs without a module or hardware.
+ */
+#ifdef MHI_WMI_STANDALONE
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include "core.h"
+#include "mhi_wmi.h"
+#endif
+
+struct mhi_wmi_command_model {
+	uint8_t packet[512];
+	size_t length;
+	unsigned int checks, sends;
+	int check_error, send_error;
+};
+
+static int
+mhi_wmi_owner_check(void *arg)
+{
+	struct mhi_wmi_command_model *model = arg;
+
+	model->checks++;
+	return (model->check_error);
+}
+
+static int
+mhi_wmi_owner_send(void *arg, const void *packet, size_t length)
+{
+	struct mhi_wmi_command_model *model = arg;
+
+	model->sends++;
+	if (length > sizeof(model->packet))
+		return (EMSGSIZE);
+	memcpy(model->packet, packet, length);
+	model->length = length;
+	return (model->send_error);
+}
+
+static uint8_t *
+mhi_wmi_case_tlv(uint8_t *packet, size_t *offset, uint32_t tag, size_t length)
+{
+	uint8_t *p = packet + *offset;
+
+	le32enc(p, tag << 16 | length);
+	memset(p + 4, 0, length);
+	*offset += length + 4;
+	return (p + 4);
+}
+
+static int
+mhi_wmi_semantic_test(void)
+{
+	struct mhi_lab_wmi wmi = { .base = true, .available = true }, before;
+	struct ath12k_wmi_resource_config_params cfg = { 0 };
+	struct mhi_wmi_command_model model = { .check_error = ENXIO };
+	const struct mhi_lab_wmi_owner owner = {
+		.arg = &model, .check = mhi_wmi_owner_check, .send = mhi_wmi_owner_send
+	};
+	uint8_t packet[1024] = { 0 }, *p, *array, *mac, *mode, *soc;
+	size_t offset = 4, nested = 0, length;
+	int error = 0;
+
+#define WMI_CASE(condition) do {						\
+	if (!(condition)) {						\
+		printf("WMI semantic case line %d failed: %s\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+	le32enc(&cfg.num_vdevs, 1);
+	le32enc(&cfg.num_peers, 4);
+	le32enc(&cfg.num_tids, 16);
+	le32enc(&cfg.num_msdu_desc, 128);
+	le32enc(&cfg.tx_chain_mask, 3);
+	le32enc(&cfg.rx_chain_mask, 3);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EAGAIN &&
+	    model.checks == 0 && model.sends == 0);
+	le32enc(packet, WMI_SERVICE_READY_EXT_EVENTID);
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SERVICE_READY_EXT_EVENT,
+	    sizeof(struct wmi_service_ready_ext_event));
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SOC_MAC_PHY_HW_MODE_CAPS,
+	    sizeof(struct ath12k_wmi_soc_mac_phy_hw_mode_caps_params));
+	soc = p;
+	le32enc(p, 1);
+	array = packet + offset + 4;
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params));
+	mode = mhi_wmi_case_tlv(array, &nested, WMI_TAG_HW_MODE_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4);
+	le32enc(mode, 7);
+	le32enc(mode + 4, 1);
+	le32enc(mode + 8, WMI_HOST_HW_MODE_DBS);
+	array = packet + offset + 4;
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT,
+	    4 + sizeof(struct ath12k_wmi_mac_phy_caps_params));
+	nested = 0;
+	mac = mhi_wmi_case_tlv(array, &nested, WMI_TAG_MAC_PHY_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_mac_phy_caps_params));
+#define CASE_MAC(field, value) le32enc(mac + offsetof(struct ath12k_wmi_mac_phy_caps_params, field), value)
+	CASE_MAC(hw_mode_id, 7);
+	CASE_MAC(pdev_and_hw_link_ids, 1);
+	CASE_MAC(supported_bands, WMI_HOST_WLAN_2GHZ_5GHZ_CAP);
+	CASE_MAC(tx_chain_mask_2g, 3);
+	CASE_MAC(rx_chain_mask_2g, 3);
+	CASE_MAC(tx_chain_mask_5g, 3);
+	CASE_MAC(rx_chain_mask_5g, 3);
+	CASE_MAC(low_2ghz_chan_freq, 2400);
+	CASE_MAC(high_2ghz_chan_freq, 2500);
+	CASE_MAC(low_5ghz_chan_freq, 4900);
+	CASE_MAC(high_5ghz_chan_freq, 7125);
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SOC_HAL_REG_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_soc_hal_reg_caps_params));
+	le32enc(p, 1);
+	array = packet + offset + 4;
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT,
+	    sizeof(struct ath12k_wmi_hal_reg_caps_ext_params));
+	nested = 0;
+	p = mhi_wmi_case_tlv(array, &nested, WMI_TAG_HAL_REG_CAPABILITIES_EXT,
+	    sizeof(struct ath12k_wmi_hal_reg_caps_ext_params) - 4);
+	le32enc(p + 4, 0x1234);
+	length = offset;
+	before = wmi;
+	/* Real WCN7850 firmware also advertises mode/config 8. */
+	le32enc(mode, 8);
+	le32enc(mode + 8, 8);
+	CASE_MAC(hw_mode_id, 8);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == 0 && wmi.semantic_caps &&
+	    wmi.modes[0].id == 8 && wmi.modes[0].config == 8);
+	wmi = before;
+	le32enc(mode, 7);
+	le32enc(mode + 8, WMI_HOST_HW_MODE_DBS);
+	CASE_MAC(hw_mode_id, 7);
+	/* Zero frequency limits are unspecified, not regulatory permission. */
+	CASE_MAC(low_2ghz_chan_freq, 0);
+	CASE_MAC(high_2ghz_chan_freq, 0);
+	CASE_MAC(low_5ghz_chan_freq, 0);
+	CASE_MAC(high_5ghz_chan_freq, 0);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == 0 && wmi.semantic_caps &&
+	    wmi.mac_phys[0].low2 == 0 && wmi.mac_phys[0].high5 == 0);
+	wmi = before;
+	CASE_MAC(low_2ghz_chan_freq, 2500);
+	CASE_MAC(high_2ghz_chan_freq, 2400);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	CASE_MAC(low_2ghz_chan_freq, 2400);
+	CASE_MAC(high_2ghz_chan_freq, 2500);
+	CASE_MAC(low_5ghz_chan_freq, 4900);
+	CASE_MAC(high_5ghz_chan_freq, 7125);
+	/* Nested length is checked independently of the valid outer array. */
+	mac[-4]++;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	mac[-4]--;
+	CASE_MAC(phy_id, MHI_WMI_MAX_PHY);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	CASE_MAC(phy_id, 0);
+	CASE_MAC(rx_chain_mask_5g, 1U << 8);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	CASE_MAC(rx_chain_mask_5g, 3);
+	CASE_MAC(hw_mode_id, 8);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	CASE_MAC(hw_mode_id, 7);
+	le32enc(soc, MHI_WMI_MAX_MODES + 1);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	le32enc(soc, 2);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	le32enc(soc, 1);
+	/* Duplicate nested modes cannot replace an earlier capability. */
+	nested = 0;
+	array = packet + length + 4;
+	mhi_wmi_case_tlv(packet, &length, WMI_TAG_ARRAY_STRUCT,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params));
+	p = mhi_wmi_case_tlv(array, &nested, WMI_TAG_HW_MODE_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4);
+	memcpy(p, mode, sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	length = offset;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == 0 && wmi.semantic_caps &&
+	    wmi.mac_phy_count == 1 && wmi.mac_phys[0].tx5 == 3 &&
+	    wmi.reg_caps[0].domain == 0x1234);
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet, WMI_SERVICE_READY_EXT2_EVENTID);
+	offset = 4;
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SERVICE_READY_EXT2_EVENT,
+	    sizeof(struct wmi_service_ready_ext2_event));
+	le32enc(p + offsetof(struct wmi_service_ready_ext2_event, reg_db_version), 9);
+	array = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT, 4);
+	le32enc(array, WMI_TAG_MAC_PHY_CAPABILITIES_EXT << 16 | 4);
+	before = wmi;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	le32enc(array, WMI_TAG_MAC_PHY_CAPABILITIES_EXT << 16);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && !wmi.extended2);
+	le32enc(array, 0xfffeU << 16);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == 0 && wmi.extended2 && wmi.reg_db_version == 9);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, NULL, &cfg, true) == ENXIO);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == ENXIO &&
+	    !wmi.init_attempted && model.checks == 1 && model.sends == 0);
+	model.check_error = 0;
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, false) == EOPNOTSUPP &&
+	    model.sends == 0);
+	wmi.memory_requests = 1;
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EOPNOTSUPP);
+	wmi.memory_requests = 0;
+	/* Unsolicited unified READY must not advance capability-only state. */
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet, WMI_READY_EVENTID);
+	offset = 4;
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_READY_EVENT,
+	    sizeof(struct ath12k_wmi_ready_event_min_params));
+	p[offsetof(struct ath12k_wmi_ready_event_min_params, mac_addr)] = 2;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && !wmi.unified_ready);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == 0 &&
+	    wmi.init_sent && !wmi.unified_ready && model.sends == 1);
+	WMI_CASE(model.length == 4 + sizeof(struct wmi_init_cmd) + sizeof(cfg) + 4 &&
+	    le32dec(model.packet) == WMI_INIT_CMDID &&
+	    le32dec(model.packet + 4) ==
+	    (WMI_TAG_INIT_CMD << 16 | (sizeof(struct wmi_init_cmd) - 4)) &&
+	    le32dec(model.packet + model.length - 4) == WMI_TAG_ARRAY_STRUCT << 16);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EALREADY &&
+	    model.sends == 1);
+	before = wmi;
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params,
+	    num_extra_mac_addr), 1);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params,
+	    num_extra_mac_addr), 0);
+	p[0] = 1;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && !wmi.ready_received);
+	p[0] = 0;
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params, status), 3);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EIO && wmi.ready_received &&
+	    !wmi.unified_ready && wmi.ready_status == 3);
+	wmi = before;
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params, status), 0);
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params,
+	    num_extra_mac_addr), 1);
+	/* A declared address must have a complete fixed-struct element. */
+	nested = offset;
+	mhi_wmi_case_tlv(packet, &nested, WMI_TAG_ARRAY_FIXED_STRUCT, 4);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, nested) == EPROTO && !wmi.ready_received);
+	nested = offset;
+	mhi_wmi_case_tlv(packet, &nested, WMI_TAG_ARRAY_FIXED_STRUCT,
+	    sizeof(struct ath12k_wmi_mac_addr_params));
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, nested) == 0 && wmi.unified_ready && wmi.mac[0] == 2);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, nested) == EPROTO);
+	wmi = before;
+	wmi.init_attempted = wmi.init_sent = false;
+	model.send_error = EIO;
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EIO &&
+	    wmi.init_attempted && !wmi.init_sent);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EALREADY);
+out:
+	if (error == 0)
+		printf("WMI nested capability, ownership/INIT and unified READY cases passed (model only)\n");
+#undef CASE_MAC
+#undef WMI_CASE
+	return (error);
+}
+
+#ifdef MHI_WMI_STANDALONE
+int
+main(void)
+{
+	return (mhi_wmi_semantic_test());
+}
+#endif
diff --git a/sys/tests/linuxkpi_wlan/qmi_codec_test.c b/sys/tests/linuxkpi_wlan/qmi_codec_test.c
new file mode 100644
index 00000000000..7521218a438
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/qmi_codec_test.c
@@ -0,0 +1,255 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/systm.h>
+
+#include "linux_qmi.h"
+
+/* Standalone codec executable: these linker-set bounds are never dereferenced. */
+uintptr_t *__start_set_pcpu, *__stop_set_pcpu;
+
+int main(void);
+
+#define TEST(expr) do {						\
+	if (!(expr)) {						\
+		printf("qmi_codec_test:%d: %s\n", __LINE__, #expr);	\
+		return (1);					\
+	}							\
+} while (0)
+
+struct mem_info {
+	uint64_t start, size;
+};
+
+struct cap {
+	struct qmi_response_type_v01 response;
+	uint8_t valid;
+	struct mem_info memory[4];
+};
+
+static const struct qmi_elem_info result_ei[] = {
+	{ .data_type = QMI_UNSIGNED_2_BYTE, .elem_len = 1, .elem_size = 2,
+	  .offset = offsetof(struct qmi_response_type_v01, result) },
+	{ .data_type = QMI_UNSIGNED_2_BYTE, .elem_len = 1, .elem_size = 2,
+	  .offset = offsetof(struct qmi_response_type_v01, error) },
+	{ .data_type = QMI_EOTI },
+};
+
+static const struct qmi_elem_info memory_ei[] = {
+	{ .data_type = QMI_UNSIGNED_8_BYTE, .elem_len = 1, .elem_size = 8,
+	  .offset = offsetof(struct mem_info, start) },
+	{ .data_type = QMI_UNSIGNED_8_BYTE, .elem_len = 1, .elem_size = 8,
+	  .offset = offsetof(struct mem_info, size) },
+	{ .data_type = QMI_EOTI },
+};
+
+static const struct qmi_elem_info cap_ei[] = {
+	{ .data_type = QMI_STRUCT, .elem_len = 1,
+	  .elem_size = sizeof(struct qmi_response_type_v01), .tlv_type = 2,
+	  .offset = offsetof(struct cap, response), .ei_array = result_ei },
+	{ .data_type = QMI_OPT_FLAG, .elem_len = 1, .elem_size = 1,
+	  .tlv_type = 0x1c, .offset = offsetof(struct cap, valid) },
+	{ .data_type = QMI_STRUCT, .elem_len = 4, .elem_size = sizeof(struct mem_info),
+	  .array_type = STATIC_ARRAY, .tlv_type = 0x1c,
+	  .offset = offsetof(struct cap, memory), .ei_array = memory_ei },
+	{ .data_type = QMI_EOTI },
+};
+
+struct list {
+	uint32_t length;
+	struct mem_info memory[2];
+};
+
+static const struct qmi_elem_info list_ei[] = {
+	{ .data_type = QMI_DATA_LEN, .elem_len = 1, .elem_size = 1,
+	  .tlv_type = 1, .offset = offsetof(struct list, length) },
+	{ .data_type = QMI_STRUCT, .elem_len = 2, .elem_size = sizeof(struct mem_info),
+	  .array_type = VAR_LEN_ARRAY, .tlv_type = 1,
+	  .offset = offsetof(struct list, memory), .ei_array = memory_ei },
+	{ .data_type = QMI_EOTI },
+};
+
+struct version {
+	uint32_t number;
+	char timestamp[8];
+};
+
+static const struct qmi_elem_info version_ei[] = {
+	{ .data_type = QMI_UNSIGNED_4_BYTE, .elem_len = 1, .elem_size = 4,
+	  .offset = offsetof(struct version, number) },
+	{ .data_type = QMI_STRING, .elem_len = 8, .elem_size = 1,
+	  .offset = offsetof(struct version, timestamp) },
+	{ .data_type = QMI_EOTI },
+};
+
+struct version_response {
+	struct version version;
+};
+
+static const struct qmi_elem_info version_response_ei[] = {
+	{ .data_type = QMI_STRUCT, .elem_len = 1, .elem_size = sizeof(struct version),
+	  .tlv_type = 1, .ei_array = version_ei },
+	{ .data_type = QMI_EOTI },
+};
+
+int
+main(void)
+{
+	struct cap input = { .valid = 1,
+		.memory = { { .start = 0x113000, .size = 0x5000 } } };
+	struct cap output, saved;
+	struct list list = { .length = 2,
+		.memory = { { .start = 0x123456789, .size = 4096 },
+			    { .start = 0x200000, .size = 8192 } } };
+	struct list decoded_list;
+	struct version_response version = { .version = {
+		.number = 0x1103006c, .timestamp = "native" } }, decoded_version;
+	uint8_t packet[256], copy[256], frame_packet[256];
+	struct lkpi_qrtr_frame frame;
+	struct qmi_txn txn = { .ei = cap_ei, .id = 42, .message = 0x24,
+		.active = true, .sent = true };
+	struct {
+		uint64_t before;
+		struct cap value;
+		uint64_t after;
+	} guarded;
+	size_t length, i, j, cut;
+
+	TEST(lkpi_qmi_encode(cap_ei, &input, packet, sizeof(packet),
+	    &length) == 0);
+	TEST(length == 74 && packet[7] == 0x1c && le16dec(packet + 8) == 64);
+	TEST(le64dec(packet + 10) == 0x113000 && le64dec(packet + 18) == 0x5000);
+	TEST(lkpi_qmi_decode(cap_ei, packet, length, &output,
+	    sizeof(output)) == 0);
+	TEST(output.valid && output.memory[0].start == input.memory[0].start &&
+	    output.memory[0].size == input.memory[0].size);
+	for (i = 1; i < 4; i++)
+		TEST(output.memory[i].start == 0 && output.memory[i].size == 0);
+	memset(&saved, 0xa5, sizeof(saved));
+	output = saved;
+	le16enc(packet + 8, 63);
+	TEST(lkpi_qmi_decode(cap_ei, packet, length, &output,
+	    sizeof(output)) != 0);
+	TEST(memcmp(&output, &saved, sizeof(output)) == 0);
+	le16enc(packet + 8, 64);
+	memcpy(copy, packet, length);
+	memcpy(copy + length, packet, 7);
+	TEST(lkpi_qmi_decode(cap_ei, copy, length + 7, &output,
+	    sizeof(output)) == -EBADMSG);
+	TEST(lkpi_qmi_decode(cap_ei, packet + 7, length - 7, &output,
+	    sizeof(output)) == -ENOMSG);
+	TEST(lkpi_qmi_decode(cap_ei, packet, 7, &output,
+	    sizeof(output)) == 0 && !output.valid);
+	for (cut = 0; cut < 74; cut++) {
+		memset(packet, 0xcc, sizeof(packet));
+		TEST(lkpi_qmi_encode(cap_ei, &input, packet, cut,
+		    &length) != 0);
+		for (j = cut; j < sizeof(packet); j++)
+			TEST(packet[j] == 0xcc);
+	}
+	TEST(lkpi_qmi_encode(cap_ei, &input, packet, sizeof(packet),
+	    &length) == 0);
+	for (i = 0; i < length; i++)
+		for (j = 0; j < 8; j++) {
+			memcpy(copy, packet, length);
+			copy[i] ^= 1U << j;
+			guarded.before = guarded.after = UINT64_MAX;
+			guarded.value = saved;
+			if (lkpi_qmi_decode(cap_ei, copy, length,
+			    &guarded.value, sizeof(guarded.value)) != 0)
+				TEST(memcmp(&guarded.value, &saved, sizeof(saved)) == 0);
+			TEST(guarded.before == UINT64_MAX && guarded.after == UINT64_MAX);
+		}
+	memset(frame_packet, 0, sizeof(frame_packet));
+	le32enc(frame_packet, 1);
+	le32enc(frame_packet + 4, 1);
+	le32enc(frame_packet + 8, 7);
+	le32enc(frame_packet + 12, 9);
+	le32enc(frame_packet + 20, length + 7);
+	le32enc(frame_packet + 24, 1);
+	le32enc(frame_packet + 28, 0x4000);
+	frame_packet[32] = 2;
+	le16enc(frame_packet + 33, txn.id);
+	le16enc(frame_packet + 35, txn.message);
+	le16enc(frame_packet + 37, length);
+	memcpy(frame_packet + 39, packet, length);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 116, &frame) == 0);
+	TEST(lkpi_qmi_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == 0 && output.valid);
+	frame_packet[32] = QMI_INDICATION;
+	le16enc(frame_packet + 33, 1);
+	le16enc(frame_packet + 35, 0x35);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 116, &frame) == 0 &&
+	    frame.body[0] == QMI_INDICATION && le16dec(frame.body + 1) == 1);
+	TEST(lkpi_qmi_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -EPROTO);
+	frame_packet[32] = 0;
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 116, &frame) == -EPROTO);
+	frame_packet[32] = 2;
+	le16enc(frame_packet + 33, txn.id);
+	le16enc(frame_packet + 35, txn.message);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 116, &frame) == 0);
+	output = saved;
+	TEST(lkpi_qmi_reply(&frame, 8, 9, &txn, &output,
+	    sizeof(output)) == -EPROTO);
+	TEST(lkpi_qmi_reply(&frame, 7, 10, &txn, &output,
+	    sizeof(output)) == -EPROTO);
+	txn.id++;
+	TEST(lkpi_qmi_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -ENOENT);
+	txn.id--;
+	txn.message++;
+	TEST(lkpi_qmi_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -ENOENT);
+	txn.message--;
+	txn.active = false;
+	TEST(lkpi_qmi_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -ENOENT);
+	txn.active = true;
+	TEST(memcmp(&output, &saved, sizeof(output)) == 0);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 115, &frame) == -EPROTO);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 113, &frame) == 0);
+	le32enc(frame_packet + 28, 0x4001);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 116, &frame) == -EPROTO);
+	le32enc(frame_packet + 28, 0x4000);
+	memcpy(copy, frame_packet + 32, length + 7);
+	memset(frame_packet, 0, sizeof(frame_packet));
+	frame_packet[0] = 3;
+	frame_packet[1] = 1;
+	frame_packet[2] = 1;
+	le32enc(frame_packet + 4, length + 7);
+	le16enc(frame_packet + 8, 7);
+	le16enc(frame_packet + 10, 9);
+	le16enc(frame_packet + 12, 1);
+	le16enc(frame_packet + 14, 0x4000);
+	memcpy(frame_packet + 16, copy, length + 7);
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 100, &frame) == 0 &&
+	    frame.confirm == 1);
+	TEST(lkpi_qmi_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == 0);
+	frame_packet[3] = 4;
+	TEST(lkpi_qrtr_frame_decode(frame_packet, 100, &frame) ==
+	    -EPROTONOSUPPORT);
+	TEST(lkpi_qmi_encode(list_ei, &list, packet, sizeof(packet),
+	    &length) == 0 && length == 36 && packet[3] == 2);
+	TEST(lkpi_qmi_decode(list_ei, packet, length, &decoded_list,
+	    sizeof(decoded_list)) == 0 && decoded_list.length == 2 &&
+	    decoded_list.memory[1].size == 8192);
+	packet[3] = 3;
+	TEST(lkpi_qmi_decode(list_ei, packet, length, &decoded_list,
+	    sizeof(decoded_list)) != 0);
+	list.length = 3;
+	TEST(lkpi_qmi_encode(list_ei, &list, packet, sizeof(packet),
+	    &length) != 0);
+	TEST(lkpi_qmi_encode(version_response_ei, &version, packet,
+	    sizeof(packet), &length) == 0);
+	TEST(length == 14 && packet[7] == 6);
+	TEST(lkpi_qmi_decode(version_response_ei, packet, length,
+	    &decoded_version, sizeof(decoded_version)) == 0 &&
+	    strcmp(decoded_version.version.timestamp, "native") == 0);
+	packet[7] = 8;
+	TEST(lkpi_qmi_decode(version_response_ei, packet, length,
+	    &decoded_version, sizeof(decoded_version)) != 0);
+	printf("qmi_codec_test: schema/CMEM, bounded frames, source/transaction matching and cancellation passed\n");
+	return (0);
+}
