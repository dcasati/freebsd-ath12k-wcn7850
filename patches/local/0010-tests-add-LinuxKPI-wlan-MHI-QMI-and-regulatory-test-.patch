+#!/usr/bin/env python3
+"""Exercise production M4 token validation and TX admission under sanitizers."""
+
+import pathlib
+import subprocess
+import tempfile
+
+from regulatory_production_test import function
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+KERNEL = ROOT / "sys/compat/linuxkpi/common/src"
+
+PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "linux_80211_sta.h"
+#define min(a,b) ((a) < (b) ? (a) : (b))
+#define IEEE80211_FC0_TYPE_MASK 0x0c
+#define IEEE80211_FC0_TYPE_DATA 8
+#define IEEE80211_FC1_DIR_MASK 3
+#define IEEE80211_FC1_DIR_TODS 1
+#define IEEE80211_FC1_DIR_FROMDS 2
+#define LKPI_STA_WPA2 1
+#define LKPI80211_TAG_M4 1
+#define MTAG_ABI_LKPI80211 1707696513
+#define IEEE80211_ADDR_EQ(a,b) (memcmp(a,b,6) == 0)
+#define atomic_load_acq_int(p) (*(p))
+#define LKPI_80211_LSTA_TXQ_LOCK(s) assert(!(s)->locked); (s)->locked = true
+#define LKPI_80211_LSTA_TXQ_UNLOCK(s) assert((s)->locked); (s)->locked = false
+struct ieee80211_hw { bool gated; };
+struct ieee80211_sta { struct lkpi_sta *lsta; };
+struct ieee80211_node {
+    struct lkpi_sta *ni_drv_data;
+    uint8_t ni_bssid[6];
+};
+struct lkpi_sta {
+    struct ieee80211_hw *hw;
+    struct ieee80211_node *ni;
+    struct lkpi_sta_port port;
+    unsigned port_key_busy, port_open;
+    bool locked, guarded;
+};
+struct lkpi_sta_m4 { uint64_t replay; uint32_t epoch; };
+struct m_tag { size_t m_tag_len; };
+struct mbuf {
+    struct { unsigned len; struct { void *ptr; } PH_loc; } m_pkthdr;
+    struct m_tag *tag;
+    uint8_t data[256];
+};
+struct sk_buff { void *m; };
+struct ieee80211_frame {
+    uint8_t i_fc[2], duration[2], i_addr1[6], i_addr2[6], i_addr3[6], seq[2];
+};
+#define STA_TO_LSTA(s) ((s)->lsta)
+#define ieee80211_hw_check(h,f) ((void)(f), (h)->gated)
+static bool lkpi_sta_port_enabled(struct lkpi_sta *s) { return s->guarded; }
+static unsigned ieee80211_anyhdrsize(struct ieee80211_frame *f)
+{ (void)f; return sizeof(*f); }
+static void m_copydata(struct mbuf *m, unsigned off, unsigned n, void *out)
+{ assert(off + n <= m->m_pkthdr.len); memcpy(out, m->data + off, n); }
+static struct m_tag *m_tag_locate(struct mbuf *m, unsigned cookie, int id, void *p)
+{
+    assert(cookie == MTAG_ABI_LKPI80211 && id == LKPI80211_TAG_M4 && !p);
+    return m->tag;
+}
+"""
+
+TEST = r"""
+int main(void)
+{
+    struct ieee80211_hw hw = { .gated = true };
+    struct ieee80211_node ni = {};
+    struct lkpi_sta sta = { .hw = &hw, .ni = &ni, .guarded = true };
+    struct { struct m_tag tag; struct lkpi_sta_m4 token; } tagged = {};
+    struct mbuf m = { .m_pkthdr.len = sizeof(struct ieee80211_frame) + 8 + 99,
+        .m_pkthdr.PH_loc.ptr = &ni, .tag = &tagged.tag };
+    struct sk_buff skb = { .m = &m };
+    ni.ni_drv_data = &sta;
+    m.data[0] = 8; m.data[1] = 1;
+    const uint8_t llc[] = { 0xaa, 0xaa, 3, 0, 0, 0, 0x88, 0x8e };
+    memcpy(m.data + sizeof(struct ieee80211_frame), llc, sizeof(llc));
+    uint8_t *e = m.data + sizeof(struct ieee80211_frame) + sizeof(llc);
+    e[0] = 2; e[1] = 3; e[3] = 95; e[4] = 2; e[5] = 3; e[6] = 0x0a;
+    e[16] = 42;
+    uint8_t nonce[32] = { 1 };
+    assert(lkpi_sta_port_m3(&sta.port, 42, nonce));
+    tagged.tag.m_tag_len = sizeof(tagged.token);
+    tagged.token.epoch = sta.port.epoch; tagged.token.replay = 42;
+    assert(lkpi_sta_m4_check(&sta, &m));
+    lkpi_sta_port_key(&sta.port, 0, true, true, true);
+    lkpi_sta_port_key(&sta.port, 1, false, true, true);
+    assert(lkpi_sta_m4_check(&sta, &m));
+    assert(!lkpi_sta_port_ready(&sta.port));
+
+    for (int scenario = 0; scenario < 10; scenario++) {
+        struct lkpi_sta saved = sta;
+        struct mbuf saved_m = m;
+        if (scenario == 0) tagged.token.epoch--;
+        if (scenario == 1) tagged.token.replay--;
+        if (scenario == 2) e[16]--;
+        if (scenario == 3) sta.port.failed = true;
+        if (scenario == 4) sta.port_key_busy = 1;
+        if (scenario == 5) m.tag = NULL;
+        if (scenario == 6) tagged.tag.m_tag_len--;
+        if (scenario == 7) m.data[1] = IEEE80211_FC1_DIR_FROMDS;
+        if (scenario == 8) m.m_pkthdr.len = sizeof(struct ieee80211_frame) + 8;
+        if (scenario == 9) e[5] = 1;
+        assert(!lkpi_sta_m4_check(&sta, &m));
+        sta = saved; m = saved_m;
+        tagged.token.epoch = sta.port.epoch; tagged.token.replay = 42;
+        tagged.tag.m_tag_len = sizeof(tagged.token);
+        e = m.data + sizeof(struct ieee80211_frame) + sizeof(llc);
+    }
+    assert(linuxkpi_ieee80211_sta_tx_permitted(&hw, NULL, &skb));
+    assert(lkpi_sta_port_m3(&sta.port, 43, nonce));
+    assert(!linuxkpi_ieee80211_sta_tx_permitted(&hw, NULL, &skb));
+    tagged.token.epoch = sta.port.epoch; tagged.token.replay = 43; e[16] = 43;
+    assert(linuxkpi_ieee80211_sta_tx_permitted(&hw, NULL, &skb));
+    assert(!lkpi_sta_port_ready(&sta.port));
+    assert(!lkpi_sta_port_ack(&sta.port, sta.port.epoch - 1, 42));
+    assert(lkpi_sta_port_ack(&sta.port, sta.port.epoch, 43));
+    assert(lkpi_sta_port_ready(&sta.port));
+    puts("production M4 token: parser/tags, stale TX rejection, key fence and strict ACK gate passed");
+    return 0;
+}
+"""
+
+
+def main():
+    source = (KERNEL / "linux_80211.c").read_text()
+    code = PRELUDE
+    for name in ("lkpi_sta_eapol", "lkpi_sta_m4_check", "lkpi_sta_tx_allowed",
+                 "linuxkpi_ieee80211_sta_tx_permitted"):
+        code += function(source, name)
+    with tempfile.TemporaryDirectory(prefix="station-m4-token-") as temp:
+        path = pathlib.Path(temp)
+        (path / "test.c").write_text(code + TEST)
+        subprocess.run(
+            ["/usr/bin/cc", "-Wall", "-Wextra", "-Werror",
+             "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
+             "-I", str(KERNEL), str(path / "test.c"), "-o", str(path / "test")],
+            check=True)
+        subprocess.run([str(path / "test")], check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sys/tests/linuxkpi_wlan/station_port_test.c b/sys/tests/linuxkpi_wlan/station_port_test.c
new file mode 100644
index 00000000000..76c83f544db
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_port_test.c
@@ -0,0 +1,212 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Native userspace: cc -Wall -Wextra -Werror station_port_test.c -o <own-obj>/station_port_test
+ * Optional kernel test selector: SRCS='station_port_test.c opt_wlan.h ${LINUXKPI_GENSRCS}'
+ * The kernel variant also checks the actual net80211/Linux PN conversion.
+ */
+#ifdef _KERNEL
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/module.h>
+#include <sys/systm.h>
+#include <sys/socket.h>
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_media.h>
+#include <net/ethernet.h>
+#include <net80211/ieee80211_var.h>
+#define LINUXKPI_NET80211
+#include <net/mac80211.h>
+#else
+#include <stdio.h>
+#include <string.h>
+#include <errno.h>
+#endif
+#include "../../compat/linuxkpi/common/src/linux_80211_sta.h"
+
+#define CHECK(x) do {							\
+	if (!(x)) {							\
+		printf("station_port_test:%d: %s\n", __LINE__, #x);	\
+		return (EINVAL);					\
+	}								\
+} while (0)
+
+static void
+key_frame(uint8_t e[99], unsigned int info, uint64_t replay)
+{
+	memset(e, 0, 99);
+	e[0] = 2;
+	e[1] = 3;
+	e[3] = 95;
+	e[4] = 2;
+	e[5] = info >> 8;
+	e[6] = info;
+	for (int i = 16; i >= 9; i--, replay >>= 8)
+		e[i] = replay;
+}
+
+static int
+station_port_test(void)
+{
+	struct lkpi_sta_port p = {};
+	uint8_t e[99];
+	uint8_t nonce[32] = { 1 };
+	uint64_t replay;
+	uint32_t epoch;
+
+	CHECK(!lkpi_sta_port_ready(&p));
+	lkpi_sta_port_key(&p, 99, false, true, true);
+	CHECK(p.failed && !lkpi_sta_port_ready(&p));
+	lkpi_sta_port_reset(&p);
+	CHECK(lkpi_sta_port_m3(&p, 7, nonce));
+	epoch = p.epoch;
+	/* Neither installed-key flags nor a lone M4 ACK opens the port. */
+	lkpi_sta_port_key(&p, 0, true, true, true);
+	lkpi_sta_port_key(&p, 1, false, true, true);
+	CHECK(!lkpi_sta_port_ready(&p));
+	CHECK(!lkpi_sta_port_ack(&p, epoch - 1, 7));
+	CHECK(!lkpi_sta_port_ack(&p, epoch, 6));
+	CHECK(!lkpi_sta_port_ack(&p, epoch, 8));
+	CHECK(lkpi_sta_port_ack(&p, epoch, 7));
+	CHECK(lkpi_sta_port_ready(&p));
+	/* A retransmitted M3 cannot reset packet numbers or installed-key proof. */
+	CHECK(!lkpi_sta_port_m3(&p, 7, nonce));
+	CHECK(!lkpi_sta_port_m3(&p, 6, nonce));
+	CHECK(p.epoch == epoch && lkpi_sta_port_ready(&p));
+	/* A new pairwise exchange revokes all old proof, including delayed ACKs. */
+	nonce[0]++;
+	CHECK(lkpi_sta_port_m3(&p, 8, nonce));
+	CHECK(!lkpi_sta_port_ready(&p));
+	CHECK(!lkpi_sta_port_ack(&p, epoch, 7));
+	CHECK(lkpi_sta_port_ack(&p, p.epoch, 8));
+	lkpi_sta_port_key(&p, 0, true, true, true);
+	CHECK(!lkpi_sta_port_ready(&p));
+	lkpi_sta_port_key(&p, 2, false, true, false);
+	CHECK(!lkpi_sta_port_ready(&p));
+	/* Install/replay/firmware failure stays closed until another exchange. */
+	lkpi_sta_port_key(&p, 2, false, true, true);
+	CHECK(!lkpi_sta_port_ready(&p));
+	nonce[0]++;
+	CHECK(lkpi_sta_port_m3(&p, 9, nonce));
+	lkpi_sta_port_key(&p, 0, true, true, true);
+	lkpi_sta_port_key(&p, 2, false, true, true);
+	CHECK(!lkpi_sta_port_ready(&p));
+	CHECK(lkpi_sta_port_ack(&p, p.epoch, 9));
+	CHECK(lkpi_sta_port_ready(&p));
+	/* AP retry with the same ANonce and advanced replay must not require
+	 * a forbidden key reinstall or accept the previous completion. */
+	epoch = p.epoch;
+	CHECK(lkpi_sta_port_m3(&p, 10, nonce));
+	CHECK(!lkpi_sta_port_ready(&p));
+	CHECK(!lkpi_sta_port_ack(&p, epoch, 9));
+	CHECK(lkpi_sta_port_ack(&p, p.epoch, 10));
+	CHECK(lkpi_sta_port_ready(&p));
+	/* GTK rotation retains completed controlled-port exchange, not old slots. */
+	lkpi_sta_port_key(&p, 1, false, true, true);
+	lkpi_sta_port_key(&p, 2, false, false, true);
+	CHECK(lkpi_sta_port_ready(&p));
+	lkpi_sta_port_key(&p, 1, false, false, true);
+	CHECK(!lkpi_sta_port_ready(&p));
+	epoch = p.epoch;
+	lkpi_sta_port_key(&p, 0, true, false, true);
+	CHECK(!lkpi_sta_port_ack(&p, epoch, 10));
+	CHECK(!lkpi_sta_port_ready(&p));
+	/* Disconnect/explicit unauthorize invalidates every outstanding token. */
+	CHECK(lkpi_sta_port_m3(&p, 11, nonce));
+	epoch = p.epoch;
+	lkpi_sta_port_reset(&p);
+	CHECK(!lkpi_sta_port_ack(&p, epoch, 11));
+
+	/* A fresh association needs its own ACK even after successful key setup. */
+	CHECK(lkpi_sta_port_m3(&p, 12, nonce));
+	lkpi_sta_port_key(&p, 0, true, true, true);
+	lkpi_sta_port_key(&p, 1, false, true, true);
+	CHECK(!lkpi_sta_port_ready(&p));
+	CHECK(lkpi_sta_port_ack(&p, p.epoch, 12));
+	CHECK(lkpi_sta_port_ready(&p));
+
+	/* Real RSN EAPOL-Key fixed-header parsing, no mock decoder. */
+	key_frame(e, 0x03ca, 0x0102030405060708ULL);
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 3);
+	CHECK(replay == 0x0102030405060708ULL);
+	key_frame(e, 0x030a, 42);
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 4 && replay == 42);
+	for (unsigned int n = 0; n < sizeof(e); n++)
+		CHECK(lkpi_sta_port_eapol(e, n, &replay) == 0);
+	key_frame(e, 0x010a, 42);	/* M2, not secure. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	key_frame(e, 0x0302, 42);	/* Group rekey reply is not pairwise M4. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	key_frame(e, 0x030b, 42);	/* Unsupported descriptor version. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	key_frame(e, 0x130a, 42);	/* M4 cannot carry encrypted key data. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	key_frame(e, 0x070a, 42);	/* Error. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	key_frame(e, 0x0b0a, 42);	/* Request. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	key_frame(e, 0x030a, 42);
+	e[98] = 1;		/* Inconsistent key-data length. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	e[98] = 0;
+	e[2] = 1;		/* Truncated advertised body. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+	e[2] = 0;
+	e[4] = 254;		/* WPA1 descriptor. */
+	CHECK(lkpi_sta_port_eapol(e, 99, &replay) == 0);
+
+#ifdef _KERNEL
+	{
+		struct ieee80211_key nk = {};
+		struct ieee80211_key_conf key = {
+			.cipher = WLAN_CIPHER_SUITE_CCMP, ._k = &nk
+		};
+		struct ieee80211_key_seq seq = {};
+		const uint8_t expected[] = { 1, 2, 3, 4, 5, 6 };
+
+		nk.wk_keyrsc[IEEE80211_NUM_TIDS] = 0x010203040506ULL;
+		ieee80211_get_key_rx_seq(&key, -1, &seq);
+		CHECK(memcmp(seq.ccmp.pn, expected, sizeof(expected)) == 0);
+		ieee80211_set_key_rx_seq(&key, 3, &seq);
+		CHECK(nk.wk_keyrsc[3] == 0x010203040506ULL);
+		memset(seq.ccmp.pn, 0, sizeof(seq.ccmp.pn));
+		ieee80211_set_key_rx_seq(&key, 3, &seq);
+		CHECK(nk.wk_keyrsc[3] == 0x010203040506ULL);
+		key.cipher = WLAN_CIPHER_SUITE_GCMP;
+		ieee80211_get_key_rx_seq(&key, 3, &seq);
+		CHECK(memcmp(seq.gcmp.pn, expected, sizeof(expected)) == 0);
+	}
+#endif
+	printf("station_port_test: ordering, rekey, stale ACK and failure cases passed\n");
+	return (0);
+}
+
+#ifdef _KERNEL
+static int
+station_port_event(module_t mod __unused, int event, void *arg __unused)
+{
+	switch (event) {
+	case MOD_LOAD:
+		return (station_port_test());
+	case MOD_UNLOAD:
+		return (0);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+static moduledata_t station_port_mod = {
+	"lkpi_station_port_test", station_port_event, NULL
+};
+DECLARE_MODULE(lkpi_station_port_test, station_port_mod, SI_SUB_DRIVERS, SI_ORDER_MIDDLE);
+MODULE_VERSION(lkpi_station_port_test, 1);
+MODULE_DEPEND(lkpi_station_port_test, linuxkpi, 1, 1, 1);
+MODULE_DEPEND(lkpi_station_port_test, linuxkpi_wlan, 1, 1, 1);
+MODULE_DEPEND(lkpi_station_port_test, wlan, 1, 1, 1);
+#else
+int
+main(void)
+{
+	return (station_port_test());
+}
+#endif
diff --git a/sys/tests/linuxkpi_wlan/station_port_worker_test.py b/sys/tests/linuxkpi_wlan/station_port_worker_test.py
new file mode 100644
index 00000000000..ae255db47fa
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_port_worker_test.py
@@ -0,0 +1,180 @@
+#!/usr/bin/env python3
+"""Exercise the real controlled-port worker and its strict M4 ACK gate."""
+
+import pathlib
+import subprocess
+import tempfile
+
+from regulatory_production_test import function
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+KERNEL = ROOT / "sys/compat/linuxkpi/common/src"
+
+PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "linux_80211_sta.h"
+#ifndef __unused
+#define __unused __attribute__((unused))
+#endif
+#define IEEE80211_STA_ASSOC 3
+#define IEEE80211_STA_AUTHORIZED 4
+#define IEEE80211_S_RUN 5
+#define IEEE80211_NODE_AUTH 1
+#define LINK_STATE_DOWN 0
+#define LINK_STATE_UP 1
+#define atomic_load_acq_int(p) (*(p))
+#define atomic_store_rel_int(p,v) (*(p) = (v))
+#define LKPI_80211_LSTA_TXQ_LOCK(s) do { assert(!(s)->locked); (s)->locked = true; } while (0)
+#define LKPI_80211_LSTA_TXQ_UNLOCK(s) do { assert((s)->locked); (s)->locked = false; } while (0)
+struct wiphy { bool locked, reg_allowed; };
+struct ieee80211_hw { struct wiphy *wiphy; };
+struct lkpi_hw { struct ieee80211_hw *hw; };
+struct ieee80211com { struct lkpi_hw *ic_softc; };
+struct ieee80211vap {
+    struct ieee80211com *iv_ic;
+    int iv_state;
+    void *iv_ifp;
+    struct lkpi_vif *lvif;
+};
+struct ieee80211_vif { struct { bool assoc; } cfg; };
+struct ieee80211_node { struct ieee80211vap *ni_vap; unsigned ni_flags; };
+struct lkpi_sta {
+    struct ieee80211_hw *hw;
+    struct ieee80211_node *ni;
+    struct lkpi_sta_port port;
+    unsigned port_open, port_key_busy;
+    bool locked, guarded;
+    int state;
+};
+struct lkpi_vif {
+    struct ieee80211vap iv_vap;
+    struct lkpi_sta *lvif_bss;
+    unsigned port_dead;
+    bool lvif_bss_synched;
+    struct ieee80211_vif vif;
+};
+#define LHW_TO_HW(h) ((h)->hw)
+#define VAP_TO_LVIF(v) ((v)->lvif)
+#define LVIF_TO_VIF(v) (&(v)->vif)
+static unsigned authorizations, publications;
+static int link_state, inject;
+static void wiphy_lock(struct wiphy *w) { assert(!w->locked); w->locked = true; }
+static void wiphy_unlock(struct wiphy *w) { assert(w->locked); w->locked = false; }
+#define lockdep_assert_wiphy(w) assert((w)->locked)
+static bool lkpi_sta_port_enabled(struct lkpi_sta *s) { return s->guarded; }
+static bool lkpi_reg_tx_allowed(struct wiphy *w) { return w->reg_allowed; }
+static void if_link_state_change(void *ifp, int state)
+{ assert(ifp != NULL); link_state = state; }
+static void ieee80211_node_authorize(struct ieee80211_node *ni)
+{
+    struct lkpi_sta *s = ni->ni_vap->lvif->lvif_bss;
+    assert(s->port_open && s->state == IEEE80211_STA_AUTHORIZED);
+    assert(!s->port_key_busy && !s->port.failed);
+    publications++; ni->ni_flags |= IEEE80211_NODE_AUTH;
+}
+static int lkpi_80211_mo_sta_state(struct ieee80211_hw *hw,
+    struct ieee80211_vif *vif, struct lkpi_sta *s, int state)
+{
+    assert(hw->wiphy->locked && !s->locked && vif->cfg.assoc);
+    if (state == IEEE80211_STA_AUTHORIZED) {
+        assert(!s->port_open && lkpi_sta_port_ready(&s->port));
+        authorizations++;
+        if (inject == 1) return -1;
+        if (inject == 2) s->port.epoch++;
+        if (inject == 3) hw->wiphy->reg_allowed = false;
+        if (inject == 4) s->port.failed = true;
+        if (inject == 5) s->port_key_busy = 1;
+    }
+    s->state = state;
+    return 0;
+}
+"""
+
+TEST = r"""
+int main(void)
+{
+    uint8_t nonce[32] = { 1 };
+    for (int scenario = 0; scenario < 17; scenario++) {
+        struct wiphy w = { .reg_allowed = true };
+        struct ieee80211_hw hw = { .wiphy = &w };
+        struct lkpi_hw lhw = { .hw = &hw };
+        struct ieee80211com ic = { .ic_softc = &lhw };
+        struct lkpi_vif vif = { .iv_vap.iv_ic = &ic,
+            .iv_vap.iv_state = IEEE80211_S_RUN,
+            .lvif_bss_synched = true, .vif.cfg.assoc = true };
+        struct ieee80211_node ni = { .ni_vap = &vif.iv_vap };
+        struct lkpi_sta sta = { .hw = &hw, .ni = &ni, .guarded = true,
+            .state = IEEE80211_STA_ASSOC };
+        vif.iv_vap.lvif = &vif; vif.iv_vap.iv_ifp = &vif;
+        vif.lvif_bss = &sta;
+        lkpi_sta_port_reset(&sta.port);
+        assert(lkpi_sta_port_m3(&sta.port, 42, nonce));
+        lkpi_sta_port_key(&sta.port, 0, true, true, true);
+        lkpi_sta_port_key(&sta.port, 1, false, true, true);
+        if (scenario != 1)
+            assert(lkpi_sta_port_ack(&sta.port, sta.port.epoch, 42));
+        inject = 0; authorizations = publications = 0;
+        link_state = LINK_STATE_DOWN;
+        if (scenario == 2) sta.port.pairwise = 0;
+        if (scenario == 3) sta.port.group = 0;
+        if (scenario == 4) sta.port.failed = true;
+        if (scenario == 5) sta.port_key_busy = 1;
+        if (scenario == 6) vif.iv_vap.iv_state = 0;
+        if (scenario == 7) vif.lvif_bss_synched = false;
+        if (scenario == 8) vif.vif.cfg.assoc = false;
+        if (scenario == 9) w.reg_allowed = false;
+        if (scenario == 10) vif.port_dead = 1;
+        if (scenario == 11) sta.guarded = false;
+        if (scenario >= 12 && scenario <= 16) inject = scenario - 11;
+        lkpi_sta_port_task(&vif, 0);
+        bool success = scenario == 0;
+        assert(!w.locked && !sta.locked);
+        assert(sta.port_open == success && publications == success);
+        assert((link_state == LINK_STATE_UP) == success);
+        assert(((ni.ni_flags & IEEE80211_NODE_AUTH) != 0) == success);
+        assert(sta.port.acked == (scenario != 1));
+        assert(authorizations == (success || scenario >= 12 ? 1U : 0U));
+        if (scenario == 12) assert(sta.port.failed);
+        if (!success) continue;
+        /* Repeated worker execution cannot close the opened initial port. */
+        lkpi_sta_port_task(&vif, 0);
+        assert(sta.port_open && authorizations == 1);
+        /* A new PTK exchange needs its own matching ACK. */
+        uint8_t other[32] = { 2 };
+        assert(lkpi_sta_port_m3(&sta.port, 43, other));
+        sta.port_open = 0;
+        lkpi_sta_port_key(&sta.port, 0, true, true, true);
+        lkpi_sta_port_key(&sta.port, 1, false, true, true);
+        lkpi_sta_port_task(&vif, 0);
+        assert(!sta.port_open && !sta.port.acked);
+        assert(lkpi_sta_port_ack(&sta.port, sta.port.epoch, 43));
+        lkpi_sta_port_task(&vif, 0);
+        assert(sta.port_open && authorizations == 2);
+    }
+    puts("production port worker: strict ACK gate, firmware failures, epoch/regulatory/key fencing and rekey passed");
+    return 0;
+}
+"""
+
+
+def main():
+    source = (KERNEL / "linux_80211.c").read_text()
+    code = PRELUDE + function(source, "lkpi_sta_port_close")
+    code += function(source, "lkpi_sta_port_task") + TEST
+    with tempfile.TemporaryDirectory(prefix="station-port-worker-") as temp:
+        path = pathlib.Path(temp)
+        (path / "test.c").write_text(code)
+        subprocess.run(
+            ["/usr/bin/cc", "-Wall", "-Wextra", "-Werror",
+             "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
+             "-I", str(KERNEL), str(path / "test.c"), "-o", str(path / "test")],
+            check=True)
+        subprocess.run([str(path / "test")], check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
