+static int
+mhi_ce_test(struct mhi_controller *ctrl)
+{
+	static const uint32_t shadow[7] = {
+		0x1b80400, 0x1b83400, 0x1b8340c, 0x1b85400,
+		0x1b8540c, 0x1b86400, 0x1b88400
+	};
+	static const uint32_t entries[7] = { 16, 512, 512, 64, 64, 32, 2048 };
+	static const uint32_t widths[7] = { 16, 8, 16, 8, 16, 16, 16 };
+	struct mhi_lab_ce ce = { 0 };
+	struct mhi_ce_model *model;
+	struct mhi_lab_ce_ring *ring;
+	unsigned int pass, i, writes;
+	uint32_t offset, pointer;
+	int expected, error = 0;
+
+	model = malloc(sizeof(*model), M_TEMP, M_WAITOK);
+	CHECK(linuxkpi_mhi_alloc_context(ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+	for (pass = 0; pass < 4; pass++) {
+		memset(model, 0, sizeof(*model));
+		CHECK(mhi_lab_ce_alloc(ctrl, &ce) == 0);
+		CHECK(mhi_lab_ce_alloc(ctrl, &ce) == EBUSY);
+		CHECK(memcmp(ce.shadow, shadow, sizeof(shadow)) == 0);
+		for (i = 0; i < nitems(ce.ring); i++)
+			CHECK(ce.ring[i].dma.size == entries[i] * widths[i] &&
+			    (ce.ring[i].dma.address & 7) == 0);
+		CHECK(mhi_lab_ce_init(ctrl, &ce, mhi_ce_model_register, model) ==
+		    EPROTO && model->writes == 0);
+		ctrl->lkpi_context->published = true;
+		expected = 0;
+		if (pass == 0) {
+			model->regs[(ce.ring[6].base + 0x10 - 0x1b80000) / 4] = 0x40;
+			expected = EBUSY;
+		} else if (pass == 1) {
+			model->fail_at = 17;
+			expected = EIO;
+		} else if (pass == 2) {
+			model->corrupt = ce.ring[0].base + 0x48;
+			expected = EIO;
+		}
+		CHECK(mhi_lab_ce_init(ctrl, &ce, mhi_ce_model_register, model) == expected);
+		CHECK(ce.initialized == (pass == 3));
+		if (pass == 0)
+			CHECK(model->writes == 0);
+		if (pass == 3) {
+			for (i = 0; i < nitems(ce.ring); i++) {
+				ring = &ce.ring[i];
+				offset = (ring->base - 0x1b80000) / 4;
+				pointer = ring->kind == MHI_LAB_CE_STATUS ? 0x14 : 0x1c;
+				CHECK(model->regs[offset] == ring->dma.address &&
+				    model->regs[offset + 1] == (entries[i] * widths[i] / 4 << 8) &&
+				    model->regs[offset + pointer / 4] ==
+				    ce.rdp.address + 4 * ring->id &&
+				    model->regs[offset + 0x4c / 4] == 0 &&
+				    (model->regs[offset + 0x10 / 4] & 0x40) != 0);
+			}
+			writes = model->writes;
+			CHECK(mhi_lab_ce_init(ctrl, &ce, mhi_ce_model_register, model) ==
+			    EPROTO && model->writes == writes);
+		}
+		CHECK(mhi_lab_ce_free(ctrl, &ce) == EBUSY &&
+		    ce.ring[6].dma.tag != NULL && ce.rdp.tag != NULL);
+		ctrl->lkpi_context->published = false;
+		if (ce.touched) {
+			CHECK(mhi_lab_ce_free(ctrl, &ce) == EBUSY);
+			if (pass == 1 || pass == 3)
+				CHECK(mhi_lab_ce_reset_check(ctrl, &ce,
+				    mhi_ce_model_register, model) == EBUSY);
+		}
+		/* Fake hardware is now reset; no real MMIO was performed. */
+		memset(model, 0, sizeof(*model));
+		CHECK(mhi_lab_ce_reset_check(ctrl, &ce,
+		    mhi_ce_model_register, model) == 0);
+		CHECK(mhi_lab_ce_free(ctrl, &ce) == 0 && ce.rdp.tag == NULL);
+	}
+out:
+	if (ctrl->lkpi_context != NULL) {
+		ctrl->lkpi_context->published = false;
+		memset(model, 0, sizeof(*model));
+		(void)mhi_lab_ce_reset_check(ctrl, &ce, mhi_ce_model_register, model);
+		(void)mhi_lab_ce_free(ctrl, &ce);
+		linuxkpi_mhi_free_context(ctrl);
+	}
+	free(model, M_TEMP);
+	if (error == 0)
+		printf("lkpi_mhi_test: CE geometry/shadows, register layout, active-ring refusal, partial/readback errors and reset-before-free passed (model only)\n");
+	return (error);
+}
