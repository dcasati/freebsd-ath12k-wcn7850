+#!/usr/bin/env python3
+"""Hardware-free tests of extracted production regulatory C functions.
+
+Use --objdir with an isolated project build directory. Before the parent glue
+patch is applied, --glue-source may name its generated validation candidate.
+Only kernel allocation, locks, atomics and WMI submission are modeled. The rule,
+channel, duplicate-event, ordered submission and readiness functions are read
+from the actual production sources, not reimplemented in this test.
+"""
+
+import argparse
+import pathlib
+import re
+import subprocess
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+
+
+def declaration(text, name):
+    start = text.index(name)
+    brace = text.index("{", start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:text.index(";", end) + 1]
+
+
+def function(text, name):
+    match = re.search(r"\b" + name + r"\s*\([^;]*?\)\s*\{", text, re.S)
+    if not match:
+        raise RuntimeError(f"{name} missing: apply the regulatory glue patch first")
+    start = text.rfind("\n", 0, match.start()) + 1
+    if not text[start:match.start()].strip():
+        start = text.rfind("\n", 0, start - 1) + 1
+    brace = text.index("{", match.start())
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end] + "\n"
+
+
+PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <errno.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef unsigned int u_int;
+#ifndef __packed
+#define __packed __attribute__((__packed__))
+#endif
+#ifndef ENODATA
+#define ENODATA ECONNREFUSED
+#endif
+#define BIT(n) (1U << (n))
+#define nitems(x) (sizeof(x) / sizeof((x)[0]))
+#define min(a,b) ((a) < (b) ? (a) : (b))
+#define max(a,b) ((a) > (b) ? (a) : (b))
+#define min_t(t,a,b) min((t)(a), (t)(b))
+#define MHZ_TO_KHZ(x) ((x) * 1000)
+#define KHZ_TO_MHZ(x) ((x) / 1000)
+#define DBI_TO_MBI(x) ((x) * 100)
+#define DBM_TO_MBM(x) ((x) * 100)
+#define GFP_KERNEL 0
+#define GFP_ATOMIC 0
+#define kzalloc(n,f) calloc(1,n)
+#define kzalloc_flex(o,m,n) calloc(1, sizeof(o) + (n) * sizeof((o).m[0]))
+#define kfree(p) free(p)
+#define REG_ALPHA2_LEN 2
+#define U16_MAX UINT16_MAX
+#define REGULATORY_WIPHY_SELF_MANAGED 1
+#define NL80211_RRF_NO_HT40 (NL80211_RRF_NO_HT40PLUS | NL80211_RRF_NO_HT40MINUS)
+#define IEEE80211_CHAN_NO_HT40 (IEEE80211_CHAN_NO_HT40PLUS | IEEE80211_CHAN_NO_HT40MINUS)
+#define atomic_load_acq_int(p) __atomic_load_n((p), __ATOMIC_ACQUIRE)
+#define atomic_swap_int(p,v) __atomic_exchange_n((p), (v), __ATOMIC_ACQ_REL)
+#define atomic_cmpset_int(p,o,n) __sync_bool_compare_and_swap((p),(o),(n))
+#define atomic_cmpset_rel_int(p,o,n) atomic_cmpset_int(p,o,n)
+#define sx_xlock(p) ((void)(p))
+#define sx_xunlock(p) ((void)(p))
+#define rcu_dereference_protected(p,c) (p)
+#define lockdep_assert_wiphy(p) ((void)(p))
+#define ath12k_warn(...) ((void)0)
+"""
+
+MOCKS = r"""
+#define ieee80211_regdomain linuxkpi_ieee80211_regdomain
+#define ieee80211_channel linuxkpi_ieee80211_channel
+struct ieee80211_supported_band {
+    struct ieee80211_channel *channels;
+    int n_channels;
+};
+struct lkpi_wiphy {
+    int reg_sx;
+    unsigned reg_tx_ready;
+    bool reg_failed;
+    const struct ieee80211_regdomain *regd_owned;
+};
+struct wiphy {
+    bool lkpi_regulatory_strict;
+    unsigned regulatory_flags;
+    const struct ieee80211_regdomain *regd;
+    struct lkpi_wiphy *owner;
+    struct ieee80211_supported_band *bands[NUM_NL80211_BANDS];
+};
+#define WIPHY_TO_LWIPHY(w) ((w)->owner)
+struct ieee80211_hw { struct wiphy *wiphy; };
+struct ath12k_base {
+    struct ath12k_reg_freq reg_freq_2ghz, reg_freq_5ghz, reg_freq_6ghz;
+};
+struct ath12k_reg_info {
+    char alpha2[3];
+    unsigned dfs_region, phybitmap, status_code;
+    u32 min_bw_2g, max_bw_2g, min_bw_5g, max_bw_5g;
+    u32 num_2g_reg_rules, num_5g_reg_rules;
+    struct ath12k_reg_rule *reg_rules_2g_ptr, *reg_rules_5g_ptr;
+};
+struct ath12k_hw { int num_radio, state; struct ieee80211_hw *hw; };
+struct pdev { unsigned pdev_id; };
+struct ath12k {
+    struct ath12k_base *ab;
+    struct ath12k_hw *ah;
+    struct pdev *pdev;
+    struct { u32 start_freq, end_freq; } freq_range;
+    struct { struct ieee80211_supported_band sbands[NUM_NL80211_BANDS]; } mac;
+    u32 min_tx_power, max_tx_power, txpower_limit_2g, txpower_limit_5g;
+};
+#define ATH12K_HW_STATE_RESTARTING 3
+#define WMI_PDEV_PARAM_TXPOWER_LIMIT2G 2
+#define WMI_PDEV_PARAM_TXPOWER_LIMIT5G 5
+#define REG_SET_CC_STATUS_PASS 0
+#define ath12k_ar_to_hw(ar) ((ar)->ah->hw)
+static int commands, fail_command, revoke_command;
+static struct wiphy *active_wiphy;
+static int ath12k_wmi_send_scan_chan_list_cmd(struct ath12k *,
+    struct ath12k_wmi_scan_chan_list_arg *);
+static int ath12k_wmi_pdev_set_param(struct ath12k *, u32, u32, u32);
+"""
+
+TESTS = r"""
+static unsigned assertions;
+#define CHECK(c) do { assertions++; if (!(c)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #c); return 1; } } while (0)
+
+static int command(void)
+{
+    commands++;
+    if (commands == revoke_command)
+        linuxkpi_regulatory_revoke(active_wiphy);
+    return commands == fail_command ? -EIO : 0;
+}
+static int ath12k_wmi_send_scan_chan_list_cmd(struct ath12k *ar,
+    struct ath12k_wmi_scan_chan_list_arg *arg)
+{
+    assert(!linuxkpi_regulatory_tx_permitted(active_wiphy));
+    assert(commands == 0 && arg->nallchans == 2 && arg->pdev_id == ar->pdev->pdev_id);
+    assert(arg->channel[0].maxpower == 38 && arg->channel[1].maxpower == 46);
+    assert(!arg->channel[0].allow_he && !arg->channel[1].allow_he);
+    assert(arg->channel[0].cfreq2 == 0 && arg->channel[1].cfreq2 == 0);
+    return command();
+}
+static int ath12k_wmi_pdev_set_param(struct ath12k *ar, u32 id, u32 power, u32 pdev)
+{
+    assert(!linuxkpi_regulatory_tx_permitted(active_wiphy));
+    assert(pdev == ar->pdev->pdev_id);
+    assert((commands == 1 && id == 2 && power == 38) ||
+           (commands == 2 && id == 5 && power == 46));
+    return command();
+}
+int main(void)
+{
+    struct ath12k_reg_rule raw = {
+        .start_freq = 2402, .end_freq = 2472, .max_bw = 40,
+        .reg_power = 20, .ant_gain = 3
+    }, rules[2];
+    struct ieee80211_reg_rule rule;
+    struct ath12k_wmi_channel_arg wire;
+    struct ieee80211_channel channel = {
+        .band = NL80211_BAND_2GHZ, .center_freq = 2412, .max_power = 30
+    }, eligible[2];
+    struct ath12k_reg_info info = {
+        .alpha2 = "US", .max_bw_2g = 40, .max_bw_5g = 80,
+        .num_2g_reg_rules = 1, .reg_rules_2g_ptr = &raw
+    }, copy;
+    struct ath12k_base ab = {0};
+    struct ieee80211_regdomain *domain, *built;
+    struct lkpi_wiphy owner = {0};
+    struct wiphy wiphy = {.lkpi_regulatory_strict = true,
+        .regulatory_flags = REGULATORY_WIPHY_SELF_MANAGED, .owner = &owner};
+    struct ieee80211_supported_band bands[2] = {0};
+    struct ieee80211_hw hw = {.wiphy = &wiphy};
+    struct ath12k_hw ah = {.num_radio = 1, .hw = &hw};
+    struct pdev pdev = {.pdev_id = 7};
+    struct ath12k ar = {.ab = &ab, .ah = &ah, .pdev = &pdev,
+        .freq_range = {2402000, 5900000}, .max_tx_power = 30};
+
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0);
+    CHECK(rule.freq_range.max_bandwidth_khz == 40000 &&
+        !(rule.flags & (NL80211_RRF_NO_HT40 | NL80211_RRF_NO_80MHZ)) &&
+        (rule.flags & NL80211_RRF_NO_160MHZ) &&
+        rule.power_rule.max_eirp == 2000 && rule.power_rule.max_antenna_gain == 300);
+    raw.max_bw = 160;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 160, 0, &rule) == 0 &&
+        rule.freq_range.max_bandwidth_khz == 80000);
+    raw.max_bw = 40;
+    raw.flags = REGULATORY_CHAN_NO_80MHZ;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_80MHZ) && !(rule.flags & NL80211_RRF_NO_HT40));
+    raw.flags = REGULATORY_CHAN_DISABLED;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    raw.flags = REGULATORY_CHAN_NO_20MHZ;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    raw.flags = BIT(15);
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    raw.flags = 0; raw.psd_flag = true;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_PSD));
+    raw.psd_flag = false;
+    CHECK(ath12k_reg_prepare_rule(&raw, 40, 80, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 0, 0, &rule) == -EINVAL);
+    built = ath12k_reg_build_station_regd(&ab, &info);
+    CHECK(built && built->n_reg_rules == 1 && built->alpha2[1] == 'S');
+    CHECK(ab.reg_freq_2ghz.start_freq == 2402 && ab.reg_freq_6ghz.end_freq == 0);
+    free(built);
+    info.num_2g_reg_rules = 129;
+    CHECK(!ath12k_reg_build_station_regd(&ab, &info));
+    info.num_2g_reg_rules = 1;
+    copy = info;
+    CHECK(ath12k_reg_same_station_info(&info, &copy));
+    rules[0] = raw; copy.reg_rules_2g_ptr = rules;
+    rules[0].reg_power--;
+    CHECK(!ath12k_reg_same_station_info(&info, &copy));
+    rules[0] = raw; rules[0].flags = REGULATORY_CHAN_NO_IR;
+    CHECK(!ath12k_reg_same_station_info(&info, &copy));
+
+    domain = calloc(1, sizeof(*domain) + 2 * sizeof(domain->reg_rules[0]));
+    CHECK(domain != NULL);
+    domain->n_reg_rules = 2;
+    domain->alpha2[0] = 'U'; domain->alpha2[1] = 'S';
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &domain->reg_rules[0]) == 0);
+    domain->reg_rules[0].power_rule.max_eirp = 1999;
+    rules[1] = raw; rules[1].start_freq = 5170; rules[1].end_freq = 5250;
+    rules[1].reg_power = 23; rules[1].max_bw = 80;
+    CHECK(ath12k_reg_prepare_rule(&rules[1], 20, 80, 0, &domain->reg_rules[1]) == 0);
+    CHECK(lkpi_regulatory_channel(domain, &channel, &eligible[0]) == 0);
+    channel.band = NL80211_BAND_5GHZ; channel.center_freq = 5180;
+    CHECK(lkpi_regulatory_channel(domain, &channel, &eligible[1]) == 0);
+    CHECK((eligible[0].flags & IEEE80211_CHAN_NO_HT40) == IEEE80211_CHAN_NO_HT40 &&
+        (eligible[0].flags & IEEE80211_CHAN_NO_80MHZ));
+    CHECK(!(eligible[1].flags & (IEEE80211_CHAN_NO_HT40PLUS | IEEE80211_CHAN_NO_80MHZ)) &&
+        (eligible[1].flags & IEEE80211_CHAN_NO_HT40MINUS) &&
+        (eligible[1].flags & IEEE80211_CHAN_NO_160MHZ));
+    CHECK(ath12k_reg_prepare_channel(&eligible[1], 0, 30, &wire) == 0 &&
+        wire.phy_mode == MODE_11NA_HT20 && wire.allow_vht && !wire.allow_he);
+    channel = eligible[0]; channel.flags &= ~IEEE80211_CHAN_NO_HT40;
+    CHECK(ath12k_reg_prepare_channel(&channel, 0, 30, &wire) == -EOPNOTSUPP);
+    channel = eligible[1]; channel.flags &= ~IEEE80211_CHAN_NO_160MHZ;
+    CHECK(ath12k_reg_prepare_channel(&channel, 0, 30, &wire) == -EOPNOTSUPP);
+    CHECK(ath12k_reg_prepare_channel(&eligible[0], 0, 30, &wire) == 0 &&
+        wire.maxpower == 38 && wire.antennamax == 6 && !wire.allow_he);
+    CHECK(ath12k_reg_prepare_channel(&eligible[0], 20, 30, &wire) == -ERANGE);
+    CHECK(ath12k_reg_prepare_channel(&eligible[0], 0, 18, &wire) == -ERANGE);
+    channel = eligible[0]; channel.flags |= IEEE80211_CHAN_NO_IR;
+    CHECK(ath12k_reg_prepare_channel(&channel, 0, 30, &wire) == 0 && wire.is_chan_passive);
+    for (int i = 0; i < 2; i++) {
+        bands[i].channels = &eligible[i]; bands[i].n_channels = 1;
+        wiphy.bands[i] = &bands[i]; ar.mac.sbands[i] = bands[i];
+    }
+    active_wiphy = &wiphy;
+    wiphy.regd = owner.regd_owned = domain;
+    CHECK(!linuxkpi_regulatory_tx_permitted(&wiphy));
+    CHECK(linuxkpi_regulatory_set_tx_ready(&wiphy, NULL) == -EINVAL);
+    CHECK(ath12k_reg_submit_chan_list(&ar) == 0 &&
+        linuxkpi_regulatory_tx_permitted(&wiphy) && commands == 3);
+    CHECK(ar.txpower_limit_2g == 38 && ar.txpower_limit_5g == 46);
+    for (int failure = 1; failure <= 3; failure++) {
+        owner.reg_tx_ready = 1; commands = 0; fail_command = failure;
+        CHECK(ath12k_reg_submit_chan_list(&ar) == -EIO &&
+            !linuxkpi_regulatory_tx_permitted(&wiphy) && commands == failure);
+        CHECK(linuxkpi_regulatory_set_tx_ready(&wiphy, domain) == -EBUSY);
+    }
+    fail_command = 0;
+    for (int revoked = 1; revoked <= 3; revoked++) {
+        commands = 0; owner.reg_tx_ready = 0; revoke_command = revoked;
+        CHECK(ath12k_reg_submit_chan_list(&ar) == -EBUSY &&
+            !linuxkpi_regulatory_tx_permitted(&wiphy) && commands == revoked);
+    }
+    revoke_command = 0; commands = 0; owner.reg_tx_ready = 0;
+    eligible[0].max_power++; eligible[0].max_reg_power++;
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -ESTALE && commands == 0);
+    eligible[0].max_power--; eligible[0].max_reg_power--;
+    owner.reg_tx_ready = 0; wiphy.regd = NULL;
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -ENODATA && commands == 0);
+    wiphy.regd = domain; owner.reg_tx_ready = 0; ah.num_radio = 2;
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -EOPNOTSUPP && commands == 0);
+    ah.num_radio = 1; owner.reg_tx_ready = 0;
+    wiphy.bands[NL80211_BAND_6GHZ] = &bands[0];
+    ar.mac.sbands[NL80211_BAND_6GHZ] = bands[0];
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -EOPNOTSUPP && commands == 0);
+    wiphy.bands[NL80211_BAND_6GHZ] = NULL;
+    wiphy.lkpi_regulatory_strict = false;
+    CHECK(linuxkpi_regulatory_tx_permitted(&wiphy) &&
+        !linuxkpi_regulatory_revoke(&wiphy));
+    free(domain);
+    printf("regulatory production model: %u assertions passed\n", assertions);
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--objdir", required=True, type=pathlib.Path)
+    parser.add_argument("--glue-source", type=pathlib.Path)
+    parser.add_argument("--sanitize", action="store_true")
+    args = parser.parse_args()
+    obj = args.objdir.resolve()
+    if obj == pathlib.Path("/tmp") or pathlib.Path("/tmp") in obj.parents:
+        parser.error("use a project object directory, not /tmp")
+    obj.mkdir(parents=True, exist_ok=True)
+    cfg = (ROOT / "sys/compat/linuxkpi/common/include/net/cfg80211.h").read_text()
+    nl = (ROOT / "sys/compat/linuxkpi/common/include/linux/nl80211.h").read_text()
+    reg = (ROOT / "sys/contrib/dev/athk/ath12k/reg.c").read_text()
+    rh = (ROOT / "sys/contrib/dev/athk/ath12k/reg.h").read_text()
+    wh = (ROOT / "sys/contrib/dev/athk/ath12k/wmi.h").read_text()
+    core = (ROOT / "sys/contrib/dev/athk/ath12k/core.h").read_text()
+    glue_path = args.glue_source or ROOT / "sys/compat/linuxkpi/common/src/linux_80211.c"
+    glue = glue_path.read_text()
+    definitions = [
+        declaration(nl, "enum nl80211_reg_rule_flags"),
+        declaration(nl, "enum nl80211_band"),
+        declaration(nl, "enum nl80211_dfs_state"),
+        declaration(nl, "enum nl80211_dfs_regions"),
+        declaration(cfg, "enum ieee80211_channel_flags"),
+        declaration(cfg, "struct linuxkpi_ieee80211_channel"),
+        declaration(cfg, "struct ieee80211_reg_rule"),
+        declaration(cfg, "struct linuxkpi_ieee80211_regdomain"),
+        declaration(rh, "enum ath12k_dfs_region"),
+        declaration(rh, "enum ath12k_reg_phy_bitmap"),
+        declaration(rh, "struct ath12k_reg_rule"),
+        declaration(core, "struct ath12k_reg_freq"),
+        declaration(wh, "enum wmi_phy_mode"),
+        declaration(wh, "struct ath12k_wmi_channel_arg"),
+        declaration(wh, "struct ath12k_wmi_scan_chan_list_arg").replace(
+            "struct list_head list;", "void *list[2];"
+        ),
+    ]
+    definitions.extend(re.findall(r"^#define REGULATORY_CHAN_.*$", wh, re.M))
+    bodies = [function(glue, name) for name in (
+        "lkpi_reg_tx_allowed", "linuxkpi_regulatory_tx_permitted",
+        "linuxkpi_regulatory_revoke", "linuxkpi_regulatory_tx_pending",
+        "linuxkpi_regulatory_set_tx_ready", "lkpi_regulatory_span",
+        "lkpi_regulatory_channel",
+    )]
+    bodies.extend(function(reg, name) for name in (
+        "ath12k_map_fw_dfs_region", "ath12k_map_fw_reg_flags",
+        "ath12k_map_fw_phy_flags", "ath12k_reg_prepare_rule",
+        "ath12k_reg_build_station_regd", "ath12k_reg_same_station_info",
+        "ath12k_reg_prepare_channel", "ath12k_reg_submit_chan_list",
+    ))
+    source = obj / "regulatory-model.c"
+    binary = obj / "regulatory-model"
+    try:
+        source.write_text("\n".join([PRELUDE, *definitions, MOCKS, *bodies, TESTS]))
+        sanitize = (["-fsanitize=address,undefined", "-fno-sanitize-recover=all"]
+                    if args.sanitize else [])
+        subprocess.run(["/usr/bin/cc", "-std=gnu17", "-Wall", "-Wextra",
+                        "-Werror", *sanitize, str(source), "-o", str(binary)],
+                       check=True)
+        subprocess.run([str(binary)], check=True)
+    finally:
+        source.unlink(missing_ok=True)
+        binary.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sys/tests/linuxkpi_wlan/regulatory_test.c b/sys/tests/linuxkpi_wlan/regulatory_test.c
new file mode 100644
index 00000000000..e2590724a5d
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/regulatory_test.c
@@ -0,0 +1,288 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/malloc.h>
+#include <sys/module.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_media.h>
+#include <net/ethernet.h>
+#include <net80211/ieee80211_var.h>
+#define LINUXKPI_NET80211
+#include <net/mac80211.h>
+#include "../../compat/linuxkpi/common/src/linux_80211.h"
+
+#define REG_CHECK(condition) do {					\
+	if (!(condition)) {						\
+		printf("lkpi_regulatory_test: line %d: %s\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+static const struct ieee80211_ops regulatory_test_ops = {
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+};
+
+static int
+regulatory_test(void)
+{
+	struct ieee80211_hw *hw;
+	struct linuxkpi_ieee80211_regdomain *regd;
+	const struct linuxkpi_ieee80211_regdomain *published;
+	struct linuxkpi_ieee80211_channel input, output, channels[2];
+	struct ieee80211_supported_band band = {};
+	struct ieee80211_reg_rule saved;
+	int error;
+
+	error = ENOMEM;
+	hw = ieee80211_alloc_hw(0, &regulatory_test_ops);
+	regd = lkpi_get_linuxkpi_ieee80211_regdomain(2);
+	if (hw == NULL || regd == NULL)
+		goto out;
+	hw->wiphy->regulatory_flags = REGULATORY_WIPHY_SELF_MANAGED;
+	regd->alpha2[0] = 'U';
+	regd->alpha2[1] = 'S';
+	regd->n_reg_rules = 1;
+	regd->reg_rules[0] = (struct ieee80211_reg_rule)
+	    REG_RULE(2402, 2472, 40, 3, 20, 0);
+	regd->reg_rules[0].power_rule.max_eirp = 1999;
+	input = (struct linuxkpi_ieee80211_channel) {
+		.band = NL80211_BAND_2GHZ, .center_freq = 2412,
+		.max_power = 30,
+	};
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0);
+	REG_CHECK(output.max_power == 19 && output.max_reg_power == 19 &&
+	    output.max_antenna_gain == 3 && output.orig_mpwr == 30 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40) == IEEE80211_CHAN_NO_HT40);
+	input.max_power = 17;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 17);
+	input.max_power = 30;
+	input.center_freq = 2484;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE &&
+	    (output.flags & IEEE80211_CHAN_DISABLED));
+	input.center_freq = 2412;
+	regd->reg_rules[0].freq_range.start_freq_khz++;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE);
+	regd->reg_rules[0].freq_range.start_freq_khz--;
+
+	regd->n_reg_rules = 2;
+	regd->reg_rules[1] = regd->reg_rules[0];
+	regd->reg_rules[1].power_rule.max_eirp = 1350;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 13);
+	saved = regd->reg_rules[0];
+	regd->reg_rules[0] = regd->reg_rules[1];
+	regd->reg_rules[1] = saved;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 13);
+	regd->reg_rules[1].freq_range.start_freq_khz = 2415000;
+	regd->reg_rules[1].flags = NL80211_RRF_NO_IR;
+	/* An overlapping no-IR rule makes the channel passive, not disabled. */
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_IR) &&
+	    (output.flags & (IEEE80211_CHAN_DISABLED |
+	    IEEE80211_CHAN_RADAR)) == 0);
+
+	regd->n_reg_rules = 1;
+	regd->reg_rules[0].flags = NL80211_RRF_DFS;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & (IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR)) ==
+	    (IEEE80211_CHAN_NO_IR | IEEE80211_CHAN_RADAR) &&
+	    (output.flags & IEEE80211_CHAN_DISABLED) == 0);
+	regd->reg_rules[0].flags = NL80211_RRF_NO_OUTDOOR;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & (IEEE80211_CHAN_DISABLED | IEEE80211_CHAN_NO_IR)) ==
+	    0);
+	regd->reg_rules[0].flags = NL80211_RRF_PSD;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	regd->reg_rules[0].flags = 0;
+	regd->reg_rules[0].freq_range.max_bandwidth_khz = 19999;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	regd->reg_rules[0].freq_range.max_bandwidth_khz = 40000;
+	input.flags = IEEE80211_CHAN_INDOOR_ONLY;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	input.flags = IEEE80211_CHAN_DISABLED;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	input.flags = 0;
+	input.band = NL80211_BAND_6GHZ;
+	input.center_freq = 5955;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	input.band = NL80211_BAND_2GHZ;
+	input.center_freq = 2412;
+
+	regd->reg_rules[0] = (struct ieee80211_reg_rule)
+	    REG_RULE(5170, 5250, 80, 3, 23, 0);
+	input.band = NL80211_BAND_5GHZ;
+	input.center_freq = 5180;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 23);
+	/* 5180 is the lower half of 36/40: HT40+ only. */
+	REG_CHECK((output.flags & (IEEE80211_CHAN_NO_HT40PLUS |
+	    IEEE80211_CHAN_NO_80MHZ)) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40MINUS) &&
+	    (output.flags & IEEE80211_CHAN_NO_160MHZ));
+	/* 5240 is the upper half of 44/48: HT40- only. */
+	input.center_freq = 5240;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0);
+	REG_CHECK((output.flags & (IEEE80211_CHAN_NO_HT40MINUS |
+	    IEEE80211_CHAN_NO_80MHZ)) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40PLUS) &&
+	    (output.flags & IEEE80211_CHAN_NO_160MHZ));
+	regd->reg_rules[0].freq_range.max_bandwidth_khz = 40000;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40MINUS) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	regd->reg_rules[0].freq_range.max_bandwidth_khz = 80000;
+	regd->reg_rules[0].flags = NL80211_RRF_NO_80MHZ;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40MINUS) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	regd->reg_rules[0].flags = 0;
+	/* Driver-forbidden aligned direction is preserved and blocks 80. */
+	input.flags = IEEE80211_CHAN_NO_HT40MINUS;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40) == IEEE80211_CHAN_NO_HT40 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	input.flags = 0;
+	/* 5170-5230: the 36/40 pair fits, 44/48 and the 80 MHz block do not. */
+	regd->reg_rules[0].freq_range.end_freq_khz = 5230000;
+	input.center_freq = 5180;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40PLUS) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40MINUS) &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	input.center_freq = 5220;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40) == IEEE80211_CHAN_NO_HT40 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	regd->reg_rules[0].freq_range.end_freq_khz = 5250000;
+
+	/* Overlapping sibling rules must not be stricter than the primary. */
+	regd->n_reg_rules = 2;
+	input.center_freq = 5180;
+	regd->reg_rules[1] = (struct ieee80211_reg_rule)
+	    REG_RULE(5210, 5250, 20, 3, 23, 0);
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40PLUS) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	regd->reg_rules[1] = (struct ieee80211_reg_rule)
+	    REG_RULE(5190, 5210, 80, 3, 17, 0);
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40) == IEEE80211_CHAN_NO_HT40 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ) &&
+	    output.max_power == 23);
+	regd->reg_rules[1] = (struct ieee80211_reg_rule)
+	    REG_RULE(5230, 5250, 80, 3, 23, NL80211_RRF_DFS);
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40PLUS) == 0 &&
+	    (output.flags & IEEE80211_CHAN_NO_80MHZ));
+	regd->n_reg_rules = 1;
+
+	regd->reg_rules[0].freq_range.end_freq_khz = 5250000;
+	input.center_freq = 5245;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE);
+	input.band = NL80211_BAND_2GHZ;
+	input.center_freq = 2412;
+	regd->reg_rules[0] = saved;
+
+	/* Adjacent AUTO_BW rules must not invent full 20 MHz permission. */
+	regd->n_reg_rules = 2;
+	regd->reg_rules[1] = regd->reg_rules[0];
+	regd->reg_rules[0].flags = regd->reg_rules[1].flags = NL80211_RRF_AUTO_BW;
+	regd->reg_rules[0].freq_range.end_freq_khz = 2412000;
+	regd->reg_rules[1].freq_range.start_freq_khz = 2412000;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE);
+	regd->n_reg_rules = 1;
+	regd->reg_rules[0] = saved;
+
+	channels[0] = input;
+	channels[1] = input;
+	channels[1].center_freq = 2484;
+	band.channels = channels;
+	band.n_channels = nitems(channels);
+	hw->wiphy->bands[NL80211_BAND_2GHZ] = &band;
+	regd->n_reg_rules = 0;
+	REG_CHECK(regulatory_set_wiphy_regd_sync(hw->wiphy, regd) == 0 &&
+	    hw->wiphy->regd == NULL && channels[0].max_power == 30);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, regd) == -EINVAL);
+	REG_CHECK(linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	hw->wiphy->lkpi_regulatory_strict = true;
+	REG_CHECK(!linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_tx_pending(hw->wiphy) == -ENODATA);
+	REG_CHECK(regulatory_set_wiphy_regd(hw->wiphy, regd) == -EINVAL &&
+	    hw->wiphy->regd == NULL && channels[0].max_power == 30);
+	regd->n_reg_rules = 1;
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, regd) == -EINVAL);
+	REG_CHECK(regulatory_set_wiphy_regd(hw->wiphy, regd) == 0);
+	published = hw->wiphy->regd;
+	REG_CHECK(published != regd && published->alpha2[0] == 'U' &&
+	    channels[0].max_power == 19 &&
+	    channels[1].flags & IEEE80211_CHAN_DISABLED);
+	REG_CHECK(atomic_load_acq_int(
+	    &WIPHY_TO_LWIPHY(hw->wiphy)->reg_tx_ready) == 0);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, regd) == -EINVAL);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, published) == 0);
+	REG_CHECK(linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_tx_pending(hw->wiphy) == 0 &&
+	    !linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, published) == 0);
+	REG_CHECK(regulatory_set_wiphy_regd_sync(hw->wiphy, regd) == 0);
+	regd->alpha2[0] = 'C';
+	regd->alpha2[1] = 'A';
+	REG_CHECK(regulatory_set_wiphy_regd_sync_rtnl(hw->wiphy, regd) == -EBUSY);
+	REG_CHECK(atomic_load_acq_int(
+	    &WIPHY_TO_LWIPHY(hw->wiphy)->reg_tx_ready) == 2);
+	REG_CHECK(!linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(!linuxkpi_regulatory_revoke(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_tx_pending(hw->wiphy) == -EBUSY);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, published) == -EBUSY);
+	kfree(regd);
+	regd = NULL;
+	REG_CHECK(published->alpha2[0] == 'U' &&
+	    published->reg_rules[0].power_rule.max_eirp == 1999);
+	error = 0;
+out:
+	kfree(regd);
+	if (hw != NULL)
+		ieee80211_free_hw(hw);
+	return (error);
+}
+
+static int
+regulatory_test_event(module_t module __unused, int event, void *arg __unused)
+{
+	int error;
+
+	switch (event) {
+	case MOD_LOAD:
+		error = regulatory_test();
+		if (error == 0)
+			printf("lkpi_regulatory_test: passed\n");
+		return (error);
+	case MOD_UNLOAD:
+		return (0);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+
+static moduledata_t regulatory_test_module = {
+	"lkpi_regulatory_test", regulatory_test_event, NULL
+};
+DECLARE_MODULE(lkpi_regulatory_test, regulatory_test_module, SI_SUB_DRIVERS,
+    SI_ORDER_ANY);
+MODULE_DEPEND(lkpi_regulatory_test, linuxkpi, 1, 1, 1);
+MODULE_DEPEND(lkpi_regulatory_test, linuxkpi_wlan, 1, 1, 1);
+MODULE_DEPEND(lkpi_regulatory_test, wlan, 1, 1, 1);
+MODULE_VERSION(lkpi_regulatory_test, 1);
diff --git a/sys/tests/linuxkpi_wlan/rhashtable_test.c b/sys/tests/linuxkpi_wlan/rhashtable_test.c
new file mode 100644
index 00000000000..b5cadb7b4be
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/rhashtable_test.c
@@ -0,0 +1,160 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+
+#include <linux/rcupdate.h>
+#include <linux/rhashtable.h>
+
+struct rhashtable_test_object {
+	unsigned int key;
+	struct rhash_head head;
+	unsigned int value;
+	struct rcu_head rcu;
+	unsigned int *freed;
+};
+
+static void
+rhashtable_test_free(struct rcu_head *rcu)
+{
+	struct rhashtable_test_object *object;
+
+	object = container_of(rcu, struct rhashtable_test_object, rcu);
+	(*object->freed)++;
+	kfree(object);
+}
+
+#define	RHT_CHECK(condition) do {					\
+	if (!(condition)) {						\
+		printf("lkpi_rhashtable_test: line %d: %s\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+int lkpi_rhashtable_test(void);
+
+int
+lkpi_rhashtable_test(void)
+{
+	const struct rhashtable_params params = {
+		.head_offset = offsetof(struct rhashtable_test_object, head),
+		.key_offset = offsetof(struct rhashtable_test_object, key),
+		.key_len = sizeof_field(struct rhashtable_test_object, key),
+		/* Force all objects into one collision chain. */
+		.nelem_hint = 1,
+		.automatic_shrinking = true,
+	};
+	struct rhashtable_test_object *objects[4] = {};
+	struct rhashtable_test_object *held;
+	struct rhashtable_params invalid;
+	struct rhashtable table;
+	unsigned int key, freed;
+	bool initialized, read_locked;
+	int error, i;
+
+	initialized = read_locked = false;
+	freed = 0;
+	invalid = params;
+	invalid.key_len = 0;
+	error = EINVAL;
+	RHT_CHECK(rhashtable_init(&table, &invalid) == -EINVAL);
+	error = -rhashtable_init(&table, &params);
+	if (error != 0)
+		return (error);
+	initialized = true;
+
+	key = 1;
+	RHT_CHECK(rhashtable_lookup_fast(&table, &key, params) == NULL);
+	for (i = 0; i < nitems(objects); i++) {
+		objects[i] = kzalloc(sizeof(*objects[i]), GFP_KERNEL);
+		if (objects[i] == NULL) {
+			error = ENOMEM;
+			goto out;
+		}
+		objects[i]->key = i + 1;
+		objects[i]->value = i + 10;
+	}
+	objects[3]->key = objects[1]->key;
+	for (i = 0; i < 3; i++)
+		RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+		    &objects[i]->head, params) == NULL);
+	for (i = 0; i < 3; i++)
+		RHT_CHECK(rhashtable_lookup_fast(&table, &objects[i]->key,
+		    params) == objects[i]);
+
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[3]->head, params) == objects[1]);
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[1]->head, params) == objects[1]);
+	/* Equal keys do not make an unlinked head removable. */
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[3]->head,
+	    params) == -ENOENT);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[1]->key,
+	    params) == objects[1]);
+
+	rcu_read_lock();
+	read_locked = true;
+	held = rhashtable_lookup_fast(&table, &objects[1]->key, params);
+	RHT_CHECK(held == objects[1]);
+	RHT_CHECK(rhashtable_remove_fast(&table, &held->head, params) == 0);
+	RHT_CHECK(rhashtable_remove_fast(&table, &held->head,
+	    params) == -ENOENT);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &held->key, params) == NULL);
+	held->freed = &freed;
+	call_rcu(&held->rcu, rhashtable_test_free);
+	objects[1] = NULL;
+	RHT_CHECK(held->value == 11 && freed == 0);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[0]->key,
+	    params) == objects[0]);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[2]->key,
+	    params) == objects[2]);
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[3]->head, params) == NULL);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[3]->key,
+	    params) == objects[3]);
+	rcu_read_unlock();
+	read_locked = false;
+	rcu_barrier();
+	RHT_CHECK(freed == 1);
+
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[3]->head,
+	    params) == 0);
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[0]->head,
+	    params) == 0);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[2]->key,
+	    params) == objects[2]);
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[2]->head,
+	    params) == 0);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[2]->key,
+	    params) == NULL);
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[0]->head, params) == NULL);
+
+	/* Destroy releases buckets, not caller-owned objects. */
+	rhashtable_destroy(&table);
+	initialized = false;
+	RHT_CHECK(objects[0]->value == 10 && objects[2]->value == 12 &&
+	    objects[3]->value == 13);
+	error = 0;
+out:
+	if (read_locked)
+		rcu_read_unlock();
+	if (initialized) {
+		for (i = 0; i < nitems(objects); i++) {
+			if (objects[i] != NULL)
+				rhashtable_remove_fast(&table, &objects[i]->head,
+				    params);
+		}
+	}
+	rcu_barrier();
+	synchronize_rcu();
+	for (i = 0; i < nitems(objects); i++)
+		kfree(objects[i]);
+	if (initialized)
+		rhashtable_destroy(&table);
+	return (error);
+}
diff --git a/sys/tests/linuxkpi_wlan/station_acceptance.sh b/sys/tests/linuxkpi_wlan/station_acceptance.sh
new file mode 100755
index 00000000000..30f50ac7b3e
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_acceptance.sh
@@ -0,0 +1,410 @@
+#!/bin/sh
+#
+# Preparation only: no claim that the native driver can scan or associate.
+# Commands and exact implementation blockers: --help and --blockers.
+set +x
+PATH=/sbin:/bin:/usr/sbin:/usr/bin
+export PATH
+LC_ALL=C
+export LC_ALL
+set -eu
+
+fail()
+{
+	echo "REFUSED: $*" >&2
+	exit 1
+}
+
+usage()
+{
+	cat <<'EOF'
+Native station acceptance PREPARATION; default is read-only preflight.
+Run only inside the isolated ath12k-lab / ATH12KLAB / bhyve guest.
+
+  sh station_acceptance.sh --interface wlan0
+  sh station_acceptance.sh --interface wlan0 --check status
+  sh station_acceptance.sh --blockers
+
+AFTER parent review and independent proof of the production prerequisites:
+  sh station_acceptance.sh --interface wlan0 --check scan \
+    --reviewed --wmi-init-ready --datapath-ready --regulatory-ready
+  sh station_acceptance.sh --interface wlan0 --check ipv4 \
+    --reviewed --wmi-init-ready --datapath-ready --regulatory-ready \
+    --source <WLAN-DHCP-IPv4> --gateway <WLAN-DHCP-router-IPv4>
+
+The four flags are explicit operator attestations, NOT automatic readiness
+detection. Never set them based only on firmware capability events, channel
+counts, country text, a successful build, or passing model/fixture tests.
+Parent review is required before either active check. No active checks have
+been approved or run by creating this harness.
+
+preflight: reads guest identity, wlanN -> ath12k_wifi7N parent/driver
+           mapping and regulatory text (the current production driver name).
+status: additionally queries the existing securely configured supplicant;
+        requires station mode, COMPLETED, WPA2 and pairwise/group CCMP.
+scan: performs one bounded scan; results/SSIDs are not printed or selected.
+      An already configured supplicant may react to scan results.
+ipv4: observes an existing unexpired base-system dhclient lease, validates
+      the WLAN address/mask and direct route to its DHCP router, sends two
+      source-bound DONTROUTE IPv4 echo requests to that on-link router only,
+      then requires a complete router ARP entry on that same WLAN.
+      No internet reachability, DNS, throughput or DHCP exchange is claimed.
+      A static address, stale lease, non-dhclient client or router blocking
+      ICMP deliberately fails; provision networking separately, not here.
+
+No interface creation/up/down, module loading, country changes, AP selection,
+supplicant configuration, credential reads, DHCP invocation, route changes,
+management-NIC traffic tests, captures or raw SSID/key/status dumps.
+This harness neither starts authentication nor benchmarks OpenBSD.
+EOF
+}
+
+blockers()
+{
+	cat <<'EOF'
+Implementation checkpoints (source paths are relative to this tree):
+
+1. Native attachment is not the lab mhi_boot capability-event milestone.
+   ath12k/mac.c ath12k_mac_register/ath12k_mac_hw_register must be reached
+   through production core/QMI/MHI, with actual WMI INIT/READY, allocated and
+   programmed DP rings/REO/cookie conversion and HTT setup, before exposing
+   ieee80211_register_hw -> linuxkpi_ieee80211_ifattach and a native VAP.
+   No current capability-event log proves those prerequisites.
+   Production ath12k_wmi_cmd_init requires init_prerequisites AND
+   init_resource_config; core.c installs ath12k_dp_init_prerequisites and
+   ath12k_dp_init_resource_config. Their live DP/cookie/REO/RX descriptors,
+   firmware resource counts and reset-retained DMA still need runtime proof,
+   not merely cc_prepared or successful callback installation. Afterwards
+   ath12k_wmi_wait_for_unified_ready(ab) must succeed; ab->wmi_ready is not
+   DBS/HTT/regulatory or data-path permission.
+
+2. Existing single-link glue is NOT missing wholesale:
+   linux_80211.c lkpi_ic_vap_create sets link_conf[0]=&bss_conf;
+   lkpi_lsta_alloc sets sta->link[0]=&sta->deflink.
+   wifi7/hw.c ath12k_ops_wifi7 already registers start/add_interface, hw_scan,
+   cancel_hw_scan, link_info_changed/vif_cfg_changed, sta_state, set_key,
+   assign_vif_chanctx, TX/wake_tx_queue. Keep valid_links=0/non-MLO.
+   mac.c ath12k_mac_op_add_interface intentionally defers firmware VDEV
+   creation to hw_scan/assign_chanctx; successful add_interface is not proof
+   of a started VDEV, peer or usable radio.
+
+3. Preserve and prove firmware ordering with real acknowledgments:
+   linux_80211.c lkpi_sta_scan_to_auth calls lkpi_set_chanctx_conf before
+   sta_state(NONE); ath12k assign_chanctx must create/start the VDEV before
+   peer creation. qwz.c qwz_auth explicitly requires VDEV_START before
+   PEER_CREATE to avoid an unbound firmware peer. Scan events must reach
+   ieee80211_scan_completed; management RX must reach linuxkpi_ieee80211_rx
+   for beacon/probe/auth/assoc delivery, and management TX completion must
+   reach ieee80211_tx_status_irqsafe. Native scan VDEV creation/deletion,
+   scan completion and beacon/probe reception are now proven; association
+   ordering and authentication/association delivery still need hardware proof.
+
+4. Implemented, NOT hardware-proven, station controlled-port bridge:
+   FreeBSD ath12k sets LKPI_STA_WPA2. linux_80211.c defers AUTHORIZED for
+   WPA2, observes bounded RSN M3 and the existing secure supplicant's real
+   matching M4 TX ACK (epoch/replay mbuf token), and requires successful
+   CCMP PTK/GTK+replay setup before process-context firmware authorization.
+   Only then are net80211 node authorization and link-up published.
+   Pairwise/group flags alone are NOT completion. Firmware error, key
+   error/delete, explicit node_unauthorize and disconnect close the host
+   port; deferred-state teardown accepts ASSOC without a fake AUTHORIZED.
+   net80211 iv_port_authorize is optional/non-sleeping; other drivers keep
+   their old behavior. BSD supplicant has no station set_supp_port callback;
+   MLME_AUTHORIZE remains HOSTAP/WDS-only. M3 observation does NOT validate
+   its MIC; the user-configured supplicant remains the authenticator.
+   qwz.c key/replay-before-authorization ordering guided this implementation.
+   Local policy sanitizer tests are not packet/firmware proof. Validate
+   real install failures, lost/stale M4 ACKs, same-key M3 retries, fresh
+   pairwise rekeys, GTK rotation, unauthorize and reconnect on hardware.
+   Key mutation closes the port, fences/drains host preparation/dequeue and
+   purges queued old-key skbs; ath12k then pauses DP entries and waits for
+   actual published TX completion before real key/replay changes. Timeout
+   fails closed. Concurrency/DMA lifetime is compiled, not runtime-proven.
+   Baseline: WPA2-CCMP, PTK slot0/GTK slots1-3, no MFP/SAE/TKIP/GTK slot0.
+   Supplicant COMPLETED still is not firmware key-install/replay proof.
+
+5. Callback adapter audit, not an ath12k showstopper by itself:
+   linux_80211_macops.c lkpi_80211_mo_vif_cfg_changed guards its invocation
+   with ops->link_info_changed instead of ops->vif_cfg_changed. ath12k has
+   BOTH today; repair separately with callback-presence regression tests.
+   lkpi_bss_info_change already splits VIF and link changes, so do not add
+   another bss_info_changed shim or duplicate BSS_CHANGED_ASSOC delivery.
+
+6. Regulatory and packet boundaries must fail closed:
+   Checked ordered firmware channel-list/power command submission and exact
+   country/rule lifetime/enforcement must precede VAP admission/scan/TX.
+   This protocol has NO separate channel-list firmware ACK. Validate native
+   half-dBm ni_txpower -> Linux dBm conversion and hardware floor/clamp.
+   reg.c now calls linuxkpi_regulatory_set_tx_ready with the EXACT published
+   snapshot after successful ordered channel/EIRP/power submission. Parent
+   must apply/reconcile native-regulatory-followup.patch: atomic terminal
+   revoke/pending/readiness CAS, start-before-final-VAP-admission ordering
+   and strict no-autonomous-11d guard. No build or country text substitutes
+   for RF enforcement proof. Changed rules revoke TX and queue scan/VDEV
+   quiesce; verify actual completion, then teardown/re-register, not an
+   in-place replacement. Initial policy permits eligible 20MHz 2.4/5GHz,
+   excluding
+   NO_IR/DFS/indoor/PSD rules; it is not general 6GHz/DFS regulatory support.
+   wifi7 datapath TX -> ieee80211_tx_status_ext and RX ->
+   ieee80211_rx_napi/linuxkpi_ieee80211_rx must preserve node/skb ownership,
+   encryption/decryption, replay flags, EAPOL/control-port and Ethernet
+   decapsulation semantics. Existing callbacks alone are not packet proof.
+   RX/TX/IRQ/DMA teardown and failed channel/peer/key operations need tested
+   unwind, not success-returning stubs.
+
+Native hardware now registers a WLAN and completes repeated scans with received
+results and clean teardown, using a temporary driver linked privately with the
+corrected MHI implementation. Ordinary shared-kernel integration and the
+firmware-managed regulatory metadata fix still need a corrected-kernel boot.
+Evidence still absent: WPA2 association/key ordering, DHCP/ARP/IPv4 traffic,
+and an OpenBSD live comparison/performance baseline. A selected test network
+and securely configured supplicant are required; fixtures are not that proof.
+EOF
+}
+
+os_name() { /usr/bin/uname -s; }
+guest_hostname() { /bin/hostname; }
+sysctl_read() { /sbin/sysctl -n "$1"; }
+interface_read() { /sbin/ifconfig "$1"; }
+interfaces_read() { /sbin/ifconfig -a inet; }
+supplicant_read()
+{
+	/usr/bin/timeout 5 /usr/sbin/wpa_cli -i "$iface" status
+}
+scan_once()
+{
+	/usr/bin/timeout 30 /sbin/ifconfig "$iface" scan
+}
+route_read()
+{
+	/usr/sbin/setfib 0 /sbin/route -n get -inet "$gateway"
+}
+ping_router()
+{
+	# -r disallows falling back through a default gateway; -S binds source.
+	/usr/sbin/setfib 0 /sbin/ping -n -r -S "$source" -c 2 -t 5 "$gateway"
+}
+arp_read() { /usr/sbin/arp -n "$gateway"; }
+epoch_now() { /bin/date -u +%s; }
+lease_expiry() { /bin/date -ju -f '%Y/%m/%d %H:%M:%S' "$1" +%s; }
+lease_read()
+{
+	lease=/var/db/dhclient.leases."$iface"
+	[ -f "$lease" ] && [ ! -L "$lease" ] ||
+	    fail "A regular native dhclient lease file is required"
+	ownership=$(/usr/bin/stat -f '%u %Lp' "$lease") ||
+	    fail "Cannot verify lease ownership"
+	set -- $ownership
+	[ "$#" -eq 2 ] && [ "$1" = 0 ] ||
+	    fail "Lease file must be root owned"
+	case "$2" in
+	*[!0-7]*|'') fail "Invalid lease permissions" ;;
+	esac
+	[ "$((0$2 & 022))" -eq 0 ] ||
+	    fail "Lease file must not be group/world writable"
+	/bin/cat "$lease"
+}
+
+guard_guest()
+{
+	[ "$(os_name)" = FreeBSD ] || fail "FreeBSD guest only"
+	[ "$(guest_hostname)" = ath12k-lab ] || fail "Guest hostname must be ath12k-lab"
+	[ "$(sysctl_read kern.ident)" = ATH12KLAB ] || fail "Kernel must be ATH12KLAB"
+	[ "$(sysctl_read kern.vm_guest)" = bhyve ] || fail "Guest must be bhyve"
+}
+
+guard_interface()
+{
+	case "$iface" in
+	wlan*) unit=${iface#wlan} ;;
+	*) fail "Specify a native wlanN interface, never em/ue/tap/wifibox" ;;
+	esac
+	case "$unit" in ''|*[!0-9]*) fail "Interface must be wlan followed by digits" ;; esac
+	parent=$(sysctl_read "net.wlan.$unit.%parent") ||
+	    fail "No authoritative native WLAN parent mapping"
+	case "$parent" in
+	ath12k_wifi7*) radio=${parent#ath12k_wifi7} ;;
+	*) fail "WLAN parent is not native ath12k" ;;
+	esac
+	case "$radio" in ''|*[!0-9]*) fail "Invalid ath12k parent unit" ;; esac
+	[ "$(sysctl_read "dev.ath12k_wifi7.$radio.%driver")" = ath12k_wifi7 ] ||
+	    fail "Parent is not an attached ath12k driver"
+	ifstate=$(interface_read "$iface") || fail "Native WLAN is absent"
+	printf '%s\n' "$ifstate" | grep -Eq 'regdomain [^[:space:]]+.*country [A-Z0-9]+' ||
+	    fail "No readable regulatory metadata (metadata alone is NOT readiness)"
+	echo "Guest and native WLAN identity verified; regulatory metadata present."
+}
+
+guard_ready()
+{
+	[ "$reviewed" = yes ] && [ "$wmi" = yes ] &&
+	    [ "$data" = yes ] && [ "$reg" = yes ] ||
+	    fail "Active checks need parent review and explicit WMI INIT/datapath/regulatory attestations"
+	echo "Readiness is OPERATOR-ATTESTED; capability events alone are insufficient."
+}
+
+field()
+{
+	# Require exactly one unambiguous key; never print whole supplicant status.
+	awk -F= -v key="$1" '$1 == key { n++; v=substr($0,length(key)+2) }
+	    END { if (n != 1) exit 1; print v }'
+}
+
+check_status()
+{
+	ifstate=$(interface_read "$iface") || fail "Cannot query WLAN status"
+	printf '%s\n' "$ifstate" | grep -Eq '^[[:space:]]*status: associated[[:space:]]*$' ||
+	    fail "WLAN is not associated"
+	state=$(supplicant_read 2>/dev/null) || fail "Cannot query existing secure supplicant"
+	[ "$(printf '%s\n' "$state" | field mode)" = station ] ||
+	    fail "Supplicant is not in station mode"
+	[ "$(printf '%s\n' "$state" | field wpa_state)" = COMPLETED ] ||
+	    fail "Supplicant handshake is incomplete"
+	[ "$(printf '%s\n' "$state" | field pairwise_cipher)" = CCMP ] &&
+	    [ "$(printf '%s\n' "$state" | field group_cipher)" = CCMP ] ||
+	    fail "Both pairwise and group ciphers must be CCMP"
+	case "$(printf '%s\n' "$state" | field key_mgmt)" in
+	WPA2-PSK|WPA2-EAP) ;;
+	*) fail "Require WPA2-PSK or WPA2-EAP" ;;
+	esac
+	echo "Associated WPA2-CCMP supplicant status verified (not firmware crypto proof)."
+}
+
+valid_ipv4()
+{
+	printf '%s\n' "$1" | awk -F. '
+	    NF != 4 { exit 1 }
+	    { for (i=1;i<=4;i++)
+	        if ($i !~ /^[0-9]+$/ || length($i)>3 || $i>255 ||
+	            (length($i)>1 && substr($i,1,1)=="0")) exit 1
+	      if ($1==0 || $1==127 || $1>=224 || $4==0 || $4==255) exit 1 }'
+}
+
+check_lease()
+{
+	valid_ipv4 "$source" && valid_ipv4 "$gateway" && [ "$source" != "$gateway" ] ||
+	    fail "Provide distinct canonical unicast WLAN source/router IPv4 addresses"
+	# Only the last complete lease is evidence; never fall back to an old one.
+	leases=$(lease_read) || fail "Cannot read trusted native DHCP lease"
+	record=$(printf '%s\n' "$leases" | awk '
+	    /^[[:space:]]*lease[[:space:]]*\{/ { inside=1; i=a=m=r=e=""; next }
+	    inside && $1=="interface" { i=$2; gsub(/[";]/,"",i) }
+	    inside && $1=="fixed-address" { a=$2; sub(/;$/,"",a) }
+	    inside && $1=="option" && $2=="subnet-mask" { m=$3; sub(/;$/,"",m) }
+	    inside && $1=="option" && $2=="routers" { r=$3; sub(/[,;].*$/,"",r) }
+	    inside && $1=="expire" { e=$3 " " $4; sub(/;$/,"",e) }
+	    inside && /^[[:space:]]*}/ { last=i "|" a "|" m "|" r "|" e; inside=0 }
+	    END { if (inside || last=="") exit 1; print last }') ||
+	    fail "Cannot parse an existing complete DHCP lease"
+	oldifs=$IFS
+	IFS='|'
+	read -r lease_if lease_addr mask lease_router expires <<EOF
+$record
+EOF
+	IFS=$oldifs
+	[ "$lease_if" = "$iface" ] && [ "$lease_addr" = "$source" ] &&
+	    [ "$lease_router" = "$gateway" ] || fail "Latest DHCP lease does not match this WLAN/source/router"
+	expiry=$(lease_expiry "$expires" 2>/dev/null) || fail "Invalid DHCP expiry"
+	now=$(epoch_now) || fail "Cannot obtain current time"
+	[ "$expiry" -gt "$now" ] || fail "DHCP lease has expired"
+	# Require a contiguous mask and on-link router; compute expected ifconfig mask.
+	hexmask=$(awk -v s="$source" -v g="$gateway" -v m="$mask" 'BEGIN {
+	    if (split(s,a,".")!=4 || split(g,b,".")!=4 || split(m,c,".")!=4) exit 1
+	    zero=0; hosta=hostb=0; ones=0
+	    for (i=1;i<=4;i++) {
+	        if (c[i] !~ /^[0-9]+$/ || c[i]>255) exit 1
+	        printf "%02x", c[i]
+	        for (bit=128;bit>=1;bit/=2) {
+	            mb=int(c[i]/bit)%2; sa=int(a[i]/bit)%2; gb=int(b[i]/bit)%2
+	            if (mb) { if (zero || sa!=gb) exit 1; ones++ }
+	            else { zero=1; hosta+=sa; hostb+=gb }
+	        }
+	    }
+	    if (ones<1 || ones>30 || hosta==0 || hostb==0 ||
+	        hosta==32-ones || hostb==32-ones) exit 1
+	    print ""
+	}') || fail "DHCP mask/router is not an ordinary directly attached IPv4 subnet"
+	printf '%s\n' "$ifstate" | awk -v s="$source" -v m="0x$hexmask" '
+	    $1=="inet" && $2==s && $3=="netmask" && $4==m { n++ }
+	    END { exit n!=1 }' || fail "DHCP address/mask is not assigned to this WLAN"
+	interfaces_read | awk -v s="$source" -v iface="$iface" '
+	    /^[^[:space:]]/ { current=$1; sub(/:$/,"",current) }
+	    $1=="inet" && $2==s { n++; if (current!=iface) bad=1 }
+	    END { exit n!=1 || bad }' ||
+	    fail "Source address is not unique to the native WLAN"
+	echo "Existing unexpired DHCP lease/address/mask verified; no DHCP client was run."
+}
+
+check_route()
+{
+	route=$(route_read 2>/dev/null) || fail "Cannot query router route in FIB 0"
+	printf '%s\n' "$route" | awk -v iface="$iface" '
+	    $1=="interface:" { n++; if ($2!=iface) bad=1 }
+	    $1=="flags:" && $0 ~ /GATEWAY/ { bad=1 }
+	    END { exit n!=1 || bad }' ||
+	    fail "DHCP router route is not directly attached to this WLAN in FIB 0"
+}
+
+check_ipv4()
+{
+	check_status
+	check_lease
+	check_route
+	ping_router >/dev/null 2>&1 || fail "Source-bound on-link WLAN router IPv4 echo failed"
+	# Detect changed route/interface/handshake around the active probe.
+	guard_interface
+	check_status
+	check_lease
+	check_route
+	arp=$(arp_read 2>/dev/null) || fail "Cannot query DHCP router ARP"
+	printf '%s\n' "$arp" | awk -v ip="($gateway)" -v iface="$iface" '
+	    $2==ip && $3=="at" && split($4,mac,":")==6 {
+	        valid=1
+	        for (i=1;i<=6;i++)
+	            if (mac[i] !~ /^[0-9a-fA-F][0-9a-fA-F]$/) valid=0
+	        for (i=5;i<NF;i++)
+	            if (valid && $i=="on" && $(i+1)==iface) ok=1
+	    } END { exit !ok }' || fail "No complete DHCP router ARP entry on the WLAN"
+	echo "PASS: observed WLAN DHCP lease, WPA2-CCMP status, router ARP and source-bound on-link IPv4."
+}
+
+station_main()
+{
+	iface= check=preflight source= gateway=
+	reviewed=no wmi=no data=no reg=no
+	while [ "$#" -gt 0 ]; do
+		case "$1" in
+		--help|-h) usage; return 0 ;;
+		--blockers) blockers; return 0 ;;
+		--interface|--check|--source|--gateway)
+			[ "$#" -ge 2 ] || fail "Missing option value"
+			case "$1" in
+			--interface) iface=$2 ;; --check) check=$2 ;;
+			--source) source=$2 ;; --gateway) gateway=$2 ;;
+			esac
+			shift ;;
+		--reviewed) reviewed=yes ;;
+		--wmi-init-ready) wmi=yes ;;
+		--datapath-ready) data=yes ;;
+		--regulatory-ready) reg=yes ;;
+		*) fail "Unknown option (use --help); credentials/network names are not accepted" ;;
+		esac
+		shift
+	done
+	case "$check" in preflight|status|scan|ipv4) ;; *) fail "Unknown check" ;; esac
+	guard_guest
+	guard_interface
+	case "$check" in
+	preflight)
+		echo "PREFLIGHT ONLY: no WMI INIT, datapath or regulatory readiness inferred; no scan/auth/TX attempted." ;;
+	status) check_status ;;
+	scan)
+		guard_ready
+		scan_once >/dev/null 2>&1 || fail "Bounded native scan failed"
+		echo "Scan command completed; no AP selected/results logged; this does not prove association." ;;
+	ipv4) guard_ready; check_ipv4 ;;
+	esac
+}
+
+# Main entry point. Tests load the definitions above, never a production bypass.
+station_main "$@"
diff --git a/sys/tests/linuxkpi_wlan/station_acceptance_test.py b/sys/tests/linuxkpi_wlan/station_acceptance_test.py
new file mode 100755
index 00000000000..1fdda2ff9e9
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_acceptance_test.py
@@ -0,0 +1,288 @@
+#!/usr/bin/env python3
+"""Local, hardware-free logic tests. Run: python3 station_acceptance_test.py."""
+
+import pathlib
+import shlex
+import subprocess
+import unittest
+
+
+SCRIPT = pathlib.Path(__file__).with_name("station_acceptance.sh")
+DEFINITIONS = SCRIPT.read_text().split("# Main entry point.", 1)[0]
+ACKS = ["--reviewed", "--wmi-init-ready", "--datapath-ready", "--regulatory-ready"]
+IPV4 = ["--check", "ipv4", "--source", "192.0.2.10", "--gateway", "192.0.2.1"]
+INTERFACE = """wlan0: flags=8843<UP,BROADCAST,RUNNING,SIMPLEX,MULTICAST>
+        inet 192.0.2.10 netmask 0xffffff00 broadcast 192.0.2.255
+        regdomain FCC country US
+        status: associated
+"""
+STATUS = """mode=station
+wpa_state=COMPLETED
+pairwise_cipher=CCMP
+group_cipher=CCMP
+key_mgmt=WPA2-PSK
+sensitive_test_field=REDACT_ME
+"""
+LEASE = """lease {
+  interface "wlan0";
+  fixed-address 192.0.2.10;
+  option subnet-mask 255.255.255.0;
+  option routers 192.0.2.1;
+  expire 3 2030/01/01 00:00:00;
+}
+"""
+ROUTE = """   route to: 192.0.2.1
+destination: 192.0.2.0
+       mask: 255.255.255.0
+        fib: 0
+  interface: wlan0
+      flags: <UP,DONE,STATIC>
+"""
+ARP = "? (192.0.2.1) at 02:00:00:00:00:01 on wlan0 expires in 1199 seconds [ethernet]\n"
+
+
+def returns(text):
+    return "printf '%s\\n' " + shlex.quote(text)
+
+
+class AcceptanceTests(unittest.TestCase):
+    def run_harness(self, args=(), overrides=None):
+        functions = {
+            "os_name": returns("FreeBSD"),
+            "guest_hostname": returns("ath12k-lab"),
+            "sysctl_read": """case "$1" in
+                kern.ident) echo ATH12KLAB ;;
+                kern.vm_guest) echo bhyve ;;
+                net.wlan.0.%parent) echo ath12k_wifi70 ;;
+                dev.ath12k_wifi7.0.%driver) echo ath12k_wifi7 ;;
+                *) echo UNEXPECTED_SYSCTL >&2; return 1 ;;
+                esac""",
+            "interface_read": returns(INTERFACE),
+            "interfaces_read": returns(INTERFACE),
+            "supplicant_read": returns(STATUS),
+            "route_read": returns(ROUTE),
+            "arp_read": returns(ARP),
+            "lease_read": returns(LEASE),
+            "epoch_now": returns("100"),
+            "lease_expiry": returns("200"),
+            "scan_once": "echo CALL_SCAN >&3",
+            "ping_router": "echo CALL_PING >&3",
+        }
+        functions.update(overrides or {})
+        # No production test flag/PATH injection exists: load only definitions
+        # in a fresh test shell and replace every OS-query/action boundary.
+        program = DEFINITIONS + "\nexec 3>&2\n"
+        for name, body in functions.items():
+            program += f"{name}() {{ {body}\n}}\n"
+        program += "station_main " + shlex.join(["--interface", "wlan0", *args]) + "\n"
+        return subprocess.run(
+            ["/bin/sh", "-s"], input=program, text=True, capture_output=True, timeout=5
+        )
+
+    def assert_refused(self, result, message=None):
+        self.assertNotEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("REFUSED:", result.stderr)
+        self.assertNotIn("CALL_PING", result.stderr)
+        self.assertNotIn("CALL_SCAN", result.stderr)
+        if message:
+            self.assertIn(message, result.stderr)
+
+    def test_real_host_refused_before_interface_queries(self):
+        # The development shell may be Linux compatibility on a FreeBSD host.
+        # Exercise the installed entry point only when an identity guard must
+        # reject before it can query any interface.
+        system = subprocess.check_output(["/usr/bin/uname", "-s"], text=True).strip()
+        hostname = subprocess.check_output(["/bin/hostname"], text=True).strip()
+        if system == "FreeBSD" and hostname == "ath12k-lab":
+            self.skipTest("Not running real entry point in a possible lab guest")
+        result = subprocess.run(
+            ["/bin/sh", str(SCRIPT), "--interface", "wlan0"],
+            text=True, capture_output=True, timeout=5,
+        )
+        self.assert_refused(result, "FreeBSD guest only" if system != "FreeBSD"
+                            else "Guest hostname must be ath12k-lab")
+
+    def test_default_preflight_is_read_only_not_readiness(self):
+        result = self.run_harness(overrides={
+            "scan_once": "exit 91",
+            "ping_router": "exit 92",
+            "supplicant_read": "exit 93",
+            "lease_read": "exit 94",
+        })
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("PREFLIGHT ONLY", result.stdout)
+        self.assertIn("no WMI INIT", result.stdout)
+
+    def test_every_guest_guard_is_required(self):
+        cases = [
+            {"os_name": returns("Linux")},
+            {"guest_hostname": returns("production-host")},
+            {"sysctl_read": returns("GENERIC")},
+            {"sysctl_read": """case "$1" in
+                kern.ident) echo ATH12KLAB ;; *) echo none ;; esac"""},
+        ]
+        for overrides in cases:
+            with self.subTest(overrides=overrides):
+                self.assert_refused(self.run_harness(["--check", "scan", *ACKS], overrides))
+
+    def test_management_virtual_and_malformed_interfaces_refused(self):
+        for name in ["em0", "ue0", "tap0", "wifibox0", "ath12k_wifi70",
+                     "wlan", "wlan0;id", "wlan0/../../em0", "-a"]:
+            with self.subTest(interface=name):
+                self.assert_refused(self.run_harness(["--interface", name]))
+
+    def test_non_native_parent_and_wrong_attached_driver_refused(self):
+        for parent, driver in [
+            ("em0", "ath12k_wifi7"), ("wifibox0", "ath12k_wifi7"),
+            ("iwlwifi0", "ath12k_wifi7"), ("ath12k_wifi7", "ath12k_wifi7"),
+            ("ath12k_wifi7_pci0", "ath12k_wifi7_pci"),
+            ("ath12k_wifi70", "em"), ("ath12k_wifi70", "lkpimhi"),
+        ]:
+            body = f"""case "$1" in
+                kern.ident) echo ATH12KLAB ;; kern.vm_guest) echo bhyve ;;
+                net.wlan.0.%parent) {returns(parent)} ;;
+                dev.*) {returns(driver)} ;; *) return 1 ;; esac"""
+            with self.subTest(parent=parent, driver=driver):
+                self.assert_refused(self.run_harness(overrides={"sysctl_read": body}))
+
+    def test_absent_interface_and_regulatory_metadata_refused(self):
+        for body in ["return 1", returns(INTERFACE.replace("regdomain FCC country US", ""))]:
+            with self.subTest(body=body):
+                self.assert_refused(self.run_harness(overrides={"interface_read": body}))
+
+    def test_each_action_needs_all_four_explicit_attestations(self):
+        for action in [["--check", "scan"], IPV4]:
+            for missing in range(len(ACKS)):
+                with self.subTest(action=action, missing=ACKS[missing]):
+                    flags = ACKS[:missing] + ACKS[missing + 1:]
+                    self.assert_refused(self.run_harness([*action, *flags]), "parent review")
+
+    def test_scan_only_after_review_does_not_log_network_results(self):
+        result = self.run_harness(["--check", "scan", *ACKS], {
+            "scan_once": "echo CALL_SCAN >&3; echo REDACT_ME",
+        })
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("CALL_SCAN", result.stderr)
+        self.assertNotIn("REDACT_ME", result.stdout + result.stderr)
+        self.assertNotIn("PASS:", result.stdout)
+
+    def test_failed_scan_is_not_success(self):
+        self.assert_refused(self.run_harness(
+            ["--check", "scan", *ACKS], {"scan_once": "return 1"}), "scan failed")
+
+    def test_secure_status_is_read_only_and_redacted(self):
+        result = self.run_harness(["--check", "status"])
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("WPA2-CCMP", result.stdout)
+        self.assertNotIn("REDACT_ME", result.stdout + result.stderr)
+        self.assertNotIn("CALL_", result.stderr)
+
+    def test_incomplete_wrong_mode_cipher_or_duplicate_status_refused(self):
+        states = [
+            STATUS.replace("COMPLETED", "4WAY_HANDSHAKE"),
+            STATUS.replace("mode=station", "mode=AP"),
+            STATUS.replace("pairwise_cipher=CCMP", "pairwise_cipher=TKIP"),
+            STATUS.replace("group_cipher=CCMP", "group_cipher=TKIP"),
+            STATUS.replace("WPA2-PSK", "WPA-PSK"),
+            STATUS + "wpa_state=COMPLETED\n",
+            STATUS.replace("mode=station\n", ""),
+        ]
+        for status in states:
+            with self.subTest(status=status):
+                self.assert_refused(self.run_harness(
+                    [*IPV4, *ACKS], {"supplicant_read": returns(status)}))
+
+    def test_dhcp_route_arp_ipv4_positive_fixture(self):
+        result = self.run_harness([*IPV4, *ACKS])
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        self.assertIn("PASS: observed WLAN DHCP lease", result.stdout)
+        self.assertIn("CALL_PING", result.stderr)
+        self.assertNotIn("CALL_SCAN", result.stderr)
+
+    def test_dhcp_missing_stale_wrong_interface_address_router_mask_refused(self):
+        leases = [
+            "", LEASE.replace("wlan0", "em0"),
+            LEASE.replace("192.0.2.10", "192.0.2.11"),
+            LEASE.replace("routers 192.0.2.1", "routers 198.51.100.1"),
+            LEASE.replace("255.255.255.0", "255.0.255.0"),
+            LEASE.replace("255.255.255.0", "255.255.255.252"),
+            LEASE + LEASE.replace("192.0.2.10", "192.0.2.11"),
+            LEASE + "lease {\n",
+        ]
+        for lease in leases:
+            with self.subTest(lease=lease):
+                self.assert_refused(self.run_harness(
+                    [*IPV4, *ACKS], {"lease_read": returns(lease)}))
+        for override in [{"lease_read": "return 1"}, {"lease_expiry": returns("99")},
+                         {"lease_expiry": "return 1"}]:
+            with self.subTest(override=override):
+                self.assert_refused(self.run_harness([*IPV4, *ACKS], override))
+
+    def test_noncanonical_or_nonunicast_ipv4_refused(self):
+        for address in ["127.0.0.1", "224.0.0.1", "0.0.0.0", "192.0.2.255",
+                        "192.000.2.10", "192.0.2.256", "192.0.2.10;id", "example.com"]:
+            with self.subTest(source=address):
+                self.assert_refused(self.run_harness(
+                    [*IPV4, "--source", address, *ACKS]))
+
+    def test_source_must_have_matching_mask_and_be_unique_to_wlan(self):
+        overrides = [
+            {"interface_read": returns(INTERFACE.replace("0xffffff00", "0xffff0000"))},
+            {"interfaces_read": returns(INTERFACE.replace("wlan0:", "em0:"))},
+            {"interfaces_read": returns(INTERFACE + INTERFACE.replace("wlan0:", "em0:"))},
+            {"interfaces_read": "return 1"},
+        ]
+        for override in overrides:
+            with self.subTest(override=override):
+                self.assert_refused(self.run_harness([*IPV4, *ACKS], override))
+
+    def test_management_or_indirect_route_refused_before_ping(self):
+        for route in [ROUTE.replace("wlan0", "em0"), ROUTE.replace("wlan0", "ue0"),
+                      ROUTE.replace("<UP,DONE,STATIC>", "<UP,GATEWAY,DONE>"), ""]:
+            with self.subTest(route=route):
+                self.assert_refused(self.run_harness(
+                    [*IPV4, *ACKS], {"route_read": returns(route)}))
+
+    def test_ping_failure_or_wrong_incomplete_arp_never_passes(self):
+        overrides = [
+            {"ping_router": "return 1"},
+            {"arp_read": returns(ARP.replace("wlan0", "em0"))},
+            {"arp_read": returns(ARP.replace("02:00:00:00:00:01", "(incomplete)"))},
+            {"arp_read": returns(ARP.replace("192.0.2.1", "192.0.2.2"))},
+        ]
+        for override in overrides:
+            with self.subTest(override=override):
+                result = self.run_harness([*IPV4, *ACKS], override)
+                self.assertNotEqual(result.returncode, 0)
+                self.assertIn("REFUSED:", result.stderr)
+                self.assertNotIn("PASS:", result.stdout)
+
+    def test_route_change_during_probe_fails_postcheck(self):
+        # Shell globals do not propagate from command substitution. Have the
+        # mocked ping change caller state; route_read varies on it,
+        # demonstrating the second lookup is enforced.
+        result = self.run_harness([*IPV4, *ACKS], {
+            "ping_router": "route_changed=yes",
+            "route_read": 'if [ "${route_changed-no}" = no ]; then '
+                          + returns(ROUTE) + "; else "
+                          + returns(ROUTE.replace("wlan0", "em0")) + "; fi",
+        })
+        self.assert_refused(result, "directly attached")
+
+    def test_source_mask_change_during_probe_fails_postcheck(self):
+        result = self.run_harness([*IPV4, *ACKS], {
+            "ping_router": "interface_read() { "
+                           + returns(INTERFACE.replace("0xffffff00", "0xffff0000"))
+                           + "; }",
+        })
+        self.assert_refused(result, "not assigned to this WLAN")
+
+    def test_unknown_options_and_credentials_are_never_accepted(self):
+        for args in [["--check", "dhcp"], ["--ssid", "unused"], ["--password", "unused"],
+                     ["--interface"], ["--check", "ipv4", *ACKS]]:
+            with self.subTest(args=args):
+                self.assert_refused(self.run_harness(args))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
