+static int
+mhi_memory_test(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_dma memory = { 0 };
+	void *address;
+	int result, error = 0;
+
+	CHECK(linuxkpi_mhi_alloc_context(ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+	CHECK(linuxkpi_mhi_alloc_memory(ctrl, &memory, 65537) == 0 &&
+	    check_buffer(&memory, 65536, true));
+	address = memory.vaddr;
+	ctrl->lkpi_context->published = true;
+	result = linuxkpi_mhi_free_memory(ctrl, &memory);
+	ctrl->lkpi_context->published = false;
+	CHECK(result == -EBUSY && memory.vaddr == address && memory.loaded);
+	CHECK(linuxkpi_mhi_free_memory(ctrl, &memory) == 0 && memory.tag == NULL);
+out:
+	if (memory.tag != NULL)
+		(void)linuxkpi_mhi_free_memory(ctrl, &memory);
+	linuxkpi_mhi_free_context(ctrl);
+	if (error == 0)
+		printf("lkpi_mhi_test: firmware DMA alignment, zeroing and reset-before-free guard passed (model only)\n");
+	return (error);
+}
+
+struct mhi_receive_model {
+	uint8_t data[257];
+	size_t length;
+	bool reject;
+};
+
+static int
+mhi_model_receive(void *arg, const void *data, size_t length)
+{
+	struct mhi_receive_model *model = arg;
+
+	if (model->reject || length > sizeof(model->data))
+		return (EPROTO);
+	memcpy(model->data, data, length);
+	model->length = length;
+	return (0);
+}
+
+static int
+mhi_transport_test(struct mhi_controller *ctrl)
+{
+	struct mhi_boot_model model = { 0 };
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_xfer *tx, *rx;
+	struct lkpi_mhi_tre *tre;
+	struct lkpi_mhi_dma *ring;
+	uint8_t payload[52] = { 1, 2, 3, 4, 5 };
+	struct mhi_receive_model received = { 0 };
+	uint8_t incoming[257] = { 7, 8, 9 };
+	size_t last;
+	int error = 0;
+
+	model.regs = malloc(MHI_MODEL_REG_LEN, M_TEMP, M_WAITOK | M_ZERO);
+	ctrl->regs = model.regs;
+	ctrl->reg_len = MHI_MODEL_REG_LEN;
+	ctrl->read_reg = mhi_model_read;
+	ctrl->write_reg = mhi_model_write;
+	ctrl->cntrl_dev->driver_data = &model;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+	context = ctrl->lkpi_context;
+	CHECK(linuxkpi_mhi_alloc_transfer(ctrl, 20) == 0);
+	CHECK(linuxkpi_mhi_alloc_transfer(ctrl, 21) == 0);
+	context->channel_db = 0x400;
+	context->event_db = 0x800;
+	context->published = true;
+	context->state = context->ee = 2;
+	context->receive = mhi_model_receive;
+	context->receive_arg = &received;
+	incoming[256] = 0xa5;
+	last = context->command_ring.size - sizeof(*tre);
+	context->command_read = context->command_write = last;
+	CHECK(linuxkpi_mhi_start_channel(ctrl, 20) == 0);
+	CHECK(context->command_pending && context->command_write == 0 &&
+	    model.offsets[0] == 0x74 && model.offsets[1] == 0x70);
+	CHECK(check_buffer(&context->command_ring,
+	    context->command_ring.size, false));
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)context->command_ring.vaddr +
+	    last);
+	CHECK(le32toh(tre->dword[1]) == ((20U << 24) | (18U << 16)));
+	CHECK(mhi_model_event(ctrl, 0, context->command_ring.address + last + 1,
+	    1U << 24, 0x21U << 16) == -EIO &&
+	    context->command_pending && !context->transfers[20].started);
+	context->event_error = 0;
+	CHECK(mhi_model_event(ctrl, 0, context->command_ring.address + last,
+	    1U << 24, 0x21U << 16) == 0 &&
+	    !context->command_pending && context->command_read == 0);
+	CHECK(linuxkpi_mhi_start_channel(ctrl, 21) == 0);
+	CHECK(mhi_model_event(ctrl, 0, context->command_ring.address,
+	    1U << 24, 0x21U << 16) == 0);
+	tx = &context->transfers[20];
+	rx = &context->transfers[21];
+	CHECK(tx->started && rx->started && context->command_events == 2 &&
+	    rx->queued == 63 && rx->write_offset == 63 * 16);
+	ring = &context->channel_rings[20];
+	tx->read_offset = tx->write_offset = ring->size - 16;
+	CHECK(linuxkpi_mhi_submit(ctrl, 20, payload, sizeof(payload)) == 0);
+	CHECK(linuxkpi_mhi_submit(ctrl, 20, payload, sizeof(payload)) == 0);
+	CHECK(linuxkpi_mhi_submit(ctrl, 20, payload, UINT16_MAX + 1U) ==
+	    -EINVAL && tx->queued == 2);
+	CHECK(check_buffer(ring, ring->size, false));
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)ring->vaddr + ring->size - 16);
+	CHECK(le64toh(tre->ptr) == tx->slots[63].dma.address &&
+	    le32toh(tre->dword[0]) == sizeof(payload) &&
+	    le32toh(tre->dword[1]) == 0x20200);
+	CHECK(check_buffer(&tx->slots[63].dma, 64, false) &&
+	    memcmp(tx->slots[63].dma.vaddr, payload, sizeof(payload)) == 0);
+	CHECK(mhi_model_event(ctrl, 1, ring->address,
+	    2U << 24, (20U << 24) | (0x22U << 16)) == 0 &&
+	    context->tx_packets == 2 && tx->queued == 0 && tx->read_offset == 16);
+	ring = &context->channel_rings[21];
+	rx->read_offset = ring->size - 16;
+	rx->write_offset = ring->size - 32;
+	CHECK(check_buffer(&context->channels, 64, false));
+	channels = context->channels.vaddr;
+	channels[21].wp = htole64(ring->address + rx->write_offset);
+	CHECK(check_buffer(&rx->slots[63].dma, 64, false));
+	memcpy(rx->slots[63].dma.vaddr, incoming, sizeof(incoming));
+	CHECK(mhi_model_event(ctrl, 1, ring->address + ring->size - 16,
+	    (2U << 24) | sizeof(incoming), (21U << 24) | (0x22U << 16)) == 0 &&
+	    context->rx_packets == 1 && rx->read_offset == 0 &&
+	    rx->write_offset == ring->size - 16 && rx->queued == 63 &&
+	    context->rx_length == sizeof(incoming) &&
+	    received.length == sizeof(incoming) &&
+	    memcmp(received.data, incoming, sizeof(incoming)) == 0);
+	CHECK(mhi_model_event(ctrl, 1, context->channel_rings[20].address,
+	    (2U << 24) | sizeof(payload), (20U << 24) | (0x22U << 16)) == -EIO &&
+	    context->tx_packets == 2 && tx->queued == 0);
+	context->event_error = 0;
+	received.reject = true;
+	CHECK(mhi_model_event(ctrl, 1, ring->address,
+	    (2U << 24) | sizeof(incoming), (21U << 24) | (0x22U << 16)) ==
+	    -EPROTO && context->event_error == EPROTO && rx->read_offset == 0 &&
+	    rx->slots[0].dma.vaddr != NULL && context->published);
+	context->event_error = 0;
+	context->stopping = true;
+	received.length = 0;
+	CHECK(mhi_model_event(ctrl, 1, ring->address,
+	    (2U << 24) | sizeof(incoming), (21U << 24) | (0x22U << 16)) ==
+	    0 && received.length == 0 && rx->read_offset == 16 &&
+	    rx->queued == 62);
+	CHECK(linuxkpi_mhi_submit(ctrl, 20, payload, sizeof(payload)) == -EBUSY);
+	last = context->command_write;
+	CHECK(linuxkpi_mhi_stop_channel(ctrl, 20) == 0);
+	CHECK(linuxkpi_mhi_stop_channel(ctrl, 21) == -EBUSY);
+	CHECK(check_buffer(&context->command_ring,
+	    context->command_ring.size, false));
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)context->command_ring.vaddr +
+	    last);
+	CHECK(le32toh(tre->dword[1]) == ((20U << 24) | (17U << 16)));
+	CHECK(mhi_model_event(ctrl, 0, context->command_ring.address + last,
+	    1U << 24, 0x21U << 16) == 0 && !tx->started);
+	last = context->command_write;
+	CHECK(linuxkpi_mhi_stop_channel(ctrl, 21) == 0);
+	CHECK(mhi_model_event(ctrl, 0, context->command_ring.address + last,
+	    1U << 24, 0x21U << 16) == 0 && !rx->started &&
+	    rx->queued == 62 && context->published &&
+	    rx->slots[0].dma.vaddr != NULL);
+	CHECK(linuxkpi_mhi_start_channel(ctrl, 20) == -EBUSY);
+	model.regs[LKPI_MHI_STATUS / 4] = 0x200;
+	model.reply_m3 = true;
+	CHECK(linuxkpi_mhi_shutdown(ctrl) == 0 && context->quiescing &&
+	    context->published && model.regs[LKPI_MHI_CTRL / 4] == 0x500);
+	model.fail_read = true;
+	CHECK(linuxkpi_mhi_shutdown(ctrl) == -EIO && context->published);
+	model.fail_read = false;
+	model.regs[LKPI_MHI_STATUS / 4] = 0x200;
+	model.reply_m3 = false;
+	CHECK(linuxkpi_mhi_shutdown(ctrl) == -ETIMEDOUT &&
+	    context->published && rx->slots[0].dma.vaddr != NULL);
+	model.reply_m3 = true;
+	CHECK(linuxkpi_mhi_shutdown(ctrl) == 0 && context->published);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == 0);
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == context && context->published);
+out:
+	/* No physical publication or IRQ setup occurs in this model. */
+	if (ctrl->lkpi_context != NULL)
+		ctrl->lkpi_context->published = false;
+	linuxkpi_mhi_free_context(ctrl);
+	ctrl->cntrl_dev->driver_data = NULL;
+	ctrl->regs = NULL;
+	ctrl->read_reg = NULL;
+	ctrl->write_reg = NULL;
+	free(model.regs, M_TEMP);
+	if (error == 0)
+		printf("lkpi_mhi_test: channel start/stop, command wrap, TX/RX, shutdown drain, M3 and reset-before-free passed (model only)\n");
+	return (error);
+}
+
+static int
+mhi_test(void)
+{
+	const struct mhi_controller_config *reference =
+	    &ath12k_wifi7_mhi_config_wcn7850;
+	struct mhi_controller_config cfg;
+	struct mhi_channel_config ch[2];
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_command_context *command;
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_dma *ring;
+	struct mhi_controller *ctrl;
+	struct device dev = { 0 };
+	device_t card;
+	unsigned int i;
+	int error;
+
+	card = NULL;
+	if (vm_guest == VM_GUEST_BHYVE &&
+	    strcmp(kern_ident, "ATH12KLAB") == 0)
+		card = pci_find_dbsf(0, 0, 6, 0);
+	else if (vm_guest == VM_GUEST_NO &&
+	    strcmp(kern_ident, "ATH12KHOST") == 0)
+		card = pci_find_dbsf(0, 194, 0, 0);
+	if (card == NULL || pci_get_vendor(card) != 0x17cb ||
+	    pci_get_device(card) != 0x1107 ||
+	    pci_get_subvendor(card) != 0x17aa ||
+	    pci_get_subdevice(card) != 0xe0e6 || device_is_attached(card)) {
+		printf("lkpi_mhi_test: expected unbound test PCI function is unavailable\n");
+		return (ENXIO);
+	}
+	dev.bsddev = card;
+	ctrl = mhi_alloc_controller();
+	if (ctrl == NULL)
+		return (ENOMEM);
+	ctrl->cntrl_dev = &dev;
+	ctrl->iova_stop = BUS_SPACE_MAXADDR_32BIT;
+	error = -linuxkpi_mhi_alloc_context(ctrl, reference);
+	if (error != 0)
+		goto out;
+	context = ctrl->lkpi_context;
+	CHECK(context != NULL && context->max_channels == 128 &&
+	    context->num_events == 2);
+	CHECK(check_buffer(&context->channels, 64, false));
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(check_buffer(&context->commands, 64, false));
+	CHECK(check_buffer(&context->command_ring, 2048, true));
+	command = context->commands.vaddr;
+	CHECK(command->reserved[0] == 0 && command->reserved[1] == 0 &&
+	    command->reserved[2] == 0);
+	CHECK(le64toh(command->rbase) == context->command_ring.address &&
+	    le64toh(command->rp) == le64toh(command->rbase) &&
+	    le64toh(command->wp) == le64toh(command->rbase) &&
+	    le64toh(command->rlen) == 128 * 16);
+	events = context->events.vaddr;
+	for (i = 0; i < 2; i++) {
+		ring = &context->event_rings[i].dma;
+		CHECK(check_buffer(ring, ring->size, true));
+		CHECK(ring->size == (i == 0 ? 32 : 256) * 16);
+		CHECK(le32toh(events[i].ertype) == 1 &&
+		    le32toh(events[i].msivec) == i + 1 &&
+		    le32toh(events[i].intmod) == i << 16);
+		CHECK(le64toh(events[i].rbase) == ring->address &&
+		    le64toh(events[i].rp) == ring->address &&
+		    le64toh(events[i].wp) == ring->address + ring->size - 16 &&
+		    le64toh(events[i].rlen) == ring->size);
+	}
+	channels = context->channels.vaddr;
+	for (i = 0; i < context->max_channels; i++) {
+		CHECK(le32toh(channels[i].chcfg) == 0x200);
+		ring = &context->channel_rings[i];
+		if (i != 20 && i != 21) {
+			CHECK(ring->vaddr == NULL && channels[i].chtype == 0 &&
+			    channels[i].rbase == 0 && channels[i].rlen == 0);
+			continue;
+		}
+		CHECK(check_buffer(ring, 1024, true) && ring->size == 64 * 16);
+		CHECK(le32toh(channels[i].chtype) == i - 19 &&
+		    le32toh(channels[i].erindex) == 1);
+		CHECK(le64toh(channels[i].rbase) == ring->address &&
+		    le64toh(channels[i].rp) == ring->address &&
+		    le64toh(channels[i].wp) == ring->address &&
+		    le64toh(channels[i].rlen) == ring->size);
+	}
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, reference) == -EBUSY &&
+	    ctrl->lkpi_context == context);
+	context->published = true;
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == context);
+	context->published = false;
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == NULL);
+	linuxkpi_mhi_free_context(ctrl);
+
+	cfg = *reference;
+	CHECK(cfg.num_channels == nitems(ch));
+	memcpy(ch, cfg.ch_cfg, sizeof(ch));
+	cfg.ch_cfg = ch;
+	ch[1].num = ch[0].num;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EINVAL &&
+	    ctrl->lkpi_context == NULL);
+	ch[1] = reference->ch_cfg[1];
+	ch[1].event_ring = cfg.num_events;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EINVAL &&
+	    ctrl->lkpi_context == NULL);
+	ch[1] = reference->ch_cfg[1];
+	ch[1].num_elements = 3;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EINVAL &&
+	    ctrl->lkpi_context == NULL);
+	ch[1] = reference->ch_cfg[1];
+	ch[1].offload_channel = true;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EOPNOTSUPP &&
+	    ctrl->lkpi_context == NULL);
+	ctrl->iova_start = 1;
+	ctrl->iova_stop = 0;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, reference) == -EINVAL);
+	/* A 4096-byte interval cannot contain the 5632-byte channel table. */
+	ctrl->iova_start = BUS_SPACE_MAXADDR_32BIT - 4095;
+	ctrl->iova_stop = BUS_SPACE_MAXADDR_32BIT;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, reference) == -ERANGE &&
+	    ctrl->lkpi_context == NULL);
+	ctrl->iova_start = 0;
+	CHECK(mhi_prepare_for_power_up(ctrl) == -EOPNOTSUPP);
+	error = linuxkpi_mhi_lifecycle_test();
+	if (error != 0)
+		goto out;
+	error = mhi_boot_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_transport_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_qmi_test();
+	if (error != 0)
+		goto out;
+	error = mhi_qmi_initialization_test();
+	if (error != 0)
+		goto out;
+	error = mhi_board_test();
+	if (error != 0)
+		goto out;
+	error = mhi_qmi_configuration_test();
+	if (error != 0)
+		goto out;
+	error = mhi_memory_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_ce_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_ce_rx_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_ce_tx_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_htc_test();
+	if (error != 0)
+		goto out;
+	error = mhi_wmi_test();
+	if (error != 0)
+		goto out;
+	error = ath12k_wmi_protocol_test();
+	if (error != 0)
+		goto out;
+	/* Exercise automatic context cleanup in mhi_free_controller(). */
+	error = -linuxkpi_mhi_alloc_context(ctrl, reference);
+out:
+	mhi_free_controller(ctrl);
+	if (error == 0)
+		printf("lkpi_mhi_test: DMA contexts, rings, address/alignment and cleanup passed; no MMIO\n");
+	return (error);
+}
+
+static int
+mhi_test_modevent(module_t mod, int type, void *arg)
+{
+	switch (type) {
+	case MOD_LOAD:
+		return (mhi_test());
+	case MOD_UNLOAD:
+		return (0);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+
+static moduledata_t mhi_test_mod = {
+	"lkpi_mhi_test", mhi_test_modevent, NULL
+};
+
+DECLARE_MODULE(lkpi_mhi_test, mhi_test_mod, SI_SUB_DRIVERS, SI_ORDER_ANY);
+MODULE_VERSION(lkpi_mhi_test, 1);
+MODULE_DEPEND(lkpi_mhi_test, linuxkpi, 1, 1, 1);
