+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 19) == EPROTO && !htc.ready);
+	le32enc(packet + 8, 1);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO && !htc.ready);
+	le32enc(packet + 8, 1 | 32 << 16);
+	packet[16] = 2;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO && !htc.ready);
+	packet[16] = 1;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == 0 &&
+	    htc.ready && htc.extended && htc.credits == 32 &&
+	    htc.credit_size == 2048 && htc.endpoints == 9 &&
+	    htc.version == 1 && htc.bundle == 8);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO);
+	memset(&htc, 0, sizeof(htc));
+	le32enc(packet, 8 << 16);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 16) == 0 &&
+	    htc.ready && !htc.extended);
+	CHECK(mhi_lab_htc_connect(&htc, ATH12K_HTC_SVC_ID_WMI_CONTROL, packet) ==
+	    EPROTO && htc.pending_service == 0);
+	CHECK(mhi_lab_htc_connect(&htc, ATH12K_HTC_SVC_ID_HTT_DATA_MSG, packet) == 0 &&
+	    le32dec(packet) == 8U << 16 &&
+	    le32dec(packet + 8) == (0x300U << 16 | 2) &&
+	    le32dec(packet + 12) == 8);
+	CHECK(mhi_lab_htc_connect(&htc, ATH12K_HTC_SVC_ID_HTT_DATA_MSG, packet) ==
+	    EPROTO && htc.pending_service == 0x300);
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet, 12U << 16);
+	le32enc(packet + 8, 0x100U << 16 | 3);
+	le32enc(packet + 12, 2048U << 16 | 1U << 8);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO &&
+	    htc.service[0].id == 0 && htc.pending_service == 0x300);
+	le32enc(packet + 8, 0x300U << 16 | 3);
+	packet[12] = 1;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO);
+	packet[12] = 0;
+	packet[13] = htc.endpoints;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO);
+	packet[13] = 1;
+	packet[16] = 1;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO);
+	packet[16] = 0;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == 0 &&
+	    htc.service[0].id == 0x300 && htc.service[0].endpoint == 1 &&
+	    htc.service[0].max_message == 2048 && htc.pending_service == 0);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO);
+	CHECK(mhi_lab_htc_connect(&htc, ATH12K_HTC_SVC_ID_WMI_CONTROL, packet) == 0 &&
+	    le32dec(packet + 4) == 1U << 8 && le32dec(packet + 12) == 32U << 8);
+	le32enc(packet, 12U << 16);
+	le32enc(packet + 8, 0x100U << 16 | 3);
+	le32enc(packet + 12, 2048U << 16 | 1U << 8);
+	le32enc(packet + 16, 0);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO &&
+	    htc.service[1].id == 0);
+	packet[13] = 2;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == 0 &&
+	    htc.service[1].endpoint == 2 && htc.service[1].id == 0x100);
+out:
+	if (error == 0)
+		printf("lkpi_mhi_test: HTC READY and HTT/WMI connection wire layouts, reply matching, credit allocation, status, metadata and endpoint uniqueness passed (model only)\n");
+	return (error);
+}
