From 5be0d52bba778495847705754ecc980c986ff7e7 Mon Sep 17 00:00:00 2001
From: dcasati <dcasati@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:57:18 -0600
Subject: [PATCH 5/6] LinuxKPI: keep NO_IR/DFS/indoor regulatory channels as
 passive

The strict regulatory filter rejected any channel touched by a rule with
NO_IR, DFS or NO_OUTDOOR. LinuxKPI only offers station and monitor
modes, so carry these as IEEE80211_CHAN_NO_IR/RADAR (net80211 passive
and DFS) instead of disabling the channel.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 sys/compat/linuxkpi/common/src/linux_80211.c | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletions(-)

diff --git a/sys/compat/linuxkpi/common/src/linux_80211.c b/sys/compat/linuxkpi/common/src/linux_80211.c
index 037fa02e..0d365044 100644
--- a/sys/compat/linuxkpi/common/src/linux_80211.c
+++ b/sys/compat/linuxkpi/common/src/linux_80211.c
@@ -8589,6 +8589,7 @@ lkpi_regulatory_channel(const struct linuxkpi_ieee80211_regdomain *regd,
 {
 	const struct ieee80211_reg_rule *rule;
 	int64_t low, high;
+	uint32_t restrict_flags;
 	int i, power, gain;
 	bool covered, prohibited;
 
@@ -8607,6 +8608,7 @@ lkpi_regulatory_channel(const struct linuxkpi_ieee80211_regdomain *regd,
 	high = (int64_t)in->center_freq * 1000 + 10000;
 	power = in->max_power;
 	gain = 63;
+	restrict_flags = 0;
 	covered = prohibited = false;
 	for (i = 0; i < regd->n_reg_rules; i++) {
 		rule = &regd->reg_rules[i];
@@ -8617,8 +8619,19 @@ lkpi_regulatory_channel(const struct linuxkpi_ieee80211_regdomain *regd,
 		if (rule->flags & ~(NL80211_RRF_AUTO_BW |
 		    NL80211_RRF_NO_HT40 | NL80211_RRF_NO_80MHZ |
 		    NL80211_RRF_NO_160MHZ | NL80211_RRF_NO_HE |
-		    NL80211_RRF_NO_EHT | NL80211_RRF_NO_320MHZ))
+		    NL80211_RRF_NO_EHT | NL80211_RRF_NO_320MHZ |
+		    NL80211_RRF_NO_IR | NL80211_RRF_DFS |
+		    NL80211_RRF_NO_OUTDOOR))
 			prohibited = true;
+		/*
+		 * LinuxKPI only offers station/monitor modes, so no-IR and
+		 * radar channels stay usable as passive (listen-first) ones.
+		 */
+		if (rule->flags & NL80211_RRF_NO_IR)
+			restrict_flags |= IEEE80211_CHAN_NO_IR;
+		if (rule->flags & NL80211_RRF_DFS)
+			restrict_flags |= IEEE80211_CHAN_NO_IR |
+			    IEEE80211_CHAN_RADAR;
 		if (rule->freq_range.max_bandwidth_khz < 20000)
 			prohibited = true;
 		power = min(power, rule->power_rule.max_eirp / 100);
@@ -8632,10 +8645,12 @@ lkpi_regulatory_channel(const struct linuxkpi_ieee80211_regdomain *regd,
 	if (prohibited || power < 1 || power > 63 || gain < 0 || gain > 63 ||
 	    (in->flags & ~(IEEE80211_CHAN_NO_HT40 |
 	    IEEE80211_CHAN_NO_80MHZ | IEEE80211_CHAN_NO_160MHZ |
-	    IEEE80211_CHAN_NO_EHT)) != 0)
+	    IEEE80211_CHAN_NO_EHT | IEEE80211_CHAN_NO_IR |
+	    IEEE80211_CHAN_RADAR)) != 0)
 		return (-EOPNOTSUPP);
 
 	out->flags &= ~IEEE80211_CHAN_DISABLED;
+	out->flags |= restrict_flags;
 	out->orig_flags = in->flags;
 	out->orig_mpwr = in->max_power;
 	out->max_power = out->max_reg_power = power;
-- 
