@@ -40,48 +46,158 @@ struct rhashtable_params {
 };
 
 struct rhashtable {
+	struct rhash_head **buckets;
+	unsigned int nbuckets;
+	spinlock_t lock;
 };
 
+/*
+ * Fixed-bucket implementation for inline, fixed-length keys.  nelem_hint
+ * selects the bucket count (one if unspecified); collisions form unbounded
+ * chains.  automatic_shrinking is accepted as a tuning hint, not implemented.
+ * There is no resizing, element limit, or allocation during insert/remove.
+ *
+ * The table lock serializes ALL chain access, including lookups; these are
+ * not lockless RCU lookups.  A returned object is not reference counted.
+ * Callers must protect its subsequent use with their own exclusion against
+ * removal/free, or hold an outer RCU read section and defer freeing removed
+ * objects with call_rcu()/synchronize_rcu().  The table never frees objects.
+ * Keys must remain unchanged while linked, and a head belongs to one table.
+ * Fast operations must use the same key/head layout passed to init.
+ *
+ * Init/destroy require exclusive ownership of the table.  Destroy requires
+ * callers to have quiesced all operations; it does not wait for readers of
+ * returned objects or drain callbacks.
+ */
 static inline int
 rhashtable_init(struct rhashtable *rht,
     const struct rhashtable_params *params)
 {
 
-	pr_debug("%s: TODO\n", __func__);
-	return (-1);
+	rht->buckets = NULL;
+	rht->nbuckets = 0;
+	if (params->key_len == 0)
+		return (-EINVAL);
+
+	rht->nbuckets = params->nelem_hint != 0 ? params->nelem_hint : 1;
+	rht->buckets = kcalloc(rht->nbuckets, sizeof(*rht->buckets),
+	    GFP_KERNEL);
+	if (rht->buckets == NULL) {
+		rht->nbuckets = 0;
+		return (-ENOMEM);
+	}
+	spin_lock_init(&rht->lock);
+	return (0);
 }
 
 static inline void
 rhashtable_destroy(struct rhashtable *rht)
 {
-	pr_debug("%s: TODO\n", __func__);
+
+	if (rht->buckets == NULL)
+		return;
+	kfree(rht->buckets);
+	rht->buckets = NULL;
+	rht->nbuckets = 0;
+	spin_lock_destroy(&rht->lock);
 }
 
 static inline void *
-rhashtable_lookup_fast(struct rhashtable *rht, const void *key,
+lkpi_rhashtable_object(struct rhash_head *head,
     const struct rhashtable_params params)
 {
 
-	pr_debug("%s: TODO\n", __func__);
+	return ((char *)head - params.head_offset);
+}
+
+static inline unsigned int
+lkpi_rhashtable_bucket(struct rhashtable *rht, const void *key,
+    const struct rhashtable_params params)
+{
+
+	return (hash32_buf(key, params.key_len, HASHINIT) % rht->nbuckets);
+}
+
+/* Caller holds the table lock. */
+static inline void *
+lkpi_rhashtable_lookup(struct rhashtable *rht, const void *key,
+    unsigned int bucket, const struct rhashtable_params params)
+{
+	struct rhash_head *head;
+	void *object;
+
+	for (head = rht->buckets[bucket]; head != NULL; head = head->next) {
+		object = lkpi_rhashtable_object(head, params);
+		if (memcmp((char *)object + params.key_offset, key,
+		    params.key_len) == 0)
+			return (object);
+	}
 	return (NULL);
 }
 
+static inline void *
+rhashtable_lookup_fast(struct rhashtable *rht, const void *key,
+    const struct rhashtable_params params)
+{
+	void *object;
+	unsigned int bucket;
+
+	bucket = lkpi_rhashtable_bucket(rht, key, params);
+	spin_lock(&rht->lock);
+	object = lkpi_rhashtable_lookup(rht, key, bucket, params);
+	spin_unlock(&rht->lock);
+	return (object);
+}
+
 static inline void *
 rhashtable_lookup_get_insert_fast(struct rhashtable *rht,
     struct rhash_head *obj, const struct rhashtable_params params)
 {
+	const void *key;
+	void *existing;
+	unsigned int bucket;
 
-	pr_debug("%s: TODO\n", __func__);
-	return (NULL);
+	key = (char *)lkpi_rhashtable_object(obj, params) + params.key_offset;
+	bucket = lkpi_rhashtable_bucket(rht, key, params);
+	spin_lock(&rht->lock);
+	existing = lkpi_rhashtable_lookup(rht, key, bucket, params);
+	/*
+	 * NULL means inserted; duplicates return the existing object
+	 * unchanged.
+	 */
+	if (existing == NULL) {
+		obj->next = rht->buckets[bucket];
+		rht->buckets[bucket] = obj;
+	}
+	spin_unlock(&rht->lock);
+	return (existing);
 }
 
 static inline int
 rhashtable_remove_fast(struct rhashtable *rht,
     struct rhash_head *obj, const struct rhashtable_params params)
 {
+	struct rhash_head **link;
+	const void *key;
+	unsigned int bucket;
+	int error;
 
-	pr_debug("%s: TODO\n", __func__);
-	return (-ENOENT);
+	key = (char *)lkpi_rhashtable_object(obj, params) + params.key_offset;
+	bucket = lkpi_rhashtable_bucket(rht, key, params);
+	error = -ENOENT;
+	spin_lock(&rht->lock);
+	for (link = &rht->buckets[bucket]; *link != NULL;
+	    link = &(*link)->next) {
+		/* A matching key alone must not remove a different object. */
+		if (*link != obj)
+			continue;
+		*link = obj->next;
+		obj->next = NULL;
+		error = 0;
+		break;
+	}
+	spin_unlock(&rht->lock);
+	return (error);
 }
 
 #endif	/* _LINUXKPI_LINUX_RHASHTABLE_H */
