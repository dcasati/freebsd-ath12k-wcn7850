+#if defined(__FreeBSD__)
+#if defined(__FreeBSD__)
+static int ath12k_core_native_quiesce(struct ath12k_base *ab)
+{
+	int ret;
+
+	ret = ath12k_dp_dma_quiesce(ab);
+	if (!ret)
+		ret = ath12k_pci_quiesce(ab);
+	if (ret) {
+		ath12k_pci_retain_owner(ab);
+		ath12k_err(ab, "native cleanup refused without quiescence: %d\n", ret);
+	}
+	return ret;
+}
+
+static bool ath12k_core_native_retained(struct ath12k_base *ab)
+{
+	return ath12k_dp_dma_owned(ab) || ath12k_pci_dma_retained(ab);
+}
+
+static int ath12k_core_native_quiesce_locked(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+	int ret;
+
+	lockdep_assert_held(&ag->mutex);
+	lockdep_assert_held(&ab->core_lock);
+	/* The QMI worker being drained may need either of these locks. */
+	mutex_unlock(&ab->core_lock);
+	mutex_unlock(&ag->mutex);
+	ret = ath12k_core_native_quiesce(ab);
+	mutex_lock(&ag->mutex);
+	mutex_lock(&ab->core_lock);
+	return ret;
+}
+
+static int ath12k_core_native_group_quiesce(struct ath12k_hw_group *ag)
+{
+	int i, ret;
+
+	for (i = 0; i < ag->num_devices; i++) {
+		if (!ag->ab[i])
+			continue;
+		ret = ath12k_core_native_quiesce(ag->ab[i]);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int ath12k_core_native_group_quiesce_locked(struct ath12k_hw_group *ag)
+{
+	int ret;
+
+	lockdep_assert_held(&ag->mutex);
+	mutex_unlock(&ag->mutex);
+	ret = ath12k_core_native_group_quiesce(ag);
+	mutex_lock(&ag->mutex);
+	return ret;
+}
+
+/*
+ * Unregister from mac80211 while the firmware still runs, as Linux does, so
+ * that interface, station and key teardown can complete over WMI.  Native
+ * quiescence resets the device and therefore has to come after this.
+ */
+static void ath12k_core_native_mac_unregister_locked(struct ath12k_hw_group *ag)
+{
+	lockdep_assert_held(&ag->mutex);
+	if (test_and_clear_bit(ATH12K_GROUP_FLAG_REGISTERED, &ag->flags))
+		ath12k_mac_unregister(ag);
+}
+
+void ath12k_core_native_mac_unregister(struct ath12k_base *ab)
+{
+	struct ath12k_hw_group *ag = ab->ag;
+
+	if (ag == NULL)
+		return;
+	mutex_lock(&ag->mutex);
+	ath12k_core_native_mac_unregister_locked(ag);
+	mutex_unlock(&ag->mutex);
+}
+#endif
+#endif
