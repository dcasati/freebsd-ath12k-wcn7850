+static int ath12k_reg_submit_chan_list(struct ath12k *ar)
+{
+	struct ieee80211_hw *hw = ath12k_ar_to_hw(ar);
+	struct wiphy *wiphy = hw->wiphy;
+	const struct ieee80211_regdomain *published;
+	struct ath12k_wmi_scan_chan_list_arg *arg = NULL;
+	struct ieee80211_supported_band *sband;
+	struct ath12k_wmi_channel_arg *ch;
+	struct ieee80211_channel *channel, expected;
+	int power[2] = { INT_MAX, INT_MAX };
+	int band, i, n = 0, ret;
+
+	lockdep_assert_wiphy(wiphy);
+	ret = linuxkpi_regulatory_tx_pending(wiphy);
+	if (ret)
+		return ret;
+	if (ar->ah->num_radio != 1 || ar->ah->state == ATH12K_HW_STATE_RESTARTING) {
+		ret = -EOPNOTSUPP;
+		goto fail;
+	}
+	published = rcu_dereference_protected(wiphy->regd, 1);
+	if (!published) {
+		ret = -ENODATA;
+		goto fail;
+	}
+	for (band = 0; band < NUM_NL80211_BANDS; band++) {
+		sband = wiphy->bands[band];
+		if (!sband)
+			continue;
+		for (i = 0; i < sband->n_channels; i++)
+			if (!(sband->channels[i].flags & IEEE80211_CHAN_DISABLED))
+				n++;
+	}
+	if (!n || n > U16_MAX) {
+		ret = !n ? -ENODATA : -E2BIG;
+		goto fail;
+	}
+	arg = kzalloc_flex(*arg, channel, n);
+	if (!arg) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	arg->pdev_id = ar->pdev->pdev_id;
+	arg->nallchans = n;
+	ch = arg->channel;
+	for (band = 0; band < NUM_NL80211_BANDS; band++) {
+		sband = wiphy->bands[band];
+		if (!sband)
+			continue;
+		for (i = 0; i < sband->n_channels; i++) {
+			channel = &sband->channels[i];
+			if (channel->flags & IEEE80211_CHAN_DISABLED)
+				continue;
+			if ((band != NL80211_BAND_2GHZ && band != NL80211_BAND_5GHZ) ||
+			    channel->band != band) {
+				ret = -EOPNOTSUPP;
+				goto fail;
+			}
+			if (!ar->mac.sbands[band].channels ||
+			    channel->center_freq < KHZ_TO_MHZ(ar->freq_range.start_freq) ||
+			    channel->center_freq > KHZ_TO_MHZ(ar->freq_range.end_freq)) {
+				ret = -ERANGE;
+				goto fail;
+			}
+			ret = lkpi_regulatory_channel(published, channel, &expected);
+			if (ret || expected.flags != channel->flags ||
+			    expected.max_power != channel->max_power ||
+			    expected.max_reg_power != channel->max_reg_power ||
+			    expected.max_antenna_gain != channel->max_antenna_gain) {
+				ret = -ESTALE;
+				goto fail;
+			}
+			ret = ath12k_reg_prepare_channel(channel, ar->min_tx_power,
+							ar->max_tx_power, ch);
+			if (ret)
+				goto fail;
+			power[band] = min(power[band], channel->max_power);
+			ch++;
+		}
+	}
+	/*
+	 * qwz checks ordered WMI submission, not a nonexistent channel-list ACK.
+	 * A partial/chunked send or either PDEV power failure leaves TX revoked.
+	 */
+	ret = linuxkpi_regulatory_tx_pending(wiphy);
+	if (ret)
+		goto fail;
+	ret = ath12k_wmi_send_scan_chan_list_cmd(ar, arg);
+	if (ret)
+		goto fail;
+	for (band = NL80211_BAND_2GHZ; band <= NL80211_BAND_5GHZ; band++) {
+		if (power[band] == INT_MAX)
+			continue;
+		ret = linuxkpi_regulatory_tx_pending(wiphy);
+		if (ret)
+			goto fail;
+		ret = ath12k_wmi_pdev_set_param(ar,
+			band == NL80211_BAND_2GHZ ?
+			WMI_PDEV_PARAM_TXPOWER_LIMIT2G : WMI_PDEV_PARAM_TXPOWER_LIMIT5G,
+			power[band] * 2, ar->pdev->pdev_id);
+		if (ret)
+			goto fail;
+	}
+	ret = linuxkpi_regulatory_set_tx_ready(wiphy, published);
+	if (ret)
+		goto fail;
+	if (power[NL80211_BAND_2GHZ] != INT_MAX)
+		ar->txpower_limit_2g = power[NL80211_BAND_2GHZ] * 2;
+	if (power[NL80211_BAND_5GHZ] != INT_MAX)
+		ar->txpower_limit_5g = power[NL80211_BAND_5GHZ] * 2;
+	kfree(arg);
+	return 0;
+fail:
+	linuxkpi_regulatory_revoke(wiphy);
+	kfree(arg);
+	ath12k_warn(ar->ab, "strict regulatory submission failed: %d; TX revoked\n",
+		    ret);
+	return ret;
+}
