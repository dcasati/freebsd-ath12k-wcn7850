+/*
+ * WMI PDEV response fixed payload is pdev_id, status, configured mode,
+ * num_vdev_mac_entries (wlan-fw-api wmi_unified.h). Startup has no VDEVs.
+ */
+static inline u32
+ath12k_wmi_startup_word(const void *data)
+{
+	__le32 word;
+
+	memcpy(&word, data, sizeof(word));
+	return le32_to_cpu(word);
+}
+
+static inline int
+ath12k_wmi_hw_mode_response_decode(const void *data, size_t length,
+    u32 requested_mode, u32 *status)
+{
+	const u8 *p = data;
+	u32 header, result = 0, configured = 0;
+	size_t n;
+	bool fixed = false;
+
+	if (!p || !status)
+		return -EINVAL;
+	while (length) {
+		if (length < sizeof(__le32))
+			return -EPROTO;
+		header = ath12k_wmi_startup_word(p);
+		n = header & 0xffff;
+		if ((n & 3) || n > length - sizeof(__le32))
+			return -EPROTO;
+		switch (header >> 16) {
+		case WMI_TAG_PDEV_SET_HW_MODE_RESPONSE_EVENT:
+			if (fixed || n < 4 * sizeof(__le32) ||
+			    ath12k_wmi_startup_word(p + 4) != WMI_PDEV_ID_SOC)
+				return -EPROTO;
+			result = ath12k_wmi_startup_word(p + 8);
+			configured = ath12k_wmi_startup_word(p + 12);
+			if (ath12k_wmi_startup_word(p + 16))
+				return -EOPNOTSUPP;
+			fixed = true;
+			break;
+		case WMI_TAG_ARRAY_STRUCT:
+			if (n)
+				return -EOPNOTSUPP;
+			break;
+		}
+		p += sizeof(__le32) + n;
+		length -= sizeof(__le32) + n;
+	}
+	if (!fixed || (!result && configured != requested_mode))
+		return -EPROTO;
+	*status = result;
+	return 0;
+}
+
+struct ath12k_wmi_hw_mode_state {
+	u32 requested, status;
+	int error;
+	bool attempted, pending;
+};
+
+static inline int
+ath12k_wmi_hw_mode_begin(struct ath12k_wmi_hw_mode_state *state, u32 mode,
+    bool unified_ready, bool single_pdev_only)
+{
+	if (!unified_ready)
+		return -EAGAIN;
+	if (!single_pdev_only || mode != WMI_HOST_HW_MODE_DBS)
+		return -EOPNOTSUPP;
+	if (state->attempted)
+		return -EALREADY;
+	state->attempted = state->pending = true;
+	state->requested = mode;
+	state->status = 0;
+	state->error = -EINPROGRESS;
+	return 0;
+}
+
+static inline void
+ath12k_wmi_hw_mode_fail(struct ath12k_wmi_hw_mode_state *state, int error)
+{
+	state->pending = false;
+	state->error = error;
+}
+
+static inline int
+ath12k_wmi_hw_mode_accept(struct ath12k_wmi_hw_mode_state *state,
+    const void *data, size_t length)
+{
+	u32 status = 0;
+	int ret;
+
+	if (!state->pending)
+		return -EALREADY;
+	ret = ath12k_wmi_hw_mode_response_decode(data, length,
+	    state->requested, &status);
+	state->status = status;
+	ath12k_wmi_hw_mode_fail(state, ret ? ret : status ? -EIO : 0);
+	return state->error;
+}
+
+static inline int
+ath12k_wmi_hw_mode_htt_ready(const struct ath12k_wmi_hw_mode_state *state,
+    bool unified_ready, bool single_pdev_only)
+{
+	if (!unified_ready)
+		return -EAGAIN;
+	if (!single_pdev_only)
+		return 0;
+	if (!state->attempted || state->pending)
+		return -EAGAIN;
+	return state->error;
+}
+
+int ath12k_wmi_check_htt_ready(struct ath12k_base *);
