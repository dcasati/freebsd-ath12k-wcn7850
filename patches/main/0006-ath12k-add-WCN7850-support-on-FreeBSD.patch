@@ -237,25 +237,47 @@ static void ath12k_ce_send_done_cb(struct ath12k_ce_pipe *pipe)
 {
 	struct ath12k_base *ab = pipe->ab;
 	struct sk_buff *skb;
+#if defined(__FreeBSD__)
+	bool completed __maybe_unused = false;
+#endif
 
 	while (!IS_ERR(skb = ath12k_ce_completed_send_next(pipe))) {
 		if (!skb)
 			continue;
+#if defined(__FreeBSD__)
+		completed = true;
+#endif
 
 		dma_unmap_single(ab->dev, ATH12K_SKB_CB(skb)->paddr, skb->len,
 				 DMA_TO_DEVICE);
 		dev_kfree_skb_any(skb);
 	}
+#ifdef __FreeBSD__
+	/* Ring space and firmware credits are independent. Wake a CE3 sender
+	 * without manufacturing credits or completing/freeing its skb twice.
+	 */
+	if (completed && pipe->pipe_num == 3)
+		wake_up(&ab->wmi_ab.tx_credits_wq);
+#endif
 }
 
