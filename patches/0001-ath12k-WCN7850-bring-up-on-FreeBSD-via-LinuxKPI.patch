+static inline u16
+ath12k_wmi_scan_chan_limit(u32 max_message_size)
+{
+	const size_t overhead = sizeof(struct wmi_cmd_hdr) +
+	    sizeof(struct wmi_scan_chan_list_cmd) + TLV_HDR_SIZE;
+	u32 count;
+
+	if (max_message_size < overhead + sizeof(struct ath12k_wmi_channel_params))
+		return 0;
+	count = (max_message_size - overhead) /
+	    sizeof(struct ath12k_wmi_channel_params);
+	return min_t(u32, count, ATH12K_WMI_MAX_NUM_CHAN_PER_CMD);
+}
