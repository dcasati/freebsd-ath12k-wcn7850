+int
+linuxkpi_regulatory_tx_pending(struct wiphy *wiphy)
+{
+	struct lkpi_wiphy *lwiphy;
+	u_int state;
+	int error;
+
+	if (wiphy == NULL || !wiphy->lkpi_regulatory_strict)
+		return (-EINVAL);
+	lwiphy = WIPHY_TO_LWIPHY(wiphy);
+	sx_xlock(&lwiphy->reg_sx);
+	state = atomic_load_acq_int(&lwiphy->reg_tx_ready);
+	error = 0;
+	if (lwiphy->reg_failed || state == 2)
+		error = -EBUSY;
+	else if (lwiphy->regd_owned == NULL)
+		error = -ENODATA;
+	else if (state == 1 &&
+	    !atomic_cmpset_int(&lwiphy->reg_tx_ready, 1, 0))
+		error = -EBUSY;
+	sx_xunlock(&lwiphy->reg_sx);
+	return (error);
