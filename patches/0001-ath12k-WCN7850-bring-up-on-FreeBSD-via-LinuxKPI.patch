+static struct ieee80211_regdomain *
+ath12k_reg_build_station_regd(struct ath12k_base *ab,
+			    const struct ath12k_reg_info *info)
+{
+	struct ieee80211_regdomain *regd;
+	const struct ath12k_reg_rule *rule;
+	struct ath12k_reg_freq range[2] = {
+		{ .start_freq = INT_MAX }, { .start_freq = INT_MAX }
+	};
+	u32 band, i, n, offset = 0, count[2];
+	int ret;
+
+	count[0] = info->num_2g_reg_rules;
+	count[1] = info->num_5g_reg_rules;
+	if (info->status_code != REG_SET_CC_STATUS_PASS ||
+	    count[0] > 128 || count[1] > 128 || count[0] + count[1] > 128 ||
+	    !(count[0] + count[1]) ||
+	    (count[0] && !info->reg_rules_2g_ptr) ||
+	    (count[1] && !info->reg_rules_5g_ptr))
+		return NULL;
+	n = count[0] + count[1];
+	regd = kzalloc(sizeof(*regd) + n * sizeof(regd->reg_rules[0]), GFP_ATOMIC);
+	if (!regd)
+		return NULL;
+	memcpy(regd->alpha2, info->alpha2, sizeof(regd->alpha2));
+	regd->dfs_region = ath12k_map_fw_dfs_region(info->dfs_region);
+	for (band = 0; band < 2; band++) {
+		rule = band == 0 ? info->reg_rules_2g_ptr : info->reg_rules_5g_ptr;
+		for (i = 0; i < count[band]; i++) {
+			if (rule[i].start_freq < (band == 0 ? 2300 : 4900) ||
+			    rule[i].end_freq > (band == 0 ? 2500 : 5920))
+				goto fail;
+			ret = ath12k_reg_prepare_rule(&rule[i],
+				band == 0 ? info->min_bw_2g : info->min_bw_5g,
+				band == 0 ? info->max_bw_2g : info->max_bw_5g,
+				info->phybitmap, &regd->reg_rules[offset++]);
+			if (ret)
+				goto fail;
+			range[band].start_freq = min(range[band].start_freq,
+						    (u32)rule[i].start_freq);
+			range[band].end_freq = max(range[band].end_freq,
+						  (u32)rule[i].end_freq);
+		}
+	}
+	regd->n_reg_rules = n;
+	ab->reg_freq_2ghz = range[0];
+	ab->reg_freq_5ghz = range[1];
+	/* No 6 GHz authorization is inferred from the capability event. */
+	ab->reg_freq_6ghz.start_freq = INT_MAX;
+	ab->reg_freq_6ghz.end_freq = 0;
+	return regd;
+fail:
+	kfree(regd);
+	return NULL;
+}
