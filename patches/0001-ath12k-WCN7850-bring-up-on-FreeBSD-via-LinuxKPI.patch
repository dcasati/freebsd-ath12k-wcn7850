+};
+
+struct lkpi_mhi_event_ring {
+	struct lkpi_mhi_dma dma;
+	size_t read_offset, write_offset;
+	unsigned int irq;
+	unsigned int type;
+};
+
+struct lkpi_mhi_slot {
+	struct lkpi_mhi_dma dma;
+	size_t length;
+};
+
+struct lkpi_mhi_xfer {
+	struct lkpi_mhi_slot *slots;
+	size_t read_offset, write_offset;
+	unsigned int count, queued, direction, event_ring;
+	bool starting, started;
+};
+
+struct lkpi_mhi_context {
+	struct mtx lock;
+	struct lkpi_mhi_dma channels, events, commands, command_ring;
+	struct lkpi_mhi_dma *channel_rings;
+	struct lkpi_mhi_xfer *transfers;
+	struct lkpi_mhi_event_ring *event_rings;
+	unsigned int max_channels, num_events;
+	uint32_t channel_db, event_db, state, ee;
+	unsigned int state_events, ee_events;
+	size_t command_read, command_write;
+	unsigned int command_channel, command_type, command_events;
+	unsigned int tx_packets, rx_packets;
+	unsigned int rx_length;
+	/* Bounded lab observation, not an upper-layer receive queue. */
+	uint8_t rx_sample[64];
+	/* Under lock: positive errno on failure; no sleep or retained DMA pointer. */
+	int (*receive)(void *, const void *, size_t);
+	void *receive_arg;
+	int event_error;
+	bool published, command_pending, stopping, quiescing;
+};
+
+#define LKPI_MHI_BHI_SIZE		(512 * 1024)
+#define LKPI_MHI_BHI_OFFSET	0x28
+#define LKPI_MHI_CTRL		0x38
+#define LKPI_MHI_STATUS		0x48
+#define LKPI_MHI_BHI_EXECENV	0x28
+#define LKPI_MHI_BHI_STATUS	0x2c
+
+struct lkpi_mhi_vector {
+	uint64_t address, length;
+} __packed;
+
+CTASSERT(sizeof(struct lkpi_mhi_vector) == 16);
+
+struct lkpi_mhi_boot {
+	struct lkpi_mhi_dma image;
+	struct lkpi_mhi_dma *segments;
+	struct lkpi_mhi_dma vectors;
+	unsigned int num_segments;
+	uint32_t bhi, status, ee;
+	uint32_t bhie, bhie_status;
+	bool pending;
+};
+
+struct lkpi_mhi_runtime {
+	const struct mhi_controller_config *config;
+	struct lkpi_mhi_boot boot;
+	int (*receive)(void *, const void *, size_t);
+	void *receive_arg;
+	unsigned int irqs;
+	bool prepared, powered, transport_started;
+};
+
+/* Caller serializes allocation/free and keeps the device quiescent throughout. */
+int linuxkpi_mhi_alloc_context(struct mhi_controller *,
+    const struct mhi_controller_config *);
+
+/* After publication, retain the image until the caller confirms device reset. */
+int linuxkpi_mhi_boot_bhi(struct mhi_controller *, struct lkpi_mhi_boot *,
+    const void *, size_t);
+int linuxkpi_mhi_boot_ready(struct mhi_controller *, struct lkpi_mhi_boot *);
+int linuxkpi_mhi_boot_bhie(struct mhi_controller *, struct lkpi_mhi_boot *,
+    const void *, size_t);
+int linuxkpi_mhi_process_events(struct mhi_controller *);
+int linuxkpi_mhi_stop_channel(struct mhi_controller *, unsigned int);
+int linuxkpi_mhi_alloc_transfer(struct mhi_controller *, unsigned int);
+int linuxkpi_mhi_start_channel(struct mhi_controller *, unsigned int);
+int linuxkpi_mhi_submit(struct mhi_controller *, unsigned int,
+    const void *, size_t);
+int linuxkpi_mhi_boot_free(struct lkpi_mhi_boot *);
+/* Address-bearing QMI messages keep these buffers owned until verified reset. */
+int linuxkpi_mhi_alloc_memory(struct mhi_controller *, struct lkpi_mhi_dma *,
+    size_t);
+int linuxkpi_mhi_free_memory(struct mhi_controller *, struct lkpi_mhi_dma *);
