+
+int
+linuxkpi_mhi_prepare(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_runtime *runtime;
+	int error;
+
+	if (ctrl == NULL || (runtime = ctrl->lkpi_runtime) == NULL)
+		return (-EOPNOTSUPP);
+	if (runtime->prepared || linuxkpi_mhi_dma_owned(ctrl))
+		return (-EBUSY);
+	if (ctrl->timeout_ms == 0 || ctrl->timeout_ms > 10000 ||
+	    !ctrl->fbc_download || ctrl->sbl_size != LKPI_MHI_BHI_SIZE ||
+	    ctrl->seg_len != LKPI_MHI_BHI_SIZE)
+		return (-EOPNOTSUPP);
+	error = linuxkpi_mhi_alloc_context(ctrl, runtime->config);
+	if (error != 0)
+		return (error);
+	ctrl->lkpi_context->receive = runtime->receive;
+	ctrl->lkpi_context->receive_arg = runtime->receive_arg;
+	error = linuxkpi_mhi_alloc_transfer(ctrl, 20);
+	if (error == 0)
+		error = linuxkpi_mhi_alloc_transfer(ctrl, 21);
+	if (error != 0)
+		goto fail;
+	while (runtime->irqs < ctrl->nr_irqs) {
+		error = request_irq(ctrl->irq[runtime->irqs], mhi_controller_intr,
+		    ctrl->irq_flags, "mhi", ctrl);
+		if (error != 0)
+			goto fail;
+		runtime->irqs++;
+	}
+	runtime->prepared = true;
+	return (0);
+fail:
+	mhi_controller_free_irqs(ctrl);
+	linuxkpi_mhi_free_context(ctrl);
+	return (error);
+}
+
+int
+linuxkpi_mhi_power_up(struct mhi_controller *ctrl)
+{
+	const struct firmware *firmware = NULL;
+	struct lkpi_mhi_runtime *runtime;
+	const uint8_t *data;
+	size_t length;
+	int error;
+
+	if (ctrl == NULL || (runtime = ctrl->lkpi_runtime) == NULL ||
+	    !runtime->prepared)
+		return (-ENXIO);
+	/* Do not boot firmware without an installed, lifetime-owned consumer. */
+	if (ctrl->lkpi_context == NULL || ctrl->lkpi_context->receive == NULL)
+		return (-ENXIO);
+	if (runtime->powered || linuxkpi_mhi_dma_owned(ctrl))
+		return (-EBUSY);
+	data = ctrl->fw_data;
+	length = ctrl->fw_sz;
+	if (data == NULL) {
+		if (ctrl->fw_image == NULL)
+			return (-ENOENT);
+		error = request_firmware(&firmware, ctrl->fw_image, ctrl->cntrl_dev);
+		if (error != 0)
+			return (error);
+		data = firmware->data;
+		length = firmware->size;
+	}
+	if (length < ctrl->sbl_size) {
+		error = -EINVAL;
+		goto out;
+	}
+	error = linuxkpi_mhi_boot_bhi(ctrl, &runtime->boot, data, ctrl->sbl_size);
+	if (error != 0)
+		goto out;
+	error = linuxkpi_mhi_boot_ready(ctrl, &runtime->boot);
+	if (error != 0)
+		goto out;
+	/* Combined SBL + ELF images use the same split as the proven lab path. */
+	if (length >= ctrl->sbl_size + 4 &&
+	    memcmp(data + ctrl->sbl_size, "\177ELF", 4) == 0) {
+		data += ctrl->sbl_size;
+		length -= ctrl->sbl_size;
+	}
+	error = linuxkpi_mhi_boot_bhie(ctrl, &runtime->boot, data, length);
+	if (error == 0) {
+		runtime->powered = true;
+		error = linuxkpi_mhi_start_transport(ctrl);
+	}
+out:
+	if (firmware != NULL)
+		release_firmware(firmware);
+	if (error == 0)
+		ctrl->status_cb(ctrl, MHI_CB_EE_MISSION_MODE);
+	/* Errors after publication deliberately retain every DMA mapping. */
+	return (error);
+}
+
+void
+linuxkpi_mhi_power_down(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_context *context;
+
+	if (ctrl == NULL || (context = ctrl->lkpi_context) == NULL)
+		return;
+	mtx_lock(&context->lock);
+	context->quiescing = true;
+	wakeup(context);
+	mtx_unlock(&context->lock);
+}
+
+int
+linuxkpi_mhi_reset_complete(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_runtime *runtime;
+	struct lkpi_mhi_context *context;
+	sbintime_t deadline;
+	uint32_t control, status, bhi, ee;
+	int error;
+
+	if (ctrl == NULL || (runtime = ctrl->lkpi_runtime) == NULL)
+		return (-ENXIO);
+	context = ctrl->lkpi_context;
+	if (context != NULL && !context->quiescing)
+		return (-EBUSY);
+	error = mhi_boot_read(ctrl, LKPI_MHI_BHI_OFFSET, &bhi);
+	if (error != 0)
+		return (-error);
+	if (bhi < 0xb0 || (bhi & 3) != 0 ||
+	    bhi > MIN(ctrl->reg_len, 0xfe0) - 0x40)
+		return (-EIO);
+	deadline = sbinuptime() + SBT_1S;
+	do {
+		error = mhi_boot_read(ctrl, LKPI_MHI_CTRL, &control);
+		if (error == 0)
+			error = mhi_boot_read(ctrl, LKPI_MHI_STATUS, &status);
+		if (error == 0)
+			error = mhi_boot_read(ctrl, bhi + LKPI_MHI_BHI_EXECENV, &ee);
+		if (error != 0)
+			return (-error);
+		if ((control & 0xff02) == 0 && (status & 0xff05) == 0 && ee == 0) {
+			runtime->boot.pending = false;
+			runtime->powered = runtime->transport_started = false;
+			if (context != NULL) {
+				mtx_lock(&context->lock);
+				context->published = false;
+				mtx_unlock(&context->lock);
+			}
+			return (0);
+		}
+		pause_sbt("mhipbl", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	return (-ETIMEDOUT);
+}
+
+void
+linuxkpi_mhi_unprepare(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_runtime *runtime;
+
+	if (ctrl == NULL)
+		return;
+	runtime = ctrl->lkpi_runtime;
+	if (runtime == NULL) {
+		linuxkpi_mhi_free_context(ctrl);
+		return;
+	}
+	if (linuxkpi_mhi_dma_owned(ctrl)) {
+		pr_err("%s: verified SoC reset required; retaining DMA and IRQs\n",
+		    __func__);
+		return;
+	}
+	mhi_controller_free_irqs(ctrl);
+	(void)linuxkpi_mhi_boot_free(&runtime->boot);
+	linuxkpi_mhi_free_context(ctrl);
+	runtime->prepared = false;
+}
+
+int
+linuxkpi_mhi_set_receive(struct mhi_controller *ctrl,
+    int (*receive)(void *, const void *, size_t), void *arg)
+{
+	struct lkpi_mhi_runtime *runtime;
+	struct lkpi_mhi_context *context;
+	int error = 0;
+
+	if (ctrl == NULL || (runtime = ctrl->lkpi_runtime) == NULL ||
+	    (receive == NULL && arg != NULL))
+		return (-EINVAL);
+	context = ctrl->lkpi_context;
+	if (context != NULL)
+		mtx_lock(&context->lock);
+	if (linuxkpi_mhi_dma_owned(ctrl) ||
+	    (receive != NULL && runtime->receive != NULL))
+		error = -EBUSY;
+	else {
+		runtime->receive = receive;
+		runtime->receive_arg = arg;
+		if (context != NULL) {
+			context->receive = receive;
+			context->receive_arg = arg;
+		}
+	}
+	if (context != NULL)
+		mtx_unlock(&context->lock);
+	return (error);
+}
+
+int
+linuxkpi_mhi_start_transport(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_runtime *runtime;
+	struct lkpi_mhi_context *context;
+	sbintime_t deadline;
+	unsigned int channel;
+	int error;
+
+	if (ctrl == NULL || (runtime = ctrl->lkpi_runtime) == NULL ||
+	    !runtime->powered || ctrl->lkpi_context == NULL ||
+	    ctrl->lkpi_context->receive == NULL)
+		return (-ENXIO);
+	if (runtime->transport_started)
+		return (-EBUSY);
+	context = ctrl->lkpi_context;
+	for (channel = 20; channel <= 21; channel++) {
+		error = linuxkpi_mhi_start_channel(ctrl, channel);
+		if (error != 0)
+			return (error);
+		deadline = sbinuptime() + ctrl->timeout_ms * SBT_1MS;
+		mtx_lock(&context->lock);
+		while (!context->transfers[channel].started &&
+		    context->event_error == 0 && !context->quiescing) {
+			error = msleep_sbt(context, &context->lock, 0, "mhiipcr",
+			    deadline, 0, C_ABSOLUTE);
+			if (error != 0)
+				break;
+		}
+		if (context->event_error != 0)
+			error = context->event_error;
+		else if (context->quiescing)
+			error = ECANCELED;
+		mtx_unlock(&context->lock);
+		if (error != 0)
+			return (-error);
+	}
+	runtime->transport_started = true;
+	return (0);
 }
