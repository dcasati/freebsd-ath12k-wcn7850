+#ifdef __FreeBSD__
+static int
+ath12k_reg_prepare_rule(const struct ath12k_reg_rule *in, u32 min_bw,
+		       u32 max_bw, u32 phy_flags, struct ieee80211_reg_rule *out)
+{
+	u32 known = REGULATORY_CHAN_DISABLED | REGULATORY_CHAN_NO_IR |
+		REGULATORY_CHAN_RADAR | REGULATORY_CHAN_NO_OFDM |
+		REGULATORY_CHAN_INDOOR_ONLY | REGULATORY_CHAN_NO_HT40 |
+		REGULATORY_CHAN_NO_80MHZ | REGULATORY_CHAN_NO_160MHZ |
+		REGULATORY_CHAN_NO_20MHZ | REGULATORY_CHAN_NO_10MHZ;
+	u32 flags;
+
+	if (in->start_freq >= in->end_freq || !in->max_bw ||
+	    !max_bw || min_bw > max_bw)
+		return -EINVAL;
+	flags = ath12k_map_fw_reg_flags(in->flags) |
+		ath12k_map_fw_phy_flags(phy_flags);
+	/* Never discard a firmware prohibition which the generic mapper lacks. */
+	if ((in->flags & (REGULATORY_CHAN_DISABLED | REGULATORY_CHAN_NO_20MHZ)) ||
+	    (in->flags & ~known) || min_bw > 20)
+		flags |= NL80211_RRF_NO_IR;
+	if (in->psd_flag)
+		flags |= NL80211_RRF_PSD;
+	memset(out, 0, sizeof(*out));
+	out->flags = flags | NL80211_RRF_NO_HT40 |
+		NL80211_RRF_NO_80MHZ | NL80211_RRF_NO_160MHZ |
+		NL80211_RRF_NO_320MHZ | NL80211_RRF_NO_HE | NL80211_RRF_NO_EHT;
+	out->freq_range.start_freq_khz = MHZ_TO_KHZ(in->start_freq);
+	out->freq_range.end_freq_khz = MHZ_TO_KHZ(in->end_freq);
+	out->freq_range.max_bandwidth_khz = MHZ_TO_KHZ(min_t(u32, 20,
+							 min_t(u32, in->max_bw, max_bw)));
+	out->power_rule.max_antenna_gain = DBI_TO_MBI(in->ant_gain);
+	out->power_rule.max_eirp = DBM_TO_MBM(in->reg_power);
+	out->psd = in->psd_eirp;
+	return 0;
+}
