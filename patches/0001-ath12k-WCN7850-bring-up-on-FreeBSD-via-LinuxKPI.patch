new file mode 100644
index 00000000..57009478
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_tx_descriptor_test.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+"""Check production MSDU extension descriptors with 40-bit DMA addresses."""
+
+import argparse
+import pathlib
+import re
+import subprocess
+import tempfile
+
+from regulatory_production_test import declaration, function
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+ATH12K = ROOT / "sys/contrib/dev/athk/ath12k"
+SOURCE = ATH12K / "wifi7/dp_tx.c"
+
+PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/endian.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef uint32_t __le32;
+typedef uint64_t dma_addr_t;
+#define BIT(n) (UINT32_C(1) << (n))
+#define GENMASK(h,l) ((UINT32_MAX >> (31 - (h))) & (UINT32_MAX << (l)))
+#define le32_encode_bits(v,m) htole32(((uint32_t)(v) << __builtin_ctz(m)) & (m))
+struct ath12k_base { int unused; };
+"""
+
+TEST = r"""
+int main(void)
+{
+    static const uint64_t addresses[] = {
+        0, 0x12345678, 0xffffffff, 0x100000000,
+        0x727d08200, 0x72ec61800, 0xffffffffff,
+    };
+    struct ath12k_base ab = {};
+
+    for (unsigned i = 0; i < sizeof(addresses) / sizeof(addresses[0]); i++) {
+        for (unsigned protected = 0; protected < 2; protected++) {
+            struct hal_tx_info ti = {
+                .paddr = addresses[i],
+                .data_len = protected ? 65535 : 153,
+                .encap_type = protected ? HAL_TCL_ENCAP_TYPE_NATIVE_WIFI :
+                    HAL_TCL_ENCAP_TYPE_RAW,
+                .encrypt_type = protected ? HAL_ENCRYPT_TYPE_CCMP_128 :
+                    HAL_ENCRYPT_TYPE_OPEN,
+            };
+            struct hal_tx_msdu_ext_desc desc = {};
+            uint32_t info;
+            uint64_t encoded;
+
+            ath12k_wifi7_hal_tx_cmd_ext_desc_setup(&ab, &desc, &ti);
+            info = le32toh(desc.info1);
+            encoded = le32toh(desc.info0);
+            encoded |= (uint64_t)(info & HAL_TX_MSDU_EXT_INFO1_BUF_PTR_HI)
+                << HAL_ADDR_MSB_REG_SHIFT;
+            assert(encoded == ti.paddr);
+            assert((info >> 16) == ti.data_len);
+            assert((info & HAL_TX_MSDU_EXT_INFO1_EXTN_OVERRIDE) != 0);
+            assert(((info & HAL_TX_MSDU_EXT_INFO1_ENCAP_TYPE) >> 9)
+                == (uint32_t)ti.encap_type);
+            assert(((info & HAL_TX_MSDU_EXT_INFO1_ENCRYPT_TYPE) >> 11)
+                == (uint32_t)ti.encrypt_type);
+        }
+    }
+    puts("production TX extension descriptors preserve 32/40-bit DMA and control fields");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tx-source", type=pathlib.Path, default=SOURCE)
+    args = parser.parse_args()
+    hal = (ATH12K / "hal.h").read_text()
+    desc = (ATH12K / "wifi7/hal_desc.h").read_text()
+    tx = (ATH12K / "wifi7/hal_tx.h").read_text()
+    defines = "\n".join(
+        line for line in (hal + "\n" + desc).splitlines()
+        if re.match(r"#define\s+(HAL_ADDR_MSB_REG_SHIFT|HAL_TX_MSDU_EXT_INFO)", line)
+    )
+    code = PRELUDE + defines + "\n"
+    for name in ("hal_tcl_desc_type", "hal_tcl_encap_type", "hal_encrypt_type"):
+        code += declaration(hal, "enum " + name + " {") + "\n"
+    code += declaration(tx, "struct hal_tx_info {") + "\n"
+    code += declaration(desc, "struct hal_tx_msdu_ext_desc {") + "\n"
+    code += function(args.tx_source.read_text(),
+                     "ath12k_wifi7_hal_tx_cmd_ext_desc_setup") + TEST
+    with tempfile.TemporaryDirectory(prefix="station-tx-descriptor-") as temp:
+        src = pathlib.Path(temp) / "test.c"
+        binary = pathlib.Path(temp) / "test"
+        src.write_text(code)
+        subprocess.run(
+            ["/usr/bin/cc", "-Wall", "-Wextra", "-Werror",
+             "-Wno-unused-parameter", "-fsanitize=address,undefined",
+             "-fno-sanitize-recover=all", str(src), "-o", str(binary)],
+            check=True,
+        )
+        subprocess.run([str(binary)], check=True, cwd=temp, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sys/tests/linuxkpi_wlan/station_tx_lock_test.py b/sys/tests/linuxkpi_wlan/station_tx_lock_test.py
new file mode 100644
index 00000000..60114f84
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_tx_lock_test.py
@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+"""Exercise production TX admission and key quiescence with a contended wiphy."""
+
+import argparse
+import pathlib
+import re
+import subprocess
+import tempfile
+
+from regulatory_production_test import function
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+SOURCE = ROOT / "sys/compat/linuxkpi/common/src/linux_80211.c"
+PORT = ROOT / "sys/compat/linuxkpi/common/src/linux_80211_sta.h"
+
+PRELUDE = r"""
+#include <assert.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <stdbool.h>
+typedef unsigned int u_int;
+typedef int64_t sbintime_t;
+#define SBT_1S 10
+#define nitems(a) ((int)(sizeof(a) / sizeof((a)[0])))
+#define atomic_load_acq_int(p) __atomic_load_n((p), __ATOMIC_ACQUIRE)
+#define atomic_store_rel_int(p,v) __atomic_store_n((p), (v), __ATOMIC_RELEASE)
+#define atomic_add_acq_int(p,v) __atomic_fetch_add((p), (v), __ATOMIC_ACQUIRE)
+#define atomic_subtract_rel_int(p,v) __atomic_fetch_sub((p), (v), __ATOMIC_RELEASE)
+#define atomic_thread_fence_seq_cst() atomic_thread_fence(memory_order_seq_cst)
+struct wiphy { pthread_mutex_t lock; };
+struct ieee80211_hw { struct wiphy *wiphy; };
+struct ieee80211_node { int refs; void *ni_vap; };
+struct mbuf { bool freed; };
+struct sk_buff { int unused; };
+struct lkpi_txq { int skbq; };
+struct lkpi_sta {
+    struct ieee80211_hw *hw;
+    struct ieee80211_node *ni;
+    unsigned port_key_busy, port_tx_users;
+    struct lkpi_sta_port port;
+    struct { struct lkpi_txq *txq[1]; } sta;
+    struct { int unused; } vap;
+    unsigned port_open;
+};
+static _Thread_local bool held;
+static atomic_bool waiting;
+static bool guarded = true, body_called;
+static unsigned body_users, now;
+static sbintime_t sbinuptime(void) { return now++; }
+#define pause(name,ticks) ((void)0)
+#define LKPI_80211_LSTA_TXQ_LOCK(s) ((void)(s))
+#define LKPI_80211_LSTA_TXQ_UNLOCK(s) ((void)(s))
+#define LKPI_80211_LTXQ_LOCK(q) ((void)(q))
+#define LKPI_80211_LTXQ_UNLOCK(q) ((void)(q))
+#define TXQ_TO_LTXQ(q) (q)
+#define VAP_TO_LVIF(v) (v)
+#define lockdep_assert_wiphy(w) assert(held)
+#define ic_printf(...) ((void)0)
+static struct sk_buff *skb_dequeue(int *q) { (void)q; return NULL; }
+static void ieee80211_free_txskb(struct ieee80211_hw *h, struct sk_buff *s)
+{ (void)h; assert(s == NULL); }
+static void lkpi_sta_port_queue(void *v) { (void)v; }
+static bool lkpi_sta_port_enabled(struct lkpi_sta *s)
+{ (void)s; return guarded; }
+static void wiphy_lock(struct wiphy *w)
+{
+    assert(!held);
+    atomic_store(&waiting, true);
+    assert(pthread_mutex_lock(&w->lock) == 0);
+    held = true;
+}
+static void wiphy_unlock(struct wiphy *w)
+{
+    assert(held);
+    held = false;
+    assert(pthread_mutex_unlock(&w->lock) == 0);
+}
+static struct ieee80211_node *ieee80211_ref_node(struct ieee80211_node *n)
+{ n->refs++; return n; }
+static void ieee80211_free_node(struct ieee80211_node *n) { n->refs--; }
+static void m_freem(struct mbuf *m) { assert(!m->freed); m->freed = true; }
+/* Preparation/submission are modeled; production admission/quiescence are not. */
+static void lkpi_80211_txq_tx_one_body(struct lkpi_sta *s, struct mbuf *m, ...)
+{
+    bool acquire = !held;
+    if (acquire)
+        wiphy_lock(s->hw->wiphy);
+    body_called = true;
+    body_users = s->port_tx_users;
+    ieee80211_free_node(s->ni);
+    m_freem(m);
+    if (acquire)
+        wiphy_unlock(s->hw->wiphy);
+}
+"""
+
+TEST = r"""
+static struct lkpi_sta *active;
+static struct mbuf packet;
+static void *transmit(void *unused)
+{
+    (void)unused;
+    lkpi_80211_txq_tx_one(active, &packet);
+    return NULL;
+}
+int main(void)
+{
+    struct wiphy w = { .lock = PTHREAD_MUTEX_INITIALIZER };
+    struct ieee80211_hw hw = { .wiphy = &w };
+    struct ieee80211_node ni = { .refs = 1 };
+    struct lkpi_sta sta = { .hw = &hw, .ni = &ni };
+    pthread_t tx;
+
+    active = &sta;
+    assert(pthread_mutex_lock(&w.lock) == 0);
+    held = true;
+    assert(pthread_create(&tx, NULL, transmit, NULL) == 0);
+    while (!atomic_load(&waiting))
+        sched_yield();
+    /* The key updater owns wiphy while TX is waiting to acquire it. */
+    assert(lkpi_sta_key_quiesce(&sta));
+    assert(sta.port_tx_users == 0 && !sta.port.failed);
+    atomic_store_rel_int(&sta.port_key_busy, 0);
+    wiphy_unlock(&w);
+    assert(pthread_join(tx, NULL) == 0);
+    assert(body_called && body_users == 1);
+    assert(sta.port_tx_users == 0 && ni.refs == 0 && packet.freed);
+
+    /* A still-fenced key must drop TX without preparing an skb. */
+    memset(&packet, 0, sizeof(packet));
+    ni.refs = 1;
+    sta.port_key_busy = 2;
+    body_called = false;
+    lkpi_80211_txq_tx_one(&sta, &packet);
+    assert(!body_called && packet.freed && ni.refs == 0);
+    assert(sta.port_tx_users == 0);
+
+    /* Drivers without the station gate retain their unguarded path. */
+    memset(&packet, 0, sizeof(packet));
+    ni.refs = 1;
+    guarded = false;
+    body_called = false;
+    lkpi_80211_txq_tx_one(&sta, &packet);
+    assert(body_called && body_users == 0 && packet.freed && ni.refs == 0);
+    assert(pthread_mutex_destroy(&w.lock) == 0);
+    puts("station TX/key contention, fenced drop and unguarded path passed");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--tx-source", type=pathlib.Path, default=SOURCE)
+    args = parser.parse_args()
+    source = re.sub(r"/\*.*?\*/", "", SOURCE.read_text(), flags=re.S)
+    tx_source = re.sub(r"/\*.*?\*/", "", args.tx_source.read_text(), flags=re.S)
+    code = (
+        f'#include "{PORT}"\n'
+        + PRELUDE
+        + function(source, "lkpi_sta_key_quiesce")
+        + function(tx_source, "lkpi_80211_txq_tx_one")
+        + TEST
+    )
+    with tempfile.TemporaryDirectory(prefix="station-tx-lock-") as temp:
+        src = pathlib.Path(temp) / "test.c"
+        binary = pathlib.Path(temp) / "test"
+        src.write_text(code)
+        subprocess.run(
+            ["/usr/bin/cc", "-Wall", "-Wextra", "-Werror", "-pthread",
+             "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
+             str(src), "-o", str(binary)],
+            check=True,
+        )
+        subprocess.run([str(binary)], check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sys/tests/linuxkpi_wlan/wmi_protocol_test.c b/sys/tests/linuxkpi_wlan/wmi_protocol_test.c
new file mode 100644
index 00000000..29f1d679
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/wmi_protocol_test.c
@@ -0,0 +1,164 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Pure production WMI/HTC protocol cases; no device, DMA or kernel module
+ * required when built with ATH12K_WMI_PROTOCOL_STANDALONE.
+ */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/systm.h>
+
+#include "core.h"
+#include "wmi.h"
+
+int ath12k_wmi_protocol_test(void);
+
+#define PROTOCOL_CHECK(condition) do {					\
+	if (!(condition)) {						\
+		printf("WMI protocol line %d: %s\n", __LINE__, #condition);	\
+		return (EINVAL);					\
+	}								\
+} while (0)
+
+static int
+hw_mode_cases(void)
+{
+	struct ath12k_wmi_hw_mode_state state = { 0 };
+	u8 event[48] = { 0 };
+	u32 status = 0xdeadbeef;
+
+	le32enc(event, WMI_TAG_PDEV_SET_HW_MODE_RESPONSE_EVENT << 16 | 16);
+	le32enc(event + 12, WMI_HOST_HW_MODE_DBS);
+	le32enc(event + 20, WMI_TAG_ARRAY_STRUCT << 16);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, false, true) == -EAGAIN);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_accept(&state, event, 24) == -EALREADY);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, false, true) == -EAGAIN && !state.attempted);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_SINGLE, true, true) == -EOPNOTSUPP);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_response_decode(event, 19,
+	    WMI_HOST_HW_MODE_DBS, &status) == -EPROTO && status == 0xdeadbeef);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_response_decode(event + 20, 4,
+	    WMI_HOST_HW_MODE_DBS, &status) == -EPROTO);
+	le32enc(event + 4, 1);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_response_decode(event, 24,
+	    WMI_HOST_HW_MODE_DBS, &status) == -EPROTO);
+	le32enc(event + 4, 0);
+	le32enc(event + 12, WMI_HOST_HW_MODE_SINGLE);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_response_decode(event, 24,
+	    WMI_HOST_HW_MODE_DBS, &status) == -EPROTO);
+	le32enc(event + 12, WMI_HOST_HW_MODE_DBS);
+	le32enc(event + 16, 1);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_response_decode(event, 24,
+	    WMI_HOST_HW_MODE_DBS, &status) == -EOPNOTSUPP);
+	le32enc(event + 16, 0);
+	memcpy(event + 24, event, 20);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_response_decode(event, 44,
+	    WMI_HOST_HW_MODE_DBS, &status) == -EPROTO);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == 0 && state.pending);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, true, true) == -EAGAIN);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_accept(&state, event, 24) == 0 &&
+	    !state.pending && state.error == 0);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, true, true) == 0);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_accept(&state, event, 24) == -EALREADY);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == -EALREADY);
+	memset(&state, 0, sizeof(state));
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == 0);
+	le32enc(event + 8, 3);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_accept(&state, event, 24) == -EIO &&
+	    state.status == 3 && !state.pending);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, true, true) == -EIO);
+	memset(&state, 0, sizeof(state));
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == 0);
+	ath12k_wmi_hw_mode_fail(&state, -ETIMEDOUT);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_accept(&state, event, 24) == -EALREADY);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, true, true) == -ETIMEDOUT);
+	memset(&state, 0, sizeof(state));
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == 0);
+	ath12k_wmi_hw_mode_fail(&state, -ESHUTDOWN);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, true, true) == -ESHUTDOWN);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == -EALREADY);
+	memset(&state, 0, sizeof(state));
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_begin(&state,
+	    WMI_HOST_HW_MODE_DBS, true, true) == 0);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_accept(&state, event, 2) == -EPROTO &&
+	    !state.pending);
+	PROTOCOL_CHECK(ath12k_wmi_hw_mode_htt_ready(&state, true, true) == -EPROTO);
+	return (0);
+}
+
+static int
+credit_cases(void)
+{
+	struct ath12k_htc htc = { 0 };
+	u32 credits[ATH12K_HTC_EP_COUNT] = { 0 }, saved[ATH12K_HTC_EP_COUNT];
+	u8 trailer[24] = { ATH12K_HTC_RECORD_CREDITS, 4, 0, 0, 2, 1 };
+
+	credits[0] = 0x1234;
+	memcpy(saved, credits, sizeof(saved));
+	PROTOCOL_CHECK(ath12k_htc_credit_trailer_decode(trailer, 7, credits) ==
+	    -EPROTO && memcmp(saved, credits, sizeof(saved)) == 0);
+	trailer[8] = ATH12K_HTC_RECORD_CREDITS;
+	trailer[9] = 4;
+	trailer[12] = ATH12K_HTC_EP_COUNT;
+	trailer[13] = 1;
+	PROTOCOL_CHECK(ath12k_htc_credit_trailer_decode(trailer, 16, credits) ==
+	    -EPROTO && memcmp(saved, credits, sizeof(saved)) == 0);
+	trailer[12] = 2;
+	PROTOCOL_CHECK(ath12k_htc_credit_trailer_decode(trailer, 16, credits) == 0 &&
+	    credits[2] == 2 && credits[0] == 0);
+	htc.endpoint[2].service_id = ATH12K_HTC_SVC_ID_WMI_CONTROL;
+	htc.endpoint[2].tx_credit_flow_enabled = true;
+	htc.endpoint[2].tx_credit_limit = 2;
+	htc.endpoint[2].tx_credits = 0;
+	PROTOCOL_CHECK(ath12k_htc_credit_report_apply(&htc, credits) == 0 &&
+	    htc.endpoint[2].tx_credits == 2);
+	PROTOCOL_CHECK(ath12k_htc_credit_report_apply(&htc, credits) == -EPROTO &&
+	    htc.endpoint[2].tx_credits == 2);
+	htc.endpoint[2].tx_credits = 0;
+	credits[3] = 1;
+	PROTOCOL_CHECK(ath12k_htc_credit_report_apply(&htc, credits) == -EPROTO &&
+	    htc.endpoint[2].tx_credits == 0);
+	credits[3] = 0;
+	htc.endpoint[2].tx_credit_flow_enabled = false;
+	PROTOCOL_CHECK(ath12k_htc_credit_report_apply(&htc, credits) == -EPROTO);
+	trailer[1] = 3;
+	PROTOCOL_CHECK(ath12k_htc_credit_trailer_decode(trailer, 7, credits) == -EPROTO);
+	return (0);
+}
+
+int
+ath12k_wmi_protocol_test(void)
+{
+	int ret;
+	const size_t overhead = sizeof(struct wmi_cmd_hdr) +
+	    sizeof(struct wmi_scan_chan_list_cmd) + TLV_HDR_SIZE;
+	const size_t channel_size = sizeof(struct ath12k_wmi_channel_params);
+
+	PROTOCOL_CHECK(ath12k_wmi_scan_chan_limit(0) == 0);
+	PROTOCOL_CHECK(ath12k_wmi_scan_chan_limit(overhead - 1) == 0);
+	PROTOCOL_CHECK(ath12k_wmi_scan_chan_limit(overhead + channel_size - 1) == 0);
+	PROTOCOL_CHECK(ath12k_wmi_scan_chan_limit(overhead + channel_size) == 1);
+	PROTOCOL_CHECK(ath12k_wmi_scan_chan_limit(overhead + 2 * channel_size) == 2);
+	PROTOCOL_CHECK(ath12k_wmi_scan_chan_limit(~0U) == ATH12K_WMI_MAX_NUM_CHAN_PER_CMD);
+	ret = hw_mode_cases();
+	if (!ret)
+		ret = credit_cases();
+	if (!ret)
+		printf("WMI DBS response/order/failure and HTC transactional credits passed (model only)\n");
+	return (ret);
