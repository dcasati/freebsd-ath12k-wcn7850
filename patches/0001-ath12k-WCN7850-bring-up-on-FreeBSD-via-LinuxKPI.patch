+static int
+mhi_test(void)
+{
+	const struct mhi_controller_config *reference =
+	    &ath12k_wifi7_mhi_config_wcn7850;
+	struct mhi_controller_config cfg;
+	struct mhi_channel_config ch[2];
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_command_context *command;
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_dma *ring;
+	struct mhi_controller *ctrl;
+	struct device dev = { 0 };
+	device_t card;
+	unsigned int i;
+	int error;
+
+	card = NULL;
+	if (vm_guest == VM_GUEST_BHYVE &&
+	    strcmp(kern_ident, "ATH12KLAB") == 0)
+		card = pci_find_dbsf(0, 0, 6, 0);
+	else if (vm_guest == VM_GUEST_NO &&
+	    strcmp(kern_ident, "ATH12KHOST") == 0)
+		card = pci_find_dbsf(0, 194, 0, 0);
+	if (card == NULL || pci_get_vendor(card) != 0x17cb ||
+	    pci_get_device(card) != 0x1107 ||
+	    pci_get_subvendor(card) != 0x17aa ||
+	    pci_get_subdevice(card) != 0xe0e6 || device_is_attached(card)) {
+		printf("lkpi_mhi_test: expected unbound test PCI function is unavailable\n");
+		return (ENXIO);
+	}
+	dev.bsddev = card;
+	ctrl = mhi_alloc_controller();
+	if (ctrl == NULL)
+		return (ENOMEM);
+	ctrl->cntrl_dev = &dev;
+	ctrl->iova_stop = BUS_SPACE_MAXADDR_32BIT;
+	error = -linuxkpi_mhi_alloc_context(ctrl, reference);
+	if (error != 0)
+		goto out;
+	context = ctrl->lkpi_context;
+	CHECK(context != NULL && context->max_channels == 128 &&
+	    context->num_events == 2);
+	CHECK(check_buffer(&context->channels, 64, false));
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(check_buffer(&context->commands, 64, false));
+	CHECK(check_buffer(&context->command_ring, 2048, true));
+	command = context->commands.vaddr;
+	CHECK(command->reserved[0] == 0 && command->reserved[1] == 0 &&
+	    command->reserved[2] == 0);
+	CHECK(le64toh(command->rbase) == context->command_ring.address &&
+	    le64toh(command->rp) == le64toh(command->rbase) &&
+	    le64toh(command->wp) == le64toh(command->rbase) &&
+	    le64toh(command->rlen) == 128 * 16);
+	events = context->events.vaddr;
+	for (i = 0; i < 2; i++) {
+		ring = &context->event_rings[i].dma;
+		CHECK(check_buffer(ring, ring->size, true));
+		CHECK(ring->size == (i == 0 ? 32 : 256) * 16);
+		CHECK(le32toh(events[i].ertype) == 1 &&
+		    le32toh(events[i].msivec) == i + 1 &&
+		    le32toh(events[i].intmod) == i << 16);
+		CHECK(le64toh(events[i].rbase) == ring->address &&
+		    le64toh(events[i].rp) == ring->address &&
+		    le64toh(events[i].wp) == ring->address + ring->size - 16 &&
+		    le64toh(events[i].rlen) == ring->size);
+	}
+	channels = context->channels.vaddr;
+	for (i = 0; i < context->max_channels; i++) {
+		CHECK(le32toh(channels[i].chcfg) == 0x200);
+		ring = &context->channel_rings[i];
+		if (i != 20 && i != 21) {
+			CHECK(ring->vaddr == NULL && channels[i].chtype == 0 &&
+			    channels[i].rbase == 0 && channels[i].rlen == 0);
+			continue;
+		}
+		CHECK(check_buffer(ring, 1024, true) && ring->size == 64 * 16);
+		CHECK(le32toh(channels[i].chtype) == i - 19 &&
+		    le32toh(channels[i].erindex) == 1);
+		CHECK(le64toh(channels[i].rbase) == ring->address &&
+		    le64toh(channels[i].rp) == ring->address &&
+		    le64toh(channels[i].wp) == ring->address &&
+		    le64toh(channels[i].rlen) == ring->size);
+	}
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, reference) == -EBUSY &&
+	    ctrl->lkpi_context == context);
+	context->published = true;
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == context);
+	context->published = false;
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == NULL);
+	linuxkpi_mhi_free_context(ctrl);
+
+	cfg = *reference;
+	CHECK(cfg.num_channels == nitems(ch));
+	memcpy(ch, cfg.ch_cfg, sizeof(ch));
+	cfg.ch_cfg = ch;
+	ch[1].num = ch[0].num;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EINVAL &&
+	    ctrl->lkpi_context == NULL);
+	ch[1] = reference->ch_cfg[1];
+	ch[1].event_ring = cfg.num_events;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EINVAL &&
+	    ctrl->lkpi_context == NULL);
+	ch[1] = reference->ch_cfg[1];
+	ch[1].num_elements = 3;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EINVAL &&
+	    ctrl->lkpi_context == NULL);
+	ch[1] = reference->ch_cfg[1];
+	ch[1].offload_channel = true;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, &cfg) == -EOPNOTSUPP &&
+	    ctrl->lkpi_context == NULL);
+	ctrl->iova_start = 1;
+	ctrl->iova_stop = 0;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, reference) == -EINVAL);
+	/* A 4096-byte interval cannot contain the 5632-byte channel table. */
+	ctrl->iova_start = BUS_SPACE_MAXADDR_32BIT - 4095;
+	ctrl->iova_stop = BUS_SPACE_MAXADDR_32BIT;
+	CHECK(linuxkpi_mhi_alloc_context(ctrl, reference) == -ERANGE &&
+	    ctrl->lkpi_context == NULL);
+	ctrl->iova_start = 0;
+	CHECK(mhi_prepare_for_power_up(ctrl) == -EOPNOTSUPP);
+	error = linuxkpi_mhi_lifecycle_test();
+	if (error != 0)
+		goto out;
+	error = mhi_boot_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_transport_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_qmi_test();
+	if (error != 0)
+		goto out;
+	error = mhi_qmi_initialization_test();
+	if (error != 0)
+		goto out;
+	error = mhi_board_test();
+	if (error != 0)
+		goto out;
+	error = mhi_qmi_configuration_test();
+	if (error != 0)
+		goto out;
+	error = mhi_memory_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_ce_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_ce_rx_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_ce_tx_test(ctrl);
+	if (error != 0)
+		goto out;
+	error = mhi_htc_test();
+	if (error != 0)
+		goto out;
+	error = mhi_wmi_test();
+	if (error != 0)
+		goto out;
+	error = ath12k_wmi_protocol_test();
+	if (error != 0)
+		goto out;
+	/* Exercise automatic context cleanup in mhi_free_controller(). */
+	error = -linuxkpi_mhi_alloc_context(ctrl, reference);
+out:
+	mhi_free_controller(ctrl);
+	if (error == 0)
+		printf("lkpi_mhi_test: DMA contexts, rings, address/alignment and cleanup passed; no MMIO\n");
+	return (error);
+}
+
+static int
+mhi_test_modevent(module_t mod, int type, void *arg)
+{
+	switch (type) {
+	case MOD_LOAD:
+		return (mhi_test());
+	case MOD_UNLOAD:
+		return (0);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+
+static moduledata_t mhi_test_mod = {
+	"lkpi_mhi_test", mhi_test_modevent, NULL
+};
+
+DECLARE_MODULE(lkpi_mhi_test, mhi_test_mod, SI_SUB_DRIVERS, SI_ORDER_ANY);
+MODULE_VERSION(lkpi_mhi_test, 1);
+MODULE_DEPEND(lkpi_mhi_test, linuxkpi, 1, 1, 1);
diff --git a/sys/tests/linuxkpi_wlan/mhi_wmi.c b/sys/tests/linuxkpi_wlan/mhi_wmi.c
new file mode 100644
index 00000000..4bdc74d1
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_wmi.c
@@ -0,0 +1,441 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+
+#include "core.h"
+#include "mhi_wmi.h"
+
+CTASSERT(sizeof(struct ath12k_wmi_abi_version_params) == 24);
+CTASSERT(WMI_MAX_EXT2_SERVICE <= 512);
+
+static int
+mhi_wmi_caps(struct mhi_lab_wmi *wmi, uint32_t tag, const uint8_t *p,
+    size_t len, unsigned int depth, bool decode)
+{
+	struct mhi_lab_wmi_mode *mode;
+	struct mhi_lab_wmi_mac_phy *mac;
+	struct mhi_lab_wmi_reg_cap *reg;
+	uint32_t header;
+	unsigned int i;
+	size_t n;
+
+	if (!decode && tag != WMI_TAG_ARRAY_STRUCT) {
+		if (tag == WMI_TAG_MAC_PHY_CAPABILITIES_EXT &&
+		    len < sizeof(struct ath12k_wmi_caps_ext_params))
+			return (EPROTO);
+		return (0);
+	}
+	switch (tag) {
+	case WMI_TAG_ARRAY_STRUCT:
+		if (depth >= 4)
+			return (EPROTO);
+		while (len != 0) {
+			if (len < 4)
+				return (EPROTO);
+			header = le32dec(p);
+			n = header & 0xffff;
+			if ((n & 3) != 0 || n > len - 4 ||
+			    mhi_wmi_caps(wmi, header >> 16, p + 4, n,
+			    depth + 1, decode) != 0)
+				return (EPROTO);
+			p += n + 4;
+			len -= n + 4;
+		}
+		break;
+	case WMI_TAG_SOC_MAC_PHY_HW_MODE_CAPS:
+		if (wmi->soc_modes ||
+		    len < sizeof(struct ath12k_wmi_soc_mac_phy_hw_mode_caps_params))
+			return (EPROTO);
+		wmi->num_modes = le32dec(p);
+		if (wmi->num_modes == 0 || wmi->num_modes > MHI_WMI_MAX_MODES)
+			return (EPROTO);
+		wmi->soc_modes = true;
+		break;
+	case WMI_TAG_SOC_HAL_REG_CAPABILITIES:
+		if (wmi->soc_reg ||
+		    len < sizeof(struct ath12k_wmi_soc_hal_reg_caps_params))
+			return (EPROTO);
+		wmi->num_phys = le32dec(p);
+		if (wmi->num_phys == 0 || wmi->num_phys > MHI_WMI_MAX_PHY)
+			return (EPROTO);
+		wmi->soc_reg = true;
+		break;
+	case WMI_TAG_HW_MODE_CAPABILITIES:
+		if (len < sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4 ||
+		    wmi->mode_count == MHI_WMI_MAX_MODES)
+			return (EPROTO);
+		mode = &wmi->modes[wmi->mode_count];
+		mode->id = le32dec(p);
+		mode->phys = le32dec(p + 4);
+		mode->config = le32dec(p + 8) & WMI_HW_MODE_CAP_CFG_TYPE;
+		/* New firmware modes are advertisements, not host mode selectors. */
+		if (mode->phys == 0 || mode->phys >> MHI_WMI_MAX_PHY) {
+			printf("mhi_lab_wmi: invalid mode id=%u phys=%#x config=%u\n",
+			    mode->id, mode->phys, mode->config);
+			return (EPROTO);
+		}
+		for (i = 0; i < wmi->mode_count; i++)
+			if (wmi->modes[i].id == mode->id)
+				return (EPROTO);
+		wmi->mode_count++;
+		break;
+	case WMI_TAG_MAC_PHY_CAPABILITIES:
+		if (len < sizeof(struct ath12k_wmi_mac_phy_caps_params) ||
+		    wmi->mac_phy_count == MHI_WMI_MAX_MAC_PHY)
+			return (EPROTO);
+		mac = &wmi->mac_phys[wmi->mac_phy_count];
+#define MHI_WMI_MAC(field) le32dec(p + offsetof(struct ath12k_wmi_mac_phy_caps_params, field))
+		mac->mode = MHI_WMI_MAC(hw_mode_id);
+		mac->pdev = MHI_WMI_MAC(pdev_and_hw_link_ids) & WMI_CAPS_PARAMS_PDEV_ID;
+		mac->phy = MHI_WMI_MAC(phy_id);
+		mac->bands = MHI_WMI_MAC(supported_bands);
+		mac->tx2 = MHI_WMI_MAC(tx_chain_mask_2g);
+		mac->rx2 = MHI_WMI_MAC(rx_chain_mask_2g);
+		mac->tx5 = MHI_WMI_MAC(tx_chain_mask_5g);
+		mac->rx5 = MHI_WMI_MAC(rx_chain_mask_5g);
+		mac->low2 = MHI_WMI_MAC(low_2ghz_chan_freq);
+		mac->high2 = MHI_WMI_MAC(high_2ghz_chan_freq);
+		mac->low5 = MHI_WMI_MAC(low_5ghz_chan_freq);
+		mac->high5 = MHI_WMI_MAC(high_5ghz_chan_freq);
+#undef MHI_WMI_MAC
+		if (mac->phy >= MHI_WMI_MAX_PHY || mac->pdev == 0 ||
+		    mac->pdev > MHI_WMI_MAX_PHY || mac->bands == 0 ||
+		    (mac->bands & ~WMI_HOST_WLAN_2GHZ_5GHZ_CAP) != 0 ||
+		    ((mac->bands & WMI_HOST_WLAN_2GHZ_CAP) != 0 &&
+		    (mac->tx2 == 0 || mac->rx2 == 0 ||
+		    ((mac->tx2 | mac->rx2) & ~0xffU) != 0 ||
+		    (mac->low2 != 0 && mac->high2 != 0 &&
+		    mac->low2 > mac->high2))) ||
+		    ((mac->bands & WMI_HOST_WLAN_5GHZ_CAP) != 0 &&
+		    (mac->tx5 == 0 || mac->rx5 == 0 ||
+		    ((mac->tx5 | mac->rx5) & ~0xffU) != 0 ||
+		    (mac->low5 != 0 && mac->high5 != 0 &&
+		    mac->low5 > mac->high5)))) {
+			printf("mhi_lab_wmi: invalid MAC/PHY mode=%u pdev=%u "
+			    "phy=%u bands=%#x chains=%#x/%#x/%#x/%#x "
+			    "ranges=%u-%u/%u-%u\n",
+			    mac->mode, mac->pdev, mac->phy, mac->bands,
+			    mac->tx2, mac->rx2, mac->tx5, mac->rx5,
+			    mac->low2, mac->high2, mac->low5, mac->high5);
+			return (EPROTO);
+		}
+		for (i = 0; i < wmi->mac_phy_count; i++)
+			if (wmi->mac_phys[i].mode == mac->mode &&
+			    wmi->mac_phys[i].phy == mac->phy)
+				return (EPROTO);
+		wmi->mac_phy_count++;
+		break;
+	case WMI_TAG_HAL_REG_CAPABILITIES_EXT:
+		if (len < sizeof(struct ath12k_wmi_hal_reg_caps_ext_params) - 4 ||
+		    wmi->reg_count == MHI_WMI_MAX_PHY)
+			return (EPROTO);
+		reg = &wmi->reg_caps[wmi->reg_count];
+#define REG(field) le32dec(p + offsetof(struct ath12k_wmi_hal_reg_caps_ext_params, field) - 4)
+		reg->phy = REG(phy_id);
+		reg->domain = REG(eeprom_reg_domain);
+		reg->domain_ext = REG(eeprom_reg_domain_ext);
+		reg->cap1 = REG(regcap1);
+		reg->cap2 = REG(regcap2);
+		reg->low2 = REG(low_2ghz_chan);
+		reg->high2 = REG(high_2ghz_chan);
+		reg->low5 = REG(low_5ghz_chan);
+		reg->high5 = REG(high_5ghz_chan);
+#undef REG
+		if (reg->phy >= MHI_WMI_MAX_PHY ||
+		    reg->low2 > reg->high2 || reg->low5 > reg->high5)
+			return (EPROTO);
+		for (i = 0; i < wmi->reg_count; i++)
+			if (wmi->reg_caps[i].phy == reg->phy)
+				return (EPROTO);
+		wmi->reg_count++;
+		break;
+	}
+	return (0);
+}
+
+static bool
+mhi_wmi_caps_complete(const struct mhi_lab_wmi *wmi)
+{
+	unsigned int i, j, count = 0;
+	uint32_t phys, reg_phys = 0;
+
+	if (!wmi->soc_modes || !wmi->soc_reg ||
+	    wmi->num_modes != wmi->mode_count || wmi->num_phys != wmi->reg_count)
+		return (false);
+	for (i = 0; i < wmi->reg_count; i++)
+		reg_phys |= 1U << wmi->reg_caps[i].phy;
+	for (i = 0; i < wmi->mode_count; i++) {
+		phys = wmi->modes[i].phys;
+		if ((phys & ~reg_phys) != 0)
+			return (false);
+		for (j = 0; j < wmi->mac_phy_count; j++) {
+			if (wmi->mac_phys[j].mode != wmi->modes[i].id)
+				continue;
+			if ((phys & (1U << wmi->mac_phys[j].phy)) == 0)
+				return (false);
+			phys &= ~(1U << wmi->mac_phys[j].phy);
+			count++;
+		}
+		if (phys != 0)
+			return (false);
+	}
+	return (count == wmi->mac_phy_count);
+}
+
+int
+mhi_lab_wmi_init(struct mhi_lab_wmi *wmi, const struct mhi_lab_wmi_owner *owner,
+    const struct ath12k_wmi_resource_config_params *cfg, bool single_pdev_only)
+{
+	uint8_t packet[4 + sizeof(struct wmi_init_cmd) +
+	    sizeof(struct ath12k_wmi_resource_config_params) + 4] = { 0 };
+	size_t offset;
+	int error;
+
+	if (wmi == NULL || cfg == NULL)
+		return (EINVAL);
+	if (wmi->init_attempted)
+		return (EALREADY);
+	if (!mhi_lab_wmi_ready(wmi) || !wmi->semantic_caps)
+		return (EAGAIN);
+	/* Only the reference single-pdev/zero-host-memory path is implemented. */
+	if (!single_pdev_only || wmi->memory_requests != 0)
+		return (EOPNOTSUPP);
+	if (owner == NULL || owner->check == NULL || owner->send == NULL)
+		return (ENXIO);
+	if (le32dec(&cfg->num_vdevs) == 0 || le32dec(&cfg->num_peers) == 0 ||
+	    le32dec(&cfg->num_tids) == 0 || le32dec(&cfg->num_msdu_desc) == 0 ||
+	    le32dec(&cfg->tx_chain_mask) == 0 || le32dec(&cfg->rx_chain_mask) == 0)
+		return (EINVAL);
+	error = owner->check(owner->arg);
+	if (error != 0)
+		return (error);
+	le32enc(packet, WMI_INIT_CMDID);
+	le32enc(packet + 4, WMI_TAG_INIT_CMD << 16 |
+	    (sizeof(struct wmi_init_cmd) - 4));
+	/* qwz leaves host ABI and num_host_mem_chunks zero. */
+	offset = 4 + sizeof(struct wmi_init_cmd);
+	memcpy(packet + offset, cfg, sizeof(*cfg));
+	le32enc(packet + offset, WMI_TAG_RESOURCE_CONFIG << 16 | (sizeof(*cfg) - 4));
+	offset += sizeof(*cfg);
+	le32enc(packet + offset, WMI_TAG_ARRAY_STRUCT << 16);
+	/* HW_MODE_MAX means omit HW_MODE and band-to-MAC TLVs, not SINGLE. */
+	wmi->init_attempted = true;
+	error = owner->send(owner->arg, packet, sizeof(packet));
+	if (error == 0) {
+		wmi->single_pdev_only = true;
+		wmi->init_sent = true;
+	}
+	return (error);
+}
+
+static bool
+mhi_wmi_service(const struct mhi_lab_wmi *wmi, unsigned int service)
+{
+	return ((wmi->services[service / 8] & (1U << (service % 8))) != 0);
+}
+
+bool
+mhi_lab_wmi_ready(const struct mhi_lab_wmi *wmi)
+{
+	return (wmi->base && wmi->available &&
+	    (!mhi_wmi_service(wmi, WMI_TLV_SERVICE_EXT_MSG) || wmi->extended) &&
+	    (!mhi_wmi_service(wmi, WMI_TLV_SERVICE_EXT2_MSG) || wmi->extended2));
+}
+
+int
+mhi_lab_wmi_receive(void *arg, uint16_t service, const void *data, size_t size)
+{
+	struct mhi_lab_wmi *wmi = arg, next;
+	const uint8_t *packet = data, *value;
+	uint32_t event, header, tag, expected, word;
+	size_t offset, length, minimum;
+	unsigned int i, b, bit, bits, start, words;
+	bool fixed = false, bitmap = false, addresses = false;
+	uint32_t extra_addresses = 0;
+
+	if (wmi == NULL || packet == NULL ||
+	    service != ATH12K_HTC_SVC_ID_WMI_CONTROL || size < 4)
+		goto invalid;
+	next = *wmi;
+	event = le32dec(packet) & 0xffffff;
+	switch (event) {
+	case WMI_SERVICE_READY_EVENTID:
+		if (wmi->base)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_READY_EVENT;
+		minimum = sizeof(struct wmi_service_ready_event);
+		break;
+	case WMI_SERVICE_AVAILABLE_EVENTID:
+		if (wmi->available)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_AVAILABLE_EVENT;
+		minimum = sizeof(struct wmi_service_available_event);
+		break;
+	case WMI_SERVICE_READY_EXT_EVENTID:
+		if (!wmi->base || wmi->extended)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_READY_EXT_EVENT;
+		minimum = sizeof(struct wmi_service_ready_ext_event);
+		break;
+	case WMI_SERVICE_READY_EXT2_EVENTID:
+		if (!wmi->extended || wmi->extended2)
+			goto invalid;
+		expected = WMI_TAG_SERVICE_READY_EXT2_EVENT;
+		minimum = sizeof(struct wmi_service_ready_ext2_event);
+		break;
+	case WMI_READY_EVENTID:
+		if (!wmi->init_sent || wmi->ready_received)
+			goto invalid;
+		expected = WMI_TAG_READY_EVENT;
+		minimum = sizeof(struct ath12k_wmi_ready_event_min_params);
+		break;
+	default:
+		printf("mhi_lab_wmi: unsupported startup event %#x\n", event);
+		return (EOPNOTSUPP);
+	}
+	offset = 4;
+	while (offset < size) {
+		if (size - offset < 4)
+			goto invalid;
+		header = le32dec(packet + offset);
+		tag = header >> 16;
+		length = header & 0xffff;
+		offset += 4;
+		if (length > size - offset || (length & 3) != 0)
+			goto invalid;
+		value = packet + offset;
+		if ((event == WMI_SERVICE_READY_EXT_EVENTID ||
+		    event == WMI_SERVICE_READY_EXT2_EVENTID) &&
+		    mhi_wmi_caps(&next, tag, value, length, 0,
+		    event == WMI_SERVICE_READY_EXT_EVENTID) != 0) {
+			printf("mhi_lab_wmi: invalid capability tag=%u "
+			    "length=%zu offset=%zu\n",
+			    tag, length, offset);
+			goto invalid;
+		}
+		if (tag == expected) {
+			if (fixed || length < minimum)
+				goto invalid;
+			fixed = true;
+			if (event == WMI_SERVICE_READY_EXT2_EVENTID) {
+				next.reg_db_version = le32dec(value +
+				    offsetof(struct wmi_service_ready_ext2_event, reg_db_version));
+				next.target_cap_flags = le32dec(value +
+				    offsetof(struct wmi_service_ready_ext2_event, target_cap_flags));
+			}
+			if (event == WMI_READY_EVENTID) {
+				for (i = 0; i < nitems(next.abi); i++)
+					if (le32dec(value + 4 * i) != next.abi[i])
+						goto invalid;
+				next.ready_status = le32dec(value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, status));
+				next.ready_peers = le32dec(value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, num_total_peers));
+				extra_addresses = le32dec(value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, num_extra_mac_addr));
+				memcpy(next.mac, value +
+				    offsetof(struct ath12k_wmi_ready_event_min_params, mac_addr), 6);
+				if ((next.mac[0] & 1) != 0 ||
+				    memcmp(next.mac, "\0\0\0\0\0\0", 6) == 0)
+					goto invalid;
+				next.unified_ready = next.ready_status == 0;
+				next.ready_received = true;
+			}
+			if (event == WMI_SERVICE_READY_EVENTID) {
+#define WMI_BASE(field) le32dec(value + offsetof(struct wmi_service_ready_event, field))
+				next.firmware = WMI_BASE(fw_build_vers);
+				next.rf_chains = WMI_BASE(num_rf_chains);
+				next.memory_requests = WMI_BASE(num_mem_reqs);
+				next.scan_channels = WMI_BASE(max_num_scan_channels);
+#undef WMI_BASE
+				for (i = 0; i < nitems(next.abi); i++)
+					next.abi[i] = le32dec(value +
+					    offsetof(struct wmi_service_ready_event, fw_abi_vers) + 4 * i);
+				if (next.rf_chains == 0 || next.rf_chains > 8 ||
+				    next.scan_channels == 0)
+					goto invalid;
+			}
+		}
+		if (event == WMI_READY_EVENTID && tag == WMI_TAG_ARRAY_FIXED_STRUCT) {
+			if (!fixed || addresses ||
+			    length % sizeof(struct ath12k_wmi_mac_addr_params) != 0 ||
+			    extra_addresses > length / sizeof(struct ath12k_wmi_mac_addr_params))
+				goto invalid;
+			addresses = true;
+		}
+		start = bits = words = 0;
+		if (event == WMI_SERVICE_READY_EVENTID && tag == WMI_TAG_ARRAY_UINT32 &&
+		    !bitmap) {
+			if (length < WMI_SERVICE_BM_SIZE * sizeof(uint32_t))
+				goto invalid;
+			bits = WMI_SERVICE_BITS_IN_SIZE32;
+			words = WMI_SERVICE_BM_SIZE;
+			bitmap = true;
+		} else if (event == WMI_SERVICE_AVAILABLE_EVENTID && tag == expected) {
+			start = le32dec(value);
+			if (start != WMI_MAX_SERVICE)
+				goto invalid;
+			bits = 32;
+			words = WMI_SERVICE_SEGMENT_BM_SIZE32;
+			value += offsetof(struct wmi_service_available_event,
+			    wmi_service_segment_bitmap);
+		} else if (event == WMI_SERVICE_AVAILABLE_EVENTID &&
+		    tag == WMI_TAG_ARRAY_UINT32) {
+			if (bitmap)
+				goto invalid;
+			start = WMI_MAX_EXT_SERVICE;
+			bits = 32;
+			words = length / 4;
+			bitmap = true;
+		}
+		if (bits != 0) {
+			for (i = 0; i < words; i++) {
+				word = le32dec(value + 4 * i);
+				for (b = 0; b < bits; b++) {
+					bit = start + bits * i + b;
+					if ((word & (1U << b)) == 0)
+						continue;
+					if (bit >= sizeof(next.services) * 8)
+						goto invalid;
+					next.services[bit / 8] |= 1U << (bit % 8);
+				}
+			}
+		}
+		offset += length;
+	}
+	if (!fixed || (event == WMI_SERVICE_READY_EVENTID && !bitmap))
+		goto invalid;
+	if (event == WMI_READY_EVENTID && extra_addresses != 0 && !addresses)
+		goto invalid;
+	if (event == WMI_SERVICE_READY_EXT_EVENTID) {
+		next.semantic_caps = mhi_wmi_caps_complete(&next);
+		if ((next.soc_modes || next.soc_reg || next.mode_count != 0 ||
+		    next.mac_phy_count != 0 || next.reg_count != 0) &&
+		    !next.semantic_caps) {
+			printf("mhi_lab_wmi: incomplete capabilities "
+			    "modes=%u/%u MAC/PHY=%u regulatory=%u/%u\n",
+			    next.mode_count, next.num_modes, next.mac_phy_count,
+			    next.reg_count, next.num_phys);
+			goto invalid;
+		}
+	}
+	next.base |= event == WMI_SERVICE_READY_EVENTID;
+	next.available |= event == WMI_SERVICE_AVAILABLE_EVENTID;
+	next.extended |= event == WMI_SERVICE_READY_EXT_EVENTID;
+	next.extended2 |= event == WMI_SERVICE_READY_EXT2_EVENTID;
+	next.events++;
+	next.last_event = event;
+	*wmi = next;
+	if (event == WMI_READY_EVENTID && next.ready_status != 0)
+		return (EIO);
+	printf("mhi_lab_wmi: startup event %#x bytes=%zu validated\n",
+	    event, size);
+	return (0);
+invalid:
+	printf("mhi_lab_wmi: invalid startup event (service=%#x bytes=%zu)\n", service, size);
+	return (EPROTO);
+}
diff --git a/sys/tests/linuxkpi_wlan/mhi_wmi.h b/sys/tests/linuxkpi_wlan/mhi_wmi.h
new file mode 100644
index 00000000..97869305
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_wmi.h
@@ -0,0 +1,65 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+#ifndef _MHI_LAB_WMI_H_
+#define _MHI_LAB_WMI_H_
+
+#define MHI_WMI_MAX_MODES 8
+#define MHI_WMI_MAX_MAC_PHY 16
+#define MHI_WMI_MAX_PHY 3
+
+struct mhi_lab_wmi_mode {
+	uint32_t id, phys, config;
+};
+
+struct mhi_lab_wmi_mac_phy {
+	uint32_t mode, pdev, phy, bands;
+	uint32_t tx2, rx2, tx5, rx5;
+	uint32_t low2, high2, low5, high5;
+};
+
+/* These are hardware capabilities, never regulatory permission to transmit. */
+struct mhi_lab_wmi_reg_cap {
+	uint32_t phy, domain, domain_ext, cap1, cap2;
+	uint32_t low2, high2, low5, high5;
+};
+
+struct mhi_lab_wmi {
+	uint32_t firmware, abi[6], rf_chains, memory_requests, scan_channels;
+	uint32_t events, last_event;
+	uint32_t num_modes, num_phys, mode_count, mac_phy_count, reg_count;
+	struct mhi_lab_wmi_mode modes[MHI_WMI_MAX_MODES];
+	struct mhi_lab_wmi_mac_phy mac_phys[MHI_WMI_MAX_MAC_PHY];
+	struct mhi_lab_wmi_reg_cap reg_caps[MHI_WMI_MAX_PHY];
+	uint32_t ready_status, ready_peers, reg_db_version, target_cap_flags;
+	uint8_t mac[6];
+	uint8_t services[64];
+	bool base, available, extended, extended2;
+	bool soc_modes, soc_reg, semantic_caps;
+	bool init_attempted, init_sent, ready_received, unified_ready, single_pdev_only;
+};
+
+struct ath12k_wmi_resource_config_params;
+
+/*
+ * The owner must verify live production DP allocation/publication, cookie
+ * conversion, REO, RX descriptors, CE3 and reset-before-free retention on
+ * every invocation. No owner/check means no INIT. Serialize with RX/reset.
+ * cfg is the complete little-endian resource config matching actual owner
+ * allocations, not a set of guessed firmware defaults. send copies the raw
+ * WMI message before returning; zero means accepted.
+ * After an ambiguous TX failure the owner must reset, not retry INIT.
+ */
+struct mhi_lab_wmi_owner {
+	void *arg;
+	int (*check)(void *);
+	int (*send)(void *, const void *, size_t);
+};
+
+int mhi_lab_wmi_receive(void *, uint16_t, const void *, size_t);
+/* Capability exchange only; not unified READY, HTT or transmit permission. */
+bool mhi_lab_wmi_ready(const struct mhi_lab_wmi *);
+int mhi_lab_wmi_init(struct mhi_lab_wmi *, const struct mhi_lab_wmi_owner *,
+    const struct ath12k_wmi_resource_config_params *, bool);
+
+#endif
diff --git a/sys/tests/linuxkpi_wlan/mhi_wmi_cases.h b/sys/tests/linuxkpi_wlan/mhi_wmi_cases.h
new file mode 100644
index 00000000..091cea19
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/mhi_wmi_cases.h
@@ -0,0 +1,291 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Focused WMI-only cases; MHI_WMI_STANDALONE runs without a module or hardware.
+ */
+#ifdef MHI_WMI_STANDALONE
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include "core.h"
+#include "mhi_wmi.h"
+#endif
+
+struct mhi_wmi_command_model {
+	uint8_t packet[512];
+	size_t length;
+	unsigned int checks, sends;
+	int check_error, send_error;
+};
+
+static int
+mhi_wmi_owner_check(void *arg)
+{
+	struct mhi_wmi_command_model *model = arg;
+
+	model->checks++;
+	return (model->check_error);
+}
+
+static int
+mhi_wmi_owner_send(void *arg, const void *packet, size_t length)
+{
+	struct mhi_wmi_command_model *model = arg;
+
+	model->sends++;
+	if (length > sizeof(model->packet))
+		return (EMSGSIZE);
+	memcpy(model->packet, packet, length);
+	model->length = length;
+	return (model->send_error);
+}
+
+static uint8_t *
+mhi_wmi_case_tlv(uint8_t *packet, size_t *offset, uint32_t tag, size_t length)
+{
+	uint8_t *p = packet + *offset;
+
+	le32enc(p, tag << 16 | length);
+	memset(p + 4, 0, length);
+	*offset += length + 4;
+	return (p + 4);
+}
+
+static int
+mhi_wmi_semantic_test(void)
+{
+	struct mhi_lab_wmi wmi = { .base = true, .available = true }, before;
+	struct ath12k_wmi_resource_config_params cfg = { 0 };
+	struct mhi_wmi_command_model model = { .check_error = ENXIO };
+	const struct mhi_lab_wmi_owner owner = {
+		.arg = &model, .check = mhi_wmi_owner_check, .send = mhi_wmi_owner_send
+	};
+	uint8_t packet[1024] = { 0 }, *p, *array, *mac, *mode, *soc;
+	size_t offset = 4, nested = 0, length;
+	int error = 0;
+
+#define WMI_CASE(condition) do {						\
+	if (!(condition)) {						\
+		printf("WMI semantic case line %d failed: %s\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+	le32enc(&cfg.num_vdevs, 1);
+	le32enc(&cfg.num_peers, 4);
+	le32enc(&cfg.num_tids, 16);
+	le32enc(&cfg.num_msdu_desc, 128);
+	le32enc(&cfg.tx_chain_mask, 3);
+	le32enc(&cfg.rx_chain_mask, 3);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EAGAIN &&
+	    model.checks == 0 && model.sends == 0);
+	le32enc(packet, WMI_SERVICE_READY_EXT_EVENTID);
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SERVICE_READY_EXT_EVENT,
+	    sizeof(struct wmi_service_ready_ext_event));
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SOC_MAC_PHY_HW_MODE_CAPS,
+	    sizeof(struct ath12k_wmi_soc_mac_phy_hw_mode_caps_params));
+	soc = p;
+	le32enc(p, 1);
+	array = packet + offset + 4;
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params));
+	mode = mhi_wmi_case_tlv(array, &nested, WMI_TAG_HW_MODE_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4);
+	le32enc(mode, 7);
+	le32enc(mode + 4, 1);
+	le32enc(mode + 8, WMI_HOST_HW_MODE_DBS);
+	array = packet + offset + 4;
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT,
+	    4 + sizeof(struct ath12k_wmi_mac_phy_caps_params));
+	nested = 0;
+	mac = mhi_wmi_case_tlv(array, &nested, WMI_TAG_MAC_PHY_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_mac_phy_caps_params));
+#define CASE_MAC(field, value) le32enc(mac + offsetof(struct ath12k_wmi_mac_phy_caps_params, field), value)
+	CASE_MAC(hw_mode_id, 7);
+	CASE_MAC(pdev_and_hw_link_ids, 1);
+	CASE_MAC(supported_bands, WMI_HOST_WLAN_2GHZ_5GHZ_CAP);
+	CASE_MAC(tx_chain_mask_2g, 3);
+	CASE_MAC(rx_chain_mask_2g, 3);
+	CASE_MAC(tx_chain_mask_5g, 3);
+	CASE_MAC(rx_chain_mask_5g, 3);
+	CASE_MAC(low_2ghz_chan_freq, 2400);
+	CASE_MAC(high_2ghz_chan_freq, 2500);
+	CASE_MAC(low_5ghz_chan_freq, 4900);
+	CASE_MAC(high_5ghz_chan_freq, 7125);
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SOC_HAL_REG_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_soc_hal_reg_caps_params));
+	le32enc(p, 1);
+	array = packet + offset + 4;
+	mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT,
+	    sizeof(struct ath12k_wmi_hal_reg_caps_ext_params));
+	nested = 0;
+	p = mhi_wmi_case_tlv(array, &nested, WMI_TAG_HAL_REG_CAPABILITIES_EXT,
+	    sizeof(struct ath12k_wmi_hal_reg_caps_ext_params) - 4);
+	le32enc(p + 4, 0x1234);
+	length = offset;
+	before = wmi;
+	/* Real WCN7850 firmware also advertises mode/config 8. */
+	le32enc(mode, 8);
+	le32enc(mode + 8, 8);
+	CASE_MAC(hw_mode_id, 8);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == 0 && wmi.semantic_caps &&
+	    wmi.modes[0].id == 8 && wmi.modes[0].config == 8);
+	wmi = before;
+	le32enc(mode, 7);
+	le32enc(mode + 8, WMI_HOST_HW_MODE_DBS);
+	CASE_MAC(hw_mode_id, 7);
+	/* Zero frequency limits are unspecified, not regulatory permission. */
+	CASE_MAC(low_2ghz_chan_freq, 0);
+	CASE_MAC(high_2ghz_chan_freq, 0);
+	CASE_MAC(low_5ghz_chan_freq, 0);
+	CASE_MAC(high_5ghz_chan_freq, 0);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == 0 && wmi.semantic_caps &&
+	    wmi.mac_phys[0].low2 == 0 && wmi.mac_phys[0].high5 == 0);
+	wmi = before;
+	CASE_MAC(low_2ghz_chan_freq, 2500);
+	CASE_MAC(high_2ghz_chan_freq, 2400);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	CASE_MAC(low_2ghz_chan_freq, 2400);
+	CASE_MAC(high_2ghz_chan_freq, 2500);
+	CASE_MAC(low_5ghz_chan_freq, 4900);
+	CASE_MAC(high_5ghz_chan_freq, 7125);
+	/* Nested length is checked independently of the valid outer array. */
+	mac[-4]++;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	mac[-4]--;
+	CASE_MAC(phy_id, MHI_WMI_MAX_PHY);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	CASE_MAC(phy_id, 0);
+	CASE_MAC(rx_chain_mask_5g, 1U << 8);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	CASE_MAC(rx_chain_mask_5g, 3);
+	CASE_MAC(hw_mode_id, 8);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	CASE_MAC(hw_mode_id, 7);
+	le32enc(soc, MHI_WMI_MAX_MODES + 1);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	le32enc(soc, 2);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	le32enc(soc, 1);
+	/* Duplicate nested modes cannot replace an earlier capability. */
+	nested = 0;
+	array = packet + length + 4;
+	mhi_wmi_case_tlv(packet, &length, WMI_TAG_ARRAY_STRUCT,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params));
+	p = mhi_wmi_case_tlv(array, &nested, WMI_TAG_HW_MODE_CAPABILITIES,
+	    sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4);
+	memcpy(p, mode, sizeof(struct ath12k_wmi_hw_mode_cap_params) - 4);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == EPROTO && !wmi.extended);
+	length = offset;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, length) == 0 && wmi.semantic_caps &&
+	    wmi.mac_phy_count == 1 && wmi.mac_phys[0].tx5 == 3 &&
+	    wmi.reg_caps[0].domain == 0x1234);
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet, WMI_SERVICE_READY_EXT2_EVENTID);
+	offset = 4;
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_SERVICE_READY_EXT2_EVENT,
+	    sizeof(struct wmi_service_ready_ext2_event));
+	le32enc(p + offsetof(struct wmi_service_ready_ext2_event, reg_db_version), 9);
+	array = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_ARRAY_STRUCT, 4);
+	le32enc(array, WMI_TAG_MAC_PHY_CAPABILITIES_EXT << 16 | 4);
+	before = wmi;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	le32enc(array, WMI_TAG_MAC_PHY_CAPABILITIES_EXT << 16);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && !wmi.extended2);
+	le32enc(array, 0xfffeU << 16);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == 0 && wmi.extended2 && wmi.reg_db_version == 9);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, NULL, &cfg, true) == ENXIO);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == ENXIO &&
+	    !wmi.init_attempted && model.checks == 1 && model.sends == 0);
+	model.check_error = 0;
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, false) == EOPNOTSUPP &&
+	    model.sends == 0);
+	wmi.memory_requests = 1;
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EOPNOTSUPP);
+	wmi.memory_requests = 0;
+	/* Unsolicited unified READY must not advance capability-only state. */
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet, WMI_READY_EVENTID);
+	offset = 4;
+	p = mhi_wmi_case_tlv(packet, &offset, WMI_TAG_READY_EVENT,
+	    sizeof(struct ath12k_wmi_ready_event_min_params));
+	p[offsetof(struct ath12k_wmi_ready_event_min_params, mac_addr)] = 2;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && !wmi.unified_ready);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == 0 &&
+	    wmi.init_sent && !wmi.unified_ready && model.sends == 1);
+	WMI_CASE(model.length == 4 + sizeof(struct wmi_init_cmd) + sizeof(cfg) + 4 &&
+	    le32dec(model.packet) == WMI_INIT_CMDID &&
+	    le32dec(model.packet + 4) ==
+	    (WMI_TAG_INIT_CMD << 16 | (sizeof(struct wmi_init_cmd) - 4)) &&
+	    le32dec(model.packet + model.length - 4) == WMI_TAG_ARRAY_STRUCT << 16);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EALREADY &&
+	    model.sends == 1);
+	before = wmi;
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params,
+	    num_extra_mac_addr), 1);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && memcmp(&before, &wmi, sizeof(wmi)) == 0);
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params,
+	    num_extra_mac_addr), 0);
+	p[0] = 1;
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EPROTO && !wmi.ready_received);
+	p[0] = 0;
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params, status), 3);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, offset) == EIO && wmi.ready_received &&
+	    !wmi.unified_ready && wmi.ready_status == 3);
+	wmi = before;
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params, status), 0);
+	le32enc(p + offsetof(struct ath12k_wmi_ready_event_min_params,
+	    num_extra_mac_addr), 1);
+	/* A declared address must have a complete fixed-struct element. */
+	nested = offset;
+	mhi_wmi_case_tlv(packet, &nested, WMI_TAG_ARRAY_FIXED_STRUCT, 4);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, nested) == EPROTO && !wmi.ready_received);
+	nested = offset;
+	mhi_wmi_case_tlv(packet, &nested, WMI_TAG_ARRAY_FIXED_STRUCT,
+	    sizeof(struct ath12k_wmi_mac_addr_params));
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, nested) == 0 && wmi.unified_ready && wmi.mac[0] == 2);
+	WMI_CASE(mhi_lab_wmi_receive(&wmi, ATH12K_HTC_SVC_ID_WMI_CONTROL,
+	    packet, nested) == EPROTO);
+	wmi = before;
+	wmi.init_attempted = wmi.init_sent = false;
+	model.send_error = EIO;
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EIO &&
+	    wmi.init_attempted && !wmi.init_sent);
+	WMI_CASE(mhi_lab_wmi_init(&wmi, &owner, &cfg, true) == EALREADY);
+out:
+	if (error == 0)
+		printf("WMI nested capability, ownership/INIT and unified READY cases passed (model only)\n");
+#undef CASE_MAC
+#undef WMI_CASE
+	return (error);
+}
+
+#ifdef MHI_WMI_STANDALONE
+int
+main(void)
+{
+	return (mhi_wmi_semantic_test());
+}
+#endif
diff --git a/sys/tests/linuxkpi_wlan/qmi_native_test.c b/sys/tests/linuxkpi_wlan/qmi_native_test.c
new file mode 100644
index 00000000..bbe390d0
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/qmi_native_test.c
@@ -0,0 +1,255 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/systm.h>
+
+#include "qmi_native.h"
+
+/* Standalone codec executable: these linker-set bounds are never dereferenced. */
+uintptr_t *__start_set_pcpu, *__stop_set_pcpu;
+
+int main(void);
+
+#define TEST(expr) do {						\
+	if (!(expr)) {						\
+		printf("qmi_native_test:%d: %s\n", __LINE__, #expr);	\
+		return (1);					\
+	}							\
+} while (0)
+
+struct mem_info {
+	uint64_t start, size;
+};
+
+struct cap {
+	struct qmi_response_type_v01 response;
+	uint8_t valid;
+	struct mem_info memory[4];
+};
+
+static const struct qmi_elem_info result_ei[] = {
+	{ .data_type = QMI_UNSIGNED_2_BYTE, .elem_len = 1, .elem_size = 2,
+	  .offset = offsetof(struct qmi_response_type_v01, result) },
+	{ .data_type = QMI_UNSIGNED_2_BYTE, .elem_len = 1, .elem_size = 2,
+	  .offset = offsetof(struct qmi_response_type_v01, error) },
+	{ .data_type = QMI_EOTI },
+};
+
+static const struct qmi_elem_info memory_ei[] = {
+	{ .data_type = QMI_UNSIGNED_8_BYTE, .elem_len = 1, .elem_size = 8,
+	  .offset = offsetof(struct mem_info, start) },
+	{ .data_type = QMI_UNSIGNED_8_BYTE, .elem_len = 1, .elem_size = 8,
+	  .offset = offsetof(struct mem_info, size) },
+	{ .data_type = QMI_EOTI },
+};
+
+static const struct qmi_elem_info cap_ei[] = {
+	{ .data_type = QMI_STRUCT, .elem_len = 1,
+	  .elem_size = sizeof(struct qmi_response_type_v01), .tlv_type = 2,
+	  .offset = offsetof(struct cap, response), .ei_array = result_ei },
+	{ .data_type = QMI_OPT_FLAG, .elem_len = 1, .elem_size = 1,
+	  .tlv_type = 0x1c, .offset = offsetof(struct cap, valid) },
+	{ .data_type = QMI_STRUCT, .elem_len = 4, .elem_size = sizeof(struct mem_info),
+	  .array_type = STATIC_ARRAY, .tlv_type = 0x1c,
+	  .offset = offsetof(struct cap, memory), .ei_array = memory_ei },
+	{ .data_type = QMI_EOTI },
+};
+
+struct list {
+	uint32_t length;
+	struct mem_info memory[2];
+};
+
+static const struct qmi_elem_info list_ei[] = {
+	{ .data_type = QMI_DATA_LEN, .elem_len = 1, .elem_size = 1,
+	  .tlv_type = 1, .offset = offsetof(struct list, length) },
+	{ .data_type = QMI_STRUCT, .elem_len = 2, .elem_size = sizeof(struct mem_info),
+	  .array_type = VAR_LEN_ARRAY, .tlv_type = 1,
+	  .offset = offsetof(struct list, memory), .ei_array = memory_ei },
+	{ .data_type = QMI_EOTI },
+};
+
+struct version {
+	uint32_t number;
+	char timestamp[8];
+};
+
+static const struct qmi_elem_info version_ei[] = {
+	{ .data_type = QMI_UNSIGNED_4_BYTE, .elem_len = 1, .elem_size = 4,
+	  .offset = offsetof(struct version, number) },
+	{ .data_type = QMI_STRING, .elem_len = 8, .elem_size = 1,
+	  .offset = offsetof(struct version, timestamp) },
+	{ .data_type = QMI_EOTI },
+};
+
+struct version_response {
+	struct version version;
+};
+
+static const struct qmi_elem_info version_response_ei[] = {
+	{ .data_type = QMI_STRUCT, .elem_len = 1, .elem_size = sizeof(struct version),
+	  .tlv_type = 1, .ei_array = version_ei },
+	{ .data_type = QMI_EOTI },
+};
+
+int
+main(void)
+{
+	struct cap input = { .valid = 1,
+		.memory = { { .start = 0x113000, .size = 0x5000 } } };
+	struct cap output, saved;
+	struct list list = { .length = 2,
+		.memory = { { .start = 0x123456789, .size = 4096 },
+			    { .start = 0x200000, .size = 8192 } } };
+	struct list decoded_list;
+	struct version_response version = { .version = {
+		.number = 0x1103006c, .timestamp = "native" } }, decoded_version;
+	uint8_t packet[256], copy[256], frame_packet[256];
+	struct ath12k_qmi_native_frame frame;
+	struct qmi_txn txn = { .ei = cap_ei, .id = 42, .message = 0x24,
+		.active = true, .sent = true };
+	struct {
+		uint64_t before;
+		struct cap value;
+		uint64_t after;
+	} guarded;
+	size_t length, i, j, cut;
+
+	TEST(ath12k_qmi_native_encode(cap_ei, &input, packet, sizeof(packet),
+	    &length) == 0);
+	TEST(length == 74 && packet[7] == 0x1c && le16dec(packet + 8) == 64);
+	TEST(le64dec(packet + 10) == 0x113000 && le64dec(packet + 18) == 0x5000);
+	TEST(ath12k_qmi_native_decode(cap_ei, packet, length, &output,
+	    sizeof(output)) == 0);
+	TEST(output.valid && output.memory[0].start == input.memory[0].start &&
+	    output.memory[0].size == input.memory[0].size);
+	for (i = 1; i < 4; i++)
+		TEST(output.memory[i].start == 0 && output.memory[i].size == 0);
+	memset(&saved, 0xa5, sizeof(saved));
+	output = saved;
+	le16enc(packet + 8, 63);
+	TEST(ath12k_qmi_native_decode(cap_ei, packet, length, &output,
+	    sizeof(output)) != 0);
+	TEST(memcmp(&output, &saved, sizeof(output)) == 0);
+	le16enc(packet + 8, 64);
+	memcpy(copy, packet, length);
+	memcpy(copy + length, packet, 7);
+	TEST(ath12k_qmi_native_decode(cap_ei, copy, length + 7, &output,
+	    sizeof(output)) == -EBADMSG);
+	TEST(ath12k_qmi_native_decode(cap_ei, packet + 7, length - 7, &output,
+	    sizeof(output)) == -ENOMSG);
+	TEST(ath12k_qmi_native_decode(cap_ei, packet, 7, &output,
+	    sizeof(output)) == 0 && !output.valid);
+	for (cut = 0; cut < 74; cut++) {
+		memset(packet, 0xcc, sizeof(packet));
+		TEST(ath12k_qmi_native_encode(cap_ei, &input, packet, cut,
+		    &length) != 0);
+		for (j = cut; j < sizeof(packet); j++)
+			TEST(packet[j] == 0xcc);
+	}
+	TEST(ath12k_qmi_native_encode(cap_ei, &input, packet, sizeof(packet),
+	    &length) == 0);
+	for (i = 0; i < length; i++)
+		for (j = 0; j < 8; j++) {
+			memcpy(copy, packet, length);
+			copy[i] ^= 1U << j;
+			guarded.before = guarded.after = UINT64_MAX;
+			guarded.value = saved;
+			if (ath12k_qmi_native_decode(cap_ei, copy, length,
+			    &guarded.value, sizeof(guarded.value)) != 0)
+				TEST(memcmp(&guarded.value, &saved, sizeof(saved)) == 0);
+			TEST(guarded.before == UINT64_MAX && guarded.after == UINT64_MAX);
+		}
+	memset(frame_packet, 0, sizeof(frame_packet));
+	le32enc(frame_packet, 1);
+	le32enc(frame_packet + 4, 1);
+	le32enc(frame_packet + 8, 7);
+	le32enc(frame_packet + 12, 9);
+	le32enc(frame_packet + 20, length + 7);
+	le32enc(frame_packet + 24, 1);
+	le32enc(frame_packet + 28, 0x4000);
+	frame_packet[32] = 2;
+	le16enc(frame_packet + 33, txn.id);
+	le16enc(frame_packet + 35, txn.message);
+	le16enc(frame_packet + 37, length);
+	memcpy(frame_packet + 39, packet, length);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 116, &frame) == 0);
+	TEST(ath12k_qmi_native_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == 0 && output.valid);
+	frame_packet[32] = QMI_INDICATION;
+	le16enc(frame_packet + 33, 1);
+	le16enc(frame_packet + 35, 0x35);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 116, &frame) == 0 &&
+	    frame.body[0] == QMI_INDICATION && le16dec(frame.body + 1) == 1);
+	TEST(ath12k_qmi_native_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -EPROTO);
+	frame_packet[32] = 0;
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 116, &frame) == -EPROTO);
+	frame_packet[32] = 2;
+	le16enc(frame_packet + 33, txn.id);
+	le16enc(frame_packet + 35, txn.message);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 116, &frame) == 0);
+	output = saved;
+	TEST(ath12k_qmi_native_reply(&frame, 8, 9, &txn, &output,
+	    sizeof(output)) == -EPROTO);
+	TEST(ath12k_qmi_native_reply(&frame, 7, 10, &txn, &output,
+	    sizeof(output)) == -EPROTO);
+	txn.id++;
+	TEST(ath12k_qmi_native_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -ENOENT);
+	txn.id--;
+	txn.message++;
+	TEST(ath12k_qmi_native_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -ENOENT);
+	txn.message--;
+	txn.active = false;
+	TEST(ath12k_qmi_native_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == -ENOENT);
+	txn.active = true;
+	TEST(memcmp(&output, &saved, sizeof(output)) == 0);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 115, &frame) == -EPROTO);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 113, &frame) == 0);
+	le32enc(frame_packet + 28, 0x4001);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 116, &frame) == -EPROTO);
+	le32enc(frame_packet + 28, 0x4000);
+	memcpy(copy, frame_packet + 32, length + 7);
+	memset(frame_packet, 0, sizeof(frame_packet));
+	frame_packet[0] = 3;
+	frame_packet[1] = 1;
+	frame_packet[2] = 1;
+	le32enc(frame_packet + 4, length + 7);
+	le16enc(frame_packet + 8, 7);
+	le16enc(frame_packet + 10, 9);
+	le16enc(frame_packet + 12, 1);
+	le16enc(frame_packet + 14, 0x4000);
+	memcpy(frame_packet + 16, copy, length + 7);
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 100, &frame) == 0 &&
+	    frame.confirm == 1);
+	TEST(ath12k_qmi_native_reply(&frame, 7, 9, &txn, &output,
+	    sizeof(output)) == 0);
+	frame_packet[3] = 4;
+	TEST(ath12k_qmi_native_frame_decode(frame_packet, 100, &frame) ==
+	    -EPROTONOSUPPORT);
+	TEST(ath12k_qmi_native_encode(list_ei, &list, packet, sizeof(packet),
+	    &length) == 0 && length == 36 && packet[3] == 2);
+	TEST(ath12k_qmi_native_decode(list_ei, packet, length, &decoded_list,
+	    sizeof(decoded_list)) == 0 && decoded_list.length == 2 &&
+	    decoded_list.memory[1].size == 8192);
+	packet[3] = 3;
+	TEST(ath12k_qmi_native_decode(list_ei, packet, length, &decoded_list,
+	    sizeof(decoded_list)) != 0);
+	list.length = 3;
+	TEST(ath12k_qmi_native_encode(list_ei, &list, packet, sizeof(packet),
+	    &length) != 0);
+	TEST(ath12k_qmi_native_encode(version_response_ei, &version, packet,
+	    sizeof(packet), &length) == 0);
+	TEST(length == 14 && packet[7] == 6);
+	TEST(ath12k_qmi_native_decode(version_response_ei, packet, length,
+	    &decoded_version, sizeof(decoded_version)) == 0 &&
+	    strcmp(decoded_version.version.timestamp, "native") == 0);
+	packet[7] = 8;
+	TEST(ath12k_qmi_native_decode(version_response_ei, packet, length,
+	    &decoded_version, sizeof(decoded_version)) != 0);
+	printf("qmi_native_test: schema/CMEM, bounded frames, source/transaction matching and cancellation passed\n");
+	return (0);
+}
diff --git a/sys/tests/linuxkpi_wlan/regulatory_production_test.py b/sys/tests/linuxkpi_wlan/regulatory_production_test.py
new file mode 100644
index 00000000..c38d6696
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/regulatory_production_test.py
@@ -0,0 +1,369 @@
+#!/usr/bin/env python3
+"""Hardware-free tests of extracted production regulatory C functions.
+
+Use --objdir with an isolated project build directory. Before the parent glue
+patch is applied, --glue-source may name its generated validation candidate.
+Only kernel allocation, locks, atomics and WMI submission are modeled. The rule,
+channel, duplicate-event, ordered submission and readiness functions are read
+from the actual production sources, not reimplemented in this test.
+"""
+
+import argparse
+import pathlib
+import re
+import subprocess
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+
+
+def declaration(text, name):
+    start = text.index(name)
+    brace = text.index("{", start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:text.index(";", end) + 1]
+
+
+def function(text, name):
+    match = re.search(r"\b" + name + r"\s*\([^;]*?\)\s*\{", text, re.S)
+    if not match:
+        raise RuntimeError(f"{name} missing: apply the regulatory glue patch first")
+    start = text.rfind("\n", 0, match.start()) + 1
+    if not text[start:match.start()].strip():
+        start = text.rfind("\n", 0, start - 1) + 1
+    brace = text.index("{", match.start())
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (text[end] == "{") - (text[end] == "}")
+        end += 1
+    return text[start:end] + "\n"
+
+
+PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <limits.h>
+#include <errno.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+typedef uint32_t u32;
+typedef unsigned int u_int;
+#ifndef __packed
+#define __packed __attribute__((__packed__))
+#endif
+#ifndef ENODATA
+#define ENODATA ECONNREFUSED
+#endif
+#define BIT(n) (1U << (n))
+#define min(a,b) ((a) < (b) ? (a) : (b))
+#define max(a,b) ((a) > (b) ? (a) : (b))
+#define min_t(t,a,b) min((t)(a), (t)(b))
+#define MHZ_TO_KHZ(x) ((x) * 1000)
+#define KHZ_TO_MHZ(x) ((x) / 1000)
+#define DBI_TO_MBI(x) ((x) * 100)
+#define DBM_TO_MBM(x) ((x) * 100)
+#define GFP_KERNEL 0
+#define GFP_ATOMIC 0
+#define kzalloc(n,f) calloc(1,n)
+#define kzalloc_flex(o,m,n) calloc(1, sizeof(o) + (n) * sizeof((o).m[0]))
+#define kfree(p) free(p)
+#define REG_ALPHA2_LEN 2
+#define U16_MAX UINT16_MAX
+#define REGULATORY_WIPHY_SELF_MANAGED 1
+#define NL80211_RRF_NO_HT40 (NL80211_RRF_NO_HT40PLUS | NL80211_RRF_NO_HT40MINUS)
+#define IEEE80211_CHAN_NO_HT40 (IEEE80211_CHAN_NO_HT40PLUS | IEEE80211_CHAN_NO_HT40MINUS)
+#define atomic_load_acq_int(p) __atomic_load_n((p), __ATOMIC_ACQUIRE)
+#define atomic_swap_int(p,v) __atomic_exchange_n((p), (v), __ATOMIC_ACQ_REL)
+#define atomic_cmpset_int(p,o,n) __sync_bool_compare_and_swap((p),(o),(n))
+#define atomic_cmpset_rel_int(p,o,n) atomic_cmpset_int(p,o,n)
+#define sx_xlock(p) ((void)(p))
+#define sx_xunlock(p) ((void)(p))
+#define rcu_dereference_protected(p,c) (p)
+#define lockdep_assert_wiphy(p) ((void)(p))
+#define ath12k_warn(...) ((void)0)
+"""
+
+MOCKS = r"""
+#define ieee80211_regdomain linuxkpi_ieee80211_regdomain
+#define ieee80211_channel linuxkpi_ieee80211_channel
+struct ieee80211_supported_band {
+    struct ieee80211_channel *channels;
+    int n_channels;
+};
+struct lkpi_wiphy {
+    int reg_sx;
+    unsigned reg_tx_ready;
+    bool reg_failed;
+    const struct ieee80211_regdomain *regd_owned;
+};
+struct wiphy {
+    bool lkpi_regulatory_strict;
+    unsigned regulatory_flags;
+    const struct ieee80211_regdomain *regd;
+    struct lkpi_wiphy *owner;
+    struct ieee80211_supported_band *bands[NUM_NL80211_BANDS];
+};
+#define WIPHY_TO_LWIPHY(w) ((w)->owner)
+struct ieee80211_hw { struct wiphy *wiphy; };
+struct ath12k_base {
+    struct ath12k_reg_freq reg_freq_2ghz, reg_freq_5ghz, reg_freq_6ghz;
+};
+struct ath12k_reg_info {
+    char alpha2[3];
+    unsigned dfs_region, phybitmap, status_code;
+    u32 min_bw_2g, max_bw_2g, min_bw_5g, max_bw_5g;
+    u32 num_2g_reg_rules, num_5g_reg_rules;
+    struct ath12k_reg_rule *reg_rules_2g_ptr, *reg_rules_5g_ptr;
+};
+struct ath12k_hw { int num_radio, state; struct ieee80211_hw *hw; };
+struct pdev { unsigned pdev_id; };
+struct ath12k {
+    struct ath12k_base *ab;
+    struct ath12k_hw *ah;
+    struct pdev *pdev;
+    struct { u32 start_freq, end_freq; } freq_range;
+    struct { struct ieee80211_supported_band sbands[NUM_NL80211_BANDS]; } mac;
+    u32 min_tx_power, max_tx_power, txpower_limit_2g, txpower_limit_5g;
+};
+#define ATH12K_HW_STATE_RESTARTING 3
+#define WMI_PDEV_PARAM_TXPOWER_LIMIT2G 2
+#define WMI_PDEV_PARAM_TXPOWER_LIMIT5G 5
+#define REG_SET_CC_STATUS_PASS 0
+#define ath12k_ar_to_hw(ar) ((ar)->ah->hw)
+static int commands, fail_command, revoke_command;
+static struct wiphy *active_wiphy;
+static int ath12k_wmi_send_scan_chan_list_cmd(struct ath12k *,
+    struct ath12k_wmi_scan_chan_list_arg *);
+static int ath12k_wmi_pdev_set_param(struct ath12k *, u32, u32, u32);
+"""
+
+TESTS = r"""
+static unsigned assertions;
+#define CHECK(c) do { assertions++; if (!(c)) { \
+    fprintf(stderr, "line %d: %s\n", __LINE__, #c); return 1; } } while (0)
+
+static int command(void)
+{
+    commands++;
+    if (commands == revoke_command)
+        linuxkpi_regulatory_revoke(active_wiphy);
+    return commands == fail_command ? -EIO : 0;
+}
+static int ath12k_wmi_send_scan_chan_list_cmd(struct ath12k *ar,
+    struct ath12k_wmi_scan_chan_list_arg *arg)
+{
+    assert(!linuxkpi_regulatory_tx_permitted(active_wiphy));
+    assert(commands == 0 && arg->nallchans == 2 && arg->pdev_id == ar->pdev->pdev_id);
+    assert(arg->channel[0].maxpower == 38 && arg->channel[1].maxpower == 46);
+    assert(!arg->channel[0].allow_he && !arg->channel[1].allow_he);
+    assert(arg->channel[0].cfreq2 == 0 && arg->channel[1].cfreq2 == 0);
+    return command();
+}
+static int ath12k_wmi_pdev_set_param(struct ath12k *ar, u32 id, u32 power, u32 pdev)
+{
+    assert(!linuxkpi_regulatory_tx_permitted(active_wiphy));
+    assert(pdev == ar->pdev->pdev_id);
+    assert((commands == 1 && id == 2 && power == 38) ||
+           (commands == 2 && id == 5 && power == 46));
+    return command();
+}
+int main(void)
+{
+    struct ath12k_reg_rule raw = {
+        .start_freq = 2402, .end_freq = 2472, .max_bw = 40,
+        .reg_power = 20, .ant_gain = 3
+    }, rules[2];
+    struct ieee80211_reg_rule rule;
+    struct ath12k_wmi_channel_arg wire;
+    struct ieee80211_channel channel = {
+        .band = NL80211_BAND_2GHZ, .center_freq = 2412, .max_power = 30
+    }, eligible[2];
+    struct ath12k_reg_info info = {
+        .alpha2 = "US", .max_bw_2g = 40, .max_bw_5g = 80,
+        .num_2g_reg_rules = 1, .reg_rules_2g_ptr = &raw
+    }, copy;
+    struct ath12k_base ab = {0};
+    struct ieee80211_regdomain *domain, *built;
+    struct lkpi_wiphy owner = {0};
+    struct wiphy wiphy = {.lkpi_regulatory_strict = true,
+        .regulatory_flags = REGULATORY_WIPHY_SELF_MANAGED, .owner = &owner};
+    struct ieee80211_supported_band bands[2] = {0};
+    struct ieee80211_hw hw = {.wiphy = &wiphy};
+    struct ath12k_hw ah = {.num_radio = 1, .hw = &hw};
+    struct pdev pdev = {.pdev_id = 7};
+    struct ath12k ar = {.ab = &ab, .ah = &ah, .pdev = &pdev,
+        .freq_range = {2402000, 5900000}, .max_tx_power = 30};
+
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0);
+    CHECK(rule.freq_range.max_bandwidth_khz == 20000 &&
+        rule.power_rule.max_eirp == 2000 && rule.power_rule.max_antenna_gain == 300);
+    raw.flags = REGULATORY_CHAN_DISABLED;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    raw.flags = REGULATORY_CHAN_NO_20MHZ;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    raw.flags = BIT(15);
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    raw.flags = 0; raw.psd_flag = true;
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_PSD));
+    raw.psd_flag = false;
+    CHECK(ath12k_reg_prepare_rule(&raw, 40, 80, 0, &rule) == 0 &&
+        (rule.flags & NL80211_RRF_NO_IR));
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 0, 0, &rule) == -EINVAL);
+    built = ath12k_reg_build_station_regd(&ab, &info);
+    CHECK(built && built->n_reg_rules == 1 && built->alpha2[1] == 'S');
+    CHECK(ab.reg_freq_2ghz.start_freq == 2402 && ab.reg_freq_6ghz.end_freq == 0);
+    free(built);
+    info.num_2g_reg_rules = 129;
+    CHECK(!ath12k_reg_build_station_regd(&ab, &info));
+    info.num_2g_reg_rules = 1;
+    copy = info;
+    CHECK(ath12k_reg_same_station_info(&info, &copy));
+    rules[0] = raw; copy.reg_rules_2g_ptr = rules;
+    rules[0].reg_power--;
+    CHECK(!ath12k_reg_same_station_info(&info, &copy));
+    rules[0] = raw; rules[0].flags = REGULATORY_CHAN_NO_IR;
+    CHECK(!ath12k_reg_same_station_info(&info, &copy));
+
+    domain = calloc(1, sizeof(*domain) + 2 * sizeof(domain->reg_rules[0]));
+    CHECK(domain != NULL);
+    domain->n_reg_rules = 2;
+    domain->alpha2[0] = 'U'; domain->alpha2[1] = 'S';
+    CHECK(ath12k_reg_prepare_rule(&raw, 20, 40, 0, &domain->reg_rules[0]) == 0);
+    domain->reg_rules[0].power_rule.max_eirp = 1999;
+    rules[1] = raw; rules[1].start_freq = 5170; rules[1].end_freq = 5250;
+    rules[1].reg_power = 23;
+    CHECK(ath12k_reg_prepare_rule(&rules[1], 20, 80, 0, &domain->reg_rules[1]) == 0);
+    CHECK(lkpi_regulatory_channel(domain, &channel, &eligible[0]) == 0);
+    channel.band = NL80211_BAND_5GHZ; channel.center_freq = 5180;
+    CHECK(lkpi_regulatory_channel(domain, &channel, &eligible[1]) == 0);
+    CHECK(ath12k_reg_prepare_channel(&eligible[0], 0, 30, &wire) == 0 &&
+        wire.maxpower == 38 && wire.antennamax == 6 && !wire.allow_he);
+    CHECK(ath12k_reg_prepare_channel(&eligible[0], 20, 30, &wire) == -ERANGE);
+    CHECK(ath12k_reg_prepare_channel(&eligible[0], 0, 18, &wire) == -ERANGE);
+    channel = eligible[0]; channel.flags |= IEEE80211_CHAN_NO_IR;
+    CHECK(ath12k_reg_prepare_channel(&channel, 0, 30, &wire) == -EOPNOTSUPP);
+    for (int i = 0; i < 2; i++) {
+        bands[i].channels = &eligible[i]; bands[i].n_channels = 1;
+        wiphy.bands[i] = &bands[i]; ar.mac.sbands[i] = bands[i];
+    }
+    active_wiphy = &wiphy;
+    wiphy.regd = owner.regd_owned = domain;
+    CHECK(!linuxkpi_regulatory_tx_permitted(&wiphy));
+    CHECK(linuxkpi_regulatory_set_tx_ready(&wiphy, NULL) == -EINVAL);
+    CHECK(ath12k_reg_submit_chan_list(&ar) == 0 &&
+        linuxkpi_regulatory_tx_permitted(&wiphy) && commands == 3);
+    CHECK(ar.txpower_limit_2g == 38 && ar.txpower_limit_5g == 46);
+    for (int failure = 1; failure <= 3; failure++) {
+        owner.reg_tx_ready = 1; commands = 0; fail_command = failure;
+        CHECK(ath12k_reg_submit_chan_list(&ar) == -EIO &&
+            !linuxkpi_regulatory_tx_permitted(&wiphy) && commands == failure);
+        CHECK(linuxkpi_regulatory_set_tx_ready(&wiphy, domain) == -EBUSY);
+    }
+    fail_command = 0;
+    for (int revoked = 1; revoked <= 3; revoked++) {
+        commands = 0; owner.reg_tx_ready = 0; revoke_command = revoked;
+        CHECK(ath12k_reg_submit_chan_list(&ar) == -EBUSY &&
+            !linuxkpi_regulatory_tx_permitted(&wiphy) && commands == revoked);
+    }
+    revoke_command = 0; commands = 0; owner.reg_tx_ready = 0;
+    eligible[0].max_power++; eligible[0].max_reg_power++;
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -ESTALE && commands == 0);
+    eligible[0].max_power--; eligible[0].max_reg_power--;
+    owner.reg_tx_ready = 0; wiphy.regd = NULL;
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -ENODATA && commands == 0);
+    wiphy.regd = domain; owner.reg_tx_ready = 0; ah.num_radio = 2;
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -EOPNOTSUPP && commands == 0);
+    ah.num_radio = 1; owner.reg_tx_ready = 0;
+    wiphy.bands[NL80211_BAND_6GHZ] = &bands[0];
+    ar.mac.sbands[NL80211_BAND_6GHZ] = bands[0];
+    CHECK(ath12k_reg_submit_chan_list(&ar) == -EOPNOTSUPP && commands == 0);
+    wiphy.bands[NL80211_BAND_6GHZ] = NULL;
+    wiphy.lkpi_regulatory_strict = false;
+    CHECK(linuxkpi_regulatory_tx_permitted(&wiphy) &&
+        !linuxkpi_regulatory_revoke(&wiphy));
+    free(domain);
+    printf("regulatory production model: %u assertions passed\n", assertions);
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--objdir", required=True, type=pathlib.Path)
+    parser.add_argument("--glue-source", type=pathlib.Path)
+    parser.add_argument("--sanitize", action="store_true")
+    args = parser.parse_args()
+    obj = args.objdir.resolve()
+    if obj == pathlib.Path("/tmp") or pathlib.Path("/tmp") in obj.parents:
+        parser.error("use a project object directory, not /tmp")
+    obj.mkdir(parents=True, exist_ok=True)
+    cfg = (ROOT / "sys/compat/linuxkpi/common/include/net/cfg80211.h").read_text()
+    nl = (ROOT / "sys/compat/linuxkpi/common/include/linux/nl80211.h").read_text()
+    reg = (ROOT / "sys/contrib/dev/athk/ath12k/reg.c").read_text()
+    rh = (ROOT / "sys/contrib/dev/athk/ath12k/reg.h").read_text()
+    wh = (ROOT / "sys/contrib/dev/athk/ath12k/wmi.h").read_text()
+    core = (ROOT / "sys/contrib/dev/athk/ath12k/core.h").read_text()
+    glue_path = args.glue_source or ROOT / "sys/compat/linuxkpi/common/src/linux_80211.c"
+    glue = glue_path.read_text()
+    definitions = [
+        declaration(nl, "enum nl80211_reg_rule_flags"),
+        declaration(nl, "enum nl80211_band"),
+        declaration(nl, "enum nl80211_dfs_state"),
+        declaration(nl, "enum nl80211_dfs_regions"),
+        declaration(cfg, "enum ieee80211_channel_flags"),
+        declaration(cfg, "struct linuxkpi_ieee80211_channel"),
+        declaration(cfg, "struct ieee80211_reg_rule"),
+        declaration(cfg, "struct linuxkpi_ieee80211_regdomain"),
+        declaration(rh, "enum ath12k_dfs_region"),
+        declaration(rh, "enum ath12k_reg_phy_bitmap"),
+        declaration(rh, "struct ath12k_reg_rule"),
+        declaration(core, "struct ath12k_reg_freq"),
+        declaration(wh, "enum wmi_phy_mode"),
+        declaration(wh, "struct ath12k_wmi_channel_arg"),
+        declaration(wh, "struct ath12k_wmi_scan_chan_list_arg").replace(
+            "struct list_head list;", "void *list[2];"
+        ),
+    ]
+    definitions.extend(re.findall(r"^#define REGULATORY_CHAN_.*$", wh, re.M))
+    bodies = [function(glue, name) for name in (
+        "lkpi_reg_tx_allowed", "linuxkpi_regulatory_tx_permitted",
+        "linuxkpi_regulatory_revoke", "linuxkpi_regulatory_tx_pending",
+        "linuxkpi_regulatory_set_tx_ready", "lkpi_regulatory_channel",
+    )]
+    bodies.extend(function(reg, name) for name in (
+        "ath12k_map_fw_dfs_region", "ath12k_map_fw_reg_flags",
+        "ath12k_map_fw_phy_flags", "ath12k_reg_prepare_rule",
+        "ath12k_reg_build_station_regd", "ath12k_reg_same_station_info",
+        "ath12k_reg_prepare_channel", "ath12k_reg_submit_chan_list",
+    ))
+    source = obj / "regulatory-model.c"
+    binary = obj / "regulatory-model"
+    try:
+        source.write_text("\n".join([PRELUDE, *definitions, MOCKS, *bodies, TESTS]))
+        sanitize = (["-fsanitize=address,undefined", "-fno-sanitize-recover=all"]
+                    if args.sanitize else [])
+        subprocess.run(["/usr/bin/cc", "-std=gnu17", "-Wall", "-Wextra",
+                        "-Werror", *sanitize, str(source), "-o", str(binary)],
+                       check=True)
+        subprocess.run([str(binary)], check=True)
+    finally:
+        source.unlink(missing_ok=True)
+        binary.unlink(missing_ok=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sys/tests/linuxkpi_wlan/regulatory_test.c b/sys/tests/linuxkpi_wlan/regulatory_test.c
new file mode 100644
index 00000000..ed64db8e
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/regulatory_test.c
@@ -0,0 +1,219 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <sys/param.h>
+#include <sys/kernel.h>
+#include <sys/malloc.h>
+#include <sys/module.h>
+#include <sys/socket.h>
+#include <sys/systm.h>
+
+#include <net/if.h>
+#include <net/if_var.h>
+#include <net/if_media.h>
+#include <net/ethernet.h>
+#include <net80211/ieee80211_var.h>
+#define LINUXKPI_NET80211
+#include <net/mac80211.h>
+#include "../../compat/linuxkpi/common/src/linux_80211.h"
+
+#define REG_CHECK(condition) do {					\
+	if (!(condition)) {						\
+		printf("lkpi_regulatory_test: line %d: %s\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+static const struct ieee80211_ops regulatory_test_ops = {
+	.add_chanctx = ieee80211_emulate_add_chanctx,
+	.change_chanctx = ieee80211_emulate_change_chanctx,
+	.remove_chanctx = ieee80211_emulate_remove_chanctx,
+};
+
+static int
+regulatory_test(void)
+{
+	struct ieee80211_hw *hw;
+	struct linuxkpi_ieee80211_regdomain *regd;
+	const struct linuxkpi_ieee80211_regdomain *published;
+	struct linuxkpi_ieee80211_channel input, output, channels[2];
+	struct ieee80211_supported_band band = {};
+	struct ieee80211_reg_rule saved;
+	int error;
+
+	error = ENOMEM;
+	hw = ieee80211_alloc_hw(0, &regulatory_test_ops);
+	regd = lkpi_get_linuxkpi_ieee80211_regdomain(2);
+	if (hw == NULL || regd == NULL)
+		goto out;
+	hw->wiphy->regulatory_flags = REGULATORY_WIPHY_SELF_MANAGED;
+	regd->alpha2[0] = 'U';
+	regd->alpha2[1] = 'S';
+	regd->n_reg_rules = 1;
+	regd->reg_rules[0] = (struct ieee80211_reg_rule)
+	    REG_RULE(2402, 2472, 40, 3, 20, 0);
+	regd->reg_rules[0].power_rule.max_eirp = 1999;
+	input = (struct linuxkpi_ieee80211_channel) {
+		.band = NL80211_BAND_2GHZ, .center_freq = 2412,
+		.max_power = 30,
+	};
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0);
+	REG_CHECK(output.max_power == 19 && output.max_reg_power == 19 &&
+	    output.max_antenna_gain == 3 && output.orig_mpwr == 30 &&
+	    (output.flags & IEEE80211_CHAN_NO_HT40) == IEEE80211_CHAN_NO_HT40);
+	input.max_power = 17;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 17);
+	input.max_power = 30;
+	input.center_freq = 2484;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE &&
+	    (output.flags & IEEE80211_CHAN_DISABLED));
+	input.center_freq = 2412;
+	regd->reg_rules[0].freq_range.start_freq_khz++;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE);
+	regd->reg_rules[0].freq_range.start_freq_khz--;
+
+	regd->n_reg_rules = 2;
+	regd->reg_rules[1] = regd->reg_rules[0];
+	regd->reg_rules[1].power_rule.max_eirp = 1350;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 13);
+	saved = regd->reg_rules[0];
+	regd->reg_rules[0] = regd->reg_rules[1];
+	regd->reg_rules[1] = saved;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 13);
+	regd->reg_rules[1].freq_range.start_freq_khz = 2415000;
+	regd->reg_rules[1].flags = NL80211_RRF_NO_IR;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) ==
+	    -EOPNOTSUPP && (output.flags & IEEE80211_CHAN_DISABLED));
+
+	regd->n_reg_rules = 1;
+	regd->reg_rules[0].flags = NL80211_RRF_DFS;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	regd->reg_rules[0].flags = NL80211_RRF_NO_OUTDOOR;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	regd->reg_rules[0].flags = NL80211_RRF_PSD;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	regd->reg_rules[0].flags = 0;
+	regd->reg_rules[0].freq_range.max_bandwidth_khz = 19999;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	regd->reg_rules[0].freq_range.max_bandwidth_khz = 40000;
+	input.flags = IEEE80211_CHAN_INDOOR_ONLY;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	input.flags = IEEE80211_CHAN_DISABLED;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	input.flags = 0;
+	input.band = NL80211_BAND_6GHZ;
+	input.center_freq = 5955;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -EOPNOTSUPP);
+	input.band = NL80211_BAND_2GHZ;
+	input.center_freq = 2412;
+
+	regd->reg_rules[0] = (struct ieee80211_reg_rule)
+	    REG_RULE(5170, 5250, 80, 3, 23, 0);
+	input.band = NL80211_BAND_5GHZ;
+	input.center_freq = 5180;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0 &&
+	    output.max_power == 23);
+	input.center_freq = 5240;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == 0);
+	input.center_freq = 5245;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE);
+	input.band = NL80211_BAND_2GHZ;
+	input.center_freq = 2412;
+	regd->reg_rules[0] = saved;
+
+	/* Adjacent AUTO_BW rules must not invent full 20 MHz permission. */
+	regd->n_reg_rules = 2;
+	regd->reg_rules[1] = regd->reg_rules[0];
+	regd->reg_rules[0].flags = regd->reg_rules[1].flags = NL80211_RRF_AUTO_BW;
+	regd->reg_rules[0].freq_range.end_freq_khz = 2412000;
+	regd->reg_rules[1].freq_range.start_freq_khz = 2412000;
+	REG_CHECK(lkpi_regulatory_channel(regd, &input, &output) == -ERANGE);
+	regd->n_reg_rules = 1;
+	regd->reg_rules[0] = saved;
+
+	channels[0] = input;
+	channels[1] = input;
+	channels[1].center_freq = 2484;
+	band.channels = channels;
+	band.n_channels = nitems(channels);
+	hw->wiphy->bands[NL80211_BAND_2GHZ] = &band;
+	regd->n_reg_rules = 0;
+	REG_CHECK(regulatory_set_wiphy_regd_sync(hw->wiphy, regd) == 0 &&
+	    hw->wiphy->regd == NULL && channels[0].max_power == 30);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, regd) == -EINVAL);
+	REG_CHECK(linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	hw->wiphy->lkpi_regulatory_strict = true;
+	REG_CHECK(!linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_tx_pending(hw->wiphy) == -ENODATA);
+	REG_CHECK(regulatory_set_wiphy_regd(hw->wiphy, regd) == -EINVAL &&
+	    hw->wiphy->regd == NULL && channels[0].max_power == 30);
+	regd->n_reg_rules = 1;
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, regd) == -EINVAL);
+	REG_CHECK(regulatory_set_wiphy_regd(hw->wiphy, regd) == 0);
+	published = hw->wiphy->regd;
+	REG_CHECK(published != regd && published->alpha2[0] == 'U' &&
+	    channels[0].max_power == 19 &&
+	    channels[1].flags & IEEE80211_CHAN_DISABLED);
+	REG_CHECK(atomic_load_acq_int(
+	    &WIPHY_TO_LWIPHY(hw->wiphy)->reg_tx_ready) == 0);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, regd) == -EINVAL);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, published) == 0);
+	REG_CHECK(linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_tx_pending(hw->wiphy) == 0 &&
+	    !linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, published) == 0);
+	REG_CHECK(regulatory_set_wiphy_regd_sync(hw->wiphy, regd) == 0);
+	regd->alpha2[0] = 'C';
+	regd->alpha2[1] = 'A';
+	REG_CHECK(regulatory_set_wiphy_regd_sync_rtnl(hw->wiphy, regd) == -EBUSY);
+	REG_CHECK(atomic_load_acq_int(
+	    &WIPHY_TO_LWIPHY(hw->wiphy)->reg_tx_ready) == 2);
+	REG_CHECK(!linuxkpi_regulatory_tx_permitted(hw->wiphy));
+	REG_CHECK(!linuxkpi_regulatory_revoke(hw->wiphy));
+	REG_CHECK(linuxkpi_regulatory_tx_pending(hw->wiphy) == -EBUSY);
+	REG_CHECK(linuxkpi_regulatory_set_tx_ready(hw->wiphy, published) == -EBUSY);
+	kfree(regd);
+	regd = NULL;
+	REG_CHECK(published->alpha2[0] == 'U' &&
+	    published->reg_rules[0].power_rule.max_eirp == 1999);
+	error = 0;
+out:
+	kfree(regd);
+	if (hw != NULL)
+		ieee80211_free_hw(hw);
+	return (error);
+}
+
+static int
+regulatory_test_event(module_t module __unused, int event, void *arg __unused)
+{
+	int error;
+
+	switch (event) {
+	case MOD_LOAD:
+		error = regulatory_test();
+		if (error == 0)
+			printf("lkpi_regulatory_test: passed\n");
+		return (error);
+	case MOD_UNLOAD:
+		return (0);
+	default:
+		return (EOPNOTSUPP);
+	}
+}
+
+static moduledata_t regulatory_test_module = {
+	"lkpi_regulatory_test", regulatory_test_event, NULL
+};
+DECLARE_MODULE(lkpi_regulatory_test, regulatory_test_module, SI_SUB_DRIVERS,
+    SI_ORDER_ANY);
+MODULE_DEPEND(lkpi_regulatory_test, linuxkpi, 1, 1, 1);
+MODULE_DEPEND(lkpi_regulatory_test, linuxkpi_wlan, 1, 1, 1);
+MODULE_DEPEND(lkpi_regulatory_test, wlan, 1, 1, 1);
+MODULE_VERSION(lkpi_regulatory_test, 1);
diff --git a/sys/tests/linuxkpi_wlan/rhashtable_test.c b/sys/tests/linuxkpi_wlan/rhashtable_test.c
new file mode 100644
index 00000000..b5cadb7b
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/rhashtable_test.c
@@ -0,0 +1,160 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+
+#include <linux/rcupdate.h>
+#include <linux/rhashtable.h>
+
+struct rhashtable_test_object {
+	unsigned int key;
+	struct rhash_head head;
+	unsigned int value;
+	struct rcu_head rcu;
+	unsigned int *freed;
+};
+
+static void
+rhashtable_test_free(struct rcu_head *rcu)
+{
+	struct rhashtable_test_object *object;
+
+	object = container_of(rcu, struct rhashtable_test_object, rcu);
+	(*object->freed)++;
+	kfree(object);
+}
+
+#define	RHT_CHECK(condition) do {					\
+	if (!(condition)) {						\
+		printf("lkpi_rhashtable_test: line %d: %s\n",		\
+		    __LINE__, #condition);				\
+		error = EINVAL;						\
+		goto out;						\
+	}								\
+} while (0)
+
+int lkpi_rhashtable_test(void);
+
+int
+lkpi_rhashtable_test(void)
+{
+	const struct rhashtable_params params = {
+		.head_offset = offsetof(struct rhashtable_test_object, head),
+		.key_offset = offsetof(struct rhashtable_test_object, key),
+		.key_len = sizeof_field(struct rhashtable_test_object, key),
+		/* Force all objects into one collision chain. */
+		.nelem_hint = 1,
+		.automatic_shrinking = true,
+	};
+	struct rhashtable_test_object *objects[4] = {};
+	struct rhashtable_test_object *held;
+	struct rhashtable_params invalid;
+	struct rhashtable table;
+	unsigned int key, freed;
+	bool initialized, read_locked;
+	int error, i;
+
+	initialized = read_locked = false;
+	freed = 0;
+	invalid = params;
+	invalid.key_len = 0;
+	error = EINVAL;
+	RHT_CHECK(rhashtable_init(&table, &invalid) == -EINVAL);
+	error = -rhashtable_init(&table, &params);
+	if (error != 0)
+		return (error);
+	initialized = true;
+
+	key = 1;
+	RHT_CHECK(rhashtable_lookup_fast(&table, &key, params) == NULL);
+	for (i = 0; i < nitems(objects); i++) {
+		objects[i] = kzalloc(sizeof(*objects[i]), GFP_KERNEL);
+		if (objects[i] == NULL) {
+			error = ENOMEM;
+			goto out;
+		}
+		objects[i]->key = i + 1;
+		objects[i]->value = i + 10;
+	}
+	objects[3]->key = objects[1]->key;
+	for (i = 0; i < 3; i++)
+		RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+		    &objects[i]->head, params) == NULL);
+	for (i = 0; i < 3; i++)
+		RHT_CHECK(rhashtable_lookup_fast(&table, &objects[i]->key,
+		    params) == objects[i]);
+
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[3]->head, params) == objects[1]);
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[1]->head, params) == objects[1]);
+	/* Equal keys do not make an unlinked head removable. */
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[3]->head,
+	    params) == -ENOENT);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[1]->key,
+	    params) == objects[1]);
+
+	rcu_read_lock();
+	read_locked = true;
+	held = rhashtable_lookup_fast(&table, &objects[1]->key, params);
+	RHT_CHECK(held == objects[1]);
+	RHT_CHECK(rhashtable_remove_fast(&table, &held->head, params) == 0);
+	RHT_CHECK(rhashtable_remove_fast(&table, &held->head,
+	    params) == -ENOENT);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &held->key, params) == NULL);
+	held->freed = &freed;
+	call_rcu(&held->rcu, rhashtable_test_free);
+	objects[1] = NULL;
+	RHT_CHECK(held->value == 11 && freed == 0);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[0]->key,
+	    params) == objects[0]);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[2]->key,
+	    params) == objects[2]);
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[3]->head, params) == NULL);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[3]->key,
+	    params) == objects[3]);
+	rcu_read_unlock();
+	read_locked = false;
+	rcu_barrier();
+	RHT_CHECK(freed == 1);
+
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[3]->head,
+	    params) == 0);
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[0]->head,
+	    params) == 0);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[2]->key,
+	    params) == objects[2]);
+	RHT_CHECK(rhashtable_remove_fast(&table, &objects[2]->head,
+	    params) == 0);
+	RHT_CHECK(rhashtable_lookup_fast(&table, &objects[2]->key,
+	    params) == NULL);
+	RHT_CHECK(rhashtable_lookup_get_insert_fast(&table,
+	    &objects[0]->head, params) == NULL);
+
+	/* Destroy releases buckets, not caller-owned objects. */
+	rhashtable_destroy(&table);
+	initialized = false;
+	RHT_CHECK(objects[0]->value == 10 && objects[2]->value == 12 &&
+	    objects[3]->value == 13);
+	error = 0;
+out:
+	if (read_locked)
+		rcu_read_unlock();
+	if (initialized) {
+		for (i = 0; i < nitems(objects); i++) {
+			if (objects[i] != NULL)
+				rhashtable_remove_fast(&table, &objects[i]->head,
+				    params);
+		}
+	}
+	rcu_barrier();
+	synchronize_rcu();
+	for (i = 0; i < nitems(objects); i++)
+		kfree(objects[i]);
+	if (initialized)
+		rhashtable_destroy(&table);
+	return (error);
+}
diff --git a/sys/tests/linuxkpi_wlan/station_acceptance.sh b/sys/tests/linuxkpi_wlan/station_acceptance.sh
new file mode 100755
index 00000000..30f50ac7
--- /dev/null
+++ b/sys/tests/linuxkpi_wlan/station_acceptance.sh
@@ -0,0 +1,410 @@
+#!/bin/sh
+#
+# Preparation only: no claim that the native driver can scan or associate.
+# Commands and exact implementation blockers: --help and --blockers.
+set +x
+PATH=/sbin:/bin:/usr/sbin:/usr/bin
+export PATH
+LC_ALL=C
+export LC_ALL
+set -eu
+
+fail()
+{
+	echo "REFUSED: $*" >&2
+	exit 1
+}
+
+usage()
+{
+	cat <<'EOF'
+Native station acceptance PREPARATION; default is read-only preflight.
+Run only inside the isolated ath12k-lab / ATH12KLAB / bhyve guest.
+
+  sh station_acceptance.sh --interface wlan0
+  sh station_acceptance.sh --interface wlan0 --check status
+  sh station_acceptance.sh --blockers
+
+AFTER parent review and independent proof of the production prerequisites:
+  sh station_acceptance.sh --interface wlan0 --check scan \
+    --reviewed --wmi-init-ready --datapath-ready --regulatory-ready
+  sh station_acceptance.sh --interface wlan0 --check ipv4 \
+    --reviewed --wmi-init-ready --datapath-ready --regulatory-ready \
+    --source <WLAN-DHCP-IPv4> --gateway <WLAN-DHCP-router-IPv4>
+
+The four flags are explicit operator attestations, NOT automatic readiness
+detection. Never set them based only on firmware capability events, channel
+counts, country text, a successful build, or passing model/fixture tests.
+Parent review is required before either active check. No active checks have
+been approved or run by creating this harness.
+
+preflight: reads guest identity, wlanN -> ath12k_wifi7N parent/driver
+           mapping and regulatory text (the current production driver name).
+status: additionally queries the existing securely configured supplicant;
+        requires station mode, COMPLETED, WPA2 and pairwise/group CCMP.
+scan: performs one bounded scan; results/SSIDs are not printed or selected.
+      An already configured supplicant may react to scan results.
+ipv4: observes an existing unexpired base-system dhclient lease, validates
+      the WLAN address/mask and direct route to its DHCP router, sends two
+      source-bound DONTROUTE IPv4 echo requests to that on-link router only,
+      then requires a complete router ARP entry on that same WLAN.
+      No internet reachability, DNS, throughput or DHCP exchange is claimed.
+      A static address, stale lease, non-dhclient client or router blocking
+      ICMP deliberately fails; provision networking separately, not here.
+
+No interface creation/up/down, module loading, country changes, AP selection,
+supplicant configuration, credential reads, DHCP invocation, route changes,
+management-NIC traffic tests, captures or raw SSID/key/status dumps.
+This harness neither starts authentication nor benchmarks OpenBSD.
+EOF
+}
+
+blockers()
+{
+	cat <<'EOF'
+Implementation checkpoints (source paths are relative to this tree):
+
+1. Native attachment is not the lab mhi_boot capability-event milestone.
+   ath12k/mac.c ath12k_mac_register/ath12k_mac_hw_register must be reached
+   through production core/QMI/MHI, with actual WMI INIT/READY, allocated and
+   programmed DP rings/REO/cookie conversion and HTT setup, before exposing
+   ieee80211_register_hw -> linuxkpi_ieee80211_ifattach and a native VAP.
+   No current capability-event log proves those prerequisites.
+   Production ath12k_wmi_cmd_init requires init_prerequisites AND
+   init_resource_config; core.c installs ath12k_dp_init_prerequisites and
+   ath12k_dp_init_resource_config. Their live DP/cookie/REO/RX descriptors,
+   firmware resource counts and reset-retained DMA still need runtime proof,
+   not merely cc_prepared or successful callback installation. Afterwards
+   ath12k_wmi_wait_for_unified_ready(ab) must succeed; ab->wmi_ready is not
+   DBS/HTT/regulatory or data-path permission.
+
+2. Existing single-link glue is NOT missing wholesale:
+   linux_80211.c lkpi_ic_vap_create sets link_conf[0]=&bss_conf;
+   lkpi_lsta_alloc sets sta->link[0]=&sta->deflink.
+   wifi7/hw.c ath12k_ops_wifi7 already registers start/add_interface, hw_scan,
+   cancel_hw_scan, link_info_changed/vif_cfg_changed, sta_state, set_key,
+   assign_vif_chanctx, TX/wake_tx_queue. Keep valid_links=0/non-MLO.
+   mac.c ath12k_mac_op_add_interface intentionally defers firmware VDEV
+   creation to hw_scan/assign_chanctx; successful add_interface is not proof
+   of a started VDEV, peer or usable radio.
+
+3. Preserve and prove firmware ordering with real acknowledgments:
+   linux_80211.c lkpi_sta_scan_to_auth calls lkpi_set_chanctx_conf before
+   sta_state(NONE); ath12k assign_chanctx must create/start the VDEV before
+   peer creation. qwz.c qwz_auth explicitly requires VDEV_START before
+   PEER_CREATE to avoid an unbound firmware peer. Scan events must reach
+   ieee80211_scan_completed; management RX must reach linuxkpi_ieee80211_rx
+   for beacon/probe/auth/assoc delivery, and management TX completion must
+   reach ieee80211_tx_status_irqsafe. Native scan VDEV creation/deletion,
+   scan completion and beacon/probe reception are now proven; association
+   ordering and authentication/association delivery still need hardware proof.
+
+4. Implemented, NOT hardware-proven, station controlled-port bridge:
+   FreeBSD ath12k sets LKPI_STA_WPA2. linux_80211.c defers AUTHORIZED for
+   WPA2, observes bounded RSN M3 and the existing secure supplicant's real
+   matching M4 TX ACK (epoch/replay mbuf token), and requires successful
+   CCMP PTK/GTK+replay setup before process-context firmware authorization.
+   Only then are net80211 node authorization and link-up published.
+   Pairwise/group flags alone are NOT completion. Firmware error, key
+   error/delete, explicit node_unauthorize and disconnect close the host
+   port; deferred-state teardown accepts ASSOC without a fake AUTHORIZED.
+   net80211 iv_port_authorize is optional/non-sleeping; other drivers keep
+   their old behavior. BSD supplicant has no station set_supp_port callback;
+   MLME_AUTHORIZE remains HOSTAP/WDS-only. M3 observation does NOT validate
+   its MIC; the user-configured supplicant remains the authenticator.
+   qwz.c key/replay-before-authorization ordering guided this implementation.
+   Local policy sanitizer tests are not packet/firmware proof. Validate
+   real install failures, lost/stale M4 ACKs, same-key M3 retries, fresh
+   pairwise rekeys, GTK rotation, unauthorize and reconnect on hardware.
+   Key mutation closes the port, fences/drains host preparation/dequeue and
+   purges queued old-key skbs; ath12k then pauses DP entries and waits for
+   actual published TX completion before real key/replay changes. Timeout
+   fails closed. Concurrency/DMA lifetime is compiled, not runtime-proven.
+   Baseline: WPA2-CCMP, PTK slot0/GTK slots1-3, no MFP/SAE/TKIP/GTK slot0.
+   Supplicant COMPLETED still is not firmware key-install/replay proof.
+
+5. Callback adapter audit, not an ath12k showstopper by itself:
+   linux_80211_macops.c lkpi_80211_mo_vif_cfg_changed guards its invocation
+   with ops->link_info_changed instead of ops->vif_cfg_changed. ath12k has
+   BOTH today; repair separately with callback-presence regression tests.
+   lkpi_bss_info_change already splits VIF and link changes, so do not add
+   another bss_info_changed shim or duplicate BSS_CHANGED_ASSOC delivery.
+
+6. Regulatory and packet boundaries must fail closed:
+   Checked ordered firmware channel-list/power command submission and exact
+   country/rule lifetime/enforcement must precede VAP admission/scan/TX.
+   This protocol has NO separate channel-list firmware ACK. Validate native
+   half-dBm ni_txpower -> Linux dBm conversion and hardware floor/clamp.
+   reg.c now calls linuxkpi_regulatory_set_tx_ready with the EXACT published
+   snapshot after successful ordered channel/EIRP/power submission. Parent
+   must apply/reconcile native-regulatory-followup.patch: atomic terminal
+   revoke/pending/readiness CAS, start-before-final-VAP-admission ordering
+   and strict no-autonomous-11d guard. No build or country text substitutes
+   for RF enforcement proof. Changed rules revoke TX and queue scan/VDEV
+   quiesce; verify actual completion, then teardown/re-register, not an
+   in-place replacement. Initial policy permits eligible 20MHz 2.4/5GHz,
+   excluding
+   NO_IR/DFS/indoor/PSD rules; it is not general 6GHz/DFS regulatory support.
+   wifi7 datapath TX -> ieee80211_tx_status_ext and RX ->
+   ieee80211_rx_napi/linuxkpi_ieee80211_rx must preserve node/skb ownership,
+   encryption/decryption, replay flags, EAPOL/control-port and Ethernet
+   decapsulation semantics. Existing callbacks alone are not packet proof.
+   RX/TX/IRQ/DMA teardown and failed channel/peer/key operations need tested
+   unwind, not success-returning stubs.
+
+Native hardware now registers a WLAN and completes repeated scans with received
+results and clean teardown, using a temporary driver linked privately with the
+corrected MHI implementation. Ordinary shared-kernel integration and the
+firmware-managed regulatory metadata fix still need a corrected-kernel boot.
+Evidence still absent: WPA2 association/key ordering, DHCP/ARP/IPv4 traffic,
+and an OpenBSD live comparison/performance baseline. A selected test network
+and securely configured supplicant are required; fixtures are not that proof.
+EOF
+}
+
+os_name() { /usr/bin/uname -s; }
+guest_hostname() { /bin/hostname; }
+sysctl_read() { /sbin/sysctl -n "$1"; }
+interface_read() { /sbin/ifconfig "$1"; }
+interfaces_read() { /sbin/ifconfig -a inet; }
+supplicant_read()
+{
+	/usr/bin/timeout 5 /usr/sbin/wpa_cli -i "$iface" status
+}
+scan_once()
+{
+	/usr/bin/timeout 30 /sbin/ifconfig "$iface" scan
+}
+route_read()
+{
+	/usr/sbin/setfib 0 /sbin/route -n get -inet "$gateway"
+}
+ping_router()
+{
+	# -r disallows falling back through a default gateway; -S binds source.
+	/usr/sbin/setfib 0 /sbin/ping -n -r -S "$source" -c 2 -t 5 "$gateway"
+}
+arp_read() { /usr/sbin/arp -n "$gateway"; }
+epoch_now() { /bin/date -u +%s; }
+lease_expiry() { /bin/date -ju -f '%Y/%m/%d %H:%M:%S' "$1" +%s; }
+lease_read()
+{
+	lease=/var/db/dhclient.leases."$iface"
+	[ -f "$lease" ] && [ ! -L "$lease" ] ||
+	    fail "A regular native dhclient lease file is required"
+	ownership=$(/usr/bin/stat -f '%u %Lp' "$lease") ||
+	    fail "Cannot verify lease ownership"
+	set -- $ownership
+	[ "$#" -eq 2 ] && [ "$1" = 0 ] ||
+	    fail "Lease file must be root owned"
+	case "$2" in
+	*[!0-7]*|'') fail "Invalid lease permissions" ;;
+	esac
+	[ "$((0$2 & 022))" -eq 0 ] ||
+	    fail "Lease file must not be group/world writable"
+	/bin/cat "$lease"
+}
+
+guard_guest()
+{
+	[ "$(os_name)" = FreeBSD ] || fail "FreeBSD guest only"
+	[ "$(guest_hostname)" = ath12k-lab ] || fail "Guest hostname must be ath12k-lab"
+	[ "$(sysctl_read kern.ident)" = ATH12KLAB ] || fail "Kernel must be ATH12KLAB"
+	[ "$(sysctl_read kern.vm_guest)" = bhyve ] || fail "Guest must be bhyve"
+}
+
+guard_interface()
+{
+	case "$iface" in
+	wlan*) unit=${iface#wlan} ;;
+	*) fail "Specify a native wlanN interface, never em/ue/tap/wifibox" ;;
+	esac
+	case "$unit" in ''|*[!0-9]*) fail "Interface must be wlan followed by digits" ;; esac
+	parent=$(sysctl_read "net.wlan.$unit.%parent") ||
+	    fail "No authoritative native WLAN parent mapping"
+	case "$parent" in
+	ath12k_wifi7*) radio=${parent#ath12k_wifi7} ;;
+	*) fail "WLAN parent is not native ath12k" ;;
+	esac
+	case "$radio" in ''|*[!0-9]*) fail "Invalid ath12k parent unit" ;; esac
+	[ "$(sysctl_read "dev.ath12k_wifi7.$radio.%driver")" = ath12k_wifi7 ] ||
+	    fail "Parent is not an attached ath12k driver"
+	ifstate=$(interface_read "$iface") || fail "Native WLAN is absent"
+	printf '%s\n' "$ifstate" | grep -Eq 'regdomain [^[:space:]]+.*country [A-Z0-9]+' ||
+	    fail "No readable regulatory metadata (metadata alone is NOT readiness)"
+	echo "Guest and native WLAN identity verified; regulatory metadata present."
+}
+
+guard_ready()
+{
+	[ "$reviewed" = yes ] && [ "$wmi" = yes ] &&
+	    [ "$data" = yes ] && [ "$reg" = yes ] ||
+	    fail "Active checks need parent review and explicit WMI INIT/datapath/regulatory attestations"
+	echo "Readiness is OPERATOR-ATTESTED; capability events alone are insufficient."
+}
+
+field()
+{
+	# Require exactly one unambiguous key; never print whole supplicant status.
+	awk -F= -v key="$1" '$1 == key { n++; v=substr($0,length(key)+2) }
+	    END { if (n != 1) exit 1; print v }'
+}
+
+check_status()
+{
+	ifstate=$(interface_read "$iface") || fail "Cannot query WLAN status"
+	printf '%s\n' "$ifstate" | grep -Eq '^[[:space:]]*status: associated[[:space:]]*$' ||
+	    fail "WLAN is not associated"
+	state=$(supplicant_read 2>/dev/null) || fail "Cannot query existing secure supplicant"
+	[ "$(printf '%s\n' "$state" | field mode)" = station ] ||
+	    fail "Supplicant is not in station mode"
+	[ "$(printf '%s\n' "$state" | field wpa_state)" = COMPLETED ] ||
+	    fail "Supplicant handshake is incomplete"
+	[ "$(printf '%s\n' "$state" | field pairwise_cipher)" = CCMP ] &&
+	    [ "$(printf '%s\n' "$state" | field group_cipher)" = CCMP ] ||
+	    fail "Both pairwise and group ciphers must be CCMP"
+	case "$(printf '%s\n' "$state" | field key_mgmt)" in
+	WPA2-PSK|WPA2-EAP) ;;
+	*) fail "Require WPA2-PSK or WPA2-EAP" ;;
+	esac
+	echo "Associated WPA2-CCMP supplicant status verified (not firmware crypto proof)."
+}
+
+valid_ipv4()
+{
+	printf '%s\n' "$1" | awk -F. '
+	    NF != 4 { exit 1 }
+	    { for (i=1;i<=4;i++)
+	        if ($i !~ /^[0-9]+$/ || length($i)>3 || $i>255 ||
+	            (length($i)>1 && substr($i,1,1)=="0")) exit 1
+	      if ($1==0 || $1==127 || $1>=224 || $4==0 || $4==255) exit 1 }'
+}
+
+check_lease()
+{
+	valid_ipv4 "$source" && valid_ipv4 "$gateway" && [ "$source" != "$gateway" ] ||
+	    fail "Provide distinct canonical unicast WLAN source/router IPv4 addresses"
+	# Only the last complete lease is evidence; never fall back to an old one.
+	leases=$(lease_read) || fail "Cannot read trusted native DHCP lease"
+	record=$(printf '%s\n' "$leases" | awk '
+	    /^[[:space:]]*lease[[:space:]]*\{/ { inside=1; i=a=m=r=e=""; next }
+	    inside && $1=="interface" { i=$2; gsub(/[";]/,"",i) }
+	    inside && $1=="fixed-address" { a=$2; sub(/;$/,"",a) }
+	    inside && $1=="option" && $2=="subnet-mask" { m=$3; sub(/;$/,"",m) }
+	    inside && $1=="option" && $2=="routers" { r=$3; sub(/[,;].*$/,"",r) }
+	    inside && $1=="expire" { e=$3 " " $4; sub(/;$/,"",e) }
+	    inside && /^[[:space:]]*}/ { last=i "|" a "|" m "|" r "|" e; inside=0 }
+	    END { if (inside || last=="") exit 1; print last }') ||
+	    fail "Cannot parse an existing complete DHCP lease"
+	oldifs=$IFS
+	IFS='|'
+	read -r lease_if lease_addr mask lease_router expires <<EOF
+$record
+EOF
+	IFS=$oldifs
+	[ "$lease_if" = "$iface" ] && [ "$lease_addr" = "$source" ] &&
+	    [ "$lease_router" = "$gateway" ] || fail "Latest DHCP lease does not match this WLAN/source/router"
+	expiry=$(lease_expiry "$expires" 2>/dev/null) || fail "Invalid DHCP expiry"
+	now=$(epoch_now) || fail "Cannot obtain current time"
+	[ "$expiry" -gt "$now" ] || fail "DHCP lease has expired"
+	# Require a contiguous mask and on-link router; compute expected ifconfig mask.
+	hexmask=$(awk -v s="$source" -v g="$gateway" -v m="$mask" 'BEGIN {
+	    if (split(s,a,".")!=4 || split(g,b,".")!=4 || split(m,c,".")!=4) exit 1
+	    zero=0; hosta=hostb=0; ones=0
+	    for (i=1;i<=4;i++) {
+	        if (c[i] !~ /^[0-9]+$/ || c[i]>255) exit 1
+	        printf "%02x", c[i]
+	        for (bit=128;bit>=1;bit/=2) {
+	            mb=int(c[i]/bit)%2; sa=int(a[i]/bit)%2; gb=int(b[i]/bit)%2
+	            if (mb) { if (zero || sa!=gb) exit 1; ones++ }
+	            else { zero=1; hosta+=sa; hostb+=gb }
+	        }
+	    }
+	    if (ones<1 || ones>30 || hosta==0 || hostb==0 ||
+	        hosta==32-ones || hostb==32-ones) exit 1
+	    print ""
+	}') || fail "DHCP mask/router is not an ordinary directly attached IPv4 subnet"
+	printf '%s\n' "$ifstate" | awk -v s="$source" -v m="0x$hexmask" '
+	    $1=="inet" && $2==s && $3=="netmask" && $4==m { n++ }
+	    END { exit n!=1 }' || fail "DHCP address/mask is not assigned to this WLAN"
+	interfaces_read | awk -v s="$source" -v iface="$iface" '
+	    /^[^[:space:]]/ { current=$1; sub(/:$/,"",current) }
+	    $1=="inet" && $2==s { n++; if (current!=iface) bad=1 }
+	    END { exit n!=1 || bad }' ||
+	    fail "Source address is not unique to the native WLAN"
+	echo "Existing unexpired DHCP lease/address/mask verified; no DHCP client was run."
+}
+
+check_route()
+{
+	route=$(route_read 2>/dev/null) || fail "Cannot query router route in FIB 0"
+	printf '%s\n' "$route" | awk -v iface="$iface" '
+	    $1=="interface:" { n++; if ($2!=iface) bad=1 }
+	    $1=="flags:" && $0 ~ /GATEWAY/ { bad=1 }
+	    END { exit n!=1 || bad }' ||
+	    fail "DHCP router route is not directly attached to this WLAN in FIB 0"
+}
+
+check_ipv4()
+{
+	check_status
+	check_lease
+	check_route
+	ping_router >/dev/null 2>&1 || fail "Source-bound on-link WLAN router IPv4 echo failed"
+	# Detect changed route/interface/handshake around the active probe.
+	guard_interface
+	check_status
+	check_lease
+	check_route
+	arp=$(arp_read 2>/dev/null) || fail "Cannot query DHCP router ARP"
+	printf '%s\n' "$arp" | awk -v ip="($gateway)" -v iface="$iface" '
+	    $2==ip && $3=="at" && split($4,mac,":")==6 {
+	        valid=1
+	        for (i=1;i<=6;i++)
+	            if (mac[i] !~ /^[0-9a-fA-F][0-9a-fA-F]$/) valid=0
+	        for (i=5;i<NF;i++)
+	            if (valid && $i=="on" && $(i+1)==iface) ok=1
+	    } END { exit !ok }' || fail "No complete DHCP router ARP entry on the WLAN"
+	echo "PASS: observed WLAN DHCP lease, WPA2-CCMP status, router ARP and source-bound on-link IPv4."
+}
+
+station_main()
+{
+	iface= check=preflight source= gateway=
+	reviewed=no wmi=no data=no reg=no
+	while [ "$#" -gt 0 ]; do
+		case "$1" in
+		--help|-h) usage; return 0 ;;
+		--blockers) blockers; return 0 ;;
+		--interface|--check|--source|--gateway)
+			[ "$#" -ge 2 ] || fail "Missing option value"
+			case "$1" in
+			--interface) iface=$2 ;; --check) check=$2 ;;
+			--source) source=$2 ;; --gateway) gateway=$2 ;;
+			esac
+			shift ;;
+		--reviewed) reviewed=yes ;;
+		--wmi-init-ready) wmi=yes ;;
+		--datapath-ready) data=yes ;;
+		--regulatory-ready) reg=yes ;;
+		*) fail "Unknown option (use --help); credentials/network names are not accepted" ;;
+		esac
+		shift
+	done
+	case "$check" in preflight|status|scan|ipv4) ;; *) fail "Unknown check" ;; esac
+	guard_guest
+	guard_interface
+	case "$check" in
+	preflight)
+		echo "PREFLIGHT ONLY: no WMI INIT, datapath or regulatory readiness inferred; no scan/auth/TX attempted." ;;
+	status) check_status ;;
+	scan)
+		guard_ready
+		scan_once >/dev/null 2>&1 || fail "Bounded native scan failed"
+		echo "Scan command completed; no AP selected/results logged; this does not prove association." ;;
+	ipv4) guard_ready; check_ipv4 ;;
+	esac
+}
+
+# Main entry point. Tests load the definitions above, never a production bypass.
+station_main "$@"
