+	CHECK(mhi_lab_htc_connect(&htc, ATH12K_HTC_SVC_ID_HTT_DATA_MSG, packet) ==
+	    EPROTO && htc.pending_service == 0x300);
+	memset(packet, 0, sizeof(packet));
