+int ath12k_wifi7_dp_tx(struct ath12k_pdev_dp *dp_pdev, struct ath12k_link_vif *arvif,
+		     struct sk_buff *skb, bool gsn_valid, int mcbc_gsn,
+		     bool is_mcast)
+{
+#ifdef __FreeBSD__
+	struct ath12k_dp *dp = dp_pdev->dp;
+	int ret;
+
+	spin_lock_bh(&dp->native_lock);
+	if (dp->native_stopping || dp->native_tx_paused ||
+	    !dp->native_setup || !dp->native_htt_ready) {
+		spin_unlock_bh(&dp->native_lock);
+		return -ESHUTDOWN;
+	}
+	atomic_inc(&dp->native_tx_users);
+	spin_unlock_bh(&dp->native_lock);
+	ret = ath12k_wifi7_dp_tx_submit(dp_pdev, arvif, skb, gsn_valid,
+				       mcbc_gsn, is_mcast);
+	spin_lock_bh(&dp->native_lock);
+	if (atomic_dec_and_test(&dp->native_tx_users))
+		wake_up(&dp->native_tx_wait);
+	spin_unlock_bh(&dp->native_lock);
+	return ret;
+#else
+	return ath12k_wifi7_dp_tx_submit(dp_pdev, arvif, skb, gsn_valid,
+					mcbc_gsn, is_mcast);
+#endif
+}
