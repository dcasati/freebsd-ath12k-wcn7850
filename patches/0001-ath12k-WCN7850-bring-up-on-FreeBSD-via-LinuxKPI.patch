+CTASSERT(sizeof(struct lkpi_mhi_event_context) == 44);
+CTASSERT(sizeof(struct lkpi_mhi_command_context) == 44);
+CTASSERT(sizeof(struct lkpi_mhi_tre) == 16);
+
+struct lkpi_mhi_dma {
+	bus_dma_tag_t tag;
+	bus_dmamap_t map;
+	void *vaddr;
+	bus_addr_t address;
+	size_t size;
