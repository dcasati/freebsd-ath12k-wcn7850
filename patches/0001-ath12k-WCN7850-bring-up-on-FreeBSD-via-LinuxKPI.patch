+int ath12k_dp_native_bind(struct ath12k_dp *dp,
+			 int (*quiesce)(struct ath12k_base *),
+			 int (*irq_ready)(struct ath12k_base *))
+{
+	if (!dp || !dp->ab || !quiesce || !irq_ready)
+		return -EINVAL;
+	if (dp->native_resources || dp->native_published || dp->native_quarantined)
+		return -EBUSY;
+	dp->native_quiesce = quiesce;
+	dp->native_irq_ready = irq_ready;
+	spin_lock_init(&dp->native_lock);
+	atomic_set(&dp->native_tx_users, 0);
+	init_waitqueue_head(&dp->native_tx_wait);
+	return 0;
+}
+
+bool ath12k_dp_dma_owned(struct ath12k_base *ab)
+{
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+
+	return dp && (dp->native_published || dp->native_quarantined);
+}
+
+static int ath12k_dp_tx_wait_idle(struct ath12k_dp *dp)
+{
+	if (!wait_event_timeout(dp->native_tx_wait,
+				!atomic_read(&dp->native_tx_users),
+				msecs_to_jiffies(1000)))
+		return -EBUSY;
+	/* Pair with the final submitter's wakeup before its owner is freed. */
+	spin_lock_bh(&dp->native_lock);
+	spin_unlock_bh(&dp->native_lock);
+	return 0;
+}
+
+int ath12k_dp_tx_pause(struct ath12k_base *ab)
+{
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+	int ret;
+
+	if (!dp || !dp->native_setup || !dp->native_quiesce)
+		return -ESHUTDOWN;
+	spin_lock_bh(&dp->native_lock);
+	if (dp->native_stopping || dp->native_quarantined || dp->native_tx_paused) {
+		spin_unlock_bh(&dp->native_lock);
+		return -EBUSY;
+	}
+	dp->native_tx_paused = true;
+	spin_unlock_bh(&dp->native_lock);
+	ret = ath12k_dp_tx_wait_idle(dp);
+	spin_lock_bh(&dp->native_lock);
+	if (dp->native_stopping || dp->native_quarantined)
+		ret = -ESHUTDOWN;
+	else if (ret)
+		dp->native_tx_paused = false;
+	spin_unlock_bh(&dp->native_lock);
+	return ret;
+}
+
+void ath12k_dp_tx_resume(struct ath12k_base *ab)
+{
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+
+	if (!dp || !dp->native_setup || !dp->native_quiesce)
+		return;
+	spin_lock_bh(&dp->native_lock);
+	if (!dp->native_stopping && !dp->native_quarantined)
+		dp->native_tx_paused = false;
+	spin_unlock_bh(&dp->native_lock);
+}
+
+int ath12k_dp_dma_quiesce(struct ath12k_base *ab)
+{
+#ifdef __FreeBSD__
+	struct ath12k_dp *dp = ath12k_ab_to_dp(ab);
+	int ret;
+
+	if (!dp || !dp->native_published)
+		return 0;
+	if (!dp->native_quiesce)
+		return -EOPNOTSUPP;
+	spin_lock_bh(&dp->native_lock);
+	dp->native_stopping = true;
+	spin_unlock_bh(&dp->native_lock);
+	/* A submitter can still be DMA-mapping or unwinding before reaching
+	 * its TCL lock. Keep its descriptor owner alive through the entire call.
+	 */
+	if (ath12k_dp_tx_wait_idle(dp)) {
+		dp->native_quarantined = true;
+		return -EBUSY;
+	}
+	ret = dp->native_quiesce(ab);
+	if (ret) {
+		dp->native_quarantined = true;
+		ath12k_warn(ab, "DP reset unconfirmed; retaining all DMA: %d\n", ret);
+		return ret;
+	}
+	dp->native_published = false;
+	dp->native_quarantined = false;
+	dp->native_reset = true;
+	dp->native_setup = false;
+	dp->native_htt_ready = false;
+	dp->native_cc = false;
+	dp->native_reo = false;
+	dp->native_reo_hw = false;
+	dp->native_rx_posted = 0;
+#endif
+	return 0;
