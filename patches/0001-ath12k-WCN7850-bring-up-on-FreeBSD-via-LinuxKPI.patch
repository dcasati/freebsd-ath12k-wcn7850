+bool
+linuxkpi_ieee80211_sta_tx_permitted(struct ieee80211_hw *hw,
+    struct ieee80211_sta *sta, struct sk_buff *skb)
+{
+	struct ieee80211_node *ni;
+	struct lkpi_sta *lsta;
+	struct mbuf *m;
+
+	if (!ieee80211_hw_check(hw, LKPI_STA_WPA2))
+		return (true);
+	if (skb == NULL || skb->m == NULL)
+		return (false);
+	m = skb->m;
+	ni = m->m_pkthdr.PH_loc.ptr;
+	if (ni == NULL || ni->ni_drv_data == NULL)
+		return (false);
+	lsta = ni->ni_drv_data;
+	if (lsta->hw != hw || (sta != NULL && STA_TO_LSTA(sta) != lsta))
+		return (false);
+	if (!lkpi_sta_tx_allowed(lsta, skb->m))
+		return (false);
+	if (m_tag_locate(m, MTAG_ABI_LKPI80211, LKPI80211_TAG_M4, NULL) != NULL)
+		return (lkpi_sta_m4_check(lsta, m));
+	return (true);
+}
