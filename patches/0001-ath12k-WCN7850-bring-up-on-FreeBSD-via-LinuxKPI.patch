+void ath12k_reg_revoke(struct ath12k_base *ab)
+{
+#ifdef __FreeBSD__
+	struct ath12k *ar;
+	int i;
+
+	/* Radios exist once registered; teardown drains WMI before freeing them. */
+	if (!test_bit(ATH12K_FLAG_REGISTERED, &ab->dev_flags))
+		return;
+	for (i = 0; i < ab->num_radios; i++) {
+		ar = ab->pdevs[i].ar;
+		if (ar && ath12k_ar_to_hw(ar)->wiphy->lkpi_regulatory_strict &&
+		    linuxkpi_regulatory_revoke(ath12k_ar_to_hw(ar)->wiphy))
+			queue_work(ab->workqueue, &ar->regd_update_work);
+	}
+#endif
+}
+
+#ifdef __FreeBSD__
+static int ath12k_reg_quiesce(struct ath12k *ar)
+{
+	struct ieee80211_hw *hw = ath12k_ar_to_hw(ar);
+	struct ath12k_link_vif *arvif;
+	struct ath12k_wmi_scan_cancel_arg cancel = {
+		.req_type = WLAN_SCAN_CANCEL_PDEV_ALL,
+		.scan_id = ATH12K_SCAN_ID,
+		.pdev_id = ar->pdev->pdev_id,
+	};
+	bool scanning;
+	int ret, error = 0;
+
+	wiphy_lock(hw->wiphy);
+	ieee80211_stop_queues(hw);
+	spin_lock_bh(&ar->data_lock);
+	scanning = ar->scan.state != ATH12K_SCAN_IDLE;
+	if (scanning)
+		reinit_completion(&ar->scan.completed);
+	spin_unlock_bh(&ar->data_lock);
+	if (scanning) {
+		ret = ath12k_wmi_send_scan_stop_cmd(ar, &cancel);
+		if (!ret && !wait_for_completion_timeout(&ar->scan.completed, 3 * HZ))
+			ret = -ETIMEDOUT;
+		if (ret)
+			error = ret;
+	}
+	if (ar->state_11d != ATH12K_11D_IDLE) {
+		if (ar->vdev_id_11d_scan == ATH12K_11D_INVALID_VDEV_ID)
+			ret = -EPROTO;
+		else
+			ret = ath12k_wmi_send_11d_scan_stop_cmd(ar, ar->vdev_id_11d_scan);
+		if (ret && !error)
+			error = ret;
+	}
+	ath12k_mac_drain_tx(ar);
+	list_for_each_entry(arvif, &ar->arvifs, list) {
+		if (!arvif->is_started)
+			continue;
+		/* Unlike channel-list submission, VDEV_STOP has a completion event. */
+		ret = ath12k_mac_vdev_stop(arvif);
+		if (ret) {
+			if (!error)
+				error = ret;
+		} else {
+			arvif->is_started = false;
+			arvif->is_up = false;
+		}
+	}
+	wiphy_unlock(hw->wiphy);
+	return error;
+}
+
+static int
+ath12k_reg_prepare_channel(const struct ieee80211_channel *channel,
+			  u32 min_power, u32 max_power,
+			  struct ath12k_wmi_channel_arg *ch)
+{
+	u32 allowed_flags = IEEE80211_CHAN_NO_HT40 |
+		IEEE80211_CHAN_NO_80MHZ | IEEE80211_CHAN_NO_160MHZ |
+		IEEE80211_CHAN_NO_EHT;
+
+	if ((channel->band != NL80211_BAND_2GHZ &&
+	     channel->band != NL80211_BAND_5GHZ) ||
+	    (channel->flags & ~allowed_flags) ||
+	    (channel->flags & IEEE80211_CHAN_NO_HT40) != IEEE80211_CHAN_NO_HT40 ||
+	    !(channel->flags & IEEE80211_CHAN_NO_80MHZ) ||
+	    !(channel->flags & IEEE80211_CHAN_NO_160MHZ))
+		return -EOPNOTSUPP;
+	if (channel->max_power < 1 || channel->max_power > 63 ||
+	    channel->max_reg_power != channel->max_power ||
+	    channel->max_antenna_gain < 0 || channel->max_antenna_gain > 63 ||
+	    min_power > (u32)channel->max_power ||
+	    max_power < (u32)channel->max_power)
+		return -ERANGE;
+
+	memset(ch, 0, sizeof(*ch));
+	ch->mhz = channel->center_freq;
+	ch->cfreq1 = channel->center_freq;
+	ch->minpower = min_power * 2;
+	ch->maxpower = channel->max_power * 2;
+	ch->maxregpower = channel->max_reg_power * 2;
+	ch->antennamax = channel->max_antenna_gain * 2;
+	/* HT/VHT may operate at 20 MHz; never advertise HE/EHT/6 GHz here. */
+	ch->allow_ht = true;
+	ch->allow_vht = true;
+	ch->phy_mode = channel->band == NL80211_BAND_2GHZ ?
+		MODE_11NG_HT20 : MODE_11NA_HT20;
+	return 0;
+}
+
+static int ath12k_reg_submit_chan_list(struct ath12k *ar)
+{
+	struct ieee80211_hw *hw = ath12k_ar_to_hw(ar);
+	struct wiphy *wiphy = hw->wiphy;
+	const struct ieee80211_regdomain *published;
+	struct ath12k_wmi_scan_chan_list_arg *arg = NULL;
+	struct ieee80211_supported_band *sband;
+	struct ath12k_wmi_channel_arg *ch;
+	struct ieee80211_channel *channel, expected;
+	int power[2] = { INT_MAX, INT_MAX };
+	int band, i, n = 0, ret;
+
+	lockdep_assert_wiphy(wiphy);
+	ret = linuxkpi_regulatory_tx_pending(wiphy);
+	if (ret)
+		return ret;
+	if (ar->ah->num_radio != 1 || ar->ah->state == ATH12K_HW_STATE_RESTARTING) {
+		ret = -EOPNOTSUPP;
+		goto fail;
+	}
+	published = rcu_dereference_protected(wiphy->regd, 1);
+	if (!published) {
+		ret = -ENODATA;
+		goto fail;
+	}
+	for (band = 0; band < NUM_NL80211_BANDS; band++) {
+		sband = wiphy->bands[band];
+		if (!sband)
+			continue;
+		for (i = 0; i < sband->n_channels; i++)
+			if (!(sband->channels[i].flags & IEEE80211_CHAN_DISABLED))
+				n++;
+	}
+	if (!n || n > U16_MAX) {
+		ret = !n ? -ENODATA : -E2BIG;
+		goto fail;
+	}
+	arg = kzalloc_flex(*arg, channel, n);
+	if (!arg) {
+		ret = -ENOMEM;
+		goto fail;
+	}
+	arg->pdev_id = ar->pdev->pdev_id;
+	arg->nallchans = n;
+	ch = arg->channel;
+	for (band = 0; band < NUM_NL80211_BANDS; band++) {
+		sband = wiphy->bands[band];
+		if (!sband)
+			continue;
+		for (i = 0; i < sband->n_channels; i++) {
+			channel = &sband->channels[i];
+			if (channel->flags & IEEE80211_CHAN_DISABLED)
+				continue;
+			if ((band != NL80211_BAND_2GHZ && band != NL80211_BAND_5GHZ) ||
+			    channel->band != band) {
+				ret = -EOPNOTSUPP;
+				goto fail;
+			}
+			if (!ar->mac.sbands[band].channels ||
+			    channel->center_freq < KHZ_TO_MHZ(ar->freq_range.start_freq) ||
+			    channel->center_freq > KHZ_TO_MHZ(ar->freq_range.end_freq)) {
+				ret = -ERANGE;
+				goto fail;
+			}
+			ret = lkpi_regulatory_channel(published, channel, &expected);
+			if (ret || expected.flags != channel->flags ||
+			    expected.max_power != channel->max_power ||
+			    expected.max_reg_power != channel->max_reg_power ||
+			    expected.max_antenna_gain != channel->max_antenna_gain) {
+				ret = -ESTALE;
+				goto fail;
+			}
+			ret = ath12k_reg_prepare_channel(channel, ar->min_tx_power,
+							ar->max_tx_power, ch);
+			if (ret)
+				goto fail;
+			power[band] = min(power[band], channel->max_power);
+			ch++;
+		}
+	}
+	/*
+	 * qwz checks ordered WMI submission, not a nonexistent channel-list ACK.
+	 * A partial/chunked send or either PDEV power failure leaves TX revoked.
+	 */
+	ret = linuxkpi_regulatory_tx_pending(wiphy);
+	if (ret)
+		goto fail;
+	ret = ath12k_wmi_send_scan_chan_list_cmd(ar, arg);
+	if (ret)
+		goto fail;
+	for (band = NL80211_BAND_2GHZ; band <= NL80211_BAND_5GHZ; band++) {
+		if (power[band] == INT_MAX)
+			continue;
+		ret = linuxkpi_regulatory_tx_pending(wiphy);
+		if (ret)
+			goto fail;
+		ret = ath12k_wmi_pdev_set_param(ar,
+			band == NL80211_BAND_2GHZ ?
+			WMI_PDEV_PARAM_TXPOWER_LIMIT2G : WMI_PDEV_PARAM_TXPOWER_LIMIT5G,
+			power[band] * 2, ar->pdev->pdev_id);
+		if (ret)
+			goto fail;
+	}
+	ret = linuxkpi_regulatory_set_tx_ready(wiphy, published);
+	if (ret)
+		goto fail;
+	if (power[NL80211_BAND_2GHZ] != INT_MAX)
+		ar->txpower_limit_2g = power[NL80211_BAND_2GHZ] * 2;
+	if (power[NL80211_BAND_5GHZ] != INT_MAX)
+		ar->txpower_limit_5g = power[NL80211_BAND_5GHZ] * 2;
+	kfree(arg);
+	return 0;
+fail:
+	linuxkpi_regulatory_revoke(wiphy);
+	kfree(arg);
+	ath12k_warn(ar->ab, "strict regulatory submission failed: %d; TX revoked\n",
+		    ret);
+	return ret;
+}
