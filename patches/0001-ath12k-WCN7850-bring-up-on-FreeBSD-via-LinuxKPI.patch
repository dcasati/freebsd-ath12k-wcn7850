+#!/usr/bin/env python3
+"""Exercise production key-update draining and failure paths under sanitizers."""
+
+import pathlib
+import subprocess
+import tempfile
+
+from regulatory_production_test import function
+
+
+ROOT = pathlib.Path(__file__).resolve().parents[3]
+ATH12K = ROOT / "sys/contrib/dev/athk/ath12k"
+
+PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#ifndef __FreeBSD__
+#define __FreeBSD__ 1
+#endif
+#define LKPI_STA_WPA2 1
+enum set_key_cmd { SET_KEY, DISABLE_KEY };
+struct ieee80211_hw { bool gated; };
+struct ath12k_base { bool paused; };
+struct ath12k { struct ath12k_base *ab; struct ieee80211_hw *hw; };
+struct ath12k_link_vif { int unused; };
+struct ath12k_link_sta { int unused; };
+struct ieee80211_key_conf { int unused; };
+#define ath12k_ar_to_hw(a) ((a)->hw)
+#define ieee80211_hw_check(h,f) ((void)(f), (h)->gated)
+static char calls[8];
+static unsigned ncalls;
+static int pause_error, wait_error, key_error;
+static void record(char c)
+{ assert(ncalls + 1 < sizeof(calls)); calls[ncalls++] = c; }
+static int ath12k_dp_tx_pause(struct ath12k_base *ab)
+{
+    assert(!ab->paused); record('P');
+    ab->paused = pause_error == 0;
+    return pause_error;
+}
+static void ath12k_dp_tx_resume(struct ath12k_base *ab)
+{ assert(ab->paused); record('R'); ab->paused = false; }
+static int ath12k_mac_wait_tx_complete(struct ath12k *ar)
+{ assert(ar->ab->paused); record('W'); return wait_error; }
+static int ath12k_mac_set_key_locked(struct ath12k *ar, enum set_key_cmd cmd,
+    struct ath12k_link_vif *vif, struct ath12k_link_sta *sta,
+    struct ieee80211_key_conf *key)
+{
+    (void)cmd; (void)vif; (void)sta; (void)key;
+    assert(!ar->hw->gated || ar->ab->paused);
+    record('K'); return key_error;
+}
+"""
+
+TEST = r"""
+int main(void)
+{
+    struct ath12k_base ab = {};
+    struct ieee80211_hw hw = { .gated = true };
+    struct ath12k ar = { .ab = &ab, .hw = &hw };
+    struct ath12k_link_vif vif = {};
+    struct ath12k_link_sta sta = {};
+    struct ieee80211_key_conf key = {};
+    for (int command = SET_KEY; command <= DISABLE_KEY; command++) {
+        for (int group = 0; group < 2; group++) {
+            for (int scenario = 0; scenario < 5; scenario++) {
+                hw.gated = scenario != 4;
+                pause_error = scenario == 1 ? -1 : 0;
+                wait_error = scenario == 2 ? -2 : 0;
+                key_error = scenario == 3 ? -3 : 0;
+                memset(calls, 0, sizeof(calls)); ncalls = 0;
+                int ret = ath12k_mac_set_key(&ar, command, &vif,
+                    group ? NULL : &sta, &key);
+                assert(ret == (pause_error ? pause_error :
+                    wait_error ? wait_error : key_error));
+                assert(strcmp(calls, scenario == 1 ? "P" :
+                    scenario == 2 ? "PWR" :
+                    scenario == 4 ? "K" : "PWKR") == 0);
+                assert(!ab.paused);
+            }
+        }
+    }
+    puts("production key ordering: mandatory drain, PTK/GTK install/removal and failures passed");
+    return 0;
+}
+"""
+
+
+def main():
+    code = PRELUDE + function((ATH12K / "mac.c").read_text(),
+                              "ath12k_mac_set_key") + TEST
+    with tempfile.TemporaryDirectory(prefix="station-key-order-") as temp:
+        source = pathlib.Path(temp) / "test.c"
+        binary = pathlib.Path(temp) / "test"
+        source.write_text(code)
+        subprocess.run(
+            ["/usr/bin/cc", "-Wall", "-Wextra", "-Werror",
+             "-fsanitize=address,undefined", "-fno-sanitize-recover=all",
+             str(source), "-o", str(binary)], check=True)
+        subprocess.run([str(binary)], check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
