+static int
+mhi_board_test(void)
+{
+	uint8_t good[72] = { 0 }, data[128];
+	const uint8_t *selected;
+	size_t length;
+	unsigned int i;
+	int error = 0, expected;
+
+	memcpy(good, "QCA-ATH12K-BOARD", 17);
+	le32enc(good + 24, 44);
+	le32enc(good + 32, 5);
+	memcpy(good + 36, "wrong", 5);
+	le32enc(good + 48, 5);
+	memcpy(good + 52, "exact", 5);
+	le32enc(good + 60, 1);
+	le32enc(good + 64, 3);
+	memcpy(good + 68, "BDF", 3);
+	CHECK(mhi_lab_board_find(good, sizeof(good), 0, "exact",
+	    &selected, &length) == 0 && selected == good + 68 &&
+	    length == 3 && memcmp(selected, "BDF", 3) == 0);
+	CHECK(mhi_lab_board_find(good, sizeof(good), 0, "wrong",
+	    &selected, &length) == 0 && selected == good + 68);
+	CHECK(mhi_lab_board_find(good, sizeof(good), 0, "exac",
+	    &selected, &length) == ENOENT && selected == NULL && length == 0);
+	CHECK(mhi_lab_board_find(good, sizeof(good), 1, "exact",
+	    &selected, &length) == ENOENT);
+	for (i = 0; i < 8; i++) {
+		memcpy(data, good, sizeof(good));
+		length = sizeof(good);
+		expected = EPROTO;
+		switch (i) {
+		case 0: data[0] = 0; break;
+		case 1: le32enc(data + 24, UINT32_MAX); break;
+		case 2: le32enc(data + 32, UINT32_MAX); break;
+		case 3: le32enc(data + 64, 5); break;
+		case 4: length--; break;
+		case 5:
+			memcpy(data + 72, good + 20, 52);
+			length = 124;
+			expected = EEXIST;
+			break;
+		case 6:
+			data[72] = 0;
+			length++;
+			break;
+		case 7: le32enc(data + 64, 0); break;
+		}
+		CHECK(mhi_lab_board_find(data, length, 0, "exact", &selected,
+		    &length) == expected && selected == NULL && length == 0);
+	}
+	memcpy(data, good, sizeof(good));
+	le32enc(data + 20, 1);
+	CHECK(mhi_lab_board_find(data, sizeof(good), 1, "exact", &selected,
+	    &length) == 0 && selected == data + 68);
+out:
+	if (error == 0)
+		printf("lkpi_mhi_test: board/regdb magic, exact aliases, nested bounds, trailing corruption and ambiguous selection passed (model only)\n");
+	return (error);
+}
