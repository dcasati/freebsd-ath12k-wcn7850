+static void
+lkpi_80211_txq_tx_one(struct lkpi_sta *lsta, struct mbuf *m)
+{
+	struct ieee80211_node *ni;
+
+	if (!lkpi_sta_port_enabled(lsta)) {
+		lkpi_80211_txq_tx_one_body(lsta, m, false);
+		return;
+	}
+	ni = ieee80211_ref_node(lsta->ni);
+	/* Key updates hold wiphy while draining users; never wait as a user. */
+	wiphy_lock(lsta->hw->wiphy);
+	if (atomic_load_acq_int(&lsta->port_key_busy)) {
+		ieee80211_free_node(lsta->ni);
+		m_freem(m);
+	} else {
+		atomic_add_acq_int(&lsta->port_tx_users, 1);
+		lkpi_80211_txq_tx_one_body(lsta, m, true);
+		atomic_subtract_rel_int(&lsta->port_tx_users, 1);
+	}
+	wiphy_unlock(lsta->hw->wiphy);
+	ieee80211_free_node(ni);
 }
 
