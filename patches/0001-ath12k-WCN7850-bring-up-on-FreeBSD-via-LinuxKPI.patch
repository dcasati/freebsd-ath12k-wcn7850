diff --git a/sys/contrib/dev/athk/ath12k/qmi_native.c b/sys/contrib/dev/athk/ath12k/qmi_native.c
new file mode 100644
index 00000000..e10bd1d4
--- /dev/null
+++ b/sys/contrib/dev/athk/ath12k/qmi_native.c
@@ -0,0 +1,597 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/kernel.h>
+#include <sys/lock.h>
+#include <sys/malloc.h>
+#include <sys/mutex.h>
+#include <sys/sx.h>
+#include <sys/systm.h>
+#include <sys/taskqueue.h>
+#include <sys/time.h>
+
+#include <linux/jiffies.h>
+#include <linux/socket.h>
+#include "qmi_native.h"
+
+#define NATIVE_PACKET 8192
+#define NATIVE_QUEUE 32
+#define NATIVE_HOST 65536
+#define QRTR_CONTROL 0xfffffffeU
+#define QRTR_LOCAL_NODE 1
+#define QRTR_LOCAL_PORT 0x4000
+
+static MALLOC_DEFINE(M_ATH12KQMI, "ath12kqmi", "ath12k direct QMI");
+
+struct native_packet {
+	size_t length;
+	uint8_t data[NATIVE_PACKET];
+};
+
+struct ath12k_native_qmi {
+	struct mtx lock;
+	struct sx tx_lock;
+	struct task task;
+	struct qmi_handle *handle;
+	struct mhi_controller *ctrl;
+	struct qmi_txn *txn;
+	struct native_packet queue[NATIVE_QUEUE];
+	struct native_packet incoming;
+	uint8_t transmit[NATIVE_PACKET];
+	uint8_t decoded[NATIVE_HOST];
+	unsigned int read, write, queued, users;
+	uint32_t service, instance, node, port;
+	uint16_t next_id;
+	int error;
+	bool lookup, discovered, stopping, hello_sent, worker_active;
+};
+
+struct qmi_elem_info qmi_response_type_v01_ei[] = {
+	{ .data_type = QMI_UNSIGNED_2_BYTE, .elem_len = 1, .elem_size = 2,
+	  .offset = offsetof(struct qmi_response_type_v01, result) },
+	{ .data_type = QMI_UNSIGNED_2_BYTE, .elem_len = 1, .elem_size = 2,
+	  .offset = offsetof(struct qmi_response_type_v01, error) },
+	{ .data_type = QMI_EOTI },
+};
+
+static void
+native_cancel_locked(struct ath12k_native_qmi *native, int error)
+{
+	struct qmi_txn *txn = native->txn;
+
+	mtx_assert(&native->lock, MA_OWNED);
+	if (txn != NULL) {
+		txn->result = -error;
+		txn->done = true;
+		native->txn = NULL;
+		wakeup(txn);
+	}
+}
+
+static void
+native_txn_put_locked(struct ath12k_native_qmi *native, struct qmi_txn *txn)
+{
+	mtx_assert(&native->lock, MA_OWNED);
+	if (txn->active) {
+		txn->active = false;
+		txn->handle = NULL;
+		KASSERT(native->users != 0, ("QMI transaction reference underflow"));
+		native->users--;
+		wakeup(native);
+	}
+}
+
+static int
+native_submit(struct ath12k_native_qmi *native, size_t length)
+{
+	sbintime_t deadline = sbinuptime() + 5 * SBT_1S;
+	int error;
+	bool stopping;
+
+	sx_assert(&native->tx_lock, SA_XLOCKED);
+	do {
+		mtx_lock(&native->lock);
+		stopping = native->stopping || native->error != 0;
+		mtx_unlock(&native->lock);
+		if (stopping)
+			return (-ESHUTDOWN);
+		error = linuxkpi_mhi_submit(native->ctrl, 20, native->transmit, length);
+		if (error != -EBUSY)
+			return (error);
+		pause_sbt("qmiqueue", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	return (-ETIMEDOUT);
+}
+
+static void
+native_header(uint8_t *packet, uint32_t type, uint32_t node,
+    uint32_t port, uint32_t length)
+{
+	memset(packet, 0, 32);
+	le32enc(packet, 1);
+	le32enc(packet + 4, type);
+	le32enc(packet + 8, QRTR_LOCAL_NODE);
+	le32enc(packet + 12, type == 2 ? QRTR_CONTROL : QRTR_LOCAL_PORT);
+	le32enc(packet + 20, length);
+	le32enc(packet + 24, node);
+	le32enc(packet + 28, port);
+}
+
+static int
+native_control(struct ath12k_native_qmi *native, uint32_t type,
+    uint32_t node, uint32_t port)
+{
+	int error;
+
+	sx_xlock(&native->tx_lock);
+	memset(native->transmit, 0, 52);
+	native_header(native->transmit, type, node, port, 20);
+	le32enc(native->transmit + 32, type);
+	if (type == 7) {
+		le32enc(native->transmit + 36, QRTR_LOCAL_NODE);
+		le32enc(native->transmit + 40, QRTR_LOCAL_PORT);
+	}
+	error = native_submit(native, 52);
+	sx_xunlock(&native->tx_lock);
+	return (error);
+}
+
+/* Called under the MHI mutex: copy now; decode, ACK and callbacks later. */
+static int
+native_receive(void *arg, const void *data, size_t length)
+{
+	struct ath12k_native_qmi *native = arg;
+	struct native_packet *packet;
+	int error = 0;
+
+	mtx_lock(&native->lock);
+	if (native->stopping)
+		goto out;
+	if (length > NATIVE_PACKET || length < 16 ||
+	    native->queued == NATIVE_QUEUE) {
+		error = native->queued == NATIVE_QUEUE ? ENOBUFS : EMSGSIZE;
+		native->error = error;
+		native_cancel_locked(native, error);
+		taskqueue_enqueue(taskqueue_thread, &native->task);
+		goto out;
+	}
+	packet = &native->queue[native->write];
+	memcpy(packet->data, data, length);
+	packet->length = length;
+	native->write = (native->write + 1) % NATIVE_QUEUE;
+	native->queued++;
+	taskqueue_enqueue(taskqueue_thread, &native->task);
+out:
+	mtx_unlock(&native->lock);
+	return (error);
+}
+
+static int
+native_data(struct ath12k_native_qmi *native,
+    const struct ath12k_qmi_native_frame *frame)
+{
+	const uint8_t *body = frame->body;
+	size_t length = frame->length;
+	uint32_t node = frame->node, port = frame->port;
+	const struct qmi_msg_handler *handler;
+	struct sockaddr_qrtr source = {
+		.sq_family = AF_QIPCRTR, .sq_node = node, .sq_port = port,
+	};
+	struct qmi_txn *txn;
+	size_t size;
+	uint16_t id, message;
+	int error = 0;
+	unsigned int i;
+
+	if (length < 7 || le16dec(body + 5) != length - 7)
+		return (EPROTO);
+	id = le16dec(body + 1);
+	message = le16dec(body + 3);
+	mtx_lock(&native->lock);
+	if (!native->discovered || node != native->node || port != native->port) {
+		error = EPROTO;
+		goto out;
+	}
+	if (body[0] == 2) {
+		txn = native->txn;
+		/* A cancelled/late response never touches a retired stack txn. */
+		if (txn == NULL)
+			goto out;
+		error = -ath12k_qmi_native_reply(frame, native->node,
+		    native->port, txn, native->decoded, txn->dest_size);
+		if (error == ENOENT) {
+			error = 0;
+			goto out;
+		}
+		if (error == 0)
+			memcpy(txn->dest, native->decoded, txn->dest_size);
+		txn->result = -error;
+		txn->done = true;
+		native->txn = NULL;
+		wakeup(txn);
+		goto out;
+	}
+	handler = native->handle->handler;
+	for (i = 0; i < 64 && handler[i].fn != NULL; i++)
+		if (handler[i].type == QMI_INDICATION && handler[i].msg_id == message)
+			break;
+	if (i == 64) {
+		error = E2BIG;
+		goto out;
+	}
+	if (handler[i].fn == NULL)
+		goto out;
+	size = handler[i].decoded_size;
+	if (size > sizeof(native->decoded)) {
+		error = E2BIG;
+		goto out;
+	}
+	error = -ath12k_qmi_native_decode(handler[i].ei, body + 7,
+	    length - 7, native->decoded, size);
+	if (error != 0)
+		goto out;
+	mtx_unlock(&native->lock);
+	/* Taskqueue context; storage is owned by this single serialized task. */
+	handler[i].fn(native->handle, &source, NULL, native->decoded);
+	return (0);
+out:
+	if (error != 0)
+		printf("ath12k QMI: rejected message %#x flags=%#x txn=%u "
+		    "source=%u:%u expected=%u:%u discovered=%u error=%d\n",
+		    message, body[0], id, node, port, native->node, native->port,
+		    native->discovered, error);
+	mtx_unlock(&native->lock);
+	return (error);
+}
+
+static int
+native_packet(struct ath12k_native_qmi *native, const uint8_t *data, size_t length)
+{
+	struct ath12k_qmi_native_frame frame;
+	struct qmi_service service;
+	const uint8_t *body;
+	uint32_t type, node, port;
+	bool notify = false, reply = false, removed = false;
+	int error = 0;
+
+	error = -ath12k_qmi_native_frame_decode(data, length, &frame);
+	if (error != 0) {
+		hexdump(data, min_t(size_t, length, 32),
+		    "ath12k QMI: rejected QRTR header", HD_OMIT_CHARS);
+		return (error);
+	}
+	type = frame.type;
+	node = frame.node;
+	port = frame.port;
+	body = frame.body;
+	if (type == 1) {
+		error = native_data(native, &frame);
+		if (error == 0 && frame.confirm != 0)
+			error = -native_control(native, 7, node, port);
+		return (error);
+	}
+	if (type == 7)
+		return (0);
+	mtx_lock(&native->lock);
+	if (type == 2) {
+		if (!native->hello_sent) {
+			native->hello_sent = true;
+			reply = true;
+		}
+	} else if (native->lookup && le32dec(body + 4) == native->service &&
+	    le32dec(body + 8) == native->instance) {
+		service.node = le32dec(body + 12);
+		service.port = le32dec(body + 16);
+		if (service.node != node || service.port == 0 ||
+		    service.port >= QRTR_CONTROL ||
+		    (native->discovered &&
+		    (native->node != service.node || native->port != service.port))) {
+			error = EPROTO;
+		} else if (type == 5) {
+			native->discovered = false;
+			native_cancel_locked(native, ENXIO);
+			removed = true;
+		} else if (!native->discovered) {
+			native->node = service.node;
+			native->port = service.port;
+			native->discovered = true;
+			notify = true;
+		}
+	}
+	mtx_unlock(&native->lock);
+	if (reply)
+		error = -native_control(native, 2, node, QRTR_CONTROL);
+	if (notify && native->handle->ops.new_server != NULL)
+		error = -native->handle->ops.new_server(native->handle, &service);
+	if (removed && native->handle->ops.del_server != NULL)
+		native->handle->ops.del_server(native->handle, &service);
+	return (error);
+}
+
+static void
+native_work(void *arg, int pending __unused)
+{
+	struct ath12k_native_qmi *native = arg;
+	int error;
+
+	mtx_lock(&native->lock);
+	if (native->worker_active) {
+		mtx_unlock(&native->lock);
+		return;
+	}
+	native->worker_active = true;
+	mtx_unlock(&native->lock);
+	for (;;) {
+		mtx_lock(&native->lock);
+		if (native->queued == 0 || native->stopping || native->error != 0) {
+			native->worker_active = false;
+			mtx_unlock(&native->lock);
+			return;
+		}
+		memcpy(&native->incoming, &native->queue[native->read],
+		    sizeof(native->incoming));
+		native->read = (native->read + 1) % NATIVE_QUEUE;
+		native->queued--;
+		mtx_unlock(&native->lock);
+		error = native_packet(native, native->incoming.data,
+		    native->incoming.length);
+		if (error != 0) {
+			mtx_lock(&native->lock);
+			native->error = error;
+			native_cancel_locked(native, error);
+			native->worker_active = false;
+			mtx_unlock(&native->lock);
+			printf("ath12k QMI: native transport rejected packet: %d\n", error);
+			return;
+		}
+	}
+}
+
+static int
+native_lookup(struct qmi_handle *handle, uint32_t service,
+    uint32_t version, uint32_t instance)
+{
+	struct ath12k_native_qmi *native = handle->native;
+
+	if (service != 0x45 || version != 1 || instance > 0xffffff)
+		return (-EOPNOTSUPP);
+	mtx_lock(&native->lock);
+	native->service = service;
+	native->instance = (instance << 8) | version;
+	native->lookup = true;
+	mtx_unlock(&native->lock);
+	return (0);
+}
+
+static int
+native_txn_init(struct qmi_handle *handle, struct qmi_txn *txn,
+    const struct qmi_elem_info *ei, void *dest)
+{
+	struct ath12k_native_qmi *native = handle->native;
+	size_t size = ath12k_qmi_native_size(ei);
+	int error = 0;
+
+	if (ei == NULL || dest == NULL || size == 0 || size > NATIVE_HOST)
+		return (-EINVAL);
+	memset(txn, 0, sizeof(*txn));
+	mtx_lock(&native->lock);
+	if (native->stopping || native->error != 0 || !native->discovered)
+		error = -ENXIO;
+	else if (native->txn != NULL)
+		error = -EBUSY;
+	else if (native->next_id == UINT16_MAX)
+		error = -EOVERFLOW;
+	else {
+		txn->handle = handle;
+		txn->ei = ei;
+		txn->dest = dest;
+		txn->dest_size = size;
+		txn->id = ++native->next_id;
+		txn->active = true;
+		native->users++;
+		native->txn = txn;
+	}
+	mtx_unlock(&native->lock);
+	return (error);
+}
+
+static void
+native_txn_cancel(struct qmi_txn *txn)
+{
+	struct ath12k_native_qmi *native = txn->handle->native;
+
+	mtx_lock(&native->lock);
+	if (native->txn == txn)
+		native_cancel_locked(native, ECANCELED);
+	native_txn_put_locked(native, txn);
+	mtx_unlock(&native->lock);
+}
+
+static int
+native_txn_wait(struct qmi_txn *txn, uint64_t ticks)
+{
+	struct ath12k_native_qmi *native = txn->handle->native;
+	sbintime_t deadline;
+	int error = 0;
+
+	if (ticks == 0 || ticks > 30ULL * hz) {
+		native_txn_cancel(txn);
+		return (-EINVAL);
+	}
+	deadline = sbinuptime() + ticks * SBT_1S / hz;
+	mtx_lock(&native->lock);
+	while (!txn->done && native->txn == txn) {
+		error = msleep_sbt(txn, &native->lock, 0, "qmitxn", deadline,
+		    0, C_ABSOLUTE);
+		if (error != 0) {
+			native_cancel_locked(native, error == EWOULDBLOCK ?
+			    ETIMEDOUT : error);
+			break;
+		}
+	}
+	error = txn->done ? txn->result : -ECANCELED;
+	native_txn_put_locked(native, txn);
+	mtx_unlock(&native->lock);
+	return (error);
+}
+
+static int
+native_send(struct qmi_handle *handle, struct qmi_txn *txn, uint32_t message,
+    size_t maximum, const struct qmi_elem_info *ei, const void *request)
+{
+	struct ath12k_native_qmi *native = handle->native;
+	size_t length, total;
+	uint32_t node, port;
+	int error;
+
+	if (message > UINT16_MAX || maximum > NATIVE_PACKET - 39)
+		return (-EMSGSIZE);
+	sx_xlock(&native->tx_lock);
+	mtx_lock(&native->lock);
+	if (native->txn != txn || txn->sent || native->stopping ||
+	    !native->discovered || native->error != 0) {
+		mtx_unlock(&native->lock);
+		sx_xunlock(&native->tx_lock);
+		return (-ENXIO);
+	}
+	node = native->node;
+	port = native->port;
+	mtx_unlock(&native->lock);
+	memset(native->transmit, 0, sizeof(native->transmit));
+	error = ath12k_qmi_native_encode(ei, request, native->transmit + 39,
+	    maximum, &length);
+	if (error != 0)
+		goto out;
+	total = roundup2(39 + length, 4);
+	native_header(native->transmit, 1, node, port, 7 + length);
+	native->transmit[32] = 0;
+	le16enc(native->transmit + 33, txn->id);
+	le16enc(native->transmit + 35, message);
+	le16enc(native->transmit + 37, length);
+	mtx_lock(&native->lock);
+	if (native->txn != txn || txn->done) {
+		mtx_unlock(&native->lock);
+		error = -ECANCELED;
+		goto out;
+	}
+	txn->message = message;
+	txn->sent = true;
+	mtx_unlock(&native->lock);
+	error = native_submit(native, total);
+out:
+	sx_xunlock(&native->tx_lock);
+	return (error);
+}
+
+int
+ath12k_qmi_native_stop(struct qmi_handle *handle)
+{
+	struct ath12k_native_qmi *native = handle->native;
+	sbintime_t deadline;
+	int error = 0;
+
+	if (native == NULL)
+		return (0);
+	mtx_lock(&native->lock);
+	native->stopping = true;
+	native_cancel_locked(native, ESHUTDOWN);
+	mtx_unlock(&native->lock);
+	/* Caller must not hold the ath12k QMI event-workqueue mutex. */
+	taskqueue_drain(taskqueue_thread, &native->task);
+	sx_xlock(&native->tx_lock);
+	sx_xunlock(&native->tx_lock);
+	deadline = sbinuptime() + 5 * SBT_1S;
+	mtx_lock(&native->lock);
+	while (native->users != 0) {
+		error = msleep_sbt(native, &native->lock, 0, "qmiusers",
+		    deadline, 0, C_ABSOLUTE);
+		if (error != 0)
+			break;
+	}
+	mtx_unlock(&native->lock);
+	return (error != 0 ? -ETIMEDOUT : 0);
+}
+
+static void
+native_release(struct qmi_handle *handle)
+{
+	struct ath12k_native_qmi *native = handle->native;
+
+	if (ath12k_qmi_native_stop(handle) != 0) {
+		printf("ath12k QMI: retaining outstanding transaction owner\n");
+		return;
+	}
+	if (linuxkpi_mhi_set_receive(native->ctrl, NULL, NULL) != 0) {
+		printf("ath12k QMI: retaining receive owner until verified reset\n");
+		return;
+	}
+	sx_destroy(&native->tx_lock);
+	mtx_destroy(&native->lock);
+	free(native, M_ATH12KQMI);
+	handle->native = NULL;
+	handle->native_ops = NULL;
+}
+
+static const struct qmi_native_ops native_ops = {
+	.lookup = native_lookup,
+	.release = native_release,
+	.send = native_send,
+	.init = native_txn_init,
+	.cancel = native_txn_cancel,
+	.wait = native_txn_wait,
+};
+
+int
+ath12k_qmi_native_init(struct qmi_handle *handle, struct mhi_controller *ctrl,
+    size_t maximum, const struct qmi_ops *ops,
+    const struct qmi_msg_handler *handlers)
+{
+	struct ath12k_native_qmi *native;
+	int error;
+
+	if (handle->native != NULL || ctrl == NULL || ops == NULL ||
+	    handlers == NULL || maximum > NATIVE_PACKET)
+		return (-EINVAL);
+	native = malloc(sizeof(*native), M_ATH12KQMI, M_WAITOK | M_ZERO);
+	mtx_init(&native->lock, "ath12k QMI", NULL, MTX_DEF);
+	sx_init(&native->tx_lock, "ath12k QMI transmit");
+	TASK_INIT(&native->task, 0, native_work, native);
+	native->handle = handle;
+	native->ctrl = ctrl;
+	handle->ops = *ops;
+	handle->handler = handlers;
+	handle->native = native;
+	handle->native_ops = &native_ops;
+	error = linuxkpi_mhi_set_receive(ctrl, native_receive, native);
+	if (error != 0) {
+		handle->native = NULL;
+		handle->native_ops = NULL;
+		sx_destroy(&native->tx_lock);
+		mtx_destroy(&native->lock);
+		free(native, M_ATH12KQMI);
+	}
+	return (error);
+}
+
+int
+ath12k_qmi_native_hello(struct qmi_handle *handle)
+{
+	struct ath12k_native_qmi *native = handle->native;
+
+	if (native == NULL)
+		return (-ENXIO);
+	mtx_lock(&native->lock);
+	if (!native->lookup || native->error != 0) {
+		mtx_unlock(&native->lock);
+		return (-ENXIO);
+	}
+	native->stopping = false;
+	if (native->hello_sent) {
+		mtx_unlock(&native->lock);
+		return (0);
+	}
+	native->hello_sent = true;
+	mtx_unlock(&native->lock);
+	/* The exercised OpenBSD/WCN7850 link-local QRTR peer, not a socket route. */
+	return (native_control(native, 2, 7, QRTR_CONTROL));
+}
diff --git a/sys/contrib/dev/athk/ath12k/qmi_native.h b/sys/contrib/dev/athk/ath12k/qmi_native.h
