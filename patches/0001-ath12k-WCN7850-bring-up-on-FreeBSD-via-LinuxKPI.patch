+	    (!a->reg_rules_2g_ptr || !b->reg_rules_2g_ptr ||
+	     memcmp(a->reg_rules_2g_ptr, b->reg_rules_2g_ptr,
+		    a->num_2g_reg_rules * sizeof(*a->reg_rules_2g_ptr))))
+		return false;
+	if (a->num_5g_reg_rules &&
+	    (!a->reg_rules_5g_ptr || !b->reg_rules_5g_ptr ||
+	     memcmp(a->reg_rules_5g_ptr, b->reg_rules_5g_ptr,
+		    a->num_5g_reg_rules * sizeof(*a->reg_rules_5g_ptr))))
+		return false;
+	return true;
+}
