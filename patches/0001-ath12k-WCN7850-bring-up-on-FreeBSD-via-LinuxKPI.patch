+++ b/sys/contrib/dev/athk/ath12k/dp_cc.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef ATH12K_DP_CC_H
+#define ATH12K_DP_CC_H
+
+/* The caller supplies u32, u64 and errno definitions. */
+struct ath12k_dp_cc_layout {
+	u32 tx_pages;
+	u32 rx_pages;
+	u32 num_spt_pages;
+	u32 rx_ppt_base;
+	u32 ppt_entries;
+};
+
+/* Validate the complete PPT footprint, including the per-device RX offset,
+ * before allocating SPTs or publishing any of their DMA addresses.
+ */
+static inline int
+ath12k_dp_cc_layout_init(struct ath12k_dp_cc_layout *layout,
+			u32 rx_desc_count, u32 tx_desc_per_pool,
+			u32 tx_pools, u32 device_id,
+			u64 cmem_start, u64 cmem_size)
+{
+	struct ath12k_dp_cc_layout next;
+	u64 tx_pages, rx_base, entries, bytes;
+
+	if (!layout || !rx_desc_count || !tx_desc_per_pool || !tx_pools ||
+	    rx_desc_count % 512 || tx_desc_per_pool % 512)
+		return -EINVAL;
+
+	next.rx_pages = rx_desc_count / 512;
+	tx_pages = (u64)(tx_desc_per_pool / 512) * tx_pools;
+	rx_base = (u64)device_id * next.rx_pages;
+	entries = tx_pages + rx_base + next.rx_pages;
+	if (entries > 1024)
+		return -E2BIG;
+
+	bytes = entries * 4;
+	if (!cmem_start || cmem_start > 0xffffffffULL ||
+	    cmem_start % 4 || cmem_size < bytes ||
