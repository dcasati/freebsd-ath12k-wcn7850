+} while (0)
+
+static bool
+check_buffer(struct lkpi_mhi_dma *buffer, size_t alignment, bool zero)
+{
+	const uint8_t *bytes = buffer->vaddr;
+	size_t i;
+
+	if (buffer->vaddr == NULL || !buffer->loaded || !buffer->synced ||
+	    (buffer->address & (alignment - 1)) != 0 ||
+	    ((uintptr_t)buffer->vaddr & (MIN(alignment, PAGE_SIZE) - 1)) != 0 ||
+	    buffer->address > BUS_SPACE_MAXADDR_32BIT ||
+	    buffer->size - 1 > BUS_SPACE_MAXADDR_32BIT - buffer->address)
+		return (false);
+	bus_dmamap_sync(buffer->tag, buffer->map,
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	buffer->synced = false;
+	if (zero)
+		for (i = 0; i < buffer->size; i++)
+			if (bytes[i] != 0)
+				return (false);
+	return (true);
+}
+
+#define MHI_MODEL_REG_LEN	0xfe0
+
+struct mhi_boot_model {
+	uint32_t *regs;
+	uint32_t offsets[128], values[128], reply, bhie_reply;
+	unsigned int writes;
+	bool fail_read, hold_ee, hold_ee_event, ee_event_sent, reply_m3;
+};
+
+static int
+mhi_model_read(struct mhi_controller *ctrl, void *address, uint32_t *value)
+{
+	struct mhi_boot_model *model = ctrl->cntrl_dev->driver_data;
+	struct lkpi_mhi_context *context = ctrl->lkpi_context;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_event_ring *event;
+	struct lkpi_mhi_tre *tre;
+	uintptr_t offset = (uintptr_t)address - (uintptr_t)ctrl->regs;
+
+	if (model->fail_read || offset >= MHI_MODEL_REG_LEN)
+		return (-EIO);
+	*value = model->regs[offset / 4];
+	/* Publish after the boot wait has polled events, before its EE read. */
+	if (offset == 0x128 && *value == 2 && context != NULL &&
+	    context->published && !model->hold_ee_event &&
+	    !model->ee_event_sent) {
+		event = &context->event_rings[0];
+		if (!check_buffer(&context->events, 64, false) ||
+		    !check_buffer(&event->dma, event->dma.size, false))
+			return (-EIO);
+		events = context->events.vaddr;
+		tre = event->dma.vaddr;
+		tre[0].dword[0] = htole32(2U << 24);
+		tre[0].dword[1] = htole32(0x20U << 16);
+		tre[1].dword[0] = htole32(2U << 24);
+		tre[1].dword[1] = htole32(0x40U << 16);
+		events[0].rp = htole64(event->dma.address + 32);
+		model->ee_event_sent = true;
+	}
+	return (0);
+}
+
+static void
+mhi_model_write(struct mhi_controller *ctrl, void *address, uint32_t value)
+{
+	struct mhi_boot_model *model = ctrl->cntrl_dev->driver_data;
+	uintptr_t offset = (uintptr_t)address - (uintptr_t)ctrl->regs;
+
+	KASSERT(model->writes < nitems(model->offsets), ("extra BHI write"));
+	model->offsets[model->writes] = offset;
+	model->values[model->writes++] = value;
+	model->regs[offset / 4] = value;
+	if (offset == 0x118)
+		model->regs[0x12c / 4] = model->reply;
+	if (offset == LKPI_MHI_CTRL && (value & 0xff00) == 0x200)
+		model->regs[LKPI_MHI_STATUS / 4] = 0x200;
+	if (offset == LKPI_MHI_CTRL && (value & 0xff00) == 0x500 &&
+	    model->reply_m3)
+		model->regs[LKPI_MHI_STATUS / 4] = 0x500;
+	if (offset == 0x260) {
+		model->regs[0x268 / 4] = model->bhie_reply;
+		if ((model->bhie_reply >> 30) == 2 && !model->hold_ee)
+			model->regs[0x128 / 4] = 2;
+	}
+}
+
+static int
+mhi_boot_test(struct mhi_controller *ctrl)
+{
+	const uint32_t offsets[] = { 0x120, 0x12c, 0x10c, 0x108, 0x110, 0x118 };
+	const uint32_t bhie_replies[] = {
+		0x80000000, 0xc0000000, 0, 0x80000000, UINT32_MAX,
+		0x80000000
+	};
+	const int bhie_results[] = {
+		0, -EIO, -ETIMEDOUT, -ETIMEDOUT, -EIO, -ETIMEDOUT
+	};
+	struct mhi_boot_model model = { 0 };
+	struct lkpi_mhi_boot boot = { 0 };
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_event_ring *event;
+	struct lkpi_mhi_tre *tre;
+	struct lkpi_mhi_vector *vectors;
+	uint8_t *payload = NULL;
+	uint8_t data[64] = { 0x7f, 'E', 'L', 'F', 0x12, 0x34 };
+	sbintime_t start;
+	size_t length = LKPI_MHI_BHI_SIZE + 64;
+	unsigned int i, j, writes;
+	int expected, error = 0;
+
+	model.regs = malloc(MHI_MODEL_REG_LEN, M_TEMP, M_WAITOK | M_ZERO);
+	ctrl->regs = model.regs;
+	ctrl->reg_len = MHI_MODEL_REG_LEN;
+	ctrl->timeout_ms = 1;
+	ctrl->read_reg = mhi_model_read;
+	ctrl->write_reg = mhi_model_write;
+	ctrl->cntrl_dev->driver_data = &model;
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x10000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EINVAL);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x50;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EINVAL);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+	model.regs[LKPI_MHI_CTRL / 4] = 2;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EBUSY);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_CTRL / 4] = 0;
+	model.regs[0x128 / 4] = 2;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EBUSY);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[0x128 / 4] = 0;
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = UINT32_MAX;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EIO);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+	model.fail_read = true;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EIO);
+	CHECK(model.writes == 0 && boot.image.vaddr == NULL);
+	model.fail_read = false;
+	model.reply = 0x80000000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == 0);
+	CHECK(model.writes == nitems(offsets) &&
+	    memcmp(model.offsets, offsets, sizeof(offsets)) == 0);
+	CHECK(model.values[0] == 0 && model.values[1] == 0 &&
+	    model.values[2] == 0 && model.values[3] == boot.image.address &&
+	    model.values[4] == sizeof(data) && model.values[5] > 0 &&
+	    model.values[5] <= 0x3fffffff);
+	CHECK(boot.pending && check_buffer(&boot.image, 64, false) &&
+	    memcmp(boot.image.vaddr, data, sizeof(data)) == 0);
+	CHECK(linuxkpi_mhi_boot_free(&boot) == -EBUSY);
+	/* The model never performs DMA; simulate confirmed reset for cleanup. */
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0 && boot.image.vaddr == NULL);
+	model.writes = 0;
+	model.reply = 0xc0000000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == -EIO &&
+	    boot.pending);
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0);
+	model.writes = 0;
+	model.reply = 0;
+	start = sbinuptime();
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) ==
+	    -ETIMEDOUT && boot.pending);
+	CHECK(sbinuptime() - start >= SBT_1MS &&
+	    sbinuptime() - start < SBT_1S);
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0);
+	model.writes = 0;
+	model.reply = 0x80000000;
+	CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == 0);
+	CHECK(linuxkpi_mhi_alloc_context(ctrl,
+	    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+	context = ctrl->lkpi_context;
+	ctrl->nr_irqs = 3;
+	model.regs[0x2c / 4] = 0x224;
+	model.regs[0x18 / 4] = 0x400;
+	model.regs[0x20 / 4] = 0x800;
+	CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == -ETIMEDOUT &&
+	    !context->published && model.writes == 6);
+	model.regs[LKPI_MHI_STATUS / 4] = 0x101;
+	model.regs[0x128 / 4] = 1;
+	model.regs[0x18 / 4] = 0x10000;
+	CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == -EINVAL &&
+	    !context->published && model.writes == 6);
+	model.regs[0x18 / 4] = 0x400;
+	model.regs[0x10 / 4] = 0xffff55aa;
+	CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == 0 && context->published);
+	CHECK(model.regs[0x58 / 4] == context->channels.address &&
+	    model.regs[0x60 / 4] == context->events.address &&
+	    model.regs[0x68 / 4] == context->commands.address &&
+	    model.regs[0x88 / 4] == UINT32_MAX &&
+	    model.regs[0x10 / 4] == 0x255aa &&
+	    model.regs[0x7f8 / 4] == 1);
+	mhi_unprepare_after_power_down(ctrl);
+	CHECK(ctrl->lkpi_context == context);
+	CHECK(check_buffer(&context->events, 64, false));
+	event = &context->event_rings[0];
+	CHECK(check_buffer(&event->dma, event->dma.size, false));
+	events = context->events.vaddr;
+	tre = event->dma.vaddr;
+	tre[0].dword[0] = htole32(2U << 24);
+	tre[0].dword[1] = htole32(0x20U << 16);
+	tre[1].dword[0] = htole32(1U << 24);
+	tre[1].dword[1] = htole32(0x40U << 16);
+	events[0].rp = htole64(event->dma.address + 32);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == 0);
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(context->state == 2 && context->ee == 1 &&
+	    context->state_events == 1 && context->ee_events == 1 &&
+	    event->read_offset == 32 && event->write_offset == 16 &&
+	    le64toh(events[0].wp) == event->dma.address + 16);
+	events[0].rp = htole64(event->dma.address + 1);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == -EIO &&
+	    event->read_offset == 32);
+	context->event_error = 0;
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(check_buffer(&event->dma, event->dma.size, false));
+	event->read_offset = event->dma.size - 16;
+	event->write_offset = event->dma.size - 32;
+	tre[event->read_offset / 16] = tre[0];
+	tre[0] = tre[1];
+	events[0].rp = htole64(event->dma.address + 16);
+	events[0].wp = htole64(event->dma.address + event->write_offset);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == 0 &&
+	    event->read_offset == 16 && event->write_offset == 0 &&
+	    context->state_events == 2 && context->ee_events == 2);
+	CHECK(check_buffer(&context->events, 64, false));
+	CHECK(check_buffer(&event->dma, event->dma.size, false));
+	tre[1].dword[1] = htole32(0x99U << 16);
+	events[0].rp = htole64(event->dma.address + 32);
+	CHECK(linuxkpi_mhi_process_events(ctrl) == -EOPNOTSUPP &&
+	    event->read_offset == 16);
+	context->published = false;
+	linuxkpi_mhi_free_context(ctrl);
+	boot.pending = false;
+	CHECK(linuxkpi_mhi_boot_free(&boot) == 0);
+	payload = malloc(length, M_TEMP, M_WAITOK | M_ZERO);
+	payload[0] = 0x41;
+	payload[LKPI_MHI_BHI_SIZE] = 0x42;
+	payload[length - 1] = 0x43;
+	for (i = 0; i < nitems(bhie_replies); i++) {
+		memset(model.regs, 0, MHI_MODEL_REG_LEN);
+		model.writes = 0;
+		model.reply = 0x80000000;
+		model.bhie_reply = bhie_replies[i];
+		model.hold_ee = i == 3;
+		model.hold_ee_event = i == 5;
+		model.ee_event_sent = false;
+		model.regs[LKPI_MHI_BHI_OFFSET / 4] = 0x100;
+		CHECK(linuxkpi_mhi_alloc_context(ctrl,
+		    &ath12k_wifi7_mhi_config_wcn7850) == 0);
+		context = ctrl->lkpi_context;
+		CHECK(linuxkpi_mhi_boot_bhi(ctrl, &boot, data, sizeof(data)) == 0);
+		model.regs[0x2c / 4] = 0x224;
+		model.regs[0x18 / 4] = 0x400;
+		model.regs[0x20 / 4] = 0x800;
+		model.regs[LKPI_MHI_STATUS / 4] = 0x101;
+		model.regs[0x128 / 4] = 1;
+		CHECK(linuxkpi_mhi_boot_ready(ctrl, &boot) == 0);
+		writes = model.writes;
+		model.regs[0x2c / 4] = 0x400;
+		CHECK(linuxkpi_mhi_boot_bhie(ctrl, &boot, payload, length) ==
+		    -EINVAL && model.writes == writes && boot.segments == NULL);
+		model.regs[0x2c / 4] = 0x224;
+		model.regs[0x260 / 4] = 0x80000000;
+		expected = bhie_results[i];
+		ctrl->timeout_ms = expected == 0 ? 100 : 1;
+		start = sbinuptime();
+		CHECK(linuxkpi_mhi_boot_bhie(ctrl, &boot, payload, length) ==
+		    expected);
+		if (expected == 0)
+			CHECK(model.ee_event_sent && context->state == 2 &&
+			    context->ee == 2 && context->state_events == 1 &&
+			    context->ee_events == 1);
+		if (model.hold_ee_event)
+			CHECK(boot.ee == 2 && context->ee == 0);
+		if (expected == -ETIMEDOUT)
+			CHECK(sbinuptime() - start >= SBT_1MS &&
+			    sbinuptime() - start < SBT_1S);
+		if (model.hold_ee)
+			CHECK((boot.bhie_status >> 30) == 2 && boot.ee == 1);
+		CHECK(boot.pending && boot.num_segments == 2 &&
+		    boot.vectors.size == 2 * sizeof(*vectors) &&
+		    model.writes == writes + (expected == 0 ? 6 : 4) &&
+		    model.offsets[writes] == 0x254 &&
+		    model.offsets[writes + 1] == 0x250 &&
+		    model.offsets[writes + 2] == 0x258 &&
+		    model.offsets[writes + 3] == 0x260 &&
+		    model.values[writes] == 0 &&
+		    model.values[writes + 1] == boot.vectors.address &&
+		    model.values[writes + 2] == boot.vectors.size &&
+		    (model.values[writes + 3] & 0xc0000000) == 0x80000000 &&
+		    (model.values[writes + 3] & 0x3fffffff) != 0);
+		CHECK(check_buffer(&boot.vectors, 64, false));
+		vectors = boot.vectors.vaddr;
+		for (j = 0; j < boot.num_segments; j++) {
+			CHECK(check_buffer(&boot.segments[j], 64, false) &&
+			    boot.segments[j].size == (j == 0 ?
+			    LKPI_MHI_BHI_SIZE : 64) &&
+			    le64toh(vectors[j].address) == boot.segments[j].address &&
+			    le64toh(vectors[j].length) == boot.segments[j].size &&
+			    memcmp(boot.segments[j].vaddr,
+			    payload + j * LKPI_MHI_BHI_SIZE,
+			    boot.segments[j].size) == 0);
+		}
+		CHECK(linuxkpi_mhi_boot_free(&boot) == -EBUSY &&
+		    boot.num_segments == 2 && boot.image.vaddr != NULL);
+		context->published = false;
+		linuxkpi_mhi_free_context(ctrl);
+		boot.pending = false;
+		CHECK(linuxkpi_mhi_boot_free(&boot) == 0 &&
+		    boot.segments == NULL && boot.vectors.vaddr == NULL);
+	}
+out:
+	/* All context publication above targets the model, not the PCI device. */
+	if (ctrl->lkpi_context != NULL)
+		ctrl->lkpi_context->published = false;
+	linuxkpi_mhi_free_context(ctrl);
+	boot.pending = false;
+	linuxkpi_mhi_boot_free(&boot);
+	ctrl->cntrl_dev->driver_data = NULL;
+	ctrl->regs = NULL;
+	ctrl->read_reg = NULL;
+	ctrl->write_reg = NULL;
+	free(payload, M_TEMP);
+	free(model.regs, M_TEMP);
+	if (error == 0)
+		printf("lkpi_mhi_test: BHI MMIO bounds, write order, payload, errors, timeout and DMA retention passed (model only)\n");
+	if (error == 0)
+		printf("lkpi_mhi_test: READY/M0 publication, active-context protection, event decoding, wrap and corruption checks passed (model only)\n");
+	if (error == 0)
+		printf("lkpi_mhi_test: BHIE vector order, chunk payload/tail, doorbell preservation, AMSS, errors, timeout and DMA retention passed (model only)\n");
+	return (error);
+}
+
+static int
+mhi_model_event(struct mhi_controller *ctrl, unsigned int ring,
+    uint64_t pointer, uint32_t word0, uint32_t word1)
+{
+	struct lkpi_mhi_context *context = ctrl->lkpi_context;
+	struct lkpi_mhi_event_ring *event = &context->event_rings[ring];
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_tre *tre;
+
+	if (!check_buffer(&context->events, 64, false) ||
+	    !check_buffer(&event->dma, event->dma.size, false)) {
+		printf("lkpi_mhi_test: model event DMA ownership invalid\n");
+		return (-EINVAL);
+	}
+	events = context->events.vaddr;
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)event->dma.vaddr +
+	    event->read_offset);
+	tre->ptr = htole64(pointer);
+	tre->dword[0] = htole32(word0);
+	tre->dword[1] = htole32(word1);
+	events[ring].rp = htole64(event->dma.address +
+	    (event->read_offset + sizeof(*tre)) % event->dma.size);
+	return (linuxkpi_mhi_process_events(ctrl));
+}
+
+static int
+mhi_qmi_test(void)
+{
+	struct mhi_lab_qmi client = { 0 }, awaiting;
+	uint8_t advertisement[52] = { 0 }, request[52], response[124] = { 0 };
+	uint8_t good[124], v2[108] = { 0 };
+	unsigned int i;
+	int error = 0;
+
+	le32enc(advertisement, 1);
+	le32enc(advertisement + 4, 4);
+	le32enc(advertisement + 8, 7);
+	le32enc(advertisement + 12, 0xfffffffe);
+	le32enc(advertisement + 20, 20);
+	le32enc(advertisement + 24, 1);
+	le32enc(advertisement + 28, 0xfffffffe);
+	le32enc(advertisement + 32, 4);
+	le32enc(advertisement + 36, 0x45);
+	le32enc(advertisement + 40, 0x101);
+	le32enc(advertisement + 44, 7);
+	le32enc(advertisement + 48, 1);
+	CHECK(mhi_lab_qmi_receive(&client, advertisement, 52) == 0 &&
+	    client.service && client.node == 7 && client.port == 1);
+	CHECK(mhi_lab_qmi_request(&client, request, 0x123) == 0 &&
+	    le32dec(request + 20) == 7 && request[32] == 0 &&
+	    le16dec(request + 33) == 0x123 &&
+	    le16dec(request + 35) == 0x57 && le16dec(request + 37) == 0);
+	awaiting = client;
+	memcpy(response, request, 32);
+	le32enc(response + 8, 7);
+	le32enc(response + 12, 1);
+	le32enc(response + 16, 1);
+	le32enc(response + 20, 92);
+	le32enc(response + 24, 1);
+	le32enc(response + 28, 0x4000);
+	response[32] = 2;
+	le16enc(response + 33, 0x123);
+	le16enc(response + 35, 0x57);
+	le16enc(response + 37, 85);
+	response[39] = 2;
+	le16enc(response + 40, 4);
+	response[46] = 0x10;
+	le16enc(response + 47, 1);
+	response[49] = 2;
+	response[50] = 0x11;
+	le16enc(response + 51, 4);
+	le32enc(response + 53, 0xe0e6);
+	response[57] = 0x80;
+	le16enc(response + 58, 64);
+	response[123] = 0xa5;
+	memcpy(good, response, sizeof(good));
+	CHECK(mhi_lab_qmi_receive(&client, response, sizeof(response)) == 0 &&
+	    client.done && !client.pending && client.result == 0 &&
+	    client.error == 0 && client.phys == 2 && client.board == 0xe0e6 &&
+	    client.response_length == 92 && client.resume);
+	CHECK(mhi_lab_qmi_resume(&client, request) == 0 && !client.resume &&
+	    le32dec(request + 4) == 7 && le32dec(request + 24) == 7 &&
+	    le32dec(request + 28) == 1 && le32dec(request + 32) == 7 &&
+	    le32dec(request + 36) == 1 && le32dec(request + 40) == 0x4000);
+	for (i = 0; i < 10; i++) {
+		client = awaiting;
+		memcpy(response, good, sizeof(response));
+		switch (i) {
+		case 0: le16enc(response + 33, 0x124); break;
+		case 1: le32enc(response + 12, 2); break;
+		case 2: le16enc(response + 37, 86); break;
+		case 3: le16enc(response + 58, 65); break;
+		case 4: response[57] = 2; break;
+		case 5: response[39] = 0x81; break;
+		case 6: le32enc(response + 20, 93); break;
+		case 7: le16enc(response + 47, 2); break;
+		case 8: le16enc(response + 35, 0x24); break;
+		case 9: response[32] = 4; break;
+		}
+		CHECK(mhi_lab_qmi_receive(&client, response, sizeof(response)) ==
+		    EPROTO && !client.done && client.pending);
+	}
+	client = awaiting;
+	memcpy(response, good, sizeof(response));
+	le16enc(response + 42, 1);
+	le16enc(response + 44, 90);
+	CHECK(mhi_lab_qmi_receive(&client, response, sizeof(response)) == 0 &&
+	    client.done && client.result == 1 && client.error == 90);
+	client = awaiting;
+	v2[0] = 3;
+	v2[1] = 1;
+	le32enc(v2 + 4, 92);
+	le16enc(v2 + 8, 7);
+	le16enc(v2 + 10, 1);
+	le16enc(v2 + 12, 1);
+	le16enc(v2 + 14, 0x4000);
+	memcpy(v2 + 16, good + 32, 92);
+	CHECK(mhi_lab_qmi_receive(&client, v2, sizeof(v2)) == 0 &&
+	    client.done && client.phys == 2 && client.board == 0xe0e6);
+	le32enc(advertisement + 4, 5);
+	le32enc(advertisement + 32, 5);
+	CHECK(mhi_lab_qmi_receive(&client, advertisement, 52) == ENXIO &&
+	    !client.service);
+out:
+	if (error == 0)
+		printf("lkpi_mhi_test: QRTR discovery/v1/v2, QMI request/reply matching, TLV bounds/duplicates, firmware errors and flow acknowledgement passed (model only)\n");
+	return (error);
+}
