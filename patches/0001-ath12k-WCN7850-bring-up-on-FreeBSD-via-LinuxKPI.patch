+/* SPDX-License-Identifier: BSD-2-Clause */
+#ifndef ATH12K_QMI_NATIVE_H
+#define ATH12K_QMI_NATIVE_H
+
+#include <linux/mhi.h>
+#include <linux/soc/qcom/qmi.h>
+
+int ath12k_qmi_native_init(struct qmi_handle *, struct mhi_controller *,
+    size_t, const struct qmi_ops *, const struct qmi_msg_handler *);
+int ath12k_qmi_native_stop(struct qmi_handle *);
+int ath12k_qmi_native_hello(struct qmi_handle *);
+
+size_t ath12k_qmi_native_size(const struct qmi_elem_info *);
+int ath12k_qmi_native_encode(const struct qmi_elem_info *, const void *,
+    void *, size_t, size_t *);
+int ath12k_qmi_native_decode(const struct qmi_elem_info *, const void *,
+    size_t, void *, size_t);
+
+struct ath12k_qmi_native_frame {
+	uint32_t type, node, port, destination_node, destination_port, confirm;
+	const uint8_t *body;
+	size_t length;
+};
+
+int ath12k_qmi_native_frame_decode(const void *, size_t,
+    struct ath12k_qmi_native_frame *);
+int ath12k_qmi_native_reply(const struct ath12k_qmi_native_frame *,
+    uint32_t, uint32_t, const struct qmi_txn *, void *, size_t);
+
+#endif
diff --git a/sys/contrib/dev/athk/ath12k/qmi_native_codec.c b/sys/contrib/dev/athk/ath12k/qmi_native_codec.c
new file mode 100644
index 00000000..6666f070
--- /dev/null
+++ b/sys/contrib/dev/athk/ath12k/qmi_native_codec.c
@@ -0,0 +1,395 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+#include <sys/param.h>
+#include <sys/endian.h>
+#include <sys/systm.h>
+
+#include "qmi_native.h"
+
+#define QMI_SCHEMA_MAX 256
+#define QMI_HOST_MAX 65536
+#define QMI_DEPTH_MAX 8
+
+size_t
+ath12k_qmi_native_size(const struct qmi_elem_info *ei)
+{
+	size_t end, size = 0, width;
+	unsigned int i;
+
+	if (ei == NULL)
+		return (0);
+	for (i = 0; i < QMI_SCHEMA_MAX && ei[i].data_type != QMI_EOTI; i++) {
+		width = ei[i].data_type == QMI_DATA_LEN ? sizeof(uint32_t) :
+		    (size_t)ei[i].elem_size * ei[i].elem_len;
+		if (width == 0 || width > QMI_HOST_MAX ||
+		    ei[i].offset > QMI_HOST_MAX - width)
+			return (0);
+		end = ei[i].offset + width;
+		size = MAX(size, end);
+	}
+	return (i == QMI_SCHEMA_MAX ? 0 : size);
+}
+
+static unsigned int
+qmi_width(enum soc_qcom_qmi_data_type type)
+{
+	switch (type) {
+	case QMI_UNSIGNED_1_BYTE: return (1);
+	case QMI_UNSIGNED_2_BYTE: return (2);
+	case QMI_UNSIGNED_4_BYTE:
+	case QMI_SIGNED_4_BYTE_ENUM: return (4);
+	case QMI_UNSIGNED_8_BYTE: return (8);
+	default: return (0);
+	}
+}
+
+static uint64_t
+qmi_get(const void *p, unsigned int width)
+{
+	switch (width) {
+	case 1: return (*(const uint8_t *)p);
+	case 2: return (le16dec(p));
+	case 4: return (le32dec(p));
+	default: return (le64dec(p));
+	}
+}
+
+static void
+qmi_put(void *p, uint64_t value, unsigned int width)
+{
+	switch (width) {
+	case 1: *(uint8_t *)p = value; break;
+	case 2: le16enc(p, value); break;
+	case 4: le32enc(p, value); break;
+	default: le64enc(p, value); break;
+	}
+}
+
+static uint64_t
+qmi_host_get(const void *p, unsigned int width)
+{
+	uint8_t a;
+	uint16_t b;
+	uint32_t c;
+	uint64_t d;
+
+	switch (width) {
+	case 1: memcpy(&a, p, 1); return (a);
+	case 2: memcpy(&b, p, 2); return (b);
+	case 4: memcpy(&c, p, 4); return (c);
+	default: memcpy(&d, p, 8); return (d);
+	}
+}
+
+static void
+qmi_host_put(void *p, uint64_t value, unsigned int width)
+{
+	uint8_t a = value;
+	uint16_t b = value;
+	uint32_t c = value;
+
+	switch (width) {
+	case 1: memcpy(p, &a, 1); break;
+	case 2: memcpy(p, &b, 2); break;
+	case 4: memcpy(p, &c, 4); break;
+	default: memcpy(p, &value, 8); break;
+	}
+}
+
+/*
+ * Top-level fields share a TLV header. Nested structs contain packed fields,
+ * not C padding or TLV headers; DATA_LEN occupies u32 in host structures.
+ */
+static int
+qmi_fields(const struct qmi_elem_info *ei, unsigned int count,
+    uint8_t *host, size_t host_size, uint8_t *wire, size_t capacity,
+    size_t *used, bool decode, bool validate, unsigned int depth, bool nested)
+{
+	size_t pos = 0, n, bytes, sub, host_width;
+	uint32_t variable = 0;
+	bool have_variable = false;
+	unsigned int i, j, width;
+	uint64_t value;
+	int error;
+
+	if (depth > QMI_DEPTH_MAX)
+		return (E2BIG);
+	for (i = 0; i < count && ei[i].data_type != QMI_EOTI; i++) {
+		const struct qmi_elem_info *e = &ei[i];
+
+		n = e->array_type == VAR_LEN_ARRAY ? variable : e->elem_len;
+		if (e->array_type == VAR_LEN_ARRAY &&
+		    (!have_variable || n > e->elem_len))
+			return (EINVAL);
+		host_width = e->data_type == QMI_DATA_LEN ? sizeof(uint32_t) :
+		    (size_t)e->elem_size * n;
+		if (e->offset > host_size || host_width > host_size - e->offset)
+			return (EMSGSIZE);
+		if (e->data_type == QMI_OPT_FLAG) {
+			if (!decode || e->elem_size != 1)
+				return (EINVAL);
+			if (!validate)
+				host[e->offset] = 1;
+			continue;
+		}
+		if (e->data_type == QMI_DATA_LEN) {
+			width = e->elem_size;
+			if ((width != 1 && width != 2) || capacity - pos < width)
+				return (EMSGSIZE);
+			if (decode)
+				variable = qmi_get(wire + pos, width);
+			else {
+				memcpy(&variable, host + e->offset, sizeof(variable));
+				if (variable > (width == 1 ? UINT8_MAX : UINT16_MAX))
+					return (ERANGE);
+				qmi_put(wire + pos, variable, width);
+			}
+			if (decode && !validate)
+				memcpy(host + e->offset, &variable, sizeof(variable));
+			have_variable = true;
+			pos += width;
+			continue;
+		}
+		if (e->data_type == QMI_STRING) {
+			if (e->elem_size != 1 || e->elem_len == 0)
+				return (EINVAL);
+			width = nested ? (e->elem_len <= UINT8_MAX ? 1 : 2) : 0;
+			if (capacity - pos < width)
+				return (EMSGSIZE);
+			if (decode)
+				n = nested ? qmi_get(wire + pos, width) : capacity - pos;
+			else {
+				n = strnlen((char *)host + e->offset, e->elem_len);
+				if (nested)
+					qmi_put(wire + pos, n, width);
+			}
+			pos += width;
+			if (n >= e->elem_len || n > capacity - pos)
+				return (EMSGSIZE);
+			if (!validate) {
+				if (decode) {
+					memcpy(host + e->offset, wire + pos, n);
+					host[e->offset + n] = 0;
+				} else
+					memcpy(wire + pos, host + e->offset, n);
+			}
+			pos += n;
+			continue;
+		}
+		if (e->data_type == QMI_STRUCT) {
+			if (e->ei_array == NULL ||
+			    ath12k_qmi_native_size(e->ei_array) > e->elem_size)
+				return (EINVAL);
+			for (j = 0; j < n; j++) {
+				error = qmi_fields(e->ei_array, QMI_SCHEMA_MAX,
+				    validate ? NULL : host + e->offset + j * e->elem_size,
+				    e->elem_size, wire + pos, capacity - pos, &sub,
+				    decode, validate, depth + 1, true);
+				if (error != 0)
+					return (error);
+				pos += sub;
+			}
+			continue;
+		}
+		width = qmi_width(e->data_type);
+		if (width == 0 || width != e->elem_size || n > SIZE_MAX / width)
+			return (EINVAL);
+		bytes = n * width;
+		if (bytes > capacity - pos)
+			return (EMSGSIZE);
+		if (!validate) {
+			for (j = 0; j < n; j++) {
+				if (decode) {
+					value = qmi_get(wire + pos + j * width, width);
+					qmi_host_put(host + e->offset + j * width,
+					    value, width);
+				} else {
+					value = qmi_host_get(host + e->offset + j * width,
+					    width);
+					qmi_put(wire + pos + j * width, value, width);
+				}
+			}
+		}
+		pos += bytes;
+	}
+	if (i == QMI_SCHEMA_MAX)
+		return (E2BIG);
+	*used = pos;
+	return (0);
+}
+
+int
+ath12k_qmi_native_encode(const struct qmi_elem_info *ei, const void *host,
+    void *output, size_t capacity, size_t *length)
+{
+	uint8_t *wire = output;
+	size_t size, pos = 0, used;
+	unsigned int i = 0, end, first;
+	int error;
+
+	if (ei == NULL || host == NULL || output == NULL || length == NULL)
+		return (-EINVAL);
+	size = ath12k_qmi_native_size(ei);
+	while (i < QMI_SCHEMA_MAX && ei[i].data_type != QMI_EOTI) {
+		first = i;
+		for (end = i + 1; end < QMI_SCHEMA_MAX &&
+		    ei[end].data_type != QMI_EOTI &&
+		    ei[end].tlv_type == ei[i].tlv_type; end++)
+			;
+		i = end;
+		if (ei[first].data_type == QMI_OPT_FLAG) {
+			if (!*((const uint8_t *)host + ei[first].offset))
+				continue;
+			first++;
+		}
+		if (first == end || pos > capacity || capacity - pos < 3)
+			return (-EMSGSIZE);
+		error = qmi_fields(ei + first, end - first, __DECONST(uint8_t *, host),
+		    size, wire + pos + 3, capacity - pos - 3, &used, false,
+		    false, 0, false);
+		if (error != 0)
+			return (-error);
+		if (used > UINT16_MAX)
+			return (-EMSGSIZE);
+		wire[pos] = ei[first].tlv_type;
+		le16enc(wire + pos + 1, used);
+		pos += 3 + used;
+	}
+	if (i == QMI_SCHEMA_MAX)
+		return (-E2BIG);
+	*length = pos;
+	return (0);
+}
+
+static int
+qmi_decode_pass(const struct qmi_elem_info *ei, const uint8_t *input,
+    size_t length, void *output, size_t size, bool validate)
+{
+	bool seen[256] = { false };
+	size_t pos = 0, bytes, used;
+	unsigned int i, end;
+	uint8_t type;
+	int error;
+
+	while (pos < length) {
+		if (length - pos < 3)
+			return (EMSGSIZE);
+		type = input[pos];
+		bytes = le16dec(input + pos + 1);
+		pos += 3;
+		if (bytes > length - pos || seen[type])
+			return (EBADMSG);
+		seen[type] = true;
+		for (i = 0; i < QMI_SCHEMA_MAX && ei[i].data_type != QMI_EOTI; i++)
+			if (ei[i].tlv_type == type)
+				break;
+		if (i == QMI_SCHEMA_MAX)
+			return (E2BIG);
+		if (ei[i].data_type != QMI_EOTI) {
+			for (end = i + 1; end < QMI_SCHEMA_MAX &&
+			    ei[end].data_type != QMI_EOTI &&
+			    ei[end].tlv_type == type; end++)
+				;
+			error = qmi_fields(ei + i, end - i, output, size,
+			    __DECONST(uint8_t *, input + pos), bytes, &used,
+			    true, validate, 0, false);
+			if (error != 0 || used != bytes)
+				return (error != 0 ? error : EBADMSG);
+		}
+		pos += bytes;
+	}
+	for (i = 0; i < QMI_SCHEMA_MAX && ei[i].data_type != QMI_EOTI;) {
+		if (ei[i].data_type != QMI_OPT_FLAG && !seen[ei[i].tlv_type])
+			return (ENOMSG);
+		for (end = i + 1; end < QMI_SCHEMA_MAX &&
+		    ei[end].data_type != QMI_EOTI &&
+		    ei[end].tlv_type == ei[i].tlv_type; end++)
+			;
+		i = end;
+	}
+	return (i == QMI_SCHEMA_MAX ? E2BIG : 0);
+}
+
+int
+ath12k_qmi_native_decode(const struct qmi_elem_info *ei, const void *input,
+    size_t length, void *output, size_t size)
+{
+	int error;
+
+	if (ei == NULL || input == NULL || output == NULL ||
+	    ath12k_qmi_native_size(ei) > size || size > QMI_HOST_MAX)
+		return (-EINVAL);
+	error = qmi_decode_pass(ei, input, length, NULL, size, true);
+	if (error != 0)
+		return (-error);
+	memset(output, 0, size);
+	return (-qmi_decode_pass(ei, input, length, output, size, false));
+}
+
+int
+ath12k_qmi_native_frame_decode(const void *input, size_t length,
+    struct ath12k_qmi_native_frame *output)
+{
+	const uint8_t *data = input;
+	struct ath12k_qmi_native_frame frame;
+	size_t header;
+	uint32_t size;
+
+	if (data == NULL || output == NULL)
+		return (-EINVAL);
+	if (length >= 32 && le32dec(data) == 1) {
+		header = 32;
+		frame.type = le32dec(data + 4);
+		frame.node = le32dec(data + 8);
+		frame.port = le32dec(data + 12);
+		frame.confirm = le32dec(data + 16);
+		size = le32dec(data + 20);
+		frame.destination_node = le32dec(data + 24);
+		frame.destination_port = le32dec(data + 28);
+	} else if (length >= 16 && data[0] == 3 && data[3] == 0 &&
+	    (data[2] & ~1U) == 0) {
+		header = 16;
+		frame.type = data[1];
+		frame.confirm = data[2] & 1;
+		size = le32dec(data + 4);
+		frame.node = le16dec(data + 8);
+		frame.port = le16dec(data + 10);
+		frame.destination_node = le16dec(data + 12);
+		frame.destination_port = le16dec(data + 14);
+	} else
+		return (-EPROTONOSUPPORT);
+	if (size > length - header ||
+	    (length != header + size && length != roundup2(header + size, 4)) ||
+	    frame.confirm > 1 || frame.node == 0 || frame.node == UINT32_MAX)
+		return (-EPROTO);
+	frame.body = data + header;
+	frame.length = size;
+	if (frame.type == 1) {
+		if (frame.destination_node != 1 || frame.destination_port != 0x4000 ||
+		    size < 7 || le16dec(frame.body + 5) != size - 7 ||
+		    (frame.body[0] != 2 && frame.body[0] != QMI_INDICATION))
+			return (-EPROTO);
+	} else if ((frame.type != 2 && frame.type != 4 && frame.type != 5 &&
+	    frame.type != 7) || size != 20 || le32dec(frame.body) != frame.type)
+		return (-EPROTO);
+	*output = frame;
+	return (0);
+}
+
+int
+ath12k_qmi_native_reply(const struct ath12k_qmi_native_frame *frame,
+    uint32_t node, uint32_t port, const struct qmi_txn *txn,
+    void *output, size_t size)
+{
+	if (frame == NULL || txn == NULL || frame->body == NULL || frame->type != 1 ||
+	    frame->node != node || frame->port != port ||
+	    frame->destination_node != 1 || frame->destination_port != 0x4000 ||
+	    frame->length < 7 || frame->body[0] != 2 ||
+	    le16dec(frame->body + 5) != frame->length - 7)
+		return (-EPROTO);
+	if (!txn->active || !txn->sent || txn->done ||
+	    le16dec(frame->body + 1) != txn->id ||
+	    le16dec(frame->body + 3) != txn->message)
+		return (-ENOENT);
+	return (ath12k_qmi_native_decode(txn->ei, frame->body + 7,
+	    frame->length - 7, output, size));
+}
