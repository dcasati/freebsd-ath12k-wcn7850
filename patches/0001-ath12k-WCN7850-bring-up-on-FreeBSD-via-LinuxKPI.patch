+static int
+lkpi_ic_setregdomain(struct ieee80211com *ic, struct ieee80211_regdomain *rd,
+    int n, struct ieee80211_channel channels[])
+{
+	struct lkpi_hw *lhw = ic->ic_softc;
+	struct wiphy *wiphy = LHW_TO_HW(lhw)->wiphy;
+	struct linuxkpi_ieee80211_channel *lc;
+	struct ieee80211_channel *c;
+	int i, j;
+
+	if (!wiphy->lkpi_regulatory_strict)
+		return (0);
+	if (memcmp(rd, &ic->ic_regdomain, sizeof(*rd)) != 0 ||
+	    n == 0 || !lkpi_reg_tx_allowed(wiphy))
+		return (EPERM);
+	for (i = 0; i < n; i++) {
+		c = &channels[i];
+		for (j = 0; j < ic->ic_nchans; j++)
+			if (c->ic_freq == ic->ic_channels[j].ic_freq &&
+			    c->ic_flags == ic->ic_channels[j].ic_flags)
+				break;
+		if (j == ic->ic_nchans)
+			return (EPERM);
+		lc = lkpi_find_lkpi80211_chan(lhw, c);
+		if (lc == NULL || (lc->flags & IEEE80211_CHAN_DISABLED) ||
+		    c->ic_maxregpower < 1 || c->ic_maxregpower > lc->max_power ||
+		    c->ic_maxpower < 1 || c->ic_maxpower > 2 * c->ic_maxregpower ||
+		    c->ic_minpower < 0 || c->ic_minpower > c->ic_maxpower ||
+		    c->ic_maxantgain < 0 ||
+		    c->ic_maxantgain > 2 * lc->max_antenna_gain)
+			return (EPERM);
+	}
+	return (0);
+}
