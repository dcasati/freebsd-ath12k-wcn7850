+	    le32dec(setup) == 12U << 16 && le32dec(setup + 8) == 5 &&
+	    le32dec(setup + 12) == 0 && le32dec(setup + 16) == 0);
+	CHECK(mhi_lab_htc_setup(&htc, setup) == EPROTO);
+	le32enc(packet + 8, WMI_SERVICE_AVAILABLE_EVENTID);
+	le32enc(packet + 12, WMI_TAG_SERVICE_AVAILABLE_EVENT << 16 |
+	    sizeof(struct wmi_service_available_event));
+	value = packet + 16;
+	le32enc(value, 0);
+	le32enc(value + 4 + ((WMI_TLV_SERVICE_EXT2_MSG - WMI_MAX_SERVICE) / 32) * 4,
+	    1U << (WMI_TLV_SERVICE_EXT2_MSG % 32));
+	offset = 16 + sizeof(struct wmi_service_available_event);
+	le32enc(packet + offset, WMI_TAG_ARRAY_UINT32 << 16 | 4);
+	le32enc(packet + offset + 4, 1U << (WMI_TLV_SERVICE_REG_CC_EXT_EVENT_SUPPORT % 32));
+	length = offset + 8;
+	le32enc(packet, 2 | (length - 8) << 16);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == EPROTO &&
+	    !wmi.available && wmi.events == 0);
+	le32enc(value, WMI_MAX_SERVICE);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == 0 &&
+	    wmi.available && !mhi_lab_wmi_ready(&wmi) &&
+	    (wmi.services[WMI_TLV_SERVICE_EXT2_MSG / 8] &
+	    (1U << (WMI_TLV_SERVICE_EXT2_MSG % 8))) != 0 &&
+	    (wmi.services[WMI_TLV_SERVICE_REG_CC_EXT_EVENT_SUPPORT / 8] &
+	    (1U << (WMI_TLV_SERVICE_REG_CC_EXT_EVENT_SUPPORT % 8))) != 0);
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet + 8, WMI_SERVICE_READY_EVENTID);
+	le32enc(packet + 12, WMI_TAG_SERVICE_READY_EVENT << 16 |
+	    sizeof(struct wmi_service_ready_event));
+	value = packet + 16;
+	le32enc(value + offsetof(struct wmi_service_ready_event, fw_build_vers), 0x1234);
+	le32enc(value + offsetof(struct wmi_service_ready_event, num_rf_chains), 2);
+	le32enc(value + offsetof(struct wmi_service_ready_event, max_num_scan_channels), 100);
+	for (i = 0; i < 6; i++)
+		le32enc(value + offsetof(struct wmi_service_ready_event, fw_abi_vers) + i * 4,
+		    i + 1);
+	offset = 16 + sizeof(struct wmi_service_ready_event);
+	le32enc(packet + offset, WMI_TAG_ARRAY_UINT32 << 16 | WMI_SERVICE_BM_SIZE * 4);
+	le32enc(packet + offset + 4 + (WMI_TLV_SERVICE_EXT_MSG / 4) * 4,
+	    1U << (WMI_TLV_SERVICE_EXT_MSG % 4));
+	length = offset + 4 + WMI_SERVICE_BM_SIZE * 4;
+	le32enc(packet, 2 | (length - 8) << 16);
+	CHECK(mhi_lab_htc_receive(&htc, 1, packet, length) == EPROTO && !wmi.base);
+	packet[12]++;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == EPROTO && !wmi.base);
+	packet[12]--;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == 0 &&
+	    wmi.base && wmi.rf_chains == 2 && wmi.firmware == 0x1234 &&
+	    wmi.scan_channels == 100 && wmi.abi[5] == 6 &&
+	    !mhi_lab_wmi_ready(&wmi));
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == EPROTO && wmi.events == 2);
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet + 8, WMI_SERVICE_READY_EXT_EVENTID);
+	le32enc(packet + 12, WMI_TAG_SERVICE_READY_EXT_EVENT << 16 |
+	    sizeof(struct wmi_service_ready_ext_event));
+	length = 16 + sizeof(struct wmi_service_ready_ext_event);
+	le32enc(packet, 2 | (length - 8) << 16);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == 0 &&
+	    wmi.extended && !mhi_lab_wmi_ready(&wmi));
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet + 8, WMI_SERVICE_READY_EXT2_EVENTID);
+	le32enc(packet + 12, WMI_TAG_SERVICE_READY_EXT2_EVENT << 16 |
+	    sizeof(struct wmi_service_ready_ext2_event));
+	length = 16 + sizeof(struct wmi_service_ready_ext2_event);
+	le32enc(packet, 2 | (length - 8) << 16);
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, length) == 0 &&
+	    wmi.extended2 && mhi_lab_wmi_ready(&wmi) && wmi.events == 4);
+	memset(packet, 0, sizeof(packet));
+	le32enc(packet, 2 | 2U << 8 | 8U << 16);
+	packet[4] = 8;
+	packet[8] = 1;
+	packet[9] = 5;
+	packet[12] = 2;
+	packet[13] = 1;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 16) == EPROTO &&
+	    htc.wmi_credits == 2);
+	packet[9] = 4;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 16) == 0 &&
+	    htc.wmi_credits == 3 && wmi.events == 4);
+	packet[12] = 9;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 16) == EPROTO &&
+	    htc.wmi_credits == 3);
+	packet[12] = 2;
+	packet[0] = 0;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 16) == 0 &&
+	    htc.wmi_credits == 4 && wmi.events == 4);
+	le32enc(packet, 2 | 2U << 8 | 12U << 16);
+	packet[4] = 12;
+	packet[16] = 1;
+	packet[17] = 4;
+	CHECK(mhi_lab_htc_receive(&htc, 2, packet, 20) == EPROTO &&
+	    htc.wmi_credits == 4);
+out:
+	if (error == 0)
+		printf("lkpi_mhi_test: HTC setup, WMI startup/extension gates, ABI, segmented/legacy bitmaps, TLV rejection and bounded credit trailers passed (model only)\n");
+	return (error);
+}
