 /* This is both individual command WMI_PDEV_SET_HW_MODE_CMDID and also part
  * of WMI_TAG_INIT_CMD.
  */
+#define WMI_PDEV_ID_SOC         0
+
 struct ath12k_wmi_pdev_set_hw_mode_cmd {
