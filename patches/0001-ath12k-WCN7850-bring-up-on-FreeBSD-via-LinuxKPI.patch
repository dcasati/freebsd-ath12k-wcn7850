+#if defined(__FreeBSD__)
+/* Validate the whole trailer before granting any firmware credits. */
+static inline int
+ath12k_htc_credit_trailer_decode(const void *data, size_t length,
+    u32 credits[ATH12K_HTC_EP_COUNT])
+{
+	const u8 *p = data;
+	u32 next[ATH12K_HTC_EP_COUNT] = { 0 };
+	size_t i, n;
+
+	if (!p || length > ATH12K_HTC_MAX_LEN)
+		return -EPROTO;
+	while (length) {
+		if (length < sizeof(struct ath12k_htc_record_hdr))
+			return -EPROTO;
+		n = p[1];
+		if (n > length - sizeof(struct ath12k_htc_record_hdr))
+			return -EPROTO;
+		if (p[0] == ATH12K_HTC_RECORD_CREDITS) {
+			if (!n || n % sizeof(struct ath12k_htc_credit_report))
+				return -EPROTO;
+			for (i = 0; i < n; i += sizeof(struct ath12k_htc_credit_report)) {
+				u8 eid = p[sizeof(struct ath12k_htc_record_hdr) + i];
+				if (eid >= ATH12K_HTC_EP_COUNT)
+					return -EPROTO;
+				next[eid] += p[sizeof(struct ath12k_htc_record_hdr) + i + 1];
+			}
+		}
+		p += sizeof(struct ath12k_htc_record_hdr) + n;
+		length -= sizeof(struct ath12k_htc_record_hdr) + n;
+	}
+	memcpy(credits, next, sizeof(next));
+	return 0;
+}
+
+/* Caller serializes endpoint ownership and credits with tx_lock. */
+static inline int
+ath12k_htc_credit_report_apply(struct ath12k_htc *htc,
+    const u32 credits[ATH12K_HTC_EP_COUNT])
+{
+	struct ath12k_htc_ep *ep;
+	int i;
+
+	for (i = 0; i < ATH12K_HTC_EP_COUNT; i++) {
+		if (!credits[i])
+			continue;
+		ep = &htc->endpoint[i];
+		if (!ep->tx_credit_flow_enabled ||
+		    ep->service_id == ATH12K_HTC_SVC_ID_UNUSED ||
+		    ep->tx_credits < 0 || ep->tx_credits > ep->tx_credit_limit ||
+		    credits[i] > ep->tx_credit_limit - ep->tx_credits)
+			return -EPROTO;
+	}
+	for (i = 0; i < ATH12K_HTC_EP_COUNT; i++)
+		htc->endpoint[i].tx_credits += credits[i];
+	return 0;
+}
+#endif
