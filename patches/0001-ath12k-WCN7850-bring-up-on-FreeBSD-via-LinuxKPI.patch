+static void
+mhi_dma_free(struct lkpi_mhi_dma *buffer)
+{
+	int error;
+
+	if (buffer->loaded) {
+		if (buffer->synced)
+			bus_dmamap_sync(buffer->tag, buffer->map,
+			    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+		bus_dmamap_unload(buffer->tag, buffer->map);
+	}
+	if (buffer->vaddr != NULL)
+		bus_dmamem_free(buffer->tag, buffer->vaddr, buffer->map);
+	if (buffer->tag != NULL) {
+		error = bus_dma_tag_destroy(buffer->tag);
+		KASSERT(error == 0, ("MHI DMA tag still busy: %d", error));
+		if (error != 0)
+			pr_err("%s: DMA tag destruction failed: %d\n",
+			    __func__, error);
+	}
+	memset(buffer, 0, sizeof(*buffer));
+}
+
+struct mhi_dma_load {
+	struct lkpi_mhi_dma *buffer;
+	int error;
+};
+
+static void
+mhi_dma_callback(void *arg, bus_dma_segment_t *segments, int count, int error)
+{
+	struct mhi_dma_load *result = arg;
+
+	result->error = error;
+	if (error != 0)
+		return;
+	result->buffer->loaded = true;
+	if (count != 1 || segments[0].ds_len < result->buffer->size) {
+		result->error = EFBIG;
+		return;
+	}
+	result->buffer->address = segments[0].ds_addr;
+}
+
+static int
+mhi_dma_alloc(struct mhi_controller *ctrl, struct lkpi_mhi_dma *buffer,
+    size_t size, size_t alignment)
+{
+	struct mhi_dma_load result = { .buffer = buffer };
+	bus_addr_t limit;
+	int error;
+
+	KFAIL_POINT_CODE(DEBUG_FP, lkpi_mhi_dma_alloc, return (ENOMEM));
+	/* ath12k uses 32-bit coherent DMA even with a wider streaming mask. */
+	limit = MIN(ctrl->iova_stop, BUS_SPACE_MAXADDR_32BIT);
+	buffer->size = size;
+	error = bus_dma_tag_create(bus_get_dma_tag(ctrl->cntrl_dev->bsddev),
+	    alignment, 0, limit, BUS_SPACE_MAXADDR, NULL, NULL,
+	    size, 1, size, 0, NULL, NULL, &buffer->tag);
+	if (error != 0)
+		return (error);
+	error = bus_dmamem_alloc(buffer->tag, &buffer->vaddr,
+	    BUS_DMA_NOWAIT | BUS_DMA_ZERO | BUS_DMA_COHERENT, &buffer->map);
+	if (error != 0)
+		return (error);
+	error = bus_dmamap_load(buffer->tag, buffer->map, buffer->vaddr, size,
+	    mhi_dma_callback, &result, BUS_DMA_NOWAIT);
+	if (error != 0)
+		return (error);
+	if (result.error != 0)
+		return (result.error);
+	if (!buffer->loaded)
+		return (EIO);
+	if ((buffer->address & (alignment - 1)) != 0 ||
+	    ((uintptr_t)buffer->vaddr & (MIN(alignment, PAGE_SIZE) - 1)) != 0 ||
+	    buffer->address < ctrl->iova_start || buffer->address > limit ||
+	    size - 1 > limit - buffer->address)
+		return (ERANGE);
+	return (0);
+}
+
+static void
+mhi_dma_sync(struct lkpi_mhi_dma *buffer)
+{
+	if (!buffer->loaded)
+		return;
+	bus_dmamap_sync(buffer->tag, buffer->map,
+	    BUS_DMASYNC_PREREAD | BUS_DMASYNC_PREWRITE);
+	buffer->synced = true;
+}
+
+int
+linuxkpi_mhi_alloc_memory(struct mhi_controller *ctrl,
+    struct lkpi_mhi_dma *buffer, size_t size)
+{
+	int error;
+
+	if (ctrl == NULL || ctrl->cntrl_dev == NULL ||
+	    ctrl->cntrl_dev->bsddev == NULL || ctrl->lkpi_context == NULL ||
+	    ctrl->iova_start > ctrl->iova_stop || buffer == NULL ||
+	    buffer->tag != NULL || size == 0) {
+		pr_err("%s: invalid firmware memory allocation\n", __func__);
+		return (-EINVAL);
+	}
+	error = mhi_dma_alloc(ctrl, buffer, size, 65536);
+	if (error != 0) {
+		mhi_dma_free(buffer);
+		pr_err("%s: firmware DMA allocation failed: %d (bytes=%zu)\n",
+		    __func__, error, size);
+		return (-error);
+	}
+	mhi_dma_sync(buffer);
+	return (0);
+}
+
+int
+linuxkpi_mhi_free_memory(struct mhi_controller *ctrl,
+    struct lkpi_mhi_dma *buffer)
+{
+	if (ctrl == NULL || buffer == NULL || ctrl->lkpi_context == NULL ||
+	    ctrl->lkpi_context->published) {
+		pr_err("%s: quiescent context required before firmware DMA free\n",
+		    __func__);
+		return (-EBUSY);
+	}
+	mhi_dma_free(buffer);
+	return (0);
+}
+
+static void
+mhi_dma_cpu(struct lkpi_mhi_dma *buffer)
+{
+	if (!buffer->synced)
+		return;
+	bus_dmamap_sync(buffer->tag, buffer->map,
+	    BUS_DMASYNC_POSTREAD | BUS_DMASYNC_POSTWRITE);
+	buffer->synced = false;
+}
+
+static void
+mhi_context_free(struct lkpi_mhi_context *context)
+{
+	unsigned int i, j;
+
+	if (context->transfers != NULL)
+		for (i = 0; i < context->max_channels; i++) {
+			if (context->transfers[i].slots == NULL)
+				continue;
+			for (j = 0; j < context->transfers[i].count; j++)
+				mhi_dma_free(&context->transfers[i].slots[j].dma);
+			free(context->transfers[i].slots, M_LKPIMHI);
+		}
+	if (context->channel_rings != NULL)
+		for (i = 0; i < context->max_channels; i++)
+			mhi_dma_free(&context->channel_rings[i]);
+	if (context->event_rings != NULL)
+		for (i = 0; i < context->num_events; i++)
+			mhi_dma_free(&context->event_rings[i].dma);
+	mhi_dma_free(&context->command_ring);
+	mhi_dma_free(&context->commands);
+	mhi_dma_free(&context->events);
+	mhi_dma_free(&context->channels);
+	free(context->channel_rings, M_LKPIMHI);
+	free(context->event_rings, M_LKPIMHI);
+	free(context->transfers, M_LKPIMHI);
+	mtx_destroy(&context->lock);
+	free(context, M_LKPIMHI);
+}
+
+void
+linuxkpi_mhi_free_context(struct mhi_controller *ctrl)
+{
+	if (ctrl == NULL || ctrl->lkpi_context == NULL)
+		return;
+	if (ctrl->lkpi_runtime != NULL && ctrl->lkpi_runtime->irqs != 0) {
+		pr_err("%s: drain controller IRQs before releasing contexts\n",
+		    __func__);
+		return;
+	}
+	if (linuxkpi_mhi_dma_owned(ctrl)) {
+		pr_err("%s: device reset required before releasing MHI contexts\n",
+		    __func__);
+		return;
+	}
+	mhi_context_free(ctrl->lkpi_context);
+	ctrl->lkpi_context = NULL;
+}
+
+static bool
+mhi_ring_valid(int elements)
+{
+	return (elements >= 2 && powerof2(elements) &&
+	    elements <= INT_MAX / sizeof(struct lkpi_mhi_tre));
+}
+
+static int
+mhi_config_valid(const struct mhi_controller_config *cfg)
+{
+	const struct mhi_channel_config *channel;
+	const struct mhi_event_config *event;
+	int i, j;
+
+	if (cfg == NULL || cfg->max_channels <= 0 || cfg->max_channels > 256 ||
+	    cfg->num_channels <= 0 || cfg->num_channels > cfg->max_channels ||
+	    cfg->num_events <= 0 || cfg->num_events > 255 ||
+	    cfg->ch_cfg == NULL || cfg->event_cfg == NULL)
+		return (EINVAL);
+	if (cfg->use_bounce_buf)
+		return (EOPNOTSUPP);
+	for (i = 0; i < cfg->num_channels; i++) {
+		channel = &cfg->ch_cfg[i];
+		if (channel->num < 0 || channel->num >= cfg->max_channels ||
+		    channel->event_ring < 0 ||
+		    channel->event_ring >= cfg->num_events ||
+		    !mhi_ring_valid(channel->num_elements) ||
+		    (channel->dir != DMA_TO_DEVICE &&
+		    channel->dir != DMA_FROM_DEVICE) ||
+		    channel->pollcfg < 0 || channel->pollcfg > 63)
+			return (EINVAL);
+		if (channel->offload_channel || channel->auto_queue ||
+		    channel->doorbell != MHI_DB_BRST_DISABLE)
+			return (EOPNOTSUPP);
+		for (j = 0; j < i; j++)
+			if (cfg->ch_cfg[j].num == channel->num)
+				return (EINVAL);
+	}
+	for (i = 0; i < cfg->num_events; i++) {
+		event = &cfg->event_cfg[i];
+		if (!mhi_ring_valid(event->num_elements) || event->irq < 0 ||
+		    event->irq_moderation_ms < 0 ||
+		    event->irq_moderation_ms > UINT16_MAX ||
+		    (event->data_type != MHI_ER_CTRL &&
+		    event->data_type != MHI_ER_DATA))
+			return (EINVAL);
+		if (event->offload_channel || event->client_managed ||
+		    event->hardware_event || event->mode != MHI_DB_BRST_DISABLE)
+			return (EOPNOTSUPP);
+	}
+	return (0);
+}
+
+int
+linuxkpi_mhi_alloc_context(struct mhi_controller *ctrl,
+    const struct mhi_controller_config *cfg)
+{
+	struct lkpi_mhi_channel_context *channels, *channel;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_command_context *command;
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_dma *ring;
+	const struct mhi_channel_config *ch;
+	const struct mhi_event_config *ev;
+	size_t size;
+	int error, i;
+
+	if (ctrl == NULL || ctrl->cntrl_dev == NULL ||
+	    ctrl->cntrl_dev->bsddev == NULL ||
+	    ctrl->iova_start > ctrl->iova_stop) {
+		pr_err("%s: invalid controller or DMA interval\n", __func__);
+		return (-EINVAL);
+	}
+	if (ctrl->lkpi_context != NULL) {
+		pr_err("%s: contexts already allocated\n", __func__);
+		return (-EBUSY);
+	}
+	error = mhi_config_valid(cfg);
+	if (error != 0) {
+		pr_err("%s: invalid or unsupported configuration: %d\n",
+		    __func__, error);
+		return (-error);
+	}
+	context = malloc(sizeof(*context), M_LKPIMHI, M_NOWAIT | M_ZERO);
+	if (context == NULL) {
+		pr_err("%s: context allocation failed\n", __func__);
+		return (-ENOMEM);
+	}
+	context->max_channels = cfg->max_channels;
+	mtx_init(&context->lock, "MHI events", NULL, MTX_DEF);
+	context->num_events = cfg->num_events;
+	context->channel_rings = mallocarray(cfg->max_channels,
+	    sizeof(*context->channel_rings), M_LKPIMHI, M_NOWAIT | M_ZERO);
+	context->event_rings = mallocarray(cfg->num_events,
+	    sizeof(*context->event_rings), M_LKPIMHI, M_NOWAIT | M_ZERO);
+	context->transfers = mallocarray(cfg->max_channels,
+	    sizeof(*context->transfers), M_LKPIMHI, M_NOWAIT | M_ZERO);
+	if (context->channel_rings == NULL || context->event_rings == NULL ||
+	    context->transfers == NULL) {
+		error = ENOMEM;
+		goto fail;
+	}
+	error = mhi_dma_alloc(ctrl, &context->channels,
+	    cfg->max_channels * sizeof(*channels), 64);
+	if (error != 0)
+		goto fail;
+	error = mhi_dma_alloc(ctrl, &context->events,
+	    cfg->num_events * sizeof(*events), 64);
+	if (error != 0)
+		goto fail;
+	error = mhi_dma_alloc(ctrl, &context->commands, sizeof(*command), 64);
+	if (error != 0)
+		goto fail;
+	size = 128 * sizeof(struct lkpi_mhi_tre);
+	error = mhi_dma_alloc(ctrl, &context->command_ring, size, size);
+	if (error != 0)
+		goto fail;
+	command = context->commands.vaddr;
+	ring = &context->command_ring;
+	command->rbase = command->rp = command->wp = htole64(ring->address);
+	command->rlen = htole64(ring->size);
+
+	events = context->events.vaddr;
+	for (i = 0; i < cfg->num_events; i++) {
+		ev = &cfg->event_cfg[i];
+		ring = &context->event_rings[i].dma;
+		size = ev->num_elements * sizeof(struct lkpi_mhi_tre);
+		error = mhi_dma_alloc(ctrl, ring, size, size);
+		if (error != 0)
+			goto fail;
+		events[i].intmod = htole32((uint32_t)ev->irq_moderation_ms << 16);
+		events[i].ertype = htole32(1);
+		events[i].msivec = htole32(ev->irq);
+		events[i].rbase = events[i].rp = htole64(ring->address);
+		events[i].wp = htole64(ring->address + ring->size -
+		    sizeof(struct lkpi_mhi_tre));
+		events[i].rlen = htole64(ring->size);
+		context->event_rings[i].write_offset = ring->size -
+		    sizeof(struct lkpi_mhi_tre);
+		context->event_rings[i].irq = ev->irq;
+		context->event_rings[i].type = ev->data_type;
+	}
+	channels = context->channels.vaddr;
+	for (i = 0; i < cfg->max_channels; i++)
+		channels[i].chcfg = htole32(MHI_DB_BRST_DISABLE << 8);
+	for (i = 0; i < cfg->num_channels; i++) {
+		ch = &cfg->ch_cfg[i];
+		channel = &channels[ch->num];
+		ring = &context->channel_rings[ch->num];
+		size = ch->num_elements * sizeof(struct lkpi_mhi_tre);
+		error = mhi_dma_alloc(ctrl, ring, size, size);
+		if (error != 0)
+			goto fail;
+		channel->chcfg = htole32((ch->doorbell << 8) | (ch->pollcfg << 10));
+		channel->chtype = htole32(ch->dir);
+		channel->erindex = htole32(ch->event_ring);
+		channel->rbase = channel->rp = channel->wp = htole64(ring->address);
+		channel->rlen = htole64(ring->size);
+		context->transfers[ch->num].direction = ch->dir;
+		context->transfers[ch->num].event_ring = ch->event_ring;
+		context->transfers[ch->num].count = ch->num_elements;
+	}
+	mhi_dma_sync(&context->channels);
+	mhi_dma_sync(&context->events);
+	mhi_dma_sync(&context->commands);
+	mhi_dma_sync(&context->command_ring);
+	for (i = 0; i < cfg->num_events; i++)
+		mhi_dma_sync(&context->event_rings[i].dma);
+	for (i = 0; i < cfg->max_channels; i++)
+		mhi_dma_sync(&context->channel_rings[i]);
+	/* No MMIO writes: the device cannot own these buffers yet. */
+	ctrl->lkpi_context = context;
+	return (0);
+fail:
+	pr_err("%s: DMA context allocation failed: %d\n", __func__, error);
+	mhi_context_free(context);
+	return (-error);
+}
+
+static int
+mhi_boot_read(struct mhi_controller *ctrl, uint32_t offset, uint32_t *value)
+{
+	int error;
+
+	if ((offset & 3) != 0 || ctrl->reg_len < sizeof(*value) ||
+	    offset > ctrl->reg_len - sizeof(*value))
+		return (EINVAL);
+	error = ctrl->read_reg(ctrl, (uint8_t *)ctrl->regs + offset, value);
+	if (error != 0 || *value == UINT32_MAX)
+		return (EIO);
+	return (0);
+}
+
+static void
+mhi_boot_write(struct mhi_controller *ctrl, uint32_t offset, uint32_t value)
+{
+	ctrl->write_reg(ctrl, (uint8_t *)ctrl->regs + offset, value);
+}
+
+static void
+mhi_boot_write64(struct mhi_controller *ctrl, uint32_t offset, uint64_t value)
+{
+	mhi_boot_write(ctrl, offset + 4, value >> 32);
+	mhi_boot_write(ctrl, offset, (uint32_t)value);
+}
+
+int
+linuxkpi_mhi_alloc_transfer(struct mhi_controller *ctrl, unsigned int channel)
+{
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_xfer *xfer;
+	struct lkpi_mhi_tre *tre;
+	unsigned int i;
+	int error;
+
+	if (ctrl == NULL || (context = ctrl->lkpi_context) == NULL ||
+	    context->published || channel >= context->max_channels ||
+	    context->transfers[channel].count == 0 ||
+	    context->transfers[channel].slots != NULL) {
+		pr_err("%s: invalid/unavailable transfer channel\n", __func__);
+		return (-EINVAL);
+	}
+	xfer = &context->transfers[channel];
+	xfer->slots = mallocarray(xfer->count, sizeof(*xfer->slots),
+	    M_LKPIMHI, M_NOWAIT | M_ZERO);
+	if (xfer->slots == NULL) {
+		pr_err("%s: slot allocation failed\n", __func__);
+		return (-ENOMEM);
+	}
+	for (i = 0; i < xfer->count; i++) {
+		error = mhi_dma_alloc(ctrl, &xfer->slots[i].dma, UINT16_MAX, 64);
+		if (error != 0)
+			goto fail;
+	}
+	if (xfer->direction == DMA_FROM_DEVICE) {
+		mhi_dma_cpu(&context->channel_rings[channel]);
+		tre = context->channel_rings[channel].vaddr;
+		for (i = 0; i < xfer->count; i++) {
+			tre[i].ptr = htole64(xfer->slots[i].dma.address);
+			tre[i].dword[0] = htole32(UINT16_MAX);
+			tre[i].dword[1] = htole32(0x20200);
+			mhi_dma_sync(&xfer->slots[i].dma);
+		}
+		mhi_dma_sync(&context->channel_rings[channel]);
+	}
+	return (0);
+fail:
+	for (i = 0; i < xfer->count; i++)
+		mhi_dma_free(&xfer->slots[i].dma);
+	free(xfer->slots, M_LKPIMHI);
+	xfer->slots = NULL;
+	pr_err("%s: transfer DMA allocation failed: %d\n", __func__, error);
+	return (-error);
+}
+
+static int
+mhi_channel_command(struct mhi_controller *ctrl, unsigned int channel, bool start)
+{
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_command_context *command;
+	struct lkpi_mhi_tre *tre;
+	struct lkpi_mhi_xfer *xfer;
+	uint32_t state, ee;
+	int error = 0;
+
+	if (ctrl == NULL || (context = ctrl->lkpi_context) == NULL ||
+	    channel >= context->max_channels) {
+		pr_err("%s: invalid channel\n", __func__);
+		return (-EINVAL);
+	}
+	mtx_lock(&context->lock);
+	xfer = &context->transfers[channel];
+	if (!context->published || context->quiescing || context->state != 2 ||
+	    context->ee != 2 || xfer->slots == NULL ||
+	    context->event_error != 0 || context->command_pending ||
+	    (start && context->stopping) ||
+	    xfer->starting || xfer->started == start) {
+		error = context->event_error != 0 ? context->event_error : EBUSY;
+		goto out;
+	}
+	if (start) {
+		mhi_dma_cpu(&context->channels);
+		channels = context->channels.vaddr;
+		channels[channel].chcfg = htole32(
+		    (le32toh(channels[channel].chcfg) & ~0xffU) | 1);
+		mhi_dma_sync(&context->channels);
+	}
+	mhi_dma_cpu(&context->command_ring);
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)context->command_ring.vaddr +
+	    context->command_write);
+	tre->ptr = 0;
+	tre->dword[0] = 0;
+	context->command_type = start ? 18 : 17;
+	tre->dword[1] = htole32((channel << 24) |
+	    (context->command_type << 16));
+	mhi_dma_sync(&context->command_ring);
+	context->command_write = (context->command_write + sizeof(*tre)) %
+	    context->command_ring.size;
+	mhi_dma_cpu(&context->commands);
+	command = context->commands.vaddr;
+	command->wp = htole64(context->command_ring.address +
+	    context->command_write);
+	mhi_dma_sync(&context->commands);
+	context->command_pending = true;
+	context->command_channel = channel;
+	xfer->starting = true;
+	mhi_boot_write64(ctrl, 0x70,
+	    context->command_ring.address + context->command_write);
+out:
+	state = context->state;
+	ee = context->ee;
+	mtx_unlock(&context->lock);
+	if (error != 0)
+		pr_err("%s: channel %u submission failed: %d (state=%u EE=%u)\n",
+		    __func__, channel, error, state, ee);
+	return (-error);
+}
+
+int
+linuxkpi_mhi_start_channel(struct mhi_controller *ctrl, unsigned int channel)
+{
+	return (mhi_channel_command(ctrl, channel, true));
+}
+
+int
+linuxkpi_mhi_stop_channel(struct mhi_controller *ctrl, unsigned int channel)
+{
+	return (mhi_channel_command(ctrl, channel, false));
+}
+
+int
+linuxkpi_mhi_submit(struct mhi_controller *ctrl, unsigned int channel,
+    const void *data, size_t length)
+{
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_xfer *xfer;
+	struct lkpi_mhi_slot *slot;
+	struct lkpi_mhi_tre *tre;
+	int error = 0;
+
+	if (ctrl == NULL || (context = ctrl->lkpi_context) == NULL ||
+	    channel >= context->max_channels || data == NULL ||
+	    length == 0 || length > UINT16_MAX) {
+		pr_err("%s: invalid transfer\n", __func__);
+		return (-EINVAL);
+	}
+	mtx_lock(&context->lock);
+	xfer = &context->transfers[channel];
+	if (!context->published || context->stopping || context->quiescing ||
+	    context->state != 2 ||
+	    !xfer->started ||
+	    xfer->direction != DMA_TO_DEVICE || context->event_error != 0 ||
+	    xfer->queued >= xfer->count - 1) {
+		error = context->event_error != 0 ? context->event_error : EBUSY;
+		goto out;
+	}
+	slot = &xfer->slots[xfer->write_offset / sizeof(*tre)];
+	mhi_dma_cpu(&slot->dma);
+	memcpy(slot->dma.vaddr, data, length);
+	slot->length = length;
+	mhi_dma_sync(&slot->dma);
+	mhi_dma_cpu(&context->channel_rings[channel]);
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)
+	    context->channel_rings[channel].vaddr + xfer->write_offset);
+	tre->ptr = htole64(slot->dma.address);
+	tre->dword[0] = htole32(length);
+	tre->dword[1] = htole32(0x20200);
+	mhi_dma_sync(&context->channel_rings[channel]);
+	xfer->write_offset = (xfer->write_offset + sizeof(*tre)) %
+	    context->channel_rings[channel].size;
+	xfer->queued++;
+	mhi_dma_cpu(&context->channels);
+	channels = context->channels.vaddr;
+	channels[channel].wp = htole64(context->channel_rings[channel].address +
+	    xfer->write_offset);
+	mhi_dma_sync(&context->channels);
+	mhi_boot_write64(ctrl, context->channel_db + channel * 8,
+	    context->channel_rings[channel].address + xfer->write_offset);
+out:
+	mtx_unlock(&context->lock);
+	if (error != 0)
+		pr_err("%s: channel %u transfer failed: %d\n",
+		    __func__, channel, error);
+	return (-error);
+}
+
+static int
+mhi_complete_command(struct mhi_controller *ctrl, uint64_t pointer,
+    uint32_t code)
+{
+	struct lkpi_mhi_context *context = ctrl->lkpi_context;
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_xfer *xfer;
+	struct lkpi_mhi_tre *tre;
+	unsigned int channel = context->command_channel;
+	int error = 0;
+
+	if (!context->command_pending || code != 1 ||
+	    pointer != context->command_ring.address + context->command_read)
+		return (EIO);
+	mhi_dma_cpu(&context->command_ring);
+	tre = (struct lkpi_mhi_tre *)((uint8_t *)context->command_ring.vaddr +
+	    context->command_read);
+	if ((context->command_type != 17 && context->command_type != 18) ||
+	    le32toh(tre->dword[1]) !=
+	    ((channel << 24) | (context->command_type << 16)))
+		error = EIO;
+	mhi_dma_sync(&context->command_ring);
+	if (error != 0)
+		return (error);
+	xfer = &context->transfers[channel];
+	xfer->starting = false;
+	xfer->started = context->command_type == 18;
+	context->command_pending = false;
+	context->command_read = (context->command_read + sizeof(*tre)) %
+	    context->command_ring.size;
+	context->command_events++;
+	if (xfer->started && xfer->direction == DMA_FROM_DEVICE) {
+		xfer->write_offset = (xfer->count - 1) * sizeof(*tre);
+		xfer->queued = xfer->count - 1;
+		mhi_dma_cpu(&context->channels);
+		channels = context->channels.vaddr;
+		channels[channel].wp = htole64(
+		    context->channel_rings[channel].address + xfer->write_offset);
+		mhi_dma_sync(&context->channels);
+		mhi_boot_write64(ctrl, context->channel_db + channel * 8,
+		    context->channel_rings[channel].address + xfer->write_offset);
+	}
+	wakeup(context);
+	return (0);
+}
+
+int
+linuxkpi_mhi_shutdown(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_context *context;
+	sbintime_t deadline;
+	uint32_t control, status;
+	unsigned int channel;
+	bool started, pending;
+	int error, first_error = 0;
+
+	if (ctrl == NULL || (context = ctrl->lkpi_context) == NULL)
+		return (-ENXIO);
+	mtx_lock(&context->lock);
+	context->stopping = true;
+	mtx_unlock(&context->lock);
+	for (channel = 20; channel <= 21 && channel < context->max_channels;
+	    channel++) {
+		mtx_lock(&context->lock);
+		started = context->transfers[channel].started;
+		mtx_unlock(&context->lock);
+		if (!started)
+			continue;
+		error = -linuxkpi_mhi_stop_channel(ctrl, channel);
+		if (error == 0) {
+			deadline = sbinuptime() + 5 * SBT_1S;
+			do {
+				error = -linuxkpi_mhi_process_events(ctrl);
+				mtx_lock(&context->lock);
+				pending = context->command_pending;
+				mtx_unlock(&context->lock);
+				if (error != 0 || !pending)
+					break;
+				pause_sbt("mhistop", SBT_1MS, 0, C_HARDCLOCK);
+			} while (sbinuptime() < deadline);
+			if (error == 0 && pending)
+				error = ETIMEDOUT;
+		}
+		if (error != 0) {
+			pr_err("%s: channel %u stop failed: %d; reset required\n",
+			    __func__, channel, error);
+			if (first_error == 0)
+				first_error = error;
+		}
+	}
+	/* Match qwz: drain events, request M3, then let the caller reset. */
+	error = -linuxkpi_mhi_process_events(ctrl);
+	if (error != 0 && first_error == 0)
+		first_error = error;
+	error = mhi_boot_read(ctrl, LKPI_MHI_STATUS, &status);
+	if (error == 0 && ((status >> 8) & 0xff) == 2) {
+		error = mhi_boot_read(ctrl, LKPI_MHI_CTRL, &control);
+		if (error == 0) {
+			ctrl->write_reg(ctrl, (uint8_t *)ctrl->regs + LKPI_MHI_CTRL,
+			    (control & ~0xff00U) | (5U << 8));
+			deadline = sbinuptime() + SBT_1S;
+			do {
+				error = mhi_boot_read(ctrl, LKPI_MHI_STATUS,
+				    &status);
+				if (error != 0 || ((status >> 8) & 0xff) == 5)
+					break;
+				pause_sbt("mhim3", 10 * SBT_1MS, 0, C_HARDCLOCK);
+			} while (sbinuptime() < deadline);
+			if (error == 0 && ((status >> 8) & 0xff) != 5)
+				error = ETIMEDOUT;
+		}
+	}
+	if (error != 0) {
+		pr_err("%s: M3 transition failed: %d; reset required\n",
+		    __func__, error);
+		if (first_error == 0)
+			first_error = error;
+	}
+	linuxkpi_mhi_power_down(ctrl);
+	return (-first_error);
+}
+
+static int
+mhi_complete_transfer(struct mhi_controller *ctrl, unsigned int event_ring,
+    struct lkpi_mhi_tre *event)
+{
+	struct lkpi_mhi_context *context = ctrl->lkpi_context;
+	struct lkpi_mhi_channel_context *channels;
+	struct lkpi_mhi_xfer *xfer;
+	struct lkpi_mhi_dma *ring;
+	struct lkpi_mhi_slot *slot;
+	uint64_t pointer = le64toh(event->ptr);
+	uint32_t word = le32toh(event->dword[0]);
+	unsigned int channel = le32toh(event->dword[1]) >> 24;
+	size_t offset, completed, length, i;
+	int error;
+
+	if (channel >= context->max_channels || (word >> 24) != 2)
+		return (EIO);
+	xfer = &context->transfers[channel];
+	ring = &context->channel_rings[channel];
+	if ((!xfer->started && !context->stopping) ||
+	    xfer->slots == NULL || xfer->event_ring != event_ring ||
+	    pointer < ring->address || pointer - ring->address >= ring->size ||
+	    ((pointer - ring->address) & 15) != 0)
+		return (EIO);
+	offset = pointer - ring->address;
+	completed = ((offset + ring->size - xfer->read_offset) % ring->size) /
+	    sizeof(*event) + 1;
+	if (completed > xfer->queued)
+		return (EIO);
+	if (xfer->direction == DMA_FROM_DEVICE && completed != 1)
+		return (EOPNOTSUPP);
+	length = word & UINT16_MAX;
+	slot = &xfer->slots[offset / sizeof(*event)];
+	if (xfer->direction == DMA_FROM_DEVICE &&
+	    (length == 0 || length > slot->dma.size))
+		return (EIO);
+	for (i = 0; i < completed; i++) {
+		slot = &xfer->slots[xfer->read_offset / sizeof(*event)];
+		mhi_dma_cpu(&slot->dma);
+		if (xfer->direction == DMA_FROM_DEVICE) {
+			memcpy(context->rx_sample, slot->dma.vaddr,
+			    MIN(length, sizeof(context->rx_sample)));
+			context->rx_length = length;
+			context->rx_packets++;
+			error = context->stopping || context->receive == NULL ? 0 :
+			    context->receive(context->receive_arg,
+			    slot->dma.vaddr, length);
+			mhi_dma_sync(&slot->dma);
+			if (error != 0)
+				return (error);
+			if (context->stopping)
+				xfer->queued--;
+			else
+				xfer->write_offset =
+				    (xfer->write_offset + sizeof(*event)) %
+				    ring->size;
+		} else {
+			slot->length = 0;
+			xfer->queued--;
+			context->tx_packets++;
+		}
+		xfer->read_offset = (xfer->read_offset + sizeof(*event)) %
+		    ring->size;
+	}
+	if (xfer->direction == DMA_FROM_DEVICE && !context->stopping) {
+		mhi_dma_cpu(&context->channels);
+		channels = context->channels.vaddr;
+		channels[channel].wp = htole64(ring->address + xfer->write_offset);
+		mhi_dma_sync(&context->channels);
+		mhi_boot_write64(ctrl, context->channel_db + channel * 8,
+		    ring->address + xfer->write_offset);
+	}
+	wakeup(context);
+	return (0);
+}
+
+static int
+mhi_process_events_locked(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_context *context;
+	struct lkpi_mhi_event_context *events;
+	struct lkpi_mhi_event_ring *event;
+	struct lkpi_mhi_dma *ring;
+	struct lkpi_mhi_tre *tre;
+	uint64_t rp;
+	uint32_t type, code;
+	size_t end;
+	unsigned int i;
+	int error = 0;
+
+	context = ctrl->lkpi_context;
+	mtx_assert(&context->lock, MA_OWNED);
+	mhi_dma_cpu(&context->events);
+	events = context->events.vaddr;
+	for (i = 0; i < context->num_events; i++) {
+		event = &context->event_rings[i];
+		ring = &event->dma;
+		rp = le64toh(events[i].rp);
+		if (rp < ring->address || rp - ring->address >= ring->size ||
+		    ((rp - ring->address) & 15) != 0 ||
+		    le64toh(events[i].wp) != ring->address + event->write_offset ||
+		    le64toh(events[i].rbase) != ring->address ||
+		    le64toh(events[i].rlen) != ring->size) {
+			error = EIO;
+			break;
+		}
+		end = rp - ring->address;
+		if (end == event->read_offset)
+			continue;
+		mhi_dma_cpu(ring);
+		while (event->read_offset != end) {
+			tre = (struct lkpi_mhi_tre *)((uint8_t *)ring->vaddr +
+			    event->read_offset);
+			type = (le32toh(tre->dword[1]) >> 16) & 0xff;
+			code = le32toh(tre->dword[0]) >> 24;
+			switch (type) {
+			case 0x21:
+				error = event->type != MHI_ER_CTRL ? EIO :
+				    mhi_complete_command(ctrl, le64toh(tre->ptr), code);
+				break;
+			case 0x22:
+				error = mhi_complete_transfer(ctrl, i, tre);
+				break;
+			case 0x20:
+				context->state = code;
+				context->state_events++;
+				if (code > 7)
+					error = EIO;
+				break;
+			case 0x40:
+				context->ee = code;
+				context->ee_events++;
+				if (code > 2)
+					error = EIO;
+				break;
+			default:
+				error = EOPNOTSUPP;
+				break;
+			}
+			if (error != 0) {
+				pr_err("%s: unsupported/error event type=%#x code=%#x\n",
+				    __func__, type, code);
+				break;
+			}
+			event->read_offset = (event->read_offset + sizeof(*tre)) %
+			    ring->size;
+			event->write_offset = (event->write_offset + sizeof(*tre)) %
+			    ring->size;
+		}
+		mhi_dma_sync(ring);
+		if (error != 0)
+			break;
+		events[i].wp = htole64(ring->address + event->write_offset);
+		mhi_dma_sync(&context->events);
+		mhi_boot_write64(ctrl, context->event_db + i * 8,
+		    ring->address + event->write_offset);
+		mhi_dma_cpu(&context->events);
+	}
+	mhi_dma_sync(&context->events);
+	if (error != 0)
+		pr_err("%s: event ring processing failed: %d\n", __func__, error);
+	return (-error);
+}
+
+int
+linuxkpi_mhi_process_events(struct mhi_controller *ctrl)
+{
+	struct lkpi_mhi_context *context;
+	int error;
+
+	if (ctrl == NULL || (context = ctrl->lkpi_context) == NULL) {
+		pr_err("%s: no event contexts\n", __func__);
+		return (-EINVAL);
+	}
+	mtx_lock(&context->lock);
+	if (!context->published || context->quiescing)
+		error = 0;
+	else if (context->event_error != 0)
+		error = -context->event_error;
+	else {
+		error = mhi_process_events_locked(ctrl);
+		if (error != 0) {
+			context->event_error = -error;
+			wakeup(context);
+		}
+	}
+	mtx_unlock(&context->lock);
+	return (error);
+}
+
+static int
+mhi_boot_wait_ee(struct mhi_controller *ctrl, struct lkpi_mhi_boot *boot,
+    uint32_t expected)
+{
+	struct lkpi_mhi_context *context = ctrl->lkpi_context;
+	sbintime_t deadline = sbinuptime() + ctrl->timeout_ms * SBT_1MS;
+	uint32_t status = 0;
+	bool ready;
+	int error;
+
+	do {
+		error = -linuxkpi_mhi_process_events(ctrl);
+		if (error != 0)
+			goto fail;
+		error = mhi_boot_read(ctrl, LKPI_MHI_STATUS, &status);
+		if (error != 0)
+			goto fail;
+		error = mhi_boot_read(ctrl, boot->bhi + LKPI_MHI_BHI_EXECENV,
+		    &boot->ee);
+		if (error != 0)
+			goto fail;
+		if ((status & 4) != 0 || boot->ee > 2) {
+			error = EIO;
+			goto fail;
+		}
+		if (((status >> 8) & 0xff) == 2 && boot->ee == expected) {
+			/* Channel startup requires the mission-mode events too. */
+			mtx_lock(&context->lock);
+			ready = expected != 2 ||
+			    (context->state == 2 && context->ee == expected);
+			mtx_unlock(&context->lock);
+			if (ready)
+				return (0);
+		}
+		pause_sbt("mhiee", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	error = ETIMEDOUT;
+fail:
+	pr_err("%s: M0/EE%u wait failed: %d (MHISTATUS=%#x EE=%u)\n",
+	    __func__, expected, error, status, boot->ee);
+	return (-error);
+}
+
+static bool
+mhi_ranges_overlap(uint32_t a, uint32_t alen, uint32_t b, uint32_t blen)
+{
+	return (a < b + blen && b < a + alen);
+}
+
+int
+linuxkpi_mhi_boot_ready(struct mhi_controller *ctrl, struct lkpi_mhi_boot *boot)
+{
+	struct lkpi_mhi_context *context;
+	sbintime_t deadline;
+	uint32_t status = 0, control, config, bhie, chlen, erlen, limit;
+	unsigned int i;
+	int error;
+
+	if (ctrl == NULL || boot == NULL ||
+	    (context = ctrl->lkpi_context) == NULL || context->published ||
+	    !boot->pending || (boot->status >> 30) != 2 ||
+	    ctrl->regs == NULL || ctrl->read_reg == NULL ||
+	    ctrl->write_reg == NULL || ctrl->reg_len < 0xac ||
+	    ctrl->nr_irqs <= 0 ||
+	    ctrl->timeout_ms == 0 || ctrl->timeout_ms > 10000 ||
+	    ctrl->iova_start > ctrl->iova_stop) {
+		pr_err("%s: invalid READY transition parameters\n", __func__);
+		return (-EINVAL);
+	}
+	for (i = 0; i < context->num_events; i++)
+		if (context->event_rings[i].irq >= ctrl->nr_irqs) {
+			pr_err("%s: missing event MSI vector\n", __func__);
+			return (-EINVAL);
+		}
+	deadline = sbinuptime() + ctrl->timeout_ms * SBT_1MS;
+	do {
+		error = mhi_boot_read(ctrl, LKPI_MHI_CTRL, &control);
+		if (error != 0)
+			goto fail;
+		error = mhi_boot_read(ctrl, LKPI_MHI_STATUS, &status);
+		if (error != 0)
+			goto fail;
+		if ((status & 4) != 0) {
+			error = EIO;
+			goto fail;
+		}
+		if ((control & 2) == 0 && (status & 1) != 0)
+			break;
+		pause_sbt("mhiready", SBT_1MS, 0, C_HARDCLOCK);
+	} while (sbinuptime() < deadline);
+	if ((control & 2) != 0 || (status & 1) == 0) {
+		error = ETIMEDOUT;
+		goto fail;
+	}
+	error = mhi_boot_read(ctrl, 0x18, &context->channel_db);
+	if (error != 0)
+		goto fail;
+	error = mhi_boot_read(ctrl, 0x20, &context->event_db);
+	if (error != 0)
+		goto fail;
+	error = mhi_boot_read(ctrl, 0x2c, &bhie);
+	if (error != 0)
+		goto fail;
+	limit = MIN(ctrl->reg_len, 0xfe0);
+	chlen = MAX(context->max_channels, 128) * 8;
+	erlen = context->num_events * 8;
+	if (boot->bhi < 0xb0 || (boot->bhi & 3) != 0 ||
+	    boot->bhi > limit - 0x40 ||
+	    context->channel_db < 0xb0 || (context->channel_db & 7) != 0 ||
+	    context->channel_db > limit || chlen > limit - context->channel_db ||
+	    context->event_db < 0xb0 || (context->event_db & 7) != 0 ||
+	    context->event_db > limit || erlen > limit - context->event_db ||
+	    bhie < 0xb0 || (bhie & 3) != 0 || bhie > limit - 0x7c ||
+	    mhi_ranges_overlap(context->channel_db, chlen,
+	    context->event_db, erlen) ||
+	    mhi_ranges_overlap(context->channel_db, chlen, boot->bhi, 0x40) ||
+	    mhi_ranges_overlap(context->event_db, erlen, boot->bhi, 0x40) ||
+	    mhi_ranges_overlap(context->channel_db, chlen, bhie, 0x7c) ||
+	    mhi_ranges_overlap(context->event_db, erlen, bhie, 0x7c)) {
+		error = EINVAL;
+		goto fail;
+	}
+	error = mhi_boot_read(ctrl, 0x10, &config);
+	if (error != 0)
+		goto fail;
+	/* Any partial register publication now requires a confirmed device reset. */
+	mtx_lock(&context->lock);
+	context->published = true;
+	mhi_boot_write(ctrl, LKPI_MHI_STATUS, status & ~1U);
+	mhi_dma_sync(&context->channels);
+	mhi_dma_sync(&context->events);
+	mhi_dma_sync(&context->commands);
+	mhi_dma_sync(&context->command_ring);
+	for (i = 0; i < context->num_events; i++)
+		mhi_dma_sync(&context->event_rings[i].dma);
+	for (i = 0; i < context->max_channels; i++)
+		mhi_dma_sync(&context->channel_rings[i]);
+	mhi_boot_write64(ctrl, 0x58, context->channels.address);
+	mhi_boot_write64(ctrl, 0x60, context->events.address);
+	mhi_boot_write64(ctrl, 0x68, context->commands.address);
+	mhi_boot_write64(ctrl, 0x80, ctrl->iova_start);
+	mhi_boot_write64(ctrl, 0x88,
+	    MIN(ctrl->iova_stop, BUS_SPACE_MAXADDR_32BIT));
+	mhi_boot_write64(ctrl, 0x98, ctrl->iova_start);
+	mhi_boot_write64(ctrl, 0xa0,
+	    MIN(ctrl->iova_stop, BUS_SPACE_MAXADDR_32BIT));
+	config = (config & 0xffff) | (context->num_events << 16);
+	mhi_boot_write(ctrl, 0x10, config);
+	for (i = 0; i < context->num_events; i++)
+		mhi_boot_write64(ctrl, context->event_db + i * 8,
+		    context->event_rings[i].dma.address +
+		    context->event_rings[i].write_offset);
+	mhi_boot_write(ctrl, LKPI_MHI_CTRL, (control & ~0xff00U) | 0x200);
+	mtx_unlock(&context->lock);
+	error = -mhi_boot_wait_ee(ctrl, boot, 1);
+	if (error != 0)
+		goto fail;
+	mhi_boot_write64(ctrl, context->channel_db + 127 * 8, 1);
+	return (0);
+fail:
+	pr_err("%s: READY transition failed: %d (MHISTATUS=%#x published=%u)\n",
+	    __func__, error, status, context->published);
+	return (-error);
+}
+
+static void
+mhi_boot_free_firmware(struct lkpi_mhi_boot *boot)
+{
+	unsigned int i;
+
+	if (boot->segments != NULL)
+		for (i = 0; i < boot->num_segments; i++)
+			mhi_dma_free(&boot->segments[i]);
+	mhi_dma_free(&boot->vectors);
+	free(boot->segments, M_LKPIMHI);
+	boot->segments = NULL;
+	boot->num_segments = 0;
+}
+
+int
+linuxkpi_mhi_boot_free(struct lkpi_mhi_boot *boot)
+{
+	if (boot == NULL) {
+		pr_err("%s: invalid boot transfer\n", __func__);
+		return (-EINVAL);
+	}
+	if (boot->pending) {
+		pr_err("%s: device reset required before releasing boot DMA\n",
+		    __func__);
+		return (-EBUSY);
+	}
+	mhi_boot_free_firmware(boot);
+	mhi_dma_free(&boot->image);
+	return (0);
+}
+
+int
+linuxkpi_mhi_boot_bhi(struct mhi_controller *ctrl, struct lkpi_mhi_boot *boot,
+    const void *data, size_t length)
+{
+	sbintime_t deadline;
+	uint32_t control, status, sequence;
+	uint8_t *base;
+	int error;
+
+	if (ctrl == NULL || boot == NULL || data == NULL || length == 0 ||
+	    length > LKPI_MHI_BHI_SIZE || ctrl->cntrl_dev == NULL ||
+	    ctrl->cntrl_dev->bsddev == NULL || ctrl->regs == NULL ||
+	    ctrl->read_reg == NULL || ctrl->write_reg == NULL ||
+	    ctrl->reg_len < 0x4c || ctrl->timeout_ms == 0 ||
+	    ctrl->timeout_ms > 10000 || ctrl->iova_start > ctrl->iova_stop) {
+		pr_err("%s: invalid boot transfer parameters\n", __func__);
+		return (-EINVAL);
+	}
+	if (boot->pending || boot->image.vaddr != NULL) {
+		pr_err("%s: previous boot transfer has not been released\n",
+		    __func__);
+		return (-EBUSY);
+	}
+	boot->bhi = boot->status = boot->ee = 0;
+	error = mhi_boot_read(ctrl, LKPI_MHI_BHI_OFFSET, &boot->bhi);
+	if (error != 0)
+		goto fail;
+	/* WCN7850 boot registers must stay in the always-accessible MHI area. */
+	if (boot->bhi < 0xb0 || (boot->bhi & 3) != 0 ||
+	    boot->bhi > MIN(ctrl->reg_len, 0xfe0) - 0x40) {
+		error = EINVAL;
+		goto fail;
+	}
+	error = mhi_boot_read(ctrl, LKPI_MHI_CTRL, &control);
+	if (error != 0)
+		goto fail;
+	error = mhi_boot_read(ctrl, LKPI_MHI_STATUS, &status);
+	if (error != 0)
+		goto fail;
+	error = mhi_boot_read(ctrl, boot->bhi + LKPI_MHI_BHI_EXECENV,
+	    &boot->ee);
+	if (error != 0)
+		goto fail;
+	if (boot->ee != 0 || (control & 0xff02) != 0 ||
+	    (status & 0xff05) != 0) {
+		error = EBUSY;
+		goto fail;
+	}
+	error = mhi_dma_alloc(ctrl, &boot->image, length, 64);
+	if (error != 0) {
+		mhi_dma_free(&boot->image);
+		goto fail;
+	}
+	memcpy(boot->image.vaddr, data, length);
+	mhi_dma_sync(&boot->image);
+	base = (uint8_t *)ctrl->regs + boot->bhi;
+	sequence = arc4random_uniform(0x3fffffff) + 1;
+	/* From this point even a failed MMIO read requires reset before free. */
+	boot->pending = true;
+	ctrl->write_reg(ctrl, base + 0x20, 0);
+	ctrl->write_reg(ctrl, base + LKPI_MHI_BHI_STATUS, 0);
+	ctrl->write_reg(ctrl, base + 0x0c, boot->image.address >> 32);
+	ctrl->write_reg(ctrl, base + 0x08, (uint32_t)boot->image.address);
+	ctrl->write_reg(ctrl, base + 0x10, length);
+	ctrl->write_reg(ctrl, base + 0x18, sequence);
+	deadline = sbinuptime() + ctrl->timeout_ms * SBT_1MS;
+	do {
+		error = mhi_boot_read(ctrl, boot->bhi + LKPI_MHI_BHI_STATUS,
+		    &boot->status);
+		if (error != 0)
+			goto fail;
+		error = mhi_boot_read(ctrl, boot->bhi + LKPI_MHI_BHI_EXECENV,
+		    &boot->ee);
+		if (error != 0)
+			goto fail;
+		error = mhi_boot_read(ctrl, LKPI_MHI_STATUS, &status);
+		if (error != 0)
+			goto fail;
+		if ((status & 4) != 0 || (boot->status >> 30) == 3) {
+			error = EIO;
+			goto fail;
+		}
+		if ((boot->status >> 30) == 2)
+			return (0);
+		if (sbinuptime() >= deadline)
+			break;
+		pause_sbt("mhibhi", SBT_1MS, 0, C_HARDCLOCK);
+	} while (true);
+	error = ETIMEDOUT;
+fail:
+	pr_err("%s: BHI transfer failed: %d (status=%#x EE=%u pending=%u)\n",
+	    __func__, error, boot->status, boot->ee, boot->pending);
+	return (-error);
+}
+
+int
+linuxkpi_mhi_boot_bhie(struct mhi_controller *ctrl, struct lkpi_mhi_boot *boot,
+    const void *data, size_t length)
+{
+	struct lkpi_mhi_vector *vectors;
+	struct lkpi_mhi_dma *segment;
+	sbintime_t deadline;
+	const uint8_t *bytes = data;
+	size_t remaining, size;
+	uint32_t status, doorbell, limit;
+	unsigned int i;
+	int error;
+
+	if (ctrl == NULL || boot == NULL || data == NULL || length == 0 ||
+	    length > UINT32_MAX || ctrl->cntrl_dev == NULL ||
+	    ctrl->cntrl_dev->bsddev == NULL || ctrl->lkpi_context == NULL ||
+	    !ctrl->lkpi_context->published || !boot->pending ||
+	    boot->segments != NULL || ctrl->regs == NULL ||
+	    ctrl->read_reg == NULL || ctrl->write_reg == NULL ||
+	    ctrl->reg_len < 0xac || ctrl->timeout_ms == 0 ||
+	    ctrl->timeout_ms > 10000 || ctrl->iova_start > ctrl->iova_stop) {
+		pr_err("%s: invalid BHIE transfer parameters\n", __func__);
+		return (-EINVAL);
+	}
+	boot->bhie_status = 0;
+	error = mhi_boot_read(ctrl, 0x2c, &boot->bhie);
+	if (error != 0)
+		goto fail;
+	limit = MIN(ctrl->reg_len, 0xfe0);
+	if (boot->bhie < 0xb0 || (boot->bhie & 3) != 0 ||
+	    boot->bhie > limit - 0x7c ||
+	    mhi_ranges_overlap(boot->bhie, 0x7c, boot->bhi, 0x40) ||
+	    mhi_ranges_overlap(boot->bhie, 0x7c,
+	    ctrl->lkpi_context->channel_db,
