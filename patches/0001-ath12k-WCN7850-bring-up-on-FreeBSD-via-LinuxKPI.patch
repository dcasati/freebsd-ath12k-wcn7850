+static size_t
+mhi_qmi_model_packet(uint8_t *packet, uint8_t type, uint16_t transaction,
+    uint16_t message, size_t body)
+{
+	size_t length = roundup2(39 + body, 4);
+
+	memset(packet, 0, length);
+	le32enc(packet, 1);
+	le32enc(packet + 4, 1);
+	le32enc(packet + 8, 7);
+	le32enc(packet + 12, 1);
+	le32enc(packet + 20, 7 + body);
+	le32enc(packet + 24, 1);
+	le32enc(packet + 28, 0x4000);
+	packet[32] = type;
+	le16enc(packet + 33, transaction);
+	le16enc(packet + 35, message);
+	le16enc(packet + 37, body);
+	if (type == 2) {
+		packet[39] = 2;
+		le16enc(packet + 40, 4);
+	}
+	return (length);
+}
