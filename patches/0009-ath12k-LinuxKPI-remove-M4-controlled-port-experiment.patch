 	p->pairwise = p->group = 0;
 	p->exchange = p->acked = p->failed = false;
-	p->no_ack = false;
-}
-
-static inline void
-lkpi_sta_port_init(struct lkpi_sta_port *p, bool initial_no_ack)
-{
-	lkpi_sta_port_reset(p);
-	p->initial_no_ack = initial_no_ack;
 }
 
