@@ -60,7 +50,6 @@ lkpi_sta_port_m3(struct lkpi_sta_port *p, uint64_t replay, const uint8_t nonce[3
 		p->acked = false;
 	} else {
 		lkpi_sta_port_reset(p);
-		p->no_ack = p->initial_no_ack;
 	}
 	for (i = 0; i < sizeof(p->anonce); i++)
 		p->anonce[i] = nonce[i];
@@ -72,20 +61,10 @@ lkpi_sta_port_m3(struct lkpi_sta_port *p, uint64_t replay, const uint8_t nonce[3
 static inline bool
 lkpi_sta_port_ready(const struct lkpi_sta_port *p)
 {
-	return (p->exchange && (p->acked || p->no_ack) && !p->failed &&
+	return (p->exchange && p->acked && !p->failed &&
 	    p->pairwise != 0 && p->group != 0);
 }
 
