+static inline uint8_t
+ieee80211_eht_mcs_nss_size(const struct ieee80211_he_cap_elem *he_cap,
+    const struct ieee80211_eht_cap_elem_fixed *eht_cap, bool from_ap)
+{
+	unsigned int sets;
+	uint8_t widths;
+
+	/* Three octets per bandwidth, four for a 20 MHz-only non-AP STA. */
+	widths = he_cap->phy_cap_info[0];
+	sets = ((widths &
+	    IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_80MHZ_IN_5G) != 0) +
+	    ((widths &
+	    IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_160MHZ_IN_5G) != 0) +
+	    ((eht_cap->phy_cap_info[0] &
+	    IEEE80211_EHT_PHY_CAP0_320MHZ_IN_6GHZ) != 0);
+	if (widths & IEEE80211_HE_PHY_CAP0_CHANNEL_WIDTH_SET_40MHZ_IN_2G)
+		sets = 1;
+	if (sets != 0)
+		return (sets * sizeof(struct ieee80211_eht_mcs_nss_supp_bw));
+	return (from_ap ? sizeof(struct ieee80211_eht_mcs_nss_supp_bw) :
+	    sizeof(struct ieee80211_eht_mcs_nss_supp_20mhz_only));
+}
