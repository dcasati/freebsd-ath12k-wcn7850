+/*
+ * True when one rule spans [start, start + width) MHz and every rule
+ * overlapping that span permits the whole width (no no_flag, max bandwidth
+ * >= width), allows no less power or antenna gain than the primary channel,
+ * and adds no NO_IR/DFS restriction the primary channel lacks.
+ * AUTO_BW stitching is not implemented.
+ */
+static bool
+lkpi_regulatory_span(const struct linuxkpi_ieee80211_regdomain *regd,
+    u_int start, u_int width, uint32_t no_flag, int power, int gain,
+    uint32_t primary_rrf)
+{
+	const struct ieee80211_reg_rule *rule;
+	int64_t low, high;
+	bool spanned;
+	int i;
+
+	low = (int64_t)start * 1000;
+	high = low + (int64_t)width * 1000;
+	spanned = false;
+	for (i = 0; i < regd->n_reg_rules; i++) {
+		rule = &regd->reg_rules[i];
+		if (rule->freq_range.end_freq_khz <= low ||
+		    rule->freq_range.start_freq_khz >= high)
+			continue;
+		if ((rule->flags & no_flag) != 0 ||
+		    (rule->flags & ~(NL80211_RRF_AUTO_BW |
+		    NL80211_RRF_NO_HT40 | NL80211_RRF_NO_80MHZ |
+		    NL80211_RRF_NO_160MHZ | NL80211_RRF_NO_HE |
+		    NL80211_RRF_NO_EHT | NL80211_RRF_NO_320MHZ |
+		    NL80211_RRF_NO_IR | NL80211_RRF_DFS |
+		    NL80211_RRF_NO_OUTDOOR)) != 0 ||
+		    (rule->flags & (NL80211_RRF_NO_IR | NL80211_RRF_DFS) &
+		    ~primary_rrf) != 0 ||
+		    rule->freq_range.max_bandwidth_khz < high - low ||
+		    rule->power_rule.max_eirp / 100 < power ||
+		    rule->power_rule.max_antenna_gain / 100 < gain)
+			return (false);
+		if (rule->freq_range.start_freq_khz <= low &&
+		    rule->freq_range.end_freq_khz >= high)
+			spanned = true;
+	}
+	return (spanned);
+}
+
+/*
+ * Deliberately do not implement AUTO_BW stitching, DFS/CAC, beacon hints,
+ * indoor location or PSD.  A single rule must contain the entire occupied
+ * 20 MHz interval.  Every overlapping rule restricts that interval; never
+ * pick a more permissive rule merely because it occurs first.
+ */
+int
+lkpi_regulatory_channel(const struct linuxkpi_ieee80211_regdomain *regd,
+    const struct linuxkpi_ieee80211_channel *in,
+    struct linuxkpi_ieee80211_channel *out)
+{
+	const struct ieee80211_reg_rule *rule;
+	int64_t low, high;
+	uint32_t primary_rrf, restrict_flags;
+	int i, power, gain;
+	bool covered, prohibited;
+
+	*out = *in;
+	out->flags |= IEEE80211_CHAN_DISABLED | IEEE80211_CHAN_NO_HT40 |
+	    IEEE80211_CHAN_NO_80MHZ | IEEE80211_CHAN_NO_160MHZ;
+	if ((in->band != NL80211_BAND_2GHZ &&
+	    in->band != NL80211_BAND_5GHZ) ||
+	    (in->band == NL80211_BAND_2GHZ &&
+	    (in->center_freq < 2412 || in->center_freq > 2484)) ||
+	    (in->band == NL80211_BAND_5GHZ &&
+	    (in->center_freq < 5180 || in->center_freq > 5885)))
+		return (-EOPNOTSUPP);
+
+	low = (int64_t)in->center_freq * 1000 - 10000;
+	high = (int64_t)in->center_freq * 1000 + 10000;
+	power = in->max_power;
+	gain = 63;
+	primary_rrf = restrict_flags = 0;
+	covered = prohibited = false;
+	for (i = 0; i < regd->n_reg_rules; i++) {
+		rule = &regd->reg_rules[i];
+		if (rule->freq_range.end_freq_khz <= low ||
+		    rule->freq_range.start_freq_khz >= high)
+			continue;
+		/* Restrictions on even a partially overlapping rule apply. */
+		if (rule->flags & ~(NL80211_RRF_AUTO_BW |
+		    NL80211_RRF_NO_HT40 | NL80211_RRF_NO_80MHZ |
+		    NL80211_RRF_NO_160MHZ | NL80211_RRF_NO_HE |
+		    NL80211_RRF_NO_EHT | NL80211_RRF_NO_320MHZ |
+		    NL80211_RRF_NO_IR | NL80211_RRF_DFS |
+		    NL80211_RRF_NO_OUTDOOR))
+			prohibited = true;
+		/*
+		 * LinuxKPI only offers station/monitor modes, so no-IR and
+		 * radar channels stay usable as passive (listen-first) ones.
+		 */
+		primary_rrf |= rule->flags &
+		    (NL80211_RRF_NO_IR | NL80211_RRF_DFS);
+		if (rule->flags & NL80211_RRF_NO_IR)
+			restrict_flags |= IEEE80211_CHAN_NO_IR;
+		if (rule->flags & NL80211_RRF_DFS)
+			restrict_flags |= IEEE80211_CHAN_NO_IR |
+			    IEEE80211_CHAN_RADAR;
+		if (rule->freq_range.max_bandwidth_khz < 20000)
+			prohibited = true;
+		power = min(power, rule->power_rule.max_eirp / 100);
+		gain = min(gain, rule->power_rule.max_antenna_gain / 100);
+		if (rule->freq_range.start_freq_khz <= low &&
+		    rule->freq_range.end_freq_khz >= high)
+			covered = true;
+	}
+	if (!covered)
+		return (-ERANGE);
+	if (prohibited || power < 1 || power > 63 || gain < 0 || gain > 63 ||
+	    (in->flags & ~(IEEE80211_CHAN_NO_HT40 |
+	    IEEE80211_CHAN_NO_80MHZ | IEEE80211_CHAN_NO_160MHZ |
+	    IEEE80211_CHAN_NO_EHT | IEEE80211_CHAN_NO_IR |
+	    IEEE80211_CHAN_RADAR)) != 0)
+		return (-EOPNOTSUPP);
+
+	/*
+	 * 2.4 GHz and 160 MHz stay 20 MHz only.  On 5 GHz, permit HT40 only
+	 * towards the other half of the aligned 40 MHz pair, and VHT80 only
+	 * when that HT40 direction is permitted too.  Each wider span must be
+	 * fully covered by one rule and no overlapping rule may be stricter
+	 * than the primary channel.  Width flags the driver already set on the
+	 * input channel are preserved.
+	 */
+	if (in->band == NL80211_BAND_5GHZ) {
+		/* Lower edges of the 5 GHz 80 MHz blocks, in MHz. */
+		static const u_int blocks[] = {
+			5170, 5250, 5490, 5570, 5650, 5735,
+		};
+		uint32_t allow, dir;
+		u_int b, start;
+
+		allow = 0;
+		dir = IEEE80211_CHAN_NO_HT40PLUS;
+		for (b = 0; b < nitems(blocks); b++) {
+			start = blocks[b];
+			if (in->center_freq < start ||
+			    in->center_freq >= start + 80)
+				continue;
+			if (in->center_freq >= start + 40)
+				start += 40;
+			if (in->center_freq >= start + 20)
+				dir = IEEE80211_CHAN_NO_HT40MINUS;
+			if (!lkpi_regulatory_span(regd, start, 40,
+			    NL80211_RRF_NO_HT40, power, gain, primary_rrf))
+				break;
+			allow |= dir;
+			if (lkpi_regulatory_span(regd, blocks[b], 80,
+			    NL80211_RRF_NO_80MHZ, power, gain, primary_rrf))
+				allow |= IEEE80211_CHAN_NO_80MHZ;
+			break;
+		}
+		out->flags &= ~(allow & ~in->flags);
+		/* VHT80 requires the aligned HT40 direction. */
+		if (out->flags & dir)
+			out->flags |= IEEE80211_CHAN_NO_80MHZ;
+	}
+
+	out->flags &= ~IEEE80211_CHAN_DISABLED;
+	out->flags |= restrict_flags;
+	out->orig_flags = in->flags;
+	out->orig_mpwr = in->max_power;
+	out->max_power = out->max_reg_power = power;
+	out->max_antenna_gain = gain;
+	return (0);
+}
