+/* No sleeping/firmware calls here: net80211 callers may hold its locks. */
+static bool
+lkpi_sta_port_authorize(struct ieee80211_node *ni, bool authorize)
+{
+	struct lkpi_sta *lsta = ni->ni_drv_data;
+
+	if (lsta == NULL || !lkpi_sta_port_enabled(lsta))
+		return (true);
+	if (authorize)
+		return (atomic_load_acq_int(&lsta->port_open) != 0);
+	LKPI_80211_LSTA_TXQ_LOCK(lsta);
+	atomic_store_rel_int(&lsta->port_open, 0);
+	lkpi_sta_port_reset(&lsta->port);
+	LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+	lkpi_sta_port_queue(VAP_TO_LVIF(ni->ni_vap));
+	return (true);
+}
+
+/* Caller holds wiphy, never the TXQ mutex. Revoke host access first. */
+static int
+lkpi_sta_port_close(struct lkpi_sta *lsta)
+{
+	struct ieee80211vap *vap = lsta->ni->ni_vap;
+	int error = 0;
+
+	lockdep_assert_wiphy(lsta->hw->wiphy);
+	atomic_store_rel_int(&lsta->port_open, 0);
+	lsta->ni->ni_flags &= ~IEEE80211_NODE_AUTH;
+	if_link_state_change(vap->iv_ifp, LINK_STATE_DOWN);
+	if (lsta->state == IEEE80211_STA_AUTHORIZED)
+		error = lkpi_80211_mo_sta_state(lsta->hw,
+		    LVIF_TO_VIF(VAP_TO_LVIF(vap)), lsta, IEEE80211_STA_ASSOC);
+	if (error != 0) {
+		LKPI_80211_LSTA_TXQ_LOCK(lsta);
+		lsta->port.failed = true;
+		LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+	}
+	return (error);
+}
+
+static void
+lkpi_sta_port_task(void *arg, int pending __unused)
+{
+	struct lkpi_vif *lvif = arg;
+	struct ieee80211vap *vap = &lvif->iv_vap;
+	struct lkpi_hw *lhw = vap->iv_ic->ic_softc;
+	struct ieee80211_hw *hw = LHW_TO_HW(lhw);
+	struct lkpi_sta *lsta;
+	uint32_t epoch;
+	bool ready;
+	int error;
+
+	wiphy_lock(hw->wiphy);
+	lsta = lvif->lvif_bss;
+	if (atomic_load_acq_int(&lvif->port_dead) || lsta == NULL ||
+	    !lkpi_sta_port_enabled(lsta))
+		goto out;
+	LKPI_80211_LSTA_TXQ_LOCK(lsta);
+	epoch = lsta->port.epoch;
+	ready = lkpi_sta_port_ready(&lsta->port) &&
+	    atomic_load_acq_int(&lsta->port_key_busy) == 0;
+	LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+	ready &= vap->iv_state == IEEE80211_S_RUN && lvif->lvif_bss_synched &&
+	    LVIF_TO_VIF(lvif)->cfg.assoc && lkpi_reg_tx_allowed(hw->wiphy);
+	if (!ready) {
+		(void)lkpi_sta_port_close(lsta);
+		goto out;
+	}
+	if (lsta->state == IEEE80211_STA_ASSOC) {
+		error = lkpi_80211_mo_sta_state(hw, LVIF_TO_VIF(lvif),
+		    lsta, IEEE80211_STA_AUTHORIZED);
+		if (error != 0) {
+			LKPI_80211_LSTA_TXQ_LOCK(lsta);
+			lsta->port.failed = true;
+			LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+			(void)lkpi_sta_port_close(lsta);
+			goto out;
+		}
+	}
+	LKPI_80211_LSTA_TXQ_LOCK(lsta);
+	ready = lsta->state == IEEE80211_STA_AUTHORIZED &&
+	    epoch == lsta->port.epoch && lkpi_reg_tx_allowed(hw->wiphy) &&
+	    atomic_load_acq_int(&lsta->port_key_busy) == 0 &&
+	    lkpi_sta_port_ready(&lsta->port);
+	atomic_store_rel_int(&lsta->port_open, ready);
+	LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+	if (!ready) {
+		(void)lkpi_sta_port_close(lsta);
+		goto out;
+	}
+	ieee80211_node_authorize(lsta->ni);
+	if_link_state_change(vap->iv_ifp, LINK_STATE_UP);
+out:
+	wiphy_unlock(hw->wiphy);
+}
+
+/*
+ * Inspect only the fixed EAPOL-Key prefix. Never copy/log key data. Native
+ * net80211 frames may be chained; IV space exists on RX only if not stripped.
+ */
+static bool
+lkpi_sta_eapol(struct lkpi_sta *lsta, struct mbuf *m, bool rx,
+    unsigned int ivlen, int *message, uint64_t *replay, uint8_t *nonce)
+{
+	static const uint8_t llc[] = { 0xaa, 0xaa, 0x03, 0, 0, 0, 0x88, 0x8e };
+	struct ieee80211_frame wh;
+	uint8_t prefix[sizeof(llc) + 99];
+	unsigned int offset, len;
+
+	*message = 0;
+	if (m->m_pkthdr.len < sizeof(wh))
+		return (false);
+	m_copydata(m, 0, sizeof(wh), (void *)&wh);
+	if ((wh.i_fc[0] & IEEE80211_FC0_TYPE_MASK) != IEEE80211_FC0_TYPE_DATA ||
+	    (wh.i_fc[1] & IEEE80211_FC1_DIR_MASK) !=
+	    (rx ? IEEE80211_FC1_DIR_FROMDS : IEEE80211_FC1_DIR_TODS) ||
+	    !IEEE80211_ADDR_EQ(rx ? wh.i_addr2 : wh.i_addr1,
+	    lsta->ni->ni_bssid))
+		return (false);
+	offset = ieee80211_anyhdrsize(&wh) + ivlen;
+	if (m->m_pkthdr.len < offset + sizeof(llc))
+		return (false);
+	len = m->m_pkthdr.len - offset;
+	m_copydata(m, offset, min(len, sizeof(prefix)), prefix);
+	if (memcmp(prefix, llc, sizeof(llc)) != 0)
+		return (false);
+	if (len >= sizeof(prefix)) {
+		*message = lkpi_sta_port_eapol(prefix + sizeof(llc),
+		    len - sizeof(llc), replay);
+		if (*message == 3 && nonce != NULL)
+			memcpy(nonce, prefix + sizeof(llc) + 17, 32);
+	}
+	return (true);
+}
+
+static bool
+lkpi_sta_m4_check(struct lkpi_sta *lsta, struct mbuf *m)
+{
+	struct lkpi_sta_m4 token;
+	struct m_tag *tag;
+	uint64_t replay;
+	int message;
+	bool matches;
+
+	tag = m_tag_locate(m, MTAG_ABI_LKPI80211, LKPI80211_TAG_M4, NULL);
+	if (tag == NULL || tag->m_tag_len != sizeof(token) ||
+	    !lkpi_sta_eapol(lsta, m, false, 0, &message, &replay, NULL) ||
+	    message != 4)
+		return (false);
+	memcpy(&token, tag + 1, sizeof(token));
+	LKPI_80211_LSTA_TXQ_LOCK(lsta);
+	matches = token.replay == replay &&
+	    lkpi_sta_port_current(&lsta->port, token.epoch, token.replay) &&
+	    atomic_load_acq_int(&lsta->port_key_busy) == 0;
+	LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+	return (matches);
+}
+
+static bool
+lkpi_sta_tx_allowed(struct lkpi_sta *lsta, struct mbuf *m)
+{
+	uint8_t fc;
+	uint64_t replay;
+	int message;
+
+	if (!lkpi_sta_port_enabled(lsta) ||
+	    (atomic_load_acq_int(&lsta->port_open) &&
+	    atomic_load_acq_int(&lsta->port_key_busy) == 0))
+		return (true);
+	if (atomic_load_acq_int(&lsta->port_key_busy))
+		return (false);
+	if (m->m_pkthdr.len < 1)
+		return (false);
+	m_copydata(m, 0, 1, &fc);
+	return ((fc & IEEE80211_FC0_TYPE_MASK) != IEEE80211_FC0_TYPE_DATA ||
+	    lkpi_sta_eapol(lsta, m, false, 0, &message, &replay, NULL));
+}
+
+static void
+lkpi_sta_key_result(struct lkpi_sta *lsta, const struct ieee80211_key *k,
+    bool install, bool success)
+{
+	if (!lkpi_sta_port_enabled(lsta))
+		return;
+	LKPI_80211_LSTA_TXQ_LOCK(lsta);
+	lkpi_sta_port_key(&lsta->port, k->wk_keyix,
+	    (k->wk_flags & IEEE80211_KEY_GROUP) == 0, install, success);
+	LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+	lkpi_sta_port_queue(VAP_TO_LVIF(lsta->ni->ni_vap));
+}
+
+static bool
+lkpi_sta_key_quiesce(struct lkpi_sta *lsta)
+{
+	sbintime_t deadline;
+
+	lockdep_assert_wiphy(lsta->hw->wiphy);
+	atomic_store_rel_int(&lsta->port_key_busy, 1);
+	/*
+	 * Pair with entry fences: gate closure and user admission cannot
+	 * miss.
+	 */
+	atomic_thread_fence_seq_cst();
+	deadline = sbinuptime() + SBT_1S;
+	while (atomic_load_acq_int(&lsta->port_tx_users) != 0 &&
+	    sbinuptime() < deadline)
+		pause("lkpikey", 1);
+	if (atomic_load_acq_int(&lsta->port_tx_users) != 0) {
+		ic_printf(lsta->ni->ni_ic,
+		    "station key update timed out waiting for %u TX users\n",
+		    atomic_load_acq_int(&lsta->port_tx_users));
+		atomic_store_rel_int(&lsta->port_key_busy, 2);
+		LKPI_80211_LSTA_TXQ_LOCK(lsta);
+		lsta->port.failed = true;
+		atomic_store_rel_int(&lsta->port_open, 0);
+		LKPI_80211_LSTA_TXQ_UNLOCK(lsta);
+		lkpi_sta_port_queue(VAP_TO_LVIF(lsta->ni->ni_vap));
+		return (false);
+	}
+	/* Host preparation and dequeue owners have left; discard stale keys. */
+	for (int i = 0; i < nitems(lsta->sta.txq); i++) {
+		struct lkpi_txq *ltxq;
+		struct sk_buff *skb;
+
+		if (lsta->sta.txq[i] == NULL)
+			continue;
+		ltxq = TXQ_TO_LTXQ(lsta->sta.txq[i]);
+		for (;;) {
+			LKPI_80211_LTXQ_LOCK(ltxq);
+			skb = skb_dequeue(&ltxq->skbq);
+			LKPI_80211_LTXQ_UNLOCK(ltxq);
+			if (skb == NULL)
+				break;
+			ieee80211_free_txskb(lsta->hw, skb);
+		}
+	}
+	return (true);
+}
+
+bool
+linuxkpi_ieee80211_sta_tx_permitted(struct ieee80211_hw *hw,
+    struct ieee80211_sta *sta, struct sk_buff *skb)
+{
+	struct ieee80211_node *ni;
+	struct lkpi_sta *lsta;
+	struct mbuf *m;
+
+	if (!ieee80211_hw_check(hw, LKPI_STA_WPA2))
+		return (true);
+	if (skb == NULL || skb->m == NULL)
+		return (false);
+	m = skb->m;
+	ni = m->m_pkthdr.PH_loc.ptr;
+	if (ni == NULL || ni->ni_drv_data == NULL)
+		return (false);
+	lsta = ni->ni_drv_data;
+	if (lsta->hw != hw || (sta != NULL && STA_TO_LSTA(sta) != lsta))
+		return (false);
+	if (!lkpi_sta_tx_allowed(lsta, skb->m))
+		return (false);
+	if (m_tag_locate(m, MTAG_ABI_LKPI80211, LKPI80211_TAG_M4, NULL) != NULL)
+		return (lkpi_sta_m4_check(lsta, m));
+	return (true);
+}
