+
+#ifndef _LINUXKPI_80211_STA_H_
+#define _LINUXKPI_80211_STA_H_
+
+#include <sys/types.h>
+#ifndef _KERNEL
+#include <stdbool.h>
+#endif
+
+/*
+ * WPA2-CCMP station policy, serialized by the lsta TXQ mutex. Observation of
+ * M3 is not authentication: only the supplicant validates its MIC. An ACKed
+ * matching M4, successful PTK/GTK+replay setup, and firmware authorization are
+ * required before opening the controlled port.
+ */
+struct lkpi_sta_port {
+	uint64_t replay;
+	uint8_t anonce[32];
+	uint32_t epoch;
+	uint8_t pairwise, group;
+	bool exchange, acked, failed;
+};
+
+static inline void
+lkpi_sta_port_reset(struct lkpi_sta_port *p)
+{
+	p->epoch++;
+	p->replay = 0;
+	p->pairwise = p->group = 0;
+	p->exchange = p->acked = p->failed = false;
+}
+
+static inline bool
+lkpi_sta_port_m3(struct lkpi_sta_port *p, uint64_t replay,
+    const uint8_t nonce[32])
+{
+	bool retry;
+	unsigned int i;
+
+	if (p->exchange && replay <= p->replay)
+		return (false);
+	retry = p->exchange;
+	for (i = 0; i < sizeof(p->anonce); i++)
+		retry &= p->anonce[i] == nonce[i];
+	if (retry) {
+		/*
+		 * Some APs advance replay on M3 retries; the supplicant
+		 * correctly skips reinstalling the SAME keys/PNs in that case.
+		 */
+		p->epoch++;
+		p->acked = false;
+	} else {
+		lkpi_sta_port_reset(p);
+	}
+	for (i = 0; i < sizeof(p->anonce); i++)
+		p->anonce[i] = nonce[i];
+	p->exchange = true;
+	p->replay = replay;
+	return (true);
+}
+
+static inline bool
+lkpi_sta_port_ready(const struct lkpi_sta_port *p)
+{
+	return (p->exchange && p->acked && !p->failed &&
+	    p->pairwise != 0 && p->group != 0);
+}
+
+static inline void
+lkpi_sta_port_key(struct lkpi_sta_port *p, unsigned int slot,
+    bool pairwise, bool install, bool success)
+{
+	if (slot >= 4) {
+		p->failed = true;
+		return;
+	}
+	p->pairwise &= ~(1U << slot);
+	p->group &= ~(1U << slot);
+	if (!success) {
+		p->failed = true;
+		return;
+	}
+	if (install) {
+		if (pairwise)
+			p->pairwise |= 1U << slot;
+		else
+			p->group |= 1U << slot;
+	} else if (pairwise) {
+		/*
+		 * A removed PTK must never be revived by a delayed M4
+		 * completion.
+		 */
+		lkpi_sta_port_reset(p);
+	}
+}
+
+static inline bool
+lkpi_sta_port_current(const struct lkpi_sta_port *p, uint32_t epoch,
+    uint64_t replay)
+{
+	return (p->exchange && p->epoch == epoch && p->replay == replay &&
+	    !p->failed);
+}
+
+static inline bool
+lkpi_sta_port_ack(struct lkpi_sta_port *p, uint32_t epoch, uint64_t replay)
+{
+	if (!lkpi_sta_port_current(p, epoch, replay))
+		return (false);
+	p->acked = true;
+	return (true);
+}
+
+/*
+ * e contains at least the 99-byte EAPOL-Key prefix; len is the full PDU
+ * size.
+ */
+static inline int
+lkpi_sta_port_eapol(const uint8_t *e, unsigned int len, uint64_t *replay)
+{
+	unsigned int body, info, data;
+	uint64_t r;
+	int i;
+
+	if (len < 99 || e[0] < 1 || e[0] > 3 || e[1] != 3 || e[4] != 2)
+		return (0);
+	body = ((unsigned int)e[2] << 8) | e[3];
+	info = ((unsigned int)e[5] << 8) | e[6];
+	data = ((unsigned int)e[97] << 8) | e[98];
+	if (body < 95 || body + 4 > len || data != body - 95)
+		return (0);
+	/* Descriptor version 2, pairwise, MIC, Secure; no Request/Error/SMK. */
+	if ((info & 0xef3f) != 0x030a)
+		return (0);
+	r = 0;
+	for (i = 9; i < 17; i++)
+		r = (r << 8) | e[i];
+	*replay = r;
+	if ((info & 0x00c0) == 0x00c0)
+		return (3);
+	if ((info & 0x10c0) == 0 && body == 95 && data == 0)
+		return (4);
+	return (0);
+}
+
+#endif
