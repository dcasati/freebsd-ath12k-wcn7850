+/* IEEE 802.11be-2024, Tables 9-417i, 9-417j and 9-417m (microseconds). */
+static inline uint32_t
+ieee80211_emlsr_pad_delay_in_us(uint16_t eml_cap)
+{
+	static const uint16_t delays[8] = { 0, 32, 64, 128, 256 };
+
+	return (delays[(eml_cap & IEEE80211_EML_CAP_EMLSR_PADDING_DELAY) >> 1]);
+}
+
+static inline uint32_t
+ieee80211_emlsr_trans_delay_in_us(uint16_t eml_cap)
+{
+	static const uint16_t delays[8] = { 0, 16, 32, 64, 128, 256 };
+
+	return (delays[(eml_cap & IEEE80211_EML_CAP_EMLSR_TRANSITION_DELAY) >>
+	    4]);
+}
+
+static inline uint32_t
+ieee80211_eml_trans_timeout_in_us(uint16_t eml_cap)
+{
+	static const uint32_t timeouts[16] = {
+		0, 128, 256, 512, 1024, 2048, 4096, 8192,
+		16384, 32768, 65536, 131072
+	};
+
+	return (timeouts[(eml_cap & IEEE80211_EML_CAP_TRANSITION_TIMEOUT) >>
+	    11]);
+}
 
